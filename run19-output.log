    }
    if *(pLocal_header as *const mz_uint8).offset(0 as ::core::ffi::c_int as isize) as mz_uint32
        | (*(pLocal_header as *const mz_uint8).offset(1 as ::core::ffi::c_int as isize)
            as mz_uint32)
            << 8 as ::core::ffi::c_uint
        | (*(pLocal_header as *const mz_uint8).offset(2 as ::core::ffi::c_int as isize)
            as mz_uint32)
            << 16 as ::core::ffi::c_uint
