        .offset(0 as ::core::ffi::c_int as isize) as mz_uint32
        | (*(pLocal_header.offset(MZ_ZIP_LDH_COMPRESSED_SIZE_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(1 as ::core::ffi::c_int as isize) as mz_uint32)
            << 8 as ::core::ffi::c_uint
        | (*(pLocal_header.offset(MZ_ZIP_LDH_COMPRESSED_SIZE_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(2 as ::core::ffi::c_int as isize) as mz_uint32)
            << 16 as ::core::ffi::c_uint
        | (*(pLocal_header.offset(MZ_ZIP_LDH_COMPRESSED_SIZE_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(3 as ::core::ffi::c_int as isize) as mz_uint32)
            << 24 as ::core::ffi::c_uint) as mz_uint64;
    local_header_uncomp_size = (*(pLocal_header
        .offset(MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS as ::core::ffi::c_int as isize)
        as *const mz_uint8)
        .offset(0 as ::core::ffi::c_int as isize) as mz_uint32
        | (*(pLocal_header.offset(MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(1 as ::core::ffi::c_int as isize) as mz_uint32)
            << 8 as ::core::ffi::c_uint
        | (*(pLocal_header.offset(MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(2 as ::core::ffi::c_int as isize) as mz_uint32)
            << 16 as ::core::ffi::c_uint
        | (*(pLocal_header.offset(MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(3 as ::core::ffi::c_int as isize) as mz_uint32)
            << 24 as ::core::ffi::c_uint) as mz_uint64;
    local_header_crc32 = *(pLocal_header.offset(MZ_ZIP_LDH_CRC32_OFS as ::core::ffi::c_int as isize)
        as *const mz_uint8)
        .offset(0 as ::core::ffi::c_int as isize) as mz_uint32
        | (*(pLocal_header.offset(MZ_ZIP_LDH_CRC32_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(1 as ::core::ffi::c_int as isize) as mz_uint32)
            << 8 as ::core::ffi::c_uint
        | (*(pLocal_header.offset(MZ_ZIP_LDH_CRC32_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(2 as ::core::ffi::c_int as isize) as mz_uint32)
            << 16 as ::core::ffi::c_uint
        | (*(pLocal_header.offset(MZ_ZIP_LDH_CRC32_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(3 as ::core::ffi::c_int as isize) as mz_uint32)
            << 24 as ::core::ffi::c_uint;
