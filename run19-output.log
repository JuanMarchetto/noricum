        .offset(0 as ::core::ffi::c_int as isize) as mz_uint32
        | (*(pLocal_header.offset(MZ_ZIP_LDH_EXTRA_LEN_OFS as ::core::ffi::c_int as isize)
            as *const mz_uint8)
            .offset(1 as ::core::ffi::c_int as isize) as mz_uint32)
            << 8 as ::core::ffi::c_uint;
    local_header_comp_size = (*(pLocal_header
        .offset(MZ_ZIP_LDH_COMPRESSED_SIZE_OFS as ::core::ffi::c_int as isize)
