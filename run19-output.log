                        (*pZip).m_pAlloc_opaque,
                        pRead_buf,
                    );
                    return mz_zip_set_error(pZip, MZ_ZIP_FILE_READ_FAILED);
                }
                if (*pZip).m_pWrite.expect("non-null function pointer")(
                    (*pZip).m_pIO_opaque,
                    cur_archive_file_ofs,
                    pRead_buf,
                    n,
                ) != n
                {
                    (*pZip).m_pFree.expect("non-null function pointer")(
                        (*pZip).m_pAlloc_opaque,
                        pRead_buf,
                    );
                    return mz_zip_set_error(pZip, MZ_ZIP_FILE_WRITE_FAILED);
                }
                file_ofs = (file_ofs as ::core::ffi::c_ulong)
                    .wrapping_add(n as ::core::ffi::c_ulong) as mz_uint64
                    as mz_uint64;
                uncomp_crc32 = mz_crc32(
                    uncomp_crc32 as mz_ulong,
                    pRead_buf as *const ::core::ffi::c_uchar,
                    n,
                ) as mz_uint32 as mz_uint;
                cur_archive_file_ofs = (cur_archive_file_ofs as ::core::ffi::c_ulong)
                    .wrapping_add(n as ::core::ffi::c_ulong)
