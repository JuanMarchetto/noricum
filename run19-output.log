pub unsafe extern "C" fn mz_zip_validate_file(
    mut pZip: *mut mz_zip_archive,
    mut file_index: mz_uint,
    mut flags: mz_uint,
) -> mz_bool {
    let mut current_block: u64;
    let mut file_stat: mz_zip_archive_file_stat = mz_zip_archive_file_stat {
        m_file_index: 0,
        m_central_dir_ofs: 0,
        m_version_made_by: 0,
        m_version_needed: 0,
        m_bit_flag: 0,
        m_method: 0,
        m_crc32: 0,
        m_comp_size: 0,
        m_uncomp_size: 0,
        m_internal_attr: 0,
        m_external_attr: 0,
        m_local_header_ofs: 0,
        m_comment_size: 0,
        m_is_directory: 0,
        m_is_encrypted: 0,
        m_is_supported: 0,
        m_filename: [0; 512],
        m_comment: [0; 512],
        m_time: 0,
