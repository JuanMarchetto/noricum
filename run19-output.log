        return mz_zip_set_error(pZip, MZ_ZIP_INVALID_PARAMETER);
    }
    pState = (*pZip).m_pState;
    pCentral_dir_header = mz_zip_get_cdh(pZip, file_index);
    if mz_zip_file_stat_internal(
        pZip,
        file_index,
