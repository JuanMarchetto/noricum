            as mz_uint32)
            << 8 as ::core::ffi::c_uint
        | (*(pLocal_header as *const mz_uint8).offset(2 as ::core::ffi::c_int as isize)
            as mz_uint32)
            << 16 as ::core::ffi::c_uint
        | (*(pLocal_header as *const mz_uint8).offset(3 as ::core::ffi::c_int as isize)
            as mz_uint32)
            << 24 as ::core::ffi::c_uint
        != MZ_ZIP_LOCAL_DIR_HEADER_SIG as ::core::ffi::c_int as mz_uint32
    {
