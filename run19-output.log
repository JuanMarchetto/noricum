            loop {
                let mut n: size_t = read_callback.expect("non-null function pointer")(
                    callback_opaque,
                    file_ofs,
                    pRead_buf,
                    MZ_ZIP_MAX_IO_BUF_SIZE as ::core::ffi::c_int as size_t,
