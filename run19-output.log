                    as *const mz_uint8)
                    .offset(0 as ::core::ffi::c_int as isize) as mz_uint32
                    | (*(pLocal_header
                        .offset(MZ_ZIP_LDH_FILENAME_LEN_OFS as ::core::ffi::c_int as isize)
                        as *const mz_uint8)
                        .offset(1 as ::core::ffi::c_int as isize)
                        as mz_uint32)
                        << 8 as ::core::ffi::c_uint) as mz_uint64,
            )
            .wrapping_add(
                (*(pLocal_header.offset(MZ_ZIP_LDH_EXTRA_LEN_OFS as ::core::ffi::c_int as isize)
                    as *const mz_uint8)
                    .offset(0 as ::core::ffi::c_int as isize) as mz_uint32
                    | (*(pLocal_header
                        .offset(MZ_ZIP_LDH_EXTRA_LEN_OFS as ::core::ffi::c_int as isize)
                        as *const mz_uint8)
                        .offset(1 as ::core::ffi::c_int as isize)
                        as mz_uint32)
                        << 8 as ::core::ffi::c_uint) as mz_uint64,
            ),
    );
