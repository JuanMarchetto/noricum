        if (*pZip).m_total_files == MZ_UINT32_MAX as mz_uint32 {
            return mz_zip_set_error(pZip, MZ_ZIP_TOO_MANY_FILES);
        }
    } else {
        if (*pZip).m_total_files == MZ_UINT16_MAX as mz_uint32 {
            return mz_zip_set_error(pZip, MZ_ZIP_TOO_MANY_FILES);
        }
        if (*pZip)
            .m_archive_size
            .wrapping_add(MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as ::core::ffi::c_int as mz_uint64)
            .wrapping_add(MZ_ZIP_LOCAL_DIR_HEADER_SIZE as ::core::ffi::c_int as mz_uint64)
            > MZ_UINT32_MAX as mz_uint64
        {
