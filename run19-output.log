        (*pZip).m_pIO_opaque,
        local_header_ofs,
        pLocal_header as *mut ::core::ffi::c_void,
        MZ_ZIP_LOCAL_DIR_HEADER_SIZE as ::core::ffi::c_int as size_t,
    ) != MZ_ZIP_LOCAL_DIR_HEADER_SIZE as ::core::ffi::c_int as size_t
    {
