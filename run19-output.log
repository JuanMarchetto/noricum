                comp_size as mz_uint32,
            );
            mz_write_le32(
                (&raw mut local_dir_footer as *mut mz_uint8)
                    .offset(12 as ::core::ffi::c_int as isize),
                uncomp_size as mz_uint32,
            );
        } else {
            mz_write_le64(
                (&raw mut local_dir_footer as *mut mz_uint8)
                    .offset(8 as ::core::ffi::c_int as isize),
                comp_size,
            );
            mz_write_le64(
                (&raw mut local_dir_footer as *mut mz_uint8)
                    .offset(16 as ::core::ffi::c_int as isize),
                uncomp_size,
            );
