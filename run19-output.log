                    file_ofs,
                    pRead_buf,
                    MZ_ZIP_MAX_IO_BUF_SIZE as ::core::ffi::c_int as size_t,
                );
                if n_0 > MZ_ZIP_MAX_IO_BUF_SIZE as ::core::ffi::c_int as size_t
