    }
    (*pState).cur_file_ofs = (*pState).cur_file_ofs.wrapping_add(
        (MZ_ZIP_LOCAL_DIR_HEADER_SIZE as ::core::ffi::c_int as mz_uint64)
            .wrapping_add(
