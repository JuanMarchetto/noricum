        pDst = pDst.offset(::core::mem::size_of::<mz_uint64>() as usize as isize);
        field_size = (field_size as ::core::ffi::c_ulong)
            .wrapping_add(::core::mem::size_of::<mz_uint64>() as usize as ::core::ffi::c_ulong)
            as mz_uint32 as mz_uint32;
    }
