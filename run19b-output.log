// Cross-platform implementation for file operations (no Windows-specific widechar conversion needed)
pub fn mz_fopen(p_filename: &str, p_mode: &str) -> Option<fs::File> {
    let mode = p_mode.trim_end_matches('b'); // Remove 'b' flag if present (binary mode)
    
    match mode {
        "r" | "rb" => fs::File::open(p_filename).ok(),
        "w" | "wb" => fs::File::create(p_filename).ok(),
        "a" | "ab" => fs::OpenOptions::new()
            .append(true)
            .create(true)
            .open(p_filename)
            .ok(),
        "r+" | "rb+" | "r+b" => fs::OpenOptions::new()
            .read(true)
            .write(true)
            .open(p_filename)
            .ok(),
        "w+" | "wb+" | "w+b" => fs::OpenOptions::new()
            .read(true)
            .write(true)
            .create(true)
            .truncate(true)
            .open(p_filename)
            .ok(),
        "a+" | "ab+" | "a+b" => fs::OpenOptions::new()
            .read(true)
            .write(true)
            .append(true)
            .create(true)
            .open(p_filename)
            .ok(),
        _ => None,
    }
}

pub fn mz_freopen(p_path: &str, p_mode: &str, p_stream: &mut fs::File) -> Option<fs::File> {
    // Rust doesn't have direct freopen equivalent. We'll close and reopen.
    // Note: This drops the original stream
    mz_fopen(p_path, p_mode)
}

