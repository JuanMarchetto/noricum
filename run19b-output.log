// --- Module: mz_p2 ---
const MZ_ZIP_DATA_DESCRIPTOR_SIZE64: usize = 24;
const MZ_ZIP_DATA_DESCRIPTOR_SIZE32: usize = 16;






const MZ_UINT32_MAX: u32 = 0xFFFFFFFF;
const MZ_UINT16_MAX: u16 = 0xFFFF;

const MZ_ZIP_FLAG_DO_NOT_SORT_CENTRAL_DIRECTORY: u32 = 0x10;
const MZ_ZIP_FLAG_READ_ALLOW_WRITING: u32 = 0x1000;

#[derive(Debug)]
struct ZipArray {
    data: Vec<u8>,
    element_size: usize,
}

impl ZipArray {
    fn new() -> Self {
        Self {
            data: Vec::new(),
            element_size: 0,
        }
    }

    fn resize(&mut self, new_size: usize, zero_init: bool) -> bool {
        let new_capacity = new_size * self.element_size;
        if zero_init {
            self.data.resize(new_capacity, 0);
        } else {
            self.data.reserve(new_capacity);
            unsafe { self.data.set_len(new_capacity) };
        }
        true
    }

    fn clear(&mut self) {
        self.data.clear();
        self.data.shrink_to_fit();
    }

    fn element<T>(&self, index: usize) -> &T {
        let offset = index * self.element_size;
        unsafe { &*(self.data.as_ptr().add(offset) as *const T) }
    }

    fn element_mut<T>(&mut self, index: usize) -> &mut T {
        let offset = index * self.element_size;
        unsafe { &mut *(self.data.as_mut_ptr().add(offset) as *mut T) }
    }
}

struct ZipInternalState {
    central_dir: ZipArray,
    central_dir_offsets: ZipArray,
    sorted_central_dir_offsets: ZipArray,
    init_flags: u32,
    zip64: bool,
    zip64_has_extended_info_fields: bool,
    pfile: Option<File>,
    file_archive_start_ofs: u64,
    pmem: Option<Vec<u8>>,
    mem_size: usize,
    mem_capacity: usize,
}

impl ZipInternalState {
    fn new() -> Self {
        Self {
            central_dir: ZipArray::new(),
            central_dir_offsets: ZipArray::new(),
            sorted_central_dir_offsets: ZipArray::new(),
            init_flags: 0,
            zip64: false,
            zip64_has_extended_info_fields: false,
            pfile: None,
            file_archive_start_ofs: 0,
            pmem: None,
            mem_size: 0,
            mem_capacity: 0,
        }
    }
}

struct ZipArchive {
    archive_size: u64,
    central_directory_file_ofs: u64,
    total_files: u32,
    zip_type: u32,
    zip_mode: u32,
    pstate: Option<ZipInternalState>,
    pread: Option<Box<dyn Fn(&mut dyn std::any::Any, u64, &mut [u8]) -> usize>>,
    pio_opaque: Option<Box<dyn std::any::Any>>,
    plast_error: i32,
    palloc: Option<Box<dyn Fn(&mut dyn std::any::Any, usize, usize) -> *mut u8>>,
    pfree: Option<Box<dyn Fn(&mut dyn std::any::Any, *mut u8)>>,
    palloc_opaque: Option<Box<dyn std::any::Any>>,
    pneeds_keepalive: Option<Box<dyn std::any::Any>>,
}

impl ZipArchive {
    fn new() -> Self {
        Self {
            archive_size: 0,
            central_directory_file_ofs: 0,
            total_files: 0,
            zip_type: 0,
            zip_mode: 0,
            pstate: None,
            pread: None,
            pio_opaque: None,
            plast_error: 0,
            palloc: None,
            pfree: None,
            palloc_opaque: None,
            pneeds_keepalive: None,
        }
    }

    fn set_error(&mut self, error: i32) -> bool {
        self.plast_error = error;
        false
    }
}

fn read_le_u16(data: &[u8]) -> u16 {
    u16::from_le_bytes([data[0], data[1]])
}

fn read_le_u32(data: &[u8]) -> u32 {
    u32::from_le_bytes([data[0], data[1], data[2], data[3]])
}

fn read_le_u64(data: &[u8]) -> u64 {
    u64::from_le_bytes([
        data[0], data[1], data[2], data[3], data[4], data[5], data[6], data[7],
    ])
}

fn mz_zip_reader_read_central_dir(zip: &mut ZipArchive, flags: u32) -> bool {
    let mut cdir_size: u32 = 0;
    let mut cdir_entries_on_this_disk: u32 = 0;
    let mut num_this_disk: u32 = 0;
    let mut cdir_disk_index: u32 = 0;
    let mut cdir_ofs: u64 = 0;
    let mut eocd_ofs: u64 = 0;
    let mut archive_ofs: u64 = 0;

    let sort_central_dir = (flags & MZ_ZIP_FLAG_DO_NOT_SORT_CENTRAL_DIRECTORY) == 0;

    if zip.archive_size < MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64 {
        return zip.set_error(1); // MZ_ZIP_NOT_AN_ARCHIVE
    }

    let mut cur_file_ofs = zip.archive_size - MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64;
    let mut found = false;
    while cur_file_ofs >= 3 {
        let mut buf = [0u8; 4];
        if zip.pread.as_ref().unwrap()(zip.pio_opaque.as_mut().unwrap(), cur_file_ofs, &mut buf) != 4 {
            break;
        }
        if read_le_u32(&buf) == MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIG {
            found = true;
            break;
        }
        cur_file_ofs -= 1;
    }

    if !found {
        return zip.set_error(2); // MZ_ZIP_FAILED_FINDING_CENTRAL_DIR
    }

    eocd_ofs = cur_file_ofs;

    let mut eocd_buf = [0u8; MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE];
    if zip.pread.as_ref().unwrap()(
        zip.pio_opaque.as_mut().unwrap(),
        cur_file_ofs,
        &mut eocd_buf,
    ) != MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE
    {
        return zip.set_error(3); // MZ_ZIP_FILE_READ_FAILED
    }

    if read_le_u32(&eocd_buf[MZ_ZIP_ECDH_SIG_OFS..]) != MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIG {
        return zip.set_error(1); // MZ_ZIP_NOT_AN_ARCHIVE
    }

    let mut zip64_locator = [0u8; MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE];
    let mut zip64_end_of_central_dir = [0u8; MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE];
    let mut zip64_end_of_central_dir_ofs: u64 = 0;

    if cur_file_ofs >= (MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE + MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE) as u64
    {
        if zip.pread.as_ref().unwrap()(
            zip.pio_opaque.as_mut().unwrap(),
            cur_file_ofs - MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE as u64,
            &mut zip64_locator,
        ) == MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE
        {
            if read_le_u32(&zip64_locator[MZ_ZIP64_ECDL_SIG_OFS..]) == MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIG
            {
                zip.pstate.as_mut().unwrap().zip64 = true;
            }
        }
    }

    if zip.pstate.as_ref().unwrap().zip64 {
        if cur_file_ofs < (MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE + MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE) as u64
        {
            return zip.set_error(1); // MZ_ZIP_NOT_AN_ARCHIVE
        }

        zip64_end_of_central_dir_ofs = cur_file_ofs
            - MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE as u64
            - MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE as u64;

        if !mz_zip_reader_eocd64_valid(zip, zip64_end_of_central_dir_ofs, &mut zip64_end_of_central_dir)
        {
            zip64_end_of_central_dir_ofs = read_le_u64(&zip64_locator[MZ_ZIP64_ECDL_REL_OFS_TO_ZIP64_ECDR_OFS..]);
            if zip64_end_of_central_dir_ofs > (zip.archive_size - MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE as u64)
            {
                return zip.set_error(1); // MZ_ZIP_NOT_AN_ARCHIVE
            }
            if !mz_zip_reader_eocd64_valid(zip, zip64_end_of_central_dir_ofs, &mut zip64_end_of_central_dir)
            {
                return zip.set_error(1); // MZ_ZIP_NOT_AN_ARCHIVE
            }
        }
    }

    zip.total_files = read_le_u16(&eocd_buf[MZ_ZIP_ECDH_CDIR_TOTAL_ENTRIES_OFS..]) as u32;
    cdir_entries_on_this_disk = read_le_u16(&eocd_buf[MZ_ZIP_ECDH_CDIR_NUM_ENTRIES_ON_DISK_OFS..]) as u32;
    num_this_disk = read_le_u16(&eocd_buf[MZ_ZIP_ECDH_NUM_THIS_DISK_OFS..]) as u32;
    cdir_disk_index = read_le_u16(&eocd_buf[MZ_ZIP_ECDH_NUM_DISK_CDIR_OFS..]) as u32;
    cdir_size = read_le_u32(&eocd_buf[MZ_ZIP_ECDH_CDIR_SIZE_OFS..]);
    cdir_ofs = read_le_u32(&eocd_buf[MZ_ZIP_ECDH_CDIR_OFS_OFS..]) as u64;

    if zip.pstate.as_ref().unwrap().zip64 {
        let zip64_total_num_of_disks = read_le_u32(&zip64_locator[MZ_ZIP64_ECDL_TOTAL_NUMBER_OF_DISKS_OFS..]);
        let zip64_cdir_total_entries = read_le_u64(&zip64_end_of_central_dir[MZ_ZIP64_ECDH_CDIR_TOTAL_ENTRIES_OFS..]);
        let zip64_cdir_total_entries_on_this_disk =
            read_le_u64(&zip64_end_of_central_dir[MZ_ZIP64_ECDH_CDIR_NUM_ENTRIES_ON_DISK_OFS..]);
        let zip64_size_of_end_of_central_dir_record =
            read_le_u64(&zip64_end_of_central_dir[MZ_ZIP64_ECDH_SIZE_OF_RECORD_OFS..]);
        let zip64_size_of_central_directory =
            read_le_u64(&zip64_end_of_central_dir[MZ_ZIP64_ECDH_CDIR_SIZE_OFS..]);

        if zip64_size_of_end_of_central_dir_record < (MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE - 12) as u64
        {
            return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
        }

        if zip64_total_num_of_disks != 1 {
            return zip.set_error(5); // MZ_ZIP_UNSUPPORTED_MULTIDISK
        }

        if zip64_cdir_total_entries > MZ_UINT32_MAX as u64 {
            return zip.set_error(6); // MZ_ZIP_TOO_MANY_FILES
        }

        zip.total_files = zip64_cdir_total_entries as u32;

        if zip64_cdir_total_entries_on_this_disk > MZ_UINT32_MAX as u64 {
            return zip.set_error(6); // MZ_ZIP_TOO_MANY_FILES
        }

        cdir_entries_on_this_disk = zip64_cdir_total_entries_on_this_disk as u32;

        if zip64_size_of_central_directory > MZ_UINT32_MAX as u64 {
            return zip.set_error(7); // MZ_ZIP_UNSUPPORTED_CDIR_SIZE
        }

        cdir_size = zip64_size_of_central_directory as u32;

        num_this_disk = read_le_u32(&zip64_end_of_central_dir[MZ_ZIP64_ECDH_NUM_THIS_DISK_OFS..]);
        cdir_disk_index = read_le_u32(&zip64_end_of_central_dir[MZ_ZIP64_ECDH_NUM_DISK_CDIR_OFS..]);
        cdir_ofs = read_le_u64(&zip64_end_of_central_dir[MZ_ZIP64_ECDH_CDIR_OFS_OFS..]);
    }

    if zip.total_files != cdir_entries_on_this_disk {
        return zip.set_error(5); // MZ_ZIP_UNSUPPORTED_MULTIDISK
    }

    if ((num_this_disk | cdir_disk_index) != 0) && ((num_this_disk != 1) || (cdir_disk_index != 1))
    {
        return zip.set_error(5); // MZ_ZIP_UNSUPPORTED_MULTIDISK
    }

    if (cdir_size as u64) < (zip.total_files as u64 * MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as u64) {
        return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
    }

    if (cdir_ofs + cdir_size as u64) > zip.archive_size {
        return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
    }

    if eocd_ofs < cdir_ofs + cdir_size as u64 {
        return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
    }

    archive_ofs = eocd_ofs - (cdir_ofs + cdir_size as u64);
    if zip.pstate.as_ref().unwrap().zip64 {
        if archive_ofs < (MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE + MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE) as u64
        {
            return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
        }
        archive_ofs -= (MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE + MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE) as u64;
    }

    if zip.pstate.as_mut().unwrap().file_archive_start_ofs == 0 {
        zip.pstate.as_mut().unwrap().file_archive_start_ofs = archive_ofs;
        zip.archive_size -= archive_ofs;
    }

    zip.central_directory_file_ofs = cdir_ofs;

    if zip.total_files > 0 {
        let state = zip.pstate.as_mut().unwrap();
        state.central_dir.element_size = 1;
        state.central_dir_offsets.element_size = 4;
        state.sorted_central_dir_offsets.element_size = 4;

        if !state.central_dir.resize(cdir_size as usize, false)
            || !state.central_dir_offsets.resize(zip.total_files as usize, false)
        {
            return zip.set_error(8); // MZ_ZIP_ALLOC_FAILED
        }

        if sort_central_dir {
            if !state.sorted_central_dir_offsets.resize(zip.total_files as usize, false) {
                return zip.set_error(8); // MZ_ZIP_ALLOC_FAILED
            }
        }

        if zip.pread.as_ref().unwrap()(
            zip.pio_opaque.as_mut().unwrap(),
            cdir_ofs,
            &mut state.central_dir.data,
        ) != cdir_size as usize
        {
            return zip.set_error(3); // MZ_ZIP_FILE_READ_FAILED
        }

        let mut p = state.central_dir.data.as_ptr();
        let mut remaining = cdir_size as usize;

        for i in 0..zip.total_files as usize {
            if remaining < MZ_ZIP_CENTRAL_DIR_HEADER_SIZE
                || read_le_u32(unsafe { std::slice::from_raw_parts(p, 4) }) != MZ_ZIP_CENTRAL_DIR_HEADER_SIG
            {
                return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
            }

            *state.central_dir_offsets.element_mut::<u32>(i) =
                (p as usize - state.central_dir.data.as_ptr() as usize) as u32;

            if sort_central_dir {
                *state.sorted_central_dir_offsets.element_mut::<u32>(i) = i as u32;
            }

            let comp_size = read_le_u32(unsafe { p.add(MZ_ZIP_CDH_COMPRESSED_SIZE_OFS..).as_ref().unwrap() });
            let decomp_size = read_le_u32(unsafe { p.add(MZ_ZIP_CDH_DECOMPRESSED_SIZE_OFS..).as_ref().unwrap() });
            let local_header_ofs = read_le_u32(unsafe { p.add(MZ_ZIP_CDH_LOCAL_HEADER_OFS..).as_ref().unwrap() });
            let filename_size =
                read_le_u16(unsafe { p.add(MZ_ZIP_CDH_FILENAME_LEN_OFS..).as_ref().unwrap() }) as usize;
            let ext_data_size =
                read_le_u16(unsafe { p.add(MZ_ZIP_CDH_EXTRA_LEN_OFS..).as_ref().unwrap() }) as usize;

            if !state.zip64_has_extended_info_fields
                && ext_data_size > 0
                && comp_size == MZ_UINT32_MAX
                && decomp_size == MZ_UINT32_MAX
                && local_header_ofs == MZ_UINT32_MAX
            {
                let mut extra_buf = vec![0u8; ext_data_size];
                if MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + filename_size + ext_data_size > remaining {
                    if zip.pread.as_ref().unwrap()(
                        zip.pio_opaque.as_mut().unwrap(),
                        cdir_ofs + (MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + filename_size) as u64,
                        &mut extra_buf,
                    ) != ext_data_size
                    {
                        return zip.set_error(3); // MZ_ZIP_FILE_READ_FAILED
                    }
                } else {
                    extra_buf.copy_from_slice(unsafe {
                        std::slice::from_raw_parts(p.add(MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + filename_size), ext_data_size)
                    });
                }

                let mut extra_ptr = extra_buf.as_ptr();
                let mut extra_remaining = ext_data_size;

                while extra_remaining >= 4 {
                    let field_id = read_le_u16(unsafe { std::slice::from_raw_parts(extra_ptr, 2) });
                    let field_data_size = read_le_u16(unsafe { std::slice::from_raw_parts(extra_ptr.add(2), 2) });

                    if (field_data_size as usize + 4) > extra_remaining {
                        return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
                    }

                    if field_id == MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID {
                        state.zip64 = true;
                        state.zip64_has_extended_info_fields = true;
                        break;
                    }

                    extra_ptr = unsafe { extra_ptr.add(field_data_size as usize + 4) };
                    extra_remaining -= field_data_size as usize + 4;
                }
            }

            if comp_size != MZ_UINT32_MAX && decomp_size != MZ_UINT32_MAX {
                let method = read_le_u16(unsafe { p.add(MZ_ZIP_CDH_METHOD_OFS..).as_ref().unwrap() });
                if (method == 0 && decomp_size != comp_size) || (decomp_size > 0 && comp_size == 0) {
                    return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
                }
            }

            let disk_index = read_le_u16(unsafe { p.add(MZ_ZIP_CDH_DISK_START_OFS..).as_ref().unwrap() });
            if disk_index == MZ_UINT16_MAX || (disk_index != num_this_disk as u16 && disk_index != 1) {
                return zip.set_error(5); // MZ_ZIP_UNSUPPORTED_MULTIDISK
            }

            if comp_size != MZ_UINT32_MAX {
                if (local_header_ofs as u64 + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + comp_size as u64) > zip.archive_size
                {
                    return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
                }
            }

            let bit_flags = read_le_u16(unsafe { p.add(MZ_ZIP_CDH_BIT_FLAG_OFS..).as_ref().unwrap() });
            if (bit_flags & MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_LOCAL_DIR_IS_MASKED) != 0 {
                return zip.set_error(9); // MZ_ZIP_UNSUPPORTED_ENCRYPTION
            }

            let comment_size = read_le_u16(unsafe { p.add(MZ_ZIP_CDH_COMMENT_LEN_OFS..).as_ref().unwrap() }) as usize;
            let total_header_size = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + filename_size + ext_data_size + comment_size;
            if total_header_size > remaining {
                return zip.set_error(4); // MZ_ZIP_INVALID_HEADER_OR_CORRUPTED
            }

            remaining -= total_header_size;
            p = unsafe { p.add(total_header_size) };
        }
    }

    if sort_central_dir {
        mz_zip_reader_sort_central_dir_offsets_by_filename(zip);
    }

    true
}

fn mz_zip_zero_struct(zip: &mut ZipArchive) {
    *zip = ZipArchive::new();
}

fn mz_zip_reader_end_internal(zip: &mut ZipArchive, set_last_error: bool) -> bool {
    if zip.pstate.is_none()
        || zip.palloc.is_none()
        || zip.pfree.is_none()
        || zip.zip_mode != 1 /* MZ_ZIP_MODE_READING */
    {
        if set_last_error {
            zip.plast_error = 10; // MZ_ZIP_INVALID_PARAMETER
        }
        return false;
    }

    if let Some(mut state) = zip.pstate.take() {
        state.central_dir.clear();
        state.central_dir_offsets.clear();
        state.sorted_central_dir_offsets.clear();

        if let Some(file) = state.pfile.take() {
            if let Err(_) = file.sync_all() {
                if set_last_error {
                    zip.plast_error = 11; // MZ_ZIP_FILE_CLOSE_FAILED
                }
            }
        }

        zip.pfree.as_ref().unwrap()(zip.palloc_opaque.as_mut().unwrap(), &mut state as *mut _ as *mut u8);
    }

    zip.zip_mode = 0; // MZ_ZIP_MODE_INVALID
    true
}

fn mz_zip_reader_end(zip: &mut ZipArchive) -> bool {
    mz_zip_reader_end_internal(zip, true)
}

fn mz_zip_reader_init(zip: &mut ZipArchive, size: u64, flags: u32) -> bool {
    if zip.pread.is_none() {
        return zip.set_error(10); // MZ_ZIP_INVALID_PARAMETER
    }

    if !mz_zip_reader_init_internal(zip, flags) {
        return false;
    }

    zip.zip_type = 2; // MZ_ZIP_TYPE_USER
    zip.archive_size = size;

    if !mz_zip_reader_read_central_dir(zip, flags) {
        mz_zip_reader_end_internal(zip, false);
        return false;
    }

    true
}

fn mz_zip_mem_read_func(opaque: &mut dyn std::any::Any, file_ofs: u64, buf: &mut [u8]) -> usize {
    let zip = opaque.downcast_ref::<ZipArchive>().unwrap();
    let state = zip.pstate.as_ref().unwrap();
    
    if file_ofs >= zip.archive_size {
        return 0;
    }
    
    let remaining = zip.archive_size - file_ofs;
    let to_read = std::cmp::min(remaining, buf.len() as u64) as usize;
    
    if let Some(pmem) = &state.pmem {
        buf[..to_read].copy_from_slice(&pmem[file_ofs as usize..file_ofs as usize + to_read]);
    }
    
    to_read
}

fn mz_zip_reader_init_mem(zip: &mut ZipArchive, pmem: &[u8], size: usize, flags: u32) -> bool {
    if pmem.is_empty() {
        return zip.set_error(10); // MZ_ZIP_INVALID_PARAMETER
    }

    if size < MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE {
        return zip.set_error(1); // MZ_ZIP_NOT_AN_ARCHIVE
    }

    if !mz_zip_reader_init_internal(zip, flags) {
        return false;
    }

    zip.zip_type = 1; // MZ_ZIP_TYPE_MEMORY
    zip.archive_size = size as u64;
    zip.pread = Some(Box::new(mz_zip_mem_read_func));
    zip.pio_opaque = Some(Box::new(zip as *mut _));
    zip.pneeds_keepalive = None;

    let state = zip.pstate.as_mut().unwrap();
    state.pmem = Some(pmem.to_vec());
    state.mem_size = size;

    if !mz_zip_reader_read_central_dir(zip, flags) {
        mz_zip_reader_end_internal(zip, false);
        return false;
    }

    true
}

fn mz_zip_file_read_func(opaque: &mut dyn std::any::Any, file_ofs: u64, buf: &mut [u8]) -> usize {
    let zip = opaque.downcast_ref::<ZipArchive>().unwrap();
    let state = zip.pstate.as_ref().unwrap();
    
    if let Some(file) = &state.pfile {
        let absolute_ofs = file_ofs + state.file_archive_start_ofs;
        if let Ok(_) = file.seek(SeekFrom::Start(absolute_ofs)) {
            if let Ok(bytes_read) = file.read(buf) {
                return bytes_read;
            }
        }
    }
    
    0
}

fn mz_zip_reader_init_file(zip: &mut ZipArchive, filename: &str, flags: u32) -> bool {
    mz_zip_reader_init_file_v2(zip, filename, flags, 0, 0)
}

fn mz_zip_reader_init_file_v2(
    zip: &mut ZipArchive,
    filename: &str,
    flags: u32,
    file_start_ofs: u64,
    archive_size: u64,
) -> bool {
    if filename.is_empty() || (archive_size > 0 && archive_size < MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64) {
        return zip.set_error(10); // MZ_ZIP_INVALID_PARAMETER
    }

    let open_mode = if (flags & MZ_ZIP_FLAG_READ_ALLOW_WRITING) != 0 {
        "r+b"
    } else {
        "rb"
    };
    
    let file = match File::open(filename) {
        Ok(f) => f,
        Err(_) => return zip.set_error(12), // MZ_ZIP_FILE_OPEN_FAILED
    };

    let mut file_size = archive_size;
    if file_size == 0 {
        if let Ok(metadata) = file.metadata() {
            file_size = metadata.len();
        } else {
            return zip.set_error(13); // MZ_ZIP_FILE_SEEK_FAILED
        }
    }

    if file_size < MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64 {
        return zip.set_error(1); // MZ_ZIP_NOT_AN_ARCHIVE
    }

    if !mz_zip_reader_init_internal(zip, flags) {
        return false;
    }

    zip.zip_type = 0; // MZ_ZIP_TYPE_FILE
    zip.pread = Some(Box::new(mz_zip_file_read_func));
    zip.pio_opaque = Some(Box::new(zip as *mut _));
    
    let state = zip.pstate.as_mut().unwrap();
    state.pfile = Some(file);
    zip.archive_size = file_size;
    state.file_archive_start_ofs = file_start_ofs;

    if !mz_zip_reader_read_central_dir(zip, flags) {
        mz_zip_reader_end_internal(zip, false);
        return false;
    }

    true
}

fn mz_zip_reader_init_cfile(
    zip: &mut ZipArchive,
    file: File,
    archive_size: u64,
    flags: u32,
) -> bool {
    let cur_file_ofs = match file.seek(SeekFrom::Current(0)) {
        Ok(pos) => pos,
        Err(_) => return zip.set_error(13), // MZ_ZIP_FILE_SEEK_FAILED
    };

    let mut actual_archive_size = archive_size;
    if actual_archive_size == 0 {
        if let Ok(metadata) = file.metadata() {
            let file_size = metadata.len();
            if file_size >= cur_file_ofs + MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64 {
                actual_archive_size = file_size - cur_file_ofs;
            } else {
                return zip.set_error(1); // MZ_ZIP_NOT_AN_ARCHIVE
            }
        } else {
            return zip.set_error(13); // MZ_ZIP_FILE_SEEK_FAILED
        }
    }

    if actual_archive_size < MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64 {
        return zip.set_error(1); // MZ_ZIP_NOT_AN_ARCHIVE
    }

    if !mz_zip_reader_init_internal(zip, flags) {
        return false;
    }

    zip.zip_type = 3; // MZ_ZIP_TYPE_CFILE
    zip.pread = Some(Box::new(mz_zip_file_read_func));
    zip.pio_opaque = Some(Box::new(zip as *mut _));
    
    let state = zip.pstate.as_mut().unwrap();
    state.pfile = Some(file);
    zip.archive_size = actual_archive_size;
    state.file_archive_start_ofs = cur_file_ofs;

    if !mz_zip_reader_read_central_dir(zip, flags) {
        mz_zip_reader_end_internal(zip, false);
        return false;
    }

    true
}

fn mz_zip_get_cdh(zip: &ZipArchive, file_index: u32) -> Option<&[u8]> {
    if file_index >= zip.total_files {
        return None;
    }
    
    let state = zip.pstate.as_ref()?;
    let offset = *state.central_dir_offsets.element::<u32>(file_index as usize) as usize;
    Some(&state.central_dir.data[offset..])
}

fn mz_zip_reader_is_file_encrypted(zip: &mut ZipArchive, file_index: u32) -> bool {
    let p = match mz_zip_get_cdh(zip, file_index) {
        Some(data) => data,
        None => {
            zip.set_error(10); // MZ_ZIP_INVALID_PARAMETER
            return false;
        }
    };
    
    let bit_flag = read_le_u16(&p[MZ_ZIP_CDH_BIT_FLAG_OFS..]);
    (bit_flag & (MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_IS_ENCRYPTED | MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_USES_STRONG_ENCRYPTION)) != 0
}

fn mz_zip_reader_is_file_supported(zip: &mut ZipArchive, file_index: u32) -> bool {
    let p = match mz_zip_get_cdh(zip, file_index) {
        Some(data) => data,
        None => {
            zip.set_error(10); // MZ_ZIP_INVALID_PARAMETER
            return false;
        }
    };
    
    let method = read_le_u16(&p[MZ_ZIP_CDH_METHOD_OFS..]);
    let bit_flag = read_le_u16(&p[MZ_ZIP_CDH_BIT_FLAG_OFS..]);

    if method != 0 && method != 8 /* MZ_DEFLATED */ {
        zip.set_error(14); // MZ_ZIP_UNSUPPORTED_METHOD
        return false;
    }

    if (bit_flag & (MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_IS_ENCRYPTED | MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_USES_STRONG_ENCRYPTION)) != 0
    {
        zip.set_error(9); // MZ_ZIP_UNSUPPORTED_ENCRYPTION
        return false;
    }

    if (bit_flag & MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_COMPRESSED_PATCH_FLAG) != 0 {
        zip.set_error(15); // MZ_ZIP_UNSUPPORTED_FEATURE
        return false;
    }

    true
}

