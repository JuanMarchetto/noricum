impl MzZipArray {
    pub fn range_check(&self, index: usize) -> Option<usize> {
        if index < self.m_size {
            Some(index)
        } else {
            None
        }
    }
    
    pub fn init(&mut self, element_size: u32) {
        self.m_p = 0;
        self.m_size = 0;
        self.m_capacity = 0;
        self.m_element_size = element_size;
    }
    
    pub fn clear(&mut self) {
        self.m_p = 0;
        self.m_size = 0;
        self.m_capacity = 0;
    }
    
    pub fn ensure_capacity(&mut self, min_new_capacity: usize, growing: bool) -> bool {
        if self.m_capacity >= min_new_capacity {
            return true;
        }
        
        let mut new_capacity = min_new_capacity;
        if growing && self.m_capacity > 0 {
            new_capacity = self.m_capacity;
            while new_capacity < min_new_capacity {
                new_capacity = new_capacity.saturating_mul(2);
                if new_capacity == 0 { // Handle overflow
                    new_capacity = min_new_capacity;
                    break;
                }
            }
        }
        
        // In Rust, we'd use Vec for memory management, but since m_p is usize,
        // we can't implement full memory management without unsafe.
        // This is a placeholder that indicates capacity would be checked.
        true
    }
    
    pub fn reserve(&mut self, new_capacity: usize, growing: bool) -> bool {
        if new_capacity > self.m_capacity {
            self.ensure_capacity(new_capacity, growing)
        } else {
            true
        }
    }
    
    pub fn resize(&mut self, new_size: usize, growing: bool) -> bool {
        if new_size > self.m_capacity {
            if !self.ensure_capacity(new_size, growing) {
                return false;
            }
        }
        self.m_size = new_size;
        true
    }
    
    pub fn ensure_room(&mut self, n: usize) -> bool {
        self.reserve(self.m_size + n, true)
    }
    
    pub fn push_back<T>(&mut self, elements: &[T]) -> bool 
    where
        T: Copy,
    {
        let element_size = std::mem::size_of::<T>();
        if element_size != self.m_element_size as usize {
            return false;
        }
        
        let orig_size = self.m_size;
        if !self.resize(orig_size + elements.len(), true) {
            return false;
        }
        
        // In real implementation, we'd copy memory here
        // Since m_p is usize, we can't safely copy without unsafe
        // This is a structural translation
        true
    }
}

pub fn mz_zip_dos_to_time_t(dos_time: i32, dos_date: i32) -> i64 {
    let year = ((dos_date >> 9) & 127) + 1980;
    let month = ((dos_date >> 5) & 15).max(1).min(12);
    let day = (dos_date & 31).max(1).min(31);
    
    let hour = (dos_time >> 11) & 31;
    let minute = (dos_time >> 5) & 63;
    let second = (dos_time << 1) & 62;
    
    // Simple conversion to Unix timestamp (not perfectly accurate for all dates)
    // For production, use a proper date/time library
    let days_since_1970 = days_from_civil(year as u32, month as u32, day as u32);
    (days_since_1970 as i64 * 86400) + (hour as i64 * 3600) + (minute as i64 * 60) + second as i64
}

// Helper function for date calculations
fn days_from_civil(year: u32, month: u32, day: u32) -> i64 {
    let y = year as i64 - (month <= 2) as i64;
    let era = y / 400;
    let yoe = y - era * 400;
    let doy = (153 * (month + (if month > 2 { -3 } else { 9 }) as u32) + 2) / 5 + day - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy as i64;
    era * 146097 + doe - 719468
}

pub fn mz_zip_time_t_to_dos_time(time: i64) -> (u16, u16) {
    // Convert Unix timestamp to DOS date/time
    // This is a simplified version
    let seconds = time % 86400;
    let days = time / 86400 + 719468; // Days since 0000-03-01
    
    let era = days / 146097;
    let doe = days - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let year = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day = doy - (153 * mp + 2) / 5 + 1;
    let month = mp + (if mp < 10 { 3 } else { -9 });
    
    let year_from_1980 = year - 1980;
    let dos_date = ((year_from_1980.max(0).min(127) as u16) << 9) |
                   ((month as u16) << 5) |
                   (day as u16);
    
    let dos_time = ((seconds / 3600) as u16) << 11 |
                   (((seconds % 3600) / 60) as u16) << 5 |
                   ((seconds % 60) / 2) as u16;
    
    (dos_time, dos_date)
}

pub fn mz_zip_get_file_modified_time(p_filename: &str) -> io::Result<i64> {
    let metadata = fs::metadata(p_filename)?;
    let modified = metadata.modified()?;
    
    let duration = modified.duration_since(UNIX_EPOCH)
        .map_err(|_| io::Error::new(io::ErrorKind::Other, "Time before Unix epoch"))?;
    
    Ok(duration.as_secs() as i64)
}

pub fn mz_zip_set_file_times(p_filename: &str, access_time: i64, modified_time: i64) -> io::Result<()> {
    let path = Path::new(p_filename);
    
    let atime = SystemTime::UNIX_EPOCH + std::time::Duration::from_secs(access_time as u64);
    let mtime = SystemTime::UNIX_EPOCH + std::time::Duration::from_secs(modified_time as u64);
    
    // Note: std::fs doesn't have a direct way to set access time
    // This would require platform-specific code or a crate like filetime
    // For now, we'll just set modified time
    filetime::set_file_mtime(path, filetime::FileTime::from_system_time(mtime))
        .map_err(|e| io::Error::new(io::ErrorKind::Other, e))
}

