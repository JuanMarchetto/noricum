// Simple byte writing helpers - these match the C inline functions
pub fn mz_write_le16(p: &mut [u8], v: u16) {
    if p.len() >= 2 {
        p[0] = v as u8;
        p[1] = (v >> 8) as u8;
    }
}

pub fn mz_write_le32(p: &mut [u8], v: u32) {
    if p.len() >= 4 {
        p[0] = v as u8;
        p[1] = (v >> 8) as u8;
        p[2] = (v >> 16) as u8;
        p[3] = (v >> 24) as u8;
    }
}

pub fn mz_write_le64(p: &mut [u8], v: u64) {
    if p.len() >= 8 {
        mz_write_le32(p, v as u32);
        mz_write_le32(&mut p[4..], (v >> 32) as u32);
    }
}

// Heap write function - converts C's reallocation pattern to Rust's Vec
pub fn mz_zip_heap_write_func_impl(
    buffer: &mut Vec<u8>,
    file_ofs: u64,
    p_buf: &[u8],
) -> Result<usize, MzZipError> {
    if p_buf.is_empty() {
        return Ok(0);
    }
    
    let required_size = (file_ofs as usize)
        .checked_add(p_buf.len())
        .ok_or(MzZipError::FileTooLarge)?;
    
    // Check for 32-bit overflow
    if required_size > 0x7FFFFFFF {
        return Err(MzZipError::FileTooLarge);
    }
    
    // Ensure buffer is large enough
    if required_size > buffer.len() {
        let mut new_capacity = buffer.capacity();
        if new_capacity == 0 {
            new_capacity = 64;
        }
        
        while new_capacity < required_size {
            new_capacity = new_capacity.checked_mul(2).ok_or(MzZipError::FileTooLarge)?;
        }
        
        buffer.reserve(new_capacity - buffer.len());
        buffer.resize(required_size, 0);
    }
    
    // Copy data
    let start = file_ofs as usize;
    buffer[start..start + p_buf.len()].copy_from_slice(p_buf);
    
    Ok(p_buf.len())
}

