// Utility function for case-insensitive comparison (used in filename comparison)
fn mz_tolower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' {
        c - b'A' + b'a'
    } else {
        c
    }
}

// Note: Many functions from the original C source depend on the complete
// mz_zip_archive structure and I/O callbacks which aren't defined in the
