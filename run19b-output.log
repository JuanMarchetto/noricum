// Helper for working with MzZipArray (simplified)
impl MzZipArray {
    /// Get slice of elements (unsafe but encapsulated)
    pub fn as_slice<T>(&self) -> &[T] {
        unsafe {
            std::slice::from_raw_parts(
                self.m_p as *const T,
                self.m_size / std::mem::size_of::<T>()
            )
        }
    }
    
    /// Get mutable slice of elements
    pub fn as_mut_slice<T>(&mut self) -> &mut [T] {
        unsafe {
            std::slice::from_raw_parts_mut(
                self.m_p as *mut T,
                self.m_size / std::mem::size_of::<T>()
            )
        }
    }
}

