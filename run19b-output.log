// State structure for decompression (not defined in contract but referenced)
#[derive(Debug)]
pub struct DecompressionState<'a> {
    pub pzip: usize,
    pub file_crc32: u32,
    pub file_stat: &'a FileStat,
    pub status: u32,
}

/// Validate CRC32 against decompressed data
/// Corresponds to the first CRC check in the C code
pub fn validate_decompressed_crc32(
    decompressed_data: &[u8],
    file_stat: &FileStat,
    pzip: usize,
) -> Result<(), u32> {
    if mz_crc32(MZ_CRC32_INIT, decompressed_data) != file_stat.crc32 {
        mz_zip_set_error(pzip, MZ_ZIP_CRC_CHECK_FAILED);
        return Err(TINFL_STATUS_FAILED);
    }
    Ok(())
}

/// Validate stored CRC32 against expected CRC32
/// Corresponds to the second CRC check in the C code
pub fn validate_stored_crc32(
    stored_crc32: u32,
    file_stat: &FileStat,
    pzip: usize,
) -> Result<(), u32> {
    if stored_crc32 != file_stat.crc32 {
        mz_zip_set_error(pzip, MZ_ZIP_DECOMPRESSION_FAILED);
        return Err(TINFL_STATUS_FAILED);
    }
    Ok(())
}

/// Validate CRC32 in decompression state
/// Corresponds to the third CRC check in the C code
pub fn validate_state_crc32(state: &mut DecompressionState) -> Result<(), u32> {
    if state.file_crc32 != state.file_stat.crc32 {
        mz_zip_set_error(state.pzip, MZ_ZIP_DECOMPRESSION_FAILED);
        state.status = TINFL_STATUS_FAILED;
        return Err(TINFL_STATUS_FAILED);
    }
    Ok(())
}

// Helper function to read data with CRC validation
pub fn read_and_validate_crc32<R: Read>(
    reader: &mut R,
    size: usize,
    expected_crc32: u32,
) -> Result<Vec<u8>, String> {
    let mut buffer = vec![0u8; size];
    reader.read_exact(&mut buffer).map_err(|e| e.to_string())?;
    
    let computed_crc = mz_crc32(MZ_CRC32_INIT, &buffer);
    if computed_crc != expected_crc32 {
        return Err(format!("CRC32 mismatch: expected {:08x}, got {:08x}", 
                          expected_crc32, computed_crc));
    }
    
    Ok(buffer)
}

