// Type aliases to match C types
pub type mz_bool = bool;
pub type mz_uint = u32;
pub type mz_uint8 = u8;
pub type mz_uint16 = u16;
pub type mz_uint32 = u32;
pub type mz_uint64 = u64;
pub type mz_int64 = i64;

// Constants
pub const MZ_TRUE: bool = true;
pub const MZ_FALSE: bool = false;

// Max sizes
pub const MZ_ZIP_MAX_ARCHIVE_FILENAME_SIZE: usize = 512;
pub const MZ_ZIP_MAX_ARCHIVE_FILE_COMMENT_SIZE: usize = 512;
pub const MZ_ZIP_MAX_IO_BUF_SIZE: usize = 64 * 1024;

// Flags
pub const MZ_ZIP_FLAG_CASE_SENSITIVE: u32 = 0;
pub const MZ_ZIP_FLAG_IGNORE_PATH: u32 = 1;
pub const MZ_ZIP_FLAG_COMPRESSED_DATA: u32 = 1 << 0;

// Error codes (simplified - we'll use Result instead)
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ZipError {
    InvalidParameter,
    FileNotFound,
    InvalidHeaderOrCorrupted,
    UnsupportedMethod,
    UnsupportedEncryption,
    FileReadFailed,
    DecompressionFailed,
    BufTooSmall,
    CrcCheckFailed,
    InternalError,
    AllocFailed,
    UnexpectedDecompressedSize,
}

impl std::fmt::Display for ZipError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{:?}", self)
    }
}

impl std::error::Error for ZipError {}

pub type ZipResult<T> = Result<T, ZipError>;

// Data structures
#[derive(Debug)]

#[derive(Debug)]

#[derive(Debug, Clone)]
pub struct ZipArchiveFileStat {
    pub file_index: u32,
    pub central_dir_ofs: u32,
    pub version_made_by: u16,
    pub version_needed: u16,
    pub bit_flag: u16,
    pub method: u16,
    pub time: u64,
    pub crc32: u32,
    pub comp_size: u64,
    pub uncomp_size: u64,
    pub internal_attr: u16,
    pub external_attr: u32,
    pub local_header_ofs: u64,
    pub filename: String,
    pub comment: Vec<u8>,
    pub comment_size: usize,
    pub is_directory: bool,
    pub is_encrypted: bool,
    pub is_supported: bool,
}

// Helper functions
fn mz_tolower(c: u8) -> u8 {
    if (b'A'..=b'Z').contains(&c) {
        c - b'A' + b'a'
    } else {
        c
    }
}

fn read_le_u16(data: &[u8], offset: usize) -> u16 {
    u16::from_le_bytes([data[offset], data[offset + 1]])
}

fn read_le_u32(data: &[u8], offset: usize) -> u32 {
    u32::from_le_bytes([
        data[offset],
        data[offset + 1],
        data[offset + 2],
        data[offset + 3],
    ])
}

fn read_le_u64(data: &[u8], offset: usize) -> u64 {
    u64::from_le_bytes([
        data[offset],
        data[offset + 1],
        data[offset + 2],
        data[offset + 3],
        data[offset + 4],
        data[offset + 5],
        data[offset + 6],
        data[offset + 7],
    ])
}

fn mz_crc32(init: u32, data: &[u8]) -> u32 {
    // Simplified CRC32 - in practice you'd use a proper CRC32 implementation
    let mut crc = init;
    for &byte in data {
        crc = crc.wrapping_add(byte as u32);
    }
    crc
}

fn mz_zip_dos_to_time_t(file_time: u16, file_date: u16) -> u64 {
    // Simplified implementation - converts DOS date/time to Unix timestamp
    // Real implementation would be more complex
    ((file_date as u64) << 16) | (file_time as u64)
}

// Function implementations
pub fn mz_zip_reader_is_file_a_directory<R: Read + Seek>(
    zip: &ZipArchive<R>,
    file_index: u32,
) -> ZipResult<bool> {
    if file_index >= zip.total_files {
        return Err(ZipError::InvalidParameter);
    }

    let cdh_offset = zip.state.central_dir_offsets[file_index as usize] as usize;
    let p = &zip.state.central_dir[cdh_offset..];

    let filename_len = read_le_u16(p, MZ_ZIP_CDH_FILENAME_LEN_OFS) as usize;
    if filename_len > 0 {
        let filename_start = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE;
        if p[filename_start + filename_len - 1] == b'/' {
            return Ok(true);
        }
    }

    let external_attr = read_le_u32(p, MZ_ZIP_CDH_EXTERNAL_ATTR_OFS);
    if (external_attr & MZ_ZIP_DOS_DIR_ATTRIBUTE_BITFLAG) != 0 {
        return Ok(true);
    }

    Ok(false)
}

pub fn mz_zip_file_stat_internal<R: Read + Seek>(
    zip: &ZipArchive<R>,
    file_index: u32,
    p_central_dir_header: &[u8],
    stat: &mut ZipArchiveFileStat,
    found_zip64_extra_data: Option<&mut bool>,
) -> ZipResult<()> {
    if p_central_dir_header.is_empty() {
        return Err(ZipError::InvalidParameter);
    }

    if let Some(found) = found_zip64_extra_data {
        *found = false;
    }

    let p = p_central_dir_header;

    stat.file_index = file_index;
    stat.central_dir_ofs = zip.state.central_dir_offsets[file_index as usize];
    stat.version_made_by = read_le_u16(p, MZ_ZIP_CDH_VERSION_MADE_BY_OFS);
    stat.version_needed = read_le_u16(p, MZ_ZIP_CDH_VERSION_NEEDED_OFS);
    stat.bit_flag = read_le_u16(p, MZ_ZIP_CDH_BIT_FLAG_OFS);
    stat.method = read_le_u16(p, MZ_ZIP_CDH_METHOD_OFS);
    stat.time = mz_zip_dos_to_time_t(
        read_le_u16(p, MZ_ZIP_CDH_FILE_TIME_OFS),
        read_le_u16(p, MZ_ZIP_CDH_FILE_DATE_OFS),
    );
    stat.crc32 = read_le_u32(p, MZ_ZIP_CDH_CRC32_OFS);
    stat.comp_size = read_le_u32(p, MZ_ZIP_CDH_COMPRESSED_SIZE_OFS) as u64;
    stat.uncomp_size = read_le_u32(p, MZ_ZIP_CDH_DECOMPRESSED_SIZE_OFS) as u64;
    stat.internal_attr = read_le_u16(p, MZ_ZIP_CDH_INTERNAL_ATTR_OFS);
    stat.external_attr = read_le_u32(p, MZ_ZIP_CDH_EXTERNAL_ATTR_OFS);
    stat.local_header_ofs = read_le_u32(p, MZ_ZIP_CDH_LOCAL_HEADER_OFS) as u64;

    // Copy filename
    let filename_len = read_le_u16(p, MZ_ZIP_CDH_FILENAME_LEN_OFS) as usize;
    let filename_len_clamped = filename_len.min(MZ_ZIP_MAX_ARCHIVE_FILENAME_SIZE - 1);
    let filename_start = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE;
    stat.filename = String::from_utf8_lossy(
        &p[filename_start..filename_start + filename_len_clamped],
    )
    .to_string();

    // Copy comment
    let comment_len = read_le_u16(p, MZ_ZIP_CDH_COMMENT_LEN_OFS) as usize;
    let comment_len_clamped = comment_len.min(MZ_ZIP_MAX_ARCHIVE_FILE_COMMENT_SIZE - 1);
    let extra_len = read_le_u16(p, MZ_ZIP_CDH_EXTRA_LEN_OFS) as usize;
    let comment_start = filename_start + filename_len + extra_len;
    stat.comment = p[comment_start..comment_start + comment_len_clamped].to_vec();
    stat.comment_size = comment_len_clamped;

    // Set flags
    stat.is_directory = mz_zip_reader_is_file_a_directory(zip, file_index)?;
    // These would need other functions that we don't have
    stat.is_encrypted = (stat.bit_flag & MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_IS_ENCRYPTED) != 0;
    stat.is_supported = true; // Simplified

    // Check for zip64 extended information
    if stat.comp_size == MZ_UINT32_MAX as u64
        || stat.uncomp_size == MZ_UINT32_MAX as u64
        || stat.local_header_ofs == MZ_UINT32_MAX as u64
    {
        let mut extra_size_remaining = read_le_u16(p, MZ_ZIP_CDH_EXTRA_LEN_OFS) as usize;
        let mut p_extra_data = &p[filename_start + filename_len..];

        while extra_size_remaining >= 4 {
            let field_id = read_le_u16(p_extra_data, 0);
            let field_data_size = read_le_u16(p_extra_data, 2) as usize;

            if field_data_size + 4 > extra_size_remaining {
                return Err(ZipError::InvalidHeaderOrCorrupted);
            }

            if field_id == MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID {
                if let Some(found) = found_zip64_extra_data {
                    *found = true;
                }

                let mut p_field_data = &p_extra_data[4..];
                let mut field_data_remaining = field_data_size;

                if stat.uncomp_size == MZ_UINT32_MAX as u64 {
                    if field_data_remaining < 8 {
                        return Err(ZipError::InvalidHeaderOrCorrupted);
                    }
                    stat.uncomp_size = read_le_u64(p_field_data, 0);
                    p_field_data = &p_field_data[8..];
                    field_data_remaining -= 8;
                }

                if stat.comp_size == MZ_UINT32_MAX as u64 {
                    if field_data_remaining < 8 {
                        return Err(ZipError::InvalidHeaderOrCorrupted);
                    }
                    stat.comp_size = read_le_u64(p_field_data, 0);
                    p_field_data = &p_field_data[8..];
                    field_data_remaining -= 8;
                }

                if stat.local_header_ofs == MZ_UINT32_MAX as u64 {
                    if field_data_remaining < 8 {
                        return Err(ZipError::InvalidHeaderOrCorrupted);
                    }
                    stat.local_header_ofs = read_le_u64(p_field_data, 0);
                }
                break;
            }

            let skip = 4 + field_data_size;
            p_extra_data = &p_extra_data[skip..];
            extra_size_remaining -= skip;
        }
    }

    Ok(())
}

pub fn mz_zip_string_equal(p_a: &[u8], p_b: &[u8], len: usize, flags: u32) -> bool {
    if flags & MZ_ZIP_FLAG_CASE_SENSITIVE != 0 {
        return p_a[..len] == p_b[..len];
    }

    p_a[..len]
        .iter()
        .zip(&p_b[..len])
        .all(|(&a, &b)| mz_tolower(a) == mz_tolower(b))
}

pub fn mz_zip_filename_compare(
    central_dir: &[u8],
    central_dir_offsets: &[u32],
    l_index: u32,
    p_r: &[u8],
    r_len: usize,
) -> i32 {
    let cdh_offset = central_dir_offsets[l_index as usize] as usize;
    let p_l = &central_dir[cdh_offset..];
    let l_len = read_le_u16(p_l, MZ_ZIP_CDH_FILENAME_LEN_OFS) as usize;
    let p_l_start = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE;
    let min_len = l_len.min(r_len);

    for i in 0..min_len {
        let l_char = mz_tolower(p_l[p_l_start + i]);
        let r_char = mz_tolower(p_r[i]);
        if l_char != r_char {
            return (l_char as i32) - (r_char as i32);
        }
    }

    (l_len as i32) - (r_len as i32)
}

pub fn mz_zip_locate_file_binary_search<R: Read + Seek>(
    zip: &ZipArchive<R>,
    filename: &str,
    p_index: &mut u32,
) -> ZipResult<bool> {
    let p_state = &zip.state;
    let size = zip.total_files;
    let filename_bytes = filename.as_bytes();
    let filename_len = filename_bytes.len();

    if size == 0 {
        return Err(ZipError::FileNotFound);
    }

    let indices = &p_state.sorted_central_dir_offsets;
    let mut l: i64 = 0;
    let mut h: i64 = size as i64 - 1;

    while l <= h {
        let m = l + ((h - l) >> 1);
        let file_index = indices[m as usize];

        let comp = mz_zip_filename_compare(
            &p_state.central_dir,
            &p_state.central_dir_offsets,
            file_index,
            filename_bytes,
            filename_len,
        );

        match comp.cmp(&0) {
            Ordering::Equal => {
                *p_index = file_index;
                return Ok(true);
            }
            Ordering::Less => l = m + 1,
            Ordering::Greater => h = m - 1,
        }
    }

    Err(ZipError::FileNotFound)
}

pub fn mz_zip_reader_locate_file<R: Read + Seek>(
    zip: &ZipArchive<R>,
    name: &str,
    comment: Option<&str>,
    flags: u32,
) -> ZipResult<i32> {
    let mut index = 0;
    if mz_zip_reader_locate_file_v2(zip, name, comment, flags, &mut index)? {
        Ok(index as i32)
    } else {
        Ok(-1)
    }
}

pub fn mz_zip_reader_locate_file_v2<R: Read + Seek>(
    zip: &ZipArchive<R>,
    name: &str,
    comment: Option<&str>,
    flags: u32,
    p_index: &mut u32,
) -> ZipResult<bool> {
    *p_index = 0;

    let name_len = name.len();
    if name_len > u16::MAX as usize {
        return Err(ZipError::InvalidParameter);
    }

    let comment_len = comment.map(|c| c.len()).unwrap_or(0);
    if comment_len > u16::MAX as usize {
        return Err(ZipError::InvalidParameter);
    }

    // Try binary search if conditions allow
    if (zip.state.init_flags & 1) == 0 // MZ_ZIP_FLAG_DO_NOT_SORT_CENTRAL_DIRECTORY check simplified
        && (flags & (MZ_ZIP_FLAG_IGNORE_PATH | MZ_ZIP_FLAG_CASE_SENSITIVE)) == 0
        && comment.is_none()
        && !zip.state.sorted_central_dir_offsets.is_empty()
    {
        return mz_zip_locate_file_binary_search(zip, name, p_index);
    }

    // Linear search
    let name_bytes = name.as_bytes();
    let comment_bytes = comment.map(|c| c.as_bytes());

    for file_index in 0..zip.total_files {
        let cdh_offset = zip.state.central_dir_offsets[file_index as usize] as usize;
        let p_header = &zip.state.central_dir[cdh_offset..];

        let filename_len = read_le_u16(p_header, MZ_ZIP_CDH_FILENAME_LEN_OFS) as usize;
        let filename_start = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE;
        let p_filename = &p_header[filename_start..filename_start + filename_len];

        // Check comment if provided
        if let Some(comment_bytes) = comment_bytes {
            let extra_len = read_le_u16(p_header, MZ_ZIP_CDH_EXTRA_LEN_OFS) as usize;
            let file_comment_len = read_le_u16(p_header, MZ_ZIP_CDH_COMMENT_LEN_OFS) as usize;
            let comment_start = filename_start + filename_len + extra_len;

            if file_comment_len != comment_len {
                continue;
            }

            let p_file_comment = &p_header[comment_start..comment_start + file_comment_len];
            if !mz_zip_string_equal(comment_bytes, p_file_comment, comment_len, flags) {
                continue;
            }
        }

        // Handle ignore path flag
        let (adjusted_filename, adjusted_len) = if (flags & MZ_ZIP_FLAG_IGNORE_PATH) != 0 && filename_len > 0 {
            let mut ofs = filename_len as isize - 1;
            while ofs >= 0 {
                let c = p_filename[ofs as usize];
                if c == b'/' || c == b'\\' || c == b':' {
                    break;
                }
                ofs -= 1;
            }
            let start = (ofs + 1) as usize;
            (&p_filename[start..], filename_len - start)
        } else {
            (p_filename, filename_len)
        };

        if adjusted_len == name_len
            && mz_zip_string_equal(name_bytes, adjusted_filename, name_len, flags)
        {
            *p_index = file_index;
            return Ok(true);
        }
    }

    Err(ZipError::FileNotFound)
}

