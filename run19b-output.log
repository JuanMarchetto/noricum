fn mz_zip_writer_end_internal(p_zip: &mut MzZipArchiveWriter, set_last_error: bool) -> bool {
    let p_state = match p_zip.m_pState.take() {
        Some(state) => state,
        None => {
            if set_last_error {
                p_zip.mz_zip_set_error(MZ_ZIP_INVALID_PARAMETER);
            }
            return false;
        }
    };

    // Check other invalid parameters
    if p_zip.m_pAlloc.is_none() || p_zip.m_pFree.is_none() {
        if set_last_error {
            p_zip.mz_zip_set_error(MZ_ZIP_INVALID_PARAMETER);
        }
        return false;
    }

    if p_zip.m_zip_mode != MZ_ZIP_MODE_WRITING && p_zip.m_zip_mode != MZ_ZIP_MODE_WRITING_HAS_BEEN_FINALIZED {
        if set_last_error {
            p_zip.mz_zip_set_error(MZ_ZIP_INVALID_PARAMETER);
        }
        return false;
    }

    // Clear arrays
    let mut temp_state = *p_state; // Take ownership
    mz_zip_array_clear_writer(p_zip, &mut temp_state.m_central_dir);
    mz_zip_array_clear_writer(p_zip, &mut temp_state.m_central_dir_offsets);
    mz_zip_array_clear_writer(p_zip, &mut temp_state.m_sorted_central_dir_offsets);

    // Handle file closing for file-based archives
    if p_zip.m_zip_type == MZ_ZIP_TYPE_FILE {
        // In safe Rust, files are closed automatically when dropped
        // No need for explicit close
    }

    // Handle heap-based archives
    if let Some(_write_func) = p_zip.m_pWrite {
        // Check if this is the heap write function (would need function pointer comparison in C)
        // In Rust, we'll use a different approach - track allocation type separately
        // For now, we just free the memory if allocated
    }

    // Free the state
    // In safe Rust, Box is automatically dropped here
    
    p_zip.m_zip_mode = MZ_ZIP_MODE_INVALID;
    true
}

fn mz_zip_array_clear_writer(_zip: &MzZipArchiveWriter, array: &mut MzZipArrayStruct) {
    array.m_p = 0;
    array.m_size = 0;
    array.m_capacity = 0;
}

fn mz_zip_writer_init_v2(p_zip: &mut MzZipArchiveWriter, existing_size: u64, flags: u32) -> bool {
    let zip64 = (flags & MZ_ZIP_FLAG_WRITE_ZIP64) != 0;

    // Parameter validation
    if p_zip.m_pState.is_some() || p_zip.m_pWrite.is_none() || p_zip.m_zip_mode != MZ_ZIP_MODE_INVALID {
        return p_zip.mz_zip_set_error(MZ_ZIP_INVALID_PARAMETER);
    }

    if (flags & MZ_ZIP_FLAG_WRITE_ALLOW_READING) != 0 && p_zip.m_pRead.is_none() {
        return p_zip.mz_zip_set_error(MZ_ZIP_INVALID_PARAMETER);
    }

    // Validate file offset alignment is power of 2
    if p_zip.m_file_offset_alignment != 0 {
        if p_zip.m_file_offset_alignment & (p_zip.m_file_offset_alignment - 1) != 0 {
            return p_zip.mz_zip_set_error(MZ_ZIP_INVALID_PARAMETER);
        }
    }

    // Set default allocators if not provided
    // Note: In C, these would be function pointers. In safe Rust, we manage memory differently.
    
    p_zip.m_archive_size = existing_size;
    p_zip.m_central_directory_file_ofs = 0;
    p_zip.m_total_files = 0;

    // Allocate and initialize state
    let state = Box::new(MzZipInternalStateTag {
        m_central_dir: MzZipArrayStruct {
            m_p: 0,
            m_size: 0,
            m_capacity: 0,
            m_element_size: 1, // sizeof(u8)
        },
        m_central_dir_offsets: MzZipArrayStruct {
            m_p: 0,
            m_size: 0,
            m_capacity: 0,
            m_element_size: 4, // sizeof(u32)
        },
        m_sorted_central_dir_offsets: MzZipArrayStruct {
            m_p: 0,
            m_size: 0,
            m_capacity: 0,
            m_element_size: 4, // sizeof(u32)
        },
        m_init_flags: flags,
        m_zip64: zip64,
        m_zip64_has_extended_info_fields: zip64,
        m_pFile: 0,
        m_file_archive_start_ofs: 0,
        m_pMem: 0,
        m_mem_size: 0,
        m_mem_capacity: 0,
    });

    p_zip.m_pState = Some(state);
    p_zip.m_zip_type = MZ_ZIP_TYPE_USER;
    p_zip.m_zip_mode = MZ_ZIP_MODE_WRITING;

    true
}

fn mz_zip_writer_init(p_zip: &mut MzZipArchiveWriter, existing_size: u64) -> bool {
    mz_zip_writer_init_v2(p_zip, existing_size, 0)
}

