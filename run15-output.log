    buf_size: usize,
    pComment: &[u8],
    comment_size: mz_uint16,
    level_and_flags: mz_uint,
) -> mz_bool {
    mz_zip_add_mem_to_archive_file_in_place_v2(
        pZip_filename,
        pArchive_name,
        pBuf,
        buf_size,
        pComment,
        comment_size,
