/// Set error on ZIP archive
pub fn mz_zip_set_error(p_zip: &mut MzZipArchive, error: MzZipError) {
    p_zip.m_last_error = error;
}

/// TINFL decompression status enum
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum TinflStatus {
    Done,
    Failed,
    NeedMoreInput,
    HasMoreOutput,
}

/// Check CRC32 of decompressed buffer against expected value
/// Returns TinflStatus::Failed if CRC mismatch
pub fn check_crc32_against_stat(
    p_zip: &mut MzZipArchive,
    p_buf: &[u8],
    file_stat: &MzZipArchiveFileStat,
) -> TinflStatus {
    if mz_crc32(MZ_CRC32_INIT, p_buf) != file_stat.m_crc32 {
        mz_zip_set_error(p_zip, MzZipError::CrcCheckFailed);
        TinflStatus::Failed
    } else {
        TinflStatus::Done
    }
}

/// Check CRC32 value directly against expected value
/// Returns TinflStatus::Failed if CRC mismatch
pub fn check_crc32_direct(
    p_zip: &mut MzZipArchive,
    file_crc32: u32,
    file_stat: &MzZipArchiveFileStat,
) -> TinflStatus {
    if file_crc32 != file_stat.m_crc32 {
        mz_zip_set_error(p_zip, MzZipError::DecompressionFailed);
        TinflStatus::Failed
    } else {
        TinflStatus::Done
    }
}

/// Check CRC32 in state structure against expected value
/// Returns TinflStatus::Failed if CRC mismatch
pub fn check_crc32_in_state(
    p_state: &mut MzZipReaderExtractIterState,
) -> TinflStatus {
    let file_crc32 = p_state.file_stat.m_crc32;
    if file_crc32 != p_state.file_stat.m_crc32 {
        if let Some(p_zip) = &mut p_state.pzip {
            mz_zip_set_error(p_zip, MzZipError::DecompressionFailed);
        }
        p_state.status = TinflStatus::Failed as i32;
        TinflStatus::Failed
    } else {
        TinflStatus::Done
    }
}

impl MzZipArray {
    /// Create a new array with specified element size
    pub fn new(element_size: u32) -> Self {
        Self {
            p: None,
            size: 0,
            capacity: 0,
            element_size,
        }
    }

    /// Set element size
    pub fn set_element_size(&mut self, element_size: u32) {
        self.element_size = element_size;
    }

    /// Get element at index (safe version)
    pub fn get<T: Copy>(&self, index: usize) -> Option<T> {
        if index >= self.size {
            return None;
        }
        
        if let Some(ref vec) = self.p {
            let element_size = self.element_size as usize;
            let start = index * element_size;
            let end = start + element_size;
            
            if end > vec.len() {
                return None;
            }
            
            // SAFETY: We've checked bounds and element size
            // This is the only unsafe block - it's required for type punning
            // but we ensure it's safe through bounds checking
            unsafe {
                let ptr = vec.as_ptr().add(start) as *const T;
                Some(ptr.read())
            }
        } else {
            None
        }
    }

    /// Push a value onto the array
    pub fn push<T: Copy>(&mut self, value: T) -> Result<(), MzZipError> {
        let element_size = self.element_size as usize;
        
        // Ensure capacity
        if self.size >= self.capacity {
            let new_capacity = if self.capacity == 0 { 4 } else { self.capacity * 2 };
            self.reserve(new_capacity)?;
        }
        
        if let Some(ref mut vec) = self.p {
            let start = self.size * element_size;
            let end = start + element_size;
            
            // Ensure vector has enough space
            if end > vec.len() {
                vec.resize(end, 0);
            }
            
            // SAFETY: We've ensured bounds and capacity
            unsafe {
                let ptr = vec.as_mut_ptr().add(start) as *mut T;
                ptr.write(value);
            }
            
            self.size += 1;
            Ok(())
        } else {
            Err(MzZipError::AllocFailed)
        }
    }

    /// Reserve capacity
    pub fn reserve(&mut self, new_capacity: usize) -> Result<(), MzZipError> {
        if new_capacity <= self.capacity {
            return Ok(());
        }
        
        let element_size = self.element_size as usize;
        let new_total_bytes = new_capacity * element_size;
        
        match &mut self.p {
            Some(vec) => {
                vec.resize(new_total_bytes, 0);
            }
            None => {
                let mut new_vec = Vec::with_capacity(new_total_bytes);
                new_vec.resize(new_total_bytes, 0);
                self.p = Some(new_vec);
            }
        }
        
        self.capacity = new_capacity;
        Ok(())
    }

    /// Clear the array
    pub fn clear(&mut self) {
        self.size = 0;
        // Keep capacity and memory
    }

    /// Get slice of bytes
    pub fn as_bytes(&self) -> Option<&[u8]> {
        self.p.as_deref()
    }

    /// Get mutable slice of bytes
    pub fn as_bytes_mut(&mut self) -> Option<&mut [u8]> {
        self.p.as_deref_mut()
    }
}

impl MzZipArchive {
    /// Create a new ZIP archive with default allocators
    pub fn new() -> Self {
        Self {
            m_palloc: None,
            m_pfree: None,
            m_prealloc: None,
            m_palloc_opaque: None,
            m_zip_mode: MzZipMode::Invalid,
            m_zip_type: MzZipType::Invalid,
            m_pread: None,
            m_pwrite: None,
            m_pio_opaque: None,
            m_pneeds_keepalive: None,
            m_archive_size: 0,
            m_central_directory_file_ofs: 0,
            m_total_files: 0,
            m_last_error: MzZipError::NoError,
            m_pstate: None,
        }
    }

    /// Initialize archive for reading
    pub fn init_reader(&mut self) -> Result<(), MzZipError> {
        if self.m_zip_mode != MzZipMode::Invalid {
            return Err(MzZipError::InvalidParameter);
        }
        
        self.m_zip_mode = MzZipMode::Reading;
        self.m_last_error = MzZipError::NoError;
        
        // Create internal state
        let state = Box::new(MzZipInternalState {
            central_dir: MzZipArray::new(1), // Bytes
            central_dir_offsets: MzZipArray::new(4), // u32
            sorted_central_dir_offsets: MzZipArray::new(4), // u32
            init_flags: 0,
            zip64: false,
            zip64_has_extended_info_fields: false,
            pfile: None,
            file_archive_start_ofs: 0,
            pmem: None,
            mem_size: 0,
            mem_capacity: 0,
        });
        
        self.m_pstate = Some(state);
        Ok(())
    }

    /// Get file count
    pub fn get_num_files(&self) -> u32 {
        self.m_total_files
    }

    /// Get last error
    pub fn get_last_error(&self) -> MzZipError {
        self.m_last_error
    }

    /// Clear last error
    pub fn clear_error(&mut self) {
        self.m_last_error = MzZipError::NoError;
    }
}

impl Default for MzZipArchive {
    fn default() -> Self {
        Self::new()
    }
}

impl MzZipInternalState {
    /// Read data from current position
    pub fn read_data(&self, offset: u64, buf: &mut [u8]) -> Result<usize, MzZipError> {
        if let Some(ref pfile) = self.pfile {
            
            // Seek to position
            pfile.seek(SeekFrom::Start(self.file_archive_start_ofs + offset))
                .map_err(|_| MzZipError::FileSeekFailed)?;
            
            // Read data
            pfile.read(buf).map_err(|_| MzZipError::FileReadFailed)
        } else if let Some(ref pmem) = self.pmem {
            let start = self.file_archive_start_ofs + offset;
            let start_usize = start as usize;
            
            if start_usize >= pmem.len() {
                return Ok(0);
            }
            
            let end = start_usize + buf.len();
            let end = end.min(pmem.len());
            
            let bytes_to_read = end - start_usize;
            buf[..bytes_to_read].copy_from_slice(&pmem[start_usize..end]);
            Ok(bytes_to_read)
        } else {
            Err(MzZipError::InternalError)
        }
    }

    /// Write data to current position
    pub fn write_data(&mut self, offset: u64, buf: &[u8]) -> Result<usize, MzZipError> {
        if let Some(ref mut pfile) = self.pfile {
            
            // Seek to position
            pfile.seek(SeekFrom::Start(self.file_archive_start_ofs + offset))
                .map_err(|_| MzZipError::FileSeekFailed)?;
            
            // Write data
            pfile.write(buf).map_err(|_| MzZipError::FileWriteFailed)
        } else if let Some(ref mut pmem) = self.pmem {
            let start = self.file_archive_start_ofs + offset;
            let start_usize = start as usize;
            
            // Ensure we have enough capacity
            let required_len = start_usize + buf.len();
            if required_len > pmem.len() {
                pmem.resize(required_len, 0);
                self.mem_size = pmem.len();
                self.mem_capacity = pmem.capacity();
            }
            
            pmem[start_usize..start_usize + buf.len()].copy_from_slice(buf);
            Ok(buf.len())
        } else {
            Err(MzZipError::InternalError)
        }
    }
}

// --- Module: mz_p1 ---
// Windows-specific UTF-8 to wide character conversion (only compiled on Windows)
#[cfg(target_os = "windows")]
pub fn mz_utf8z_to_widechar(str: &str) -> Vec<u16> {
    use windows::Win32::Globalization::{
        MultiByteToWideChar, CP_UTF8, MB_ERR_INVALID_CHARS,
    };
    
    unsafe {
        // Calculate required buffer size (including null terminator)
        let required_chars = MultiByteToWideChar(
            CP_UTF8,
            MB_ERR_INVALID_CHARS.0,
            str.as_ptr() as *const i8,
            str.len() as i32,
            std::ptr::null_mut(),
            0,
        ) as usize;
        
        if required_chars == 0 {
            return Vec::new();
        }
        
        // Allocate buffer with null terminator
        let mut buffer = Vec::with_capacity(required_chars + 1);
        buffer.resize(required_chars + 1, 0);
        
        // Convert to wide string
        let converted = MultiByteToWideChar(
            CP_UTF8,
            MB_ERR_INVALID_CHARS.0,
            str.as_ptr() as *const i8,
            str.len() as i32,
            buffer.as_mut_ptr(),
            required_chars as i32,
        );
        
        if converted == 0 {
            Vec::new()
        } else {
            // Resize to actual converted characters (without null terminator for Vec)
            buffer.truncate(converted as usize);
            buffer
        }
    }
}

#[cfg(not(target_os = "windows"))]
pub fn mz_utf8z_to_widechar(str: &str) -> Vec<u16> {
    // On non-Windows, just return empty vector (not used)
    Vec::new()
}

// Platform-specific file operations
#[cfg(target_os = "windows")]
pub fn mz_fopen(p_filename: &str, p_mode: &str) -> Result<std::fs::File, std::io::Error> {
        FILE_SHARE_READ, FILE_SHARE_WRITE, FILE_SHARE_DELETE,
    };
    
    // Parse mode string
    let (read, write, append, truncate) = parse_file_mode(p_mode);
    
    let mut options = OpenOptions::new();
    options.read(read)
           .write(write)
           .append(append)
           .truncate(truncate)
           .create(write || append)
           .share_mode((FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE).0);
    
    // Convert filename to wide string
    let wfilename = mz_utf8z_to_widechar(p_filename);
    let path = std::path::PathBuf::from(
        std::ffi::OsString::from_wide(&wfilename)
    );
    
    options.open(&path)
}

#[cfg(not(target_os = "windows"))]
pub fn mz_fopen(p_filename: &str, p_mode: &str) -> Result<std::fs::File, std::io::Error> {
    
    // Parse mode string
    let (read, write, append, truncate) = parse_file_mode(p_mode);
    
    let mut options = OpenOptions::new();
    options.read(read)
           .write(write)
           .append(append)
           .truncate(truncate)
           .create(write || append);
    
    options.open(p_filename)
}

#[cfg(target_os = "windows")]
pub fn mz_freopen(p_path: &str, p_mode: &str, p_stream: &mut std::fs::File) -> Result<std::fs::File, std::io::Error> {
    // On Windows, we need to close the old file and open a new one
    // because freopen with _wfreopen_s is complex and not directly supported
    let new_file = mz_fopen(p_path, p_mode)?;
    *p_stream = new_file.try_clone()?;
    Ok(new_file)
}

#[cfg(not(target_os = "windows"))]
pub fn mz_freopen(p_path: &str, p_mode: &str, p_stream: &mut std::fs::File) -> Result<std::fs::File, std::io::Error> {
    
    // On Unix, we can use libc::freopen if needed, but it's safer to
    // close and reopen like we do on Windows
    let new_file = mz_fopen(p_path, p_mode)?;
    *p_stream = new_file.try_clone()?;
    Ok(new_file)
}

// File stat functions
#[cfg(target_os = "windows")]
pub fn mz_stat(path: &str, buffer: &mut std::fs::Metadata) -> Result<(), std::io::Error> {
    
    let wpath = mz_utf8z_to_widechar(path);
    let path_buf = std::path::PathBuf::from(
        std::ffi::OsString::from_wide(&wpath)
    );
    
    *buffer = fs::metadata(&path_buf)?;
    Ok(())
}

#[cfg(not(target_os = "windows"))]
pub fn mz_stat(path: &str, buffer: &mut std::fs::Metadata) -> Result<(), std::io::Error> {
    *buffer = std::fs::metadata(path)?;
    Ok(())
}

// For 64-bit stat, use the same on all platforms (Rust's metadata is always 64-bit)
pub fn mz_stat64(path: &str, buffer: &mut std::fs::Metadata) -> Result<(), std::io::Error> {
    mz_stat(path, buffer)
}

// Helper to parse file mode strings
fn parse_file_mode(mode: &str) -> (bool, bool, bool, bool) {
    let mut read = false;
    let mut write = false;
    let mut append = false;
    let mut truncate = false;
    
    match mode {
        "r" => read = true,
        "rb" => read = true,
        "r+" => { read = true; write = true; }
        "r+b" => { read = true; write = true; }
        "rb+" => { read = true; write = true; }
        "w" => { write = true; truncate = true; }
        "wb" => { write = true; truncate = true; }
        "w+" => { read = true; write = true; truncate = true; }
        "w+b" => { read = true; write = true; truncate = true; }
        "wb+" => { read = true; write = true; truncate = true; }
        "a" => { write = true; append = true; }
        "ab" => { write = true; append = true; }
        "a+" => { read = true; write = true; append = true; }
        "a+b" => { read = true; write = true; append = true; }
        "ab+" => { read = true; write = true; append = true; }
        _ => {} // Invalid mode
    }
    
    (read, write, append, truncate)
}

// Array utilities
impl MzZipArray {
    /// Range check for array access
    pub fn range_check(&self, index: usize) -> Option<usize> {
        if index < self.size {
            Some(index)
        } else {
            None
        }
    }
    
    /// Initialize array with element size
    pub fn init(&mut self, element_size: u32) {
        self.p = None;
        self.size = 0;
        self.capacity = 0;
        self.element_size = element_size;
    }
    
    /// Clear array and free memory
    pub fn array_clear(&mut self, p_zip: &mut MzZipArchive) -> Result<(), MzZipError> {
        self.p = None;
        self.size = 0;
        self.capacity = 0;
        // Element size is preserved
        Ok(())
    }
    
    /// Ensure capacity for at least min_new_capacity elements
    pub fn ensure_capacity(
        &mut self,
        p_zip: &mut MzZipArchive,
        min_new_capacity: usize,
        growing: bool,
    ) -> Result<(), MzZipError> {
        if self.capacity >= min_new_capacity {
            return Ok(());
        }
        
        let mut new_capacity = min_new_capacity;
        if growing && self.capacity > 0 {
            new_capacity = self.capacity;
            while new_capacity < min_new_capacity {
                new_capacity = new_capacity.saturating_mul(2);
            }
        }
        
        self.reserve(new_capacity)
    }
    
    /// Reserve capacity for exactly new_capacity elements
    pub fn array_reserve(
        &mut self,
        p_zip: &mut MzZipArchive,
        new_capacity: usize,
        growing: bool,
    ) -> Result<(), MzZipError> {
        if new_capacity > self.capacity {
            self.ensure_capacity(p_zip, new_capacity, growing)
        } else {
            Ok(())
        }
    }
    
    /// Resize array to new_size elements
    pub fn array_resize(
        &mut self,
        p_zip: &mut MzZipArchive,
        new_size: usize,
        growing: bool,
    ) -> Result<(), MzZipError> {
        if new_size > self.capacity {
            self.ensure_capacity(p_zip, new_size, growing)?;
        }
        self.size = new_size;
        Ok(())
    }
    
    /// Ensure room for n additional elements
    pub fn ensure_room(
        &mut self,
        p_zip: &mut MzZipArchive,
        n: usize,
    ) -> Result<(), MzZipError> {
        self.array_reserve(p_zip, self.size + n, true)
    }
    
    /// Push n elements to the back of the array
    pub fn push_back(
        &mut self,
        p_zip: &mut MzZipArchive,
        elements: &[u8],
        n: usize,
    ) -> Result<(), MzZipError> {
        let element_size = self.element_size as usize;
        let total_bytes = n * element_size;
        
        if elements.len() < total_bytes {
            return Err(MzZipError::InvalidParameter);
        }
        
        let orig_size = self.size;
        self.array_resize(p_zip, orig_size + n, true)?;
        
        if n > 0 {
            let start = orig_size * element_size;
            let end = start + total_bytes;
            
            if let Some(ref mut vec) = self.p {
                if end > vec.len() {
                    vec.resize(end, 0);
                }
                vec[start..end].copy_from_slice(&elements[..total_bytes]);
            } else {
                return Err(MzZipError::AllocFailed);
            }
        }
        
        Ok(())
    }
}

// Time conversion functions
impl MzZipArchive {
    /// Convert DOS date/time to Unix timestamp
    pub fn dos_to_time_t(dos_time: u16, dos_date: u16) -> Result<u64, MzZipError> {
        let year = ((dos_date as u32 >> 9) & 0x7F) + 1980;
        let month = ((dos_date as u32 >> 5) & 0x0F).saturating_sub(1);
        let day = dos_date as u32 & 0x1F;
        
        let hour = (dos_time as u32 >> 11) & 0x1F;
        let minute = (dos_time as u32 >> 5) & 0x3F;
        let second = (dos_time as u32 & 0x1F) * 2;
        
        if month >= 12 || day == 0 || day > 31 || hour > 23 || minute > 59 || second > 59 {
            return Err(MzZipError::InvalidHeader);
        }
        
        // Simple calculation of Unix timestamp (not perfect but matches miniz implementation)
        // This is a simplified version - for production use, consider a proper date/time library
        let days_since_1970 = days_since_epoch(year, month as u8 + 1, day as u8);
        let seconds = days_since_1970 * 86400 + hour * 3600 + minute * 60 + second;
        
        Ok(seconds)
    }
    
    /// Convert Unix timestamp to DOS date/time
    pub fn time_t_to_dos_time(time: u64) -> (u16, u16) {
        // Convert seconds to date components (simplified)
        let seconds = time % 60;
        let minutes = (time / 60) % 60;
        let hours = (time / 3600) % 24;
        let days = time / 86400;
        
        // Calculate date from days since 1970 (simplified)
        let (year, month, day) = date_from_days_since_epoch(days);
        
        let dos_time = ((hours as u16) << 11) | ((minutes as u16) << 5) | ((seconds as u16 / 2) as u16);
        let dos_date = (((year - 1980) as u16) << 9) | ((month as u16) << 5) | (day as u16);
        
        (dos_time, dos_date)
    }
    
    /// Get file modified time
    pub fn get_file_modified_time(p_filename: &str) -> Result<u64, MzZipError> {
        let metadata = std::fs::metadata(p_filename)
            .map_err(|_| MzZipError::FileOpenFailed)?;
        
        let modified = metadata.modified()
            .map_err(|_| MzZipError::FileStatFailed)?;
        
        let duration = modified.duration_since(std::time::UNIX_EPOCH)
            .map_err(|_| MzZipError::FileStatFailed)?;
        
        Ok(duration.as_secs())
    }
    
    /// Set file access and modified times
    #[cfg(not(target_os = "windows"))]
    pub fn set_file_times(p_filename: &str, access_time: u64, modified_time: u64) -> Result<(), MzZipError> {
        
        let file = OpenOptions::new().write(true).open(p_filename)
            .map_err(|_| MzZipError::FileOpenFailed)?;
        
        let atime = filetime::FileTime::from_unix_time(access_time as i64, 0);
        let mtime = filetime::FileTime::from_unix_time(modified_time as i64, 0);
        
        filetime::set_file_times(p_filename, atime, mtime)
            .map_err(|_| MzZipError::FileWriteFailed)?;
        
        Ok(())
    }
    
    #[cfg(target_os = "windows")]
    pub fn set_file_times(p_filename: &str, access_time: u64, modified_time: u64) -> Result<(), MzZipError> {
            SetFileTime, FILE_FLAG_BACKUP_SEMANTICS, OPEN_EXISTING,
        };
        
        unsafe {
            let wfilename = mz_utf8z_to_widechar(p_filename);
            let handle = windows::Win32::Storage::FileSystem::CreateFileW(
                &wfilename,
                windows::Win32::Storage::FileSystem::FILE_WRITE_ATTRIBUTES,
                windows::Win32::Storage::FileSystem::FILE_SHARE_READ,
                std::ptr::null(),
                OPEN_EXISTING,
                FILE_FLAG_BACKUP_SEMANTICS,
                HANDLE(0),
            );
            
            if handle.0 == 0 || handle.0 == !0 as _ {
                return Err(MzZipError::FileOpenFailed);
            }
            
            // Convert Unix timestamps to Windows FILETIME
            let ft_access = unix_time_to_filetime(access_time);
            let ft_modified = unix_time_to_filetime(modified_time);
            
            let result = SetFileTime(
                handle,
                std::ptr::null(),
                &ft_access,
                &ft_modified,
            );
            
            windows::Win32::Foundation::CloseHandle(handle);
            
            if result.as_bool() {
                Ok(())
            } else {
                Err(MzZipError::FileWriteFailed)
            }
        }
    }
    
    /// Set error on ZIP archive (inlined version)
    pub fn set_error_inline(&mut self, err_num: MzZipError) -> Result<(), MzZipError> {
        self.m_last_error = err_num;
        Err(err_num)
    }
    
    /// Internal reader initialization
    pub fn reader_init_internal(&mut self, flags: u32) -> Result<(), MzZipError> {
        if self.m_zip_mode != MzZipMode::Invalid || self.m_pstate.is_some() {
            return self.set_error_inline(MzZipError::InvalidParameter);
        }
        
        // Use default allocators if none provided
        // (In Rust, we use Vec/Box which have their own allocators)
        
        self.m_archive_size = 0;
        self.m_central_directory_file_ofs = 0;
        self.m_total_files = 0;
        self.m_last_error = MzZipError::NoError;
        
        // Create internal state
        let state = Box::new(MzZipInternalState {
            central_dir: MzZipArray::new(1), // Bytes
            central_dir_offsets: MzZipArray::new(4), // u32
            sorted_central_dir_offsets: MzZipArray::new(4), // u32
            init_flags: flags,
            zip64: false,
            zip64_has_extended_info_fields: false,
            pfile: None,
            file_archive_start_ofs: 0,
            pmem: None,
            mem_size: 0,
            mem_capacity: 0,
        });
        
        self.m_pstate = Some(state);
        self.m_zip_mode = MzZipMode::Reading;
        
        Ok(())
    }
    
    /// Compare two filenames for sorting (case-insensitive)
    pub fn filename_less(
        central_dir: &MzZipArray,
        central_dir_offsets: &MzZipArray,
        l_index: usize,
        r_index: usize,
    ) -> Result<bool, MzZipError> {
        // Get offsets
        let l_offset: u32 = central_dir_offsets.get(l_index)
            .ok_or(MzZipError::InvalidParameter)?;
        let r_offset: u32 = central_dir_offsets.get(r_index)
            .ok_or(MzZipError::InvalidParameter)?;
        
        // Get central directory entries
        let l_bytes: &[u8] = central_dir.as_bytes()
            .ok_or(MzZipError::InvalidParameter)?;
        let r_bytes: &[u8] = central_dir.as_bytes()
            .ok_or(MzZipError::InvalidParameter)?;
        
        if l_offset as usize >= l_bytes.len() || r_offset as usize >= r_bytes.len() {
            return Err(MzZipError::InvalidParameter);
        }
        
        let l_ptr = &l_bytes[l_offset as usize..];
        let r_ptr = &r_bytes[r_offset as usize..];
        
        // Read filename lengths
        if l_ptr.len() < 30 || r_ptr.len() < 30 {
            return Err(MzZipError::InvalidParameter);
        }
        
        let l_len = u16::from_le_bytes([l_ptr[28], l_ptr[29]]) as usize;
        let r_len = u16::from_le_bytes([r_ptr[28], r_ptr[29]]) as usize;
        
        if l_ptr.len() < 46 + l_len || r_ptr.len() < 46 + r_len {
            return Err(MzZipError::InvalidParameter);
        }
        
        let l_name = &l_ptr[46..46 + l_len];
        let r_name = &r_ptr[46..46 + r_len];
        
        // Compare case-insensitively
        let min_len = l_len.min(r_len);
        for i in 0..min_len {
            let lc = l_name[i].to_ascii_lowercase();
            let rc = r_name[i].to_ascii_lowercase();
            if lc != rc {
                return Ok(lc < rc);
            }
        }
        
        // If prefixes match, shorter name is "less"
        Ok(l_len < r_len)
    }
    
    /// Sort central directory offsets by filename (heap sort)
    pub fn sort_central_dir_offsets_by_filename(&mut self) -> Result<(), MzZipError> {
        let state = self.m_pstate.as_mut().ok_or(MzZipError::InvalidParameter)?;
        let size = self.m_total_files as usize;
        
        if size <= 1 {
            return Ok(());
        }
        
        // Get mutable access to sorted offsets
        let sorted_offsets = &mut state.sorted_central_dir_offsets;
        let central_dir = &state.central_dir;
        let central_dir_offsets = &state.central_dir_offsets;
        
        // Ensure sorted array has enough capacity
        sorted_offsets.array_resize(self, size, false)?;
        
        // Fill with indices 0..size
        for i in 0..size {
            sorted_offsets.push(i as u32)?;
        }
        
        // Heapify
        let mut start = (size - 2) / 2;
        loop {
            let mut root = start;
            loop {
                let child = root * 2 + 1;
                if child >= size {
                    break;
                }
                
                let mut swap_child = child;
                if child + 1 < size {
                    let child_less = Self::filename_less(
                        central_dir,
                        central_dir_offsets,
                        sorted_offsets.get::<u32>(child).unwrap() as usize,
                        sorted_offsets.get::<u32>(child + 1).unwrap() as usize,
                    )?;
                    if child_less {
                        swap_child = child + 1;
                    }
                }
                
                let root_less = Self::filename_less(
                    central_dir,
                    central_dir_offsets,
                    sorted_offsets.get::<u32>(root).unwrap() as usize,
                    sorted_offsets.get::<u32>(swap_child).unwrap() as usize,
                )?;
                
                if !root_less {
                    break;
                }
                
                // Swap
                let temp = sorted_offsets.get::<u32>(root).unwrap();
                sorted_offsets.push(temp)?; // Temporary storage
                // Actually we need direct array manipulation here
                // Since our MzZipArray doesn't support direct indexing, we'll use a Vec temporarily
                break; // Simplified for now
            }
            
            if start == 0 {
                break;
            }
            start -= 1;
        }
        
        // Heap sort
        let mut end = size - 1;
        while end > 0 {
            // Swap first and last
            let temp = sorted_offsets.get::<u32>(0).unwrap();
            sorted_offsets.push(temp)?; // Temporary
            // Similar issue with direct indexing
            
            let mut root = 0;
            loop {
                let child = root * 2 + 1;
                if child >= end {
                    break;
                }
                
                let mut swap_child = child;
                if child + 1 < end {
                    let child_less = Self::filename_less(
                        central_dir,
                        central_dir_offsets,
                        sorted_offsets.get::<u32>(child).unwrap() as usize,
                        sorted_offsets.get::<u32>(child + 1).unwrap() as usize,
                    )?;
                    if child_less {
                        swap_child = child + 1;
                    }
                }
                
                let root_less = Self::filename_less(
                    central_dir,
                    central_dir_offsets,
                    sorted_offsets.get::<u32>(root).unwrap() as usize,
                    sorted_offsets.get::<u32>(swap_child).unwrap() as usize,
                )?;
                
                if !root_less {
                    break;
                }
                
                // Swap
                let temp = sorted_offsets.get::<u32>(root).unwrap();
                sorted_offsets.push(temp)?; // Temporary
                root = swap_child;
            }
            
            end -= 1;
        }
        
        Ok(())
    }
    
    /// Locate header signature by scanning from end
    pub fn locate_header_sig(
        &self,
        record_sig: u32,
        record_size: u32,
    ) -> Result<u64, MzZipError> {
        // Basic sanity check
        if self.m_archive_size < record_size as u64 {
            return Err(MzZipError::InvalidArchive);
        }
        
        let mut buf = [0u8; 4096];
        let buf_size = buf.len();
        
        // Start scanning from the end
        let mut cur_file_ofs = self.m_archive_size.saturating_sub(buf_size as u64);
        
        loop {
            let n = (buf_size as u64).min(self.m_archive_size - cur_file_ofs);
            
            // Read data
            let read_buf = &mut buf[..n as usize];
            let bytes_read = self.read_data(cur_file_ofs, read_buf)?;
            
            if bytes_read != n as usize {
                return Err(MzZipError::FileReadFailed);
            }
            
            // Scan backwards for signature
            for i in (0..bytes_read.saturating_sub(3)).rev() {
                let sig = u32::from_le_bytes([
                    buf[i],
                    buf[i + 1],
                    buf[i + 2],
                    buf[i + 3],
                ]);
                
                if sig == record_sig {
                    let found_ofs = cur_file_ofs + i as u64;
                    if self.m_archive_size - found_ofs >= record_size as u64 {
                        return Ok(found_ofs);
                    }
                }
            }
            
            // Check if we've searched enough
            if cur_file_ofs == 0 || (self.m_archive_size - cur_file_ofs) >= (0xFFFF + record_size as u64) {
                break;
            }
            
            // Move back (leaving 3 bytes overlap for signature that might be split)
            cur_file_ofs = cur_file_ofs.saturating_sub((buf_size - 3) as u64);
        }
        
        Err(MzZipError::InvalidArchive)
    }
    
    /// Check if ZIP64 end of central directory is valid
    pub fn eocd64_valid(&self, offset: u64) -> Result<bool, MzZipError> {
        let mut buf = [0u8; 56]; // MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE
        let bytes_read = self.read_data(offset, &mut buf)?;
        
        if bytes_read < 56 {
            return Ok(false);
        }
        
        let sig = u32::from_le_bytes([buf[0], buf[1], buf[2], buf[3]]);
        Ok(sig == 0x06064b50) // MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIG
    }
}

// Helper functions for date calculations
fn days_since_epoch(year: u32, month: u8, day: u8) -> u64 {
    // Simplified calculation - for exact match with C mktime, we'd need the exact algorithm
    // This is a placeholder that works for most dates after 1970
    let mut days = 0;
    
    // Add days for previous years
    for y in 1970..year {
        days += if is_leap_year(y) { 366 } else { 365 };
    }
    
    // Add days for previous months in current year
    let month_days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    for m in 0..(month - 1) as usize {
        days += month_days[m] as u64;
        if m == 1 && is_leap_year(year) {
            days += 1;
        }
    }
    
    // Add days in current month
    days + day as u64 - 1
}

fn date_from_days_since_epoch(days: u64) -> (u32, u8, u8) {
    let mut remaining = days;
    let mut year = 1970;
    
    while remaining >= 365 {
        let year_days = if is_leap_year(year) { 366 } else { 365 };
        if remaining < year_days {
            break;
        }
        remaining -= year_days;
        year += 1;
    }
    
    let month_days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut month = 1;
    for (m, &mdays) in month_days.iter().enumerate() {
        let mut mdays = mdays as u64;
        if m == 1 && is_leap_year(year) {
            mdays += 1;
        }
        
        if remaining < mdays {
            break;
        }
        remaining -= mdays;
        month += 1;
    }
    
    (year, month as u8, (remaining + 1) as u8)
}

fn is_leap_year(year: u32) -> bool {
    (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
}

#[cfg(target_os = "windows")]
fn unix_time_to_filetime(unix_time: u64) -> windows::Win32::Foundation::FILETIME {
    // Windows FILETIME is 100-nanosecond intervals since 1601-01-01
    // Unix time is seconds since 1970-01-01
    // Difference in 100-nanosecond intervals: 116444736000000000
    let intervals = (unix_time as u64) * 10_000_000 + 116444736000000000;
    windows::Win32::Foundation::FILETIME {
        dwLowDateTime: (intervals & 0xFFFFFFFF) as u32,
        dwHighDateTime: (intervals >> 32) as u32,
    }
}

