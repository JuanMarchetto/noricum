/// CRC32 computation function (equivalent to C's mz_crc32)
pub fn mz_crc32(initial_crc: u64, buf: &[u8]) -> u32 {
    let mut crc = !initial_crc as u32;
    for &byte in buf {
        crc = CRC32_TABLE[((crc ^ u32::from(byte)) & 0xFF) as usize] ^ (crc >> 8);
    }
    !crc
}

