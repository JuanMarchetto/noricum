// Windows-specific UTF-8 to UTF-16 conversion (only for Windows)
#[cfg(target_os = "windows")]
mod windows_utf16 {
    use winapi::um::stringapiset::{
        MultiByteToWideChar, WideCharToMultiByte,
        CP_UTF8, CP_ACP,
    };
    
    pub fn utf8_to_wide_char(utf8: &str) -> Result<Vec<u16>, std::io::Error> {
        if utf8.is_empty() {
            return Ok(vec![0]);
        }
        
        // Calculate required buffer size
        let utf8_bytes = utf8.as_bytes();
        let required_chars = unsafe {
            MultiByteToWideChar(
                CP_UTF8,
                0,
                utf8_bytes.as_ptr() as *const i8,
                utf8_bytes.len() as i32,
                ptr::null_mut(),
                0,
            )
        };
        
        if required_chars == 0 {
            return Err(std::io::Error::last_os_error());
        }
        
        // Allocate buffer with null terminator
        let mut buffer = vec![0u16; required_chars as usize + 1];
        
        // Perform conversion
        let result = unsafe {
            MultiByteToWideChar(
                CP_UTF8,
                0,
                utf8_bytes.as_ptr() as *const i8,
                utf8_bytes.len() as i32,
                buffer.as_mut_ptr(),
                required_chars,
            )
        };
        
        if result == 0 {
            Err(std::io::Error::last_os_error())
        } else {
            buffer[result as usize] = 0; // Ensure null termination
            buffer.truncate(result as usize + 1);
            Ok(buffer)
        }
    }
}

#[cfg(target_os = "windows")]
pub fn mz_utf8z_to_widechar(str: &str) -> Result<Vec<u16>, std::io::Error> {
    windows_utf16::utf8_to_wide_char(str)
}

#[cfg(not(target_os = "windows"))]
pub fn mz_utf8z_to_widechar(_str: &str) -> Result<Vec<u16>, std::io::Error> {
    // On non-Windows, we don't need wide chars
    Ok(vec![0])
}

#[cfg(target_os = "windows")]
pub fn mz_fopen(filename: &str, mode: &str) -> Result<std::fs::File, std::io::Error> {
    
    let wide_filename = windows_utf16::utf8_to_wide_char(filename)?;
    let wide_mode = windows_utf16::utf8_to_wide_char(mode)?;
    
    // Simplified: use Rust's OpenOptions
    let mut options = OpenOptions::new();
    
    if mode.contains('r') {
        options.read(true);
    }
    if mode.contains('w') || mode.contains('a') {
        options.write(true);
        if mode.contains('w') {
            options.create(true).truncate(true);
        }
        if mode.contains('a') {
            options.append(true).create(true);
        }
    }
    
    // Convert wide char filename back to Rust string for OpenOptions
    // This is simplified; proper implementation would use Windows API directly
    std::fs::OpenOptions::new()
        .read(mode.contains('r'))
        .write(mode.contains('w') || mode.contains('a') || mode.contains('+'))
        .create(mode.contains('w') || mode.contains('a') || mode.contains('+'))
        .truncate(mode.contains('w'))
        .append(mode.contains('a'))
        .open(filename)
}

#[cfg(not(target_os = "windows"))]
pub fn mz_fopen(filename: &str, mode: &str) -> Result<std::fs::File, std::io::Error> {
    
    let mut options = OpenOptions::new();
    
    if mode.contains('r') {
        options.read(true);
    }
    if mode.contains('w') || mode.contains('a') {
        options.write(true);
        if mode.contains('w') {
            options.create(true).truncate(true);
        }
        if mode.contains('a') {
            options.append(true).create(true);
        }
    }
    if mode.contains('+') {
        options.read(true).write(true);
    }
    
    options.open(filename)
}

#[cfg(target_os = "windows")]
pub fn mz_freopen(path: &str, mode: &str, stream: &mut std::fs::File) -> Result<std::fs::File, std::io::Error> {
    // On Windows, we can't truly freopen a File object
    // Close and reopen is the closest approximation
    drop(stream);
    mz_fopen(path, mode)
}

#[cfg(not(target_os = "windows"))]
pub fn mz_freopen(path: &str, mode: &str, _stream: &mut std::fs::File) -> Result<std::fs::File, std::io::Error> {
    // Simplified: just open the file
    mz_fopen(path, mode)
}

#[cfg(target_os = "windows")]
pub fn mz_stat(path: &str, buffer: &mut libc::stat) -> Result<(), std::io::Error> {
    
    let wide_path = windows_utf16::utf8_to_wide_char(path)?;
    
    // Convert to null-terminated wide string
    let wide_path_ptr = wide_path.as_ptr();
    
    // Use _wstat on Windows
    let result = unsafe {
        libc::_wstat(wide_path_ptr as *const libc::wchar_t, buffer)
    };
    
    if result == 0 {
        Ok(())
    } else {
        Err(std::io::Error::last_os_error())
    }
}

#[cfg(not(target_os = "windows"))]
pub fn mz_stat(path: &str, buffer: &mut libc::stat) -> Result<(), std::io::Error> {
    
    let c_path = CString::new(path).map_err(|_| std::io::Error::new(
        std::io::ErrorKind::InvalidInput,
        "path contains null byte"
    ))?;
    
    let result = unsafe {
        libc::stat(c_path.as_ptr(), buffer)
    };
    
    if result == 0 {
        Ok(())
    } else {
        Err(std::io::Error::last_os_error())
    }
}

#[cfg(target_os = "windows")]
pub fn mz_stat64(path: &str, buffer: &mut libc::stat64) -> Result<(), std::io::Error> {
    
    let wide_path = windows_utf16::utf8_to_wide_char(path)?;
    
    // Use _wstat64 on Windows
    let result = unsafe {
        libc::_wstat64(wide_path.as_ptr() as *const libc::wchar_t, buffer)
    };
    
    if result == 0 {
        Ok(())
    } else {
        Err(std::io::Error::last_os_error())
    }
}

#[cfg(not(target_os = "windows"))]
pub fn mz_stat64(path: &str, buffer: &mut libc::stat64) -> Result<(), std::io::Error> {
    
    let c_path = CString::new(path).map_err(|_| std::io::Error::new(
        std::io::ErrorKind::InvalidInput,
        "path contains null byte"
    ))?;
    
    let result = unsafe {
        libc::stat64(c_path.as_ptr(), buffer)
    };
    
    if result == 0 {
        Ok(())
    } else {
        Err(std::io::Error::last_os_error())
    }
}

impl MzZipArray {
    /// Range check for debug builds (similar to C's MZ_ZIP_ARRAY_ELEMENT macro)
    pub fn range_check(&self, index: usize) -> Result<usize, MzZipError> {
        #[cfg(debug_assertions)]
        {
            if index >= self.size {
                return Err(MzZipError::ArrayOutOfBounds);
            }
        }
        Ok(index)
    }
    
    /// Initialize array with element size (already in new() constructor)
    pub fn init(&mut self, element_size: u32) {
        self.p = None;
        self.size = 0;
        self.capacity = 0;
        self.element_size = element_size;
    }
    
    /// Clear array and free memory
    pub fn clear_with_free(&mut self) {
        self.p = None;
        self.size = 0;
        self.capacity = 0;
    }
    
    /// Ensure capacity with growing strategy
    pub fn ensure_capacity(&mut self, min_new_capacity: usize, growing: bool) -> Result<(), MzZipError> {
        if self.capacity >= min_new_capacity {
            return Ok(());
        }
        
        let mut new_capacity = min_new_capacity;
        if growing {
            new_capacity = std::cmp::max(1, self.capacity);
            while new_capacity < min_new_capacity {
                new_capacity = new_capacity.checked_mul(2)
                    .ok_or(MzZipError::CapacityOverflow)?;
            }
        }
        
        self.reserve(new_capacity)
    }
    
    /// Reserve capacity with growing flag
    pub fn reserve_with_growing(&mut self, new_capacity: usize, growing: bool) -> Result<(), MzZipError> {
        if new_capacity > self.capacity {
            self.ensure_capacity(new_capacity, growing)
        } else {
            Ok(())
        }
    }
    
    /// Resize array
    pub fn resize_with_growing(&mut self, new_size: usize, growing: bool) -> Result<(), MzZipError> {
        if new_size > self.capacity {
            self.ensure_capacity(new_size, growing)?;
        }
        self.size = new_size;
        Ok(())
    }
    
    /// Ensure room for n more elements
    pub fn ensure_room(&mut self, n: usize) -> Result<(), MzZipError> {
        self.reserve_with_growing(self.size + n, true)
    }
    
    /// Push multiple elements
    pub fn push_back(&mut self, elements: &[u8], n: usize) -> Result<(), MzZipError> {
        let element_size = self.element_size as usize;
        let total_bytes = n * element_size;
        
        if elements.len() < total_bytes {
            return Err(MzZipError::InvalidParameter);
        }
        
        let orig_size = self.size;
        self.resize_with_growing(orig_size + n, true)?;
        
        if n > 0 {
            let start = orig_size * element_size;
            let end = start + total_bytes;
            
            if let Some(ref mut vec) = self.p {
                if end > vec.len() {
                    vec.resize(end, 0);
                }
                vec[start..end].copy_from_slice(&elements[..total_bytes]);
            }
        }
        
        Ok(())
    }
}

/// Convert DOS date/time to Unix timestamp
pub fn mz_zip_dos_to_time_t(dos_time: u16, dos_date: u16) -> Option<std::time::SystemTime> {
    let year = ((dos_date as u32 >> 9) & 0x7F) + 1980;
    let month = ((dos_date as u32 >> 5) & 0x0F);
    let day = (dos_date as u32) & 0x1F;
    
    let hour = (dos_time as u32 >> 11) & 0x1F;
    let minute = (dos_time as u32 >> 5) & 0x3F;
    let second = ((dos_time as u32) & 0x1F) * 2;
    
    // Validate ranges
    if month == 0 || month > 12 || day == 0 || day > 31 ||
       hour > 23 || minute > 59 || second > 59 {
        return None;
    }
    
    let naive = chrono::NaiveDate::from_ymd_opt(
        year as i32,
        month,
        day
    )?.and_hms_opt(
        hour,
        minute,
        second
    )?;
    
    Some(std::time::SystemTime::from(
        std::time::UNIX_EPOCH + std::time::Duration::from_secs(
            naive.and_utc().timestamp() as u64
        )
    ))
}

/// Convert Unix timestamp to DOS date/time
pub fn mz_zip_time_t_to_dos_time(time: std::time::SystemTime) -> (u16, u16) {
    let duration_since_epoch = time.duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_else(|_| std::time::Duration::from_secs(0));
    
    let timestamp = duration_since_epoch.as_secs() as i64;
    let naive = chrono::DateTime::from_timestamp(timestamp, 0)
        .unwrap_or_else(|| chrono::DateTime::from_timestamp(0, 0).unwrap());
    
    let year = naive.year();
    let month = naive.month();
    let day = naive.day();
    let hour = naive.hour();
    let minute = naive.minute();
    let second = naive.second();
    
    let dos_date = ((year - 1980) << 9) as u16 |
                   ((month as u16) << 5) |
                   (day as u16);
    
    let dos_time = ((hour as u16) << 11) |
                   ((minute as u16) << 5) |
                   ((second as u16) >> 1);
    
    (dos_time, dos_date)
}

/// Get file modified time
pub fn mz_zip_get_file_modified_time(filename: &str) -> Result<std::time::SystemTime, std::io::Error> {
    let metadata = std::fs::metadata(filename)?;
    Ok(metadata.modified()?)
}

/// Set file access and modified times
pub fn mz_zip_set_file_times(
    filename: &str,
    access_time: std::time::SystemTime,
    modified_time: std::time::SystemTime,
) -> Result<(), std::io::Error> {
    let atime = filetime::FileTime::from_system_time(access_time);
    let mtime = filetime::FileTime::from_system_time(modified_time);
    filetime::set_file_times(filename, atime, mtime)
}

impl MzZipArchive {
    /// Internal reader initialization
    pub fn reader_init_internal(&mut self, flags: u32) -> Result<(), MzZipError> {
        
        if self.m_pstate.is_some() || self.m_zip_mode != MzZipMode::Invalid {
            return Err(InvalidParameter);
        }
        
        // Use default allocators if none provided
        // In Rust, we use Vec/Box which have their own allocators
        
        self.m_archive_size = 0;
        self.m_central_directory_file_ofs = 0;
        self.m_total_files = 0;
        self.m_last_error = MzZipError::NoError;
        
        // Create internal state
        let state = Box::new(MzZipInternalState {
            central_dir: MzZipArray::new(1), // Bytes
            central_dir_offsets: MzZipArray::new(4), // u32
            sorted_central_dir_offsets: MzZipArray::new(4), // u32
            init_flags: flags,
            zip64: false,
            zip64_has_extended_info_fields: false,
            pfile: None,
            file_archive_start_ofs: 0,
            pmem: None,
            mem_size: 0,
            mem_capacity: 0,
        });
        
        self.m_pstate = Some(state);
        self.m_zip_mode = MzZipMode::Reading;
        
        Ok(())
    }
    
    /// Compare two filenames (case-insensitive) for sorting
    fn filename_less(&self, l_index: usize, r_index: usize) -> Result<bool, MzZipError> {
        let state = self.m_pstate.as_ref().ok_or(MzZipError::InternalError)?;
        
        // Get central directory entries
        let central_dir_bytes = state.central_dir.as_bytes()
            .ok_or(MzZipError::InternalError)?;
        
        // Get offsets
        let l_offset = state.central_dir_offsets.get::<u32>(l_index)
            .ok_or(MzZipError::InternalError)? as usize;
        let r_offset = state.central_dir_offsets.get::<u32>(r_index)
            .ok_or(MzZipError::InternalError)? as usize;
        
        // Get filename lengths
        if l_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS + 2 > central_dir_bytes.len() ||
           r_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS + 2 > central_dir_bytes.len() {
            return Err(MzZipError::InternalError);
        }
        
        let l_len = u16::from_le_bytes([
            central_dir_bytes[l_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS],
            central_dir_bytes[l_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS + 1]
        ]) as usize;
        
        let r_len = u16::from_le_bytes([
            central_dir_bytes[r_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS],
            central_dir_bytes[r_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS + 1]
        ]) as usize;
        
        // Compare filenames
        let l_start = l_offset + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE;
        let r_start = r_offset + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE;
        
        let l_end = l_start + l_len.min(r_len);
        let r_end = r_start + l_len.min(r_len);
        
        if l_end > central_dir_bytes.len() || r_end > central_dir_bytes.len() {
            return Err(MzZipError::InternalError);
        }
        
        for (l_byte, r_byte) in central_dir_bytes[l_start..l_end]
            .iter()
            .zip(&central_dir_bytes[r_start..r_end]) 
        {
            let l_lower = l_byte.to_ascii_lowercase();
            let r_lower = r_byte.to_ascii_lowercase();
            
            if l_lower != r_lower {
                return Ok(l_lower < r_lower);
            }
        }
        
        // If prefixes are equal, shorter filename comes first
        Ok(l_len < r_len)
    }
    
    /// Sort central directory offsets by filename (heap sort)
    pub fn sort_central_dir_offsets_by_filename(&mut self) -> Result<(), MzZipError> {
        let state = self.m_pstate.as_mut().ok_or(MzZipError::InternalError)?;
        let size = self.m_total_files as usize;
        
        if size <= 1 {
            return Ok(());
        }
        
        // Ensure sorted_central_dir_offsets has the right size
        state.sorted_central_dir_offsets.resize_with_growing(size, true)?;
        
        // Get mutable slice to indices
        let indices_slice = state.sorted_central_dir_offsets.as_bytes_mut()
            .ok_or(MzZipError::InternalError)?;
        
        // Initialize with sequential indices
        for i in 0..size {
            let offset_bytes = (i as u32).to_le_bytes();
            let start = i * 4;
            indices_slice[start..start + 4].copy_from_slice(&offset_bytes);
        }
        
        // Heap sort implementation
        let mut start = (size - 2) / 2;
        loop {
            let mut root = start;
            loop {
                let child = (root << 1) + 1;
                if child >= size {
                    break;
                }
                
                let mut child_idx = child;
                if child + 1 < size {
                    let child1_less = self.filename_less(
                        get_u32_from_slice(indices_slice, child)? as usize,
                        get_u32_from_slice(indices_slice, child + 1)? as usize
                    )?;
                    if child1_less {
                        child_idx = child + 1;
                    }
                }
                
                let root_less = self.filename_less(
                    get_u32_from_slice(indices_slice, root)? as usize,
                    get_u32_from_slice(indices_slice, child_idx)? as usize
                )?;
                
                if !root_less {
                    break;
                }
                
                // Swap root and child
                swap_u32_in_slice(indices_slice, root, child_idx);
                root = child_idx;
            }
            
            if start == 0 {
                break;
            }
            start -= 1;
        }
        
        let mut end = size - 1;
        while end > 0 {
            // Swap first and last
            swap_u32_in_slice(indices_slice, 0, end);
            
            let mut root = 0;
            loop {
                let child = (root << 1) + 1;
                if child >= end {
                    break;
                }
                
                let mut child_idx = child;
                if child + 1 < end {
                    let child1_less = self.filename_less(
                        get_u32_from_slice(indices_slice, child)? as usize,
                        get_u32_from_slice(indices_slice, child + 1)? as usize
                    )?;
                    if child1_less {
                        child_idx = child + 1;
                    }
                }
                
                let root_less = self.filename_less(
                    get_u32_from_slice(indices_slice, root)? as usize,
                    get_u32_from_slice(indices_slice, child_idx)? as usize
                )?;
                
                if !root_less {
                    break;
                }
                
                swap_u32_in_slice(indices_slice, root, child_idx);
                root = child_idx;
            }
            
            end -= 1;
        }
        
        Ok(())
    }
    
    /// Locate a header signature in the archive
    pub fn locate_header_sig(
        &self,
        record_sig: u32,
        record_size: usize,
    ) -> Result<Option<u64>, MzZipError> {
        if self.m_archive_size < record_size as u64 {
            return Ok(None);
        }
        
        let buf_size = 4096;
        let mut buf = vec![0u8; buf_size];
        
        // Start scanning from the end
        let mut cur_file_ofs = self.m_archive_size.saturating_sub(buf_size as u64);
        
        loop {
            let n = (buf_size as u64).min(self.m_archive_size - cur_file_ofs) as usize;
            
            // Read data at current offset
            let bytes_read = self.read_data(cur_file_ofs, &mut buf[..n])?;
            if bytes_read != n {
                return Ok(None);
            }
            
            // Search for signature from the end of the buffer
            for i in (0..=n.saturating_sub(4)).rev() {
                let sig = u32::from_le_bytes([buf[i], buf[i + 1], buf[i + 2], buf[i + 3]]);
                if sig == record_sig {
                    let found_ofs = cur_file_ofs + i as u64;
                    if self.m_archive_size - found_ofs >= record_size as u64 {
                        return Ok(Some(found_ofs));
                    }
                }
            }
            
            // Stop if we've searched the entire file or gone back too far
            if cur_file_ofs == 0 ||
               (self.m_archive_size - cur_file_ofs) >= (u16::MAX as u64 + record_size as u64) {
                return Ok(None);
            }
            
            // Move back (leaving 3 bytes overlap to catch signatures at boundaries)
            cur_file_ofs = cur_file_ofs.saturating_sub((buf_size - 3) as u64);
        }
    }
    
    /// Check if a potential Zip64 end of central directory is valid
    pub fn eocd64_valid(&self, offset: u64) -> Result<bool, MzZipError> {
        let mut buf = [0u8; MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE as usize];
        
        let bytes_read = self.read_data(offset, &mut buf)?;
        if bytes_read != MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE as usize {
            return Ok(false);
        }
        
        let sig = u32::from_le_bytes([buf[0], buf[1], buf[2], buf[3]]);
        Ok(sig == MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIG)
    }
}

// Helper functions for byte array manipulation
fn get_u32_from_slice(slice: &[u8], index: usize) -> Result<u32, MzZipError> {
    let start = index * 4;
    let end = start + 4;
    
    if end > slice.len() {
        return Err(MzZipError::InternalError);
    }
    
    Ok(u32::from_le_bytes([
        slice[start],
        slice[start + 1],
        slice[start + 2],
        slice[start + 3],
    ]))
}

fn swap_u32_in_slice(slice: &mut [u8], i: usize, j: usize) {
    let i_start = i * 4;
    let j_start = j * 4;
    
    for k in 0..4 {
        slice.swap(i_start + k, j_start + k);
    }
}

