// Helper functions
fn MZ_READ_LE16(p: &[u8], ofs: usize) -> mz_uint16 {
    u16::from_le_bytes([p[ofs], p[ofs + 1]])
}

fn MZ_READ_LE32(p: &[u8], ofs: usize) -> mz_uint32 {
    u32::from_le_bytes([p[ofs], p[ofs + 1], p[ofs + 2], p[ofs + 3]])
}

fn MZ_READ_LE64(p: &[u8], ofs: usize) -> mz_uint64 {
    u64::from_le_bytes([
        p[ofs], p[ofs + 1], p[ofs + 2], p[ofs + 3],
        p[ofs + 4], p[ofs + 5], p[ofs + 6], p[ofs + 7],
    ])
}


