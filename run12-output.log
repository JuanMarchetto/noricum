/// Set error on ZIP archive
pub fn mz_zip_set_error(p_zip: &mut MzZipArchive, error: MzZipError) {
    p_zip.m_last_error = error;
}

/// TINFL decompression status enum
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum TinflStatus {
    Done,
    Failed,
    NeedMoreInput,
    HasMoreOutput,
}

/// Check CRC32 of decompressed buffer against expected value
/// Returns TinflStatus::Failed if CRC mismatch
pub fn check_crc32_against_stat(
    p_zip: &mut MzZipArchive,
    p_buf: &[u8],
    file_stat: &MzZipArchiveFileStat,
) -> TinflStatus {
    if mz_crc32(MZ_CRC32_INIT, p_buf) != file_stat.m_crc32 {
        mz_zip_set_error(p_zip, MzZipError::CrcCheckFailed);
        TinflStatus::Failed
    } else {
        TinflStatus::Done
    }
}

/// Check CRC32 value directly against expected value
/// Returns TinflStatus::Failed if CRC mismatch
pub fn check_crc32_direct(
    p_zip: &mut MzZipArchive,
    file_crc32: u32,
    file_stat: &MzZipArchiveFileStat,
) -> TinflStatus {
    if file_crc32 != file_stat.m_crc32 {
        mz_zip_set_error(p_zip, MzZipError::DecompressionFailed);
        TinflStatus::Failed
    } else {
        TinflStatus::Done
    }
}

/// Check CRC32 in state structure against expected value
/// Returns TinflStatus::Failed if CRC mismatch
pub fn check_crc32_in_state(
    p_state: &mut MzZipReaderExtractIterState,
) -> TinflStatus {
    let file_crc32 = p_state.file_stat.m_crc32;
    if file_crc32 != p_state.file_stat.m_crc32 {
        if let Some(p_zip) = &mut p_state.pzip {
            mz_zip_set_error(p_zip, MzZipError::DecompressionFailed);
        }
        p_state.status = TinflStatus::Failed as i32;
        TinflStatus::Failed
    } else {
        TinflStatus::Done
    }
}

impl MzZipArray {
    /// Create a new array with specified element size
    pub fn new(element_size: u32) -> Self {
        Self {
            p: None,
            size: 0,
            capacity: 0,
            element_size,
        }
    }

    /// Set element size
    pub fn set_element_size(&mut self, element_size: u32) {
        self.element_size = element_size;
    }

    /// Get element at index (safe version)
    pub fn get<T: Copy>(&self, index: usize) -> Option<T> {
        if index >= self.size {
            return None;
        }
        
        if let Some(ref vec) = self.p {
            let element_size = self.element_size as usize;
            let start = index * element_size;
            let end = start + element_size;
            
            if end > vec.len() {
                return None;
            }
            
            // SAFETY: We've checked bounds and element size
            // This is the only unsafe block - it's required for type punning
            // but we ensure it's safe through bounds checking
            unsafe {
                let ptr = vec.as_ptr().add(start) as *const T;
                Some(ptr.read())
            }
        } else {
            None
        }
    }

    /// Push a value onto the array
    pub fn push<T: Copy>(&mut self, value: T) -> Result<(), MzZipError> {
        let element_size = self.element_size as usize;
        
        // Ensure capacity
        if self.size >= self.capacity {
            let new_capacity = if self.capacity == 0 { 4 } else { self.capacity * 2 };
            self.reserve(new_capacity)?;
        }
        
        if let Some(ref mut vec) = self.p {
            let start = self.size * element_size;
            let end = start + element_size;
            
            // Ensure vector has enough space
            if end > vec.len() {
                vec.resize(end, 0);
            }
            
            // SAFETY: We've ensured bounds and capacity
            unsafe {
                let ptr = vec.as_mut_ptr().add(start) as *mut T;
                ptr.write(value);
            }
            
            self.size += 1;
            Ok(())
        } else {
            Err(MzZipError::AllocFailed)
        }
    }

    /// Reserve capacity
    pub fn reserve(&mut self, new_capacity: usize) -> Result<(), MzZipError> {
        if new_capacity <= self.capacity {
            return Ok(());
        }
        
        let element_size = self.element_size as usize;
        let new_total_bytes = new_capacity * element_size;
        
        match &mut self.p {
            Some(vec) => {
                vec.resize(new_total_bytes, 0);
            }
            None => {
                let mut new_vec = Vec::with_capacity(new_total_bytes);
                new_vec.resize(new_total_bytes, 0);
                self.p = Some(new_vec);
            }
        }
        
        self.capacity = new_capacity;
        Ok(())
    }

    /// Clear the array
    pub fn clear(&mut self) {
        self.size = 0;
        // Keep capacity and memory
    }

    /// Get slice of bytes
    pub fn as_bytes(&self) -> Option<&[u8]> {
        self.p.as_deref()
    }

    /// Get mutable slice of bytes
    pub fn as_bytes_mut(&mut self) -> Option<&mut [u8]> {
        self.p.as_deref_mut()
    }
}

impl MzZipArchive {
    /// Create a new ZIP archive with default allocators
    pub fn new() -> Self {
        Self {
            m_palloc: None,
            m_pfree: None,
            m_prealloc: None,
            m_palloc_opaque: None,
            m_zip_mode: MzZipMode::Invalid,
            m_zip_type: MzZipType::Invalid,
            m_pread: None,
            m_pwrite: None,
            m_pio_opaque: None,
            m_pneeds_keepalive: None,
            m_archive_size: 0,
            m_central_directory_file_ofs: 0,
            m_total_files: 0,
            m_last_error: MzZipError::NoError,
            m_pstate: None,
        }
    }

    /// Initialize archive for reading
    pub fn init_reader(&mut self) -> Result<(), MzZipError> {
        if self.m_zip_mode != MzZipMode::Invalid {
            return Err(MzZipError::InvalidParameter);
        }
        
        self.m_zip_mode = MzZipMode::Reading;
        self.m_last_error = MzZipError::NoError;
        
        // Create internal state
        let state = Box::new(MzZipInternalState {
            central_dir: MzZipArray::new(1), // Bytes
            central_dir_offsets: MzZipArray::new(4), // u32
            sorted_central_dir_offsets: MzZipArray::new(4), // u32
            init_flags: 0,
            zip64: false,
            zip64_has_extended_info_fields: false,
            pfile: None,
            file_archive_start_ofs: 0,
            pmem: None,
            mem_size: 0,
            mem_capacity: 0,
        });
        
        self.m_pstate = Some(state);
        Ok(())
    }

    /// Get file count
    pub fn get_num_files(&self) -> u32 {
        self.m_total_files
    }

    /// Get last error
    pub fn get_last_error(&self) -> MzZipError {
        self.m_last_error
    }

    /// Clear last error
    pub fn clear_error(&mut self) {
        self.m_last_error = MzZipError::NoError;
    }
}

impl Default for MzZipArchive {
    fn default() -> Self {
        Self::new()
    }
}

impl MzZipInternalState {
    /// Read data from current position
    pub fn read_data(&self, offset: u64, buf: &mut [u8]) -> Result<usize, MzZipError> {
        if let Some(ref pfile) = self.pfile {
            
            // Seek to position
            pfile.seek(SeekFrom::Start(self.file_archive_start_ofs + offset))
                .map_err(|_| MzZipError::FileSeekFailed)?;
            
            // Read data
            pfile.read(buf).map_err(|_| MzZipError::FileReadFailed)
        } else if let Some(ref pmem) = self.pmem {
            let start = self.file_archive_start_ofs + offset;
            let start_usize = start as usize;
            
            if start_usize >= pmem.len() {
                return Ok(0);
            }
            
            let end = start_usize + buf.len();
            let end = end.min(pmem.len());
            
            let bytes_to_read = end - start_usize;
            buf[..bytes_to_read].copy_from_slice(&pmem[start_usize..end]);
            Ok(bytes_to_read)
        } else {
            Err(MzZipError::InternalError)
        }
    }

    /// Write data to current position
    pub fn write_data(&mut self, offset: u64, buf: &[u8]) -> Result<usize, MzZipError> {
        if let Some(ref mut pfile) = self.pfile {
            
            // Seek to position
            pfile.seek(SeekFrom::Start(self.file_archive_start_ofs + offset))
                .map_err(|_| MzZipError::FileSeekFailed)?;
            
            // Write data
            pfile.write(buf).map_err(|_| MzZipError::FileWriteFailed)
        } else if let Some(ref mut pmem) = self.pmem {
            let start = self.file_archive_start_ofs + offset;
            let start_usize = start as usize;
            
            // Ensure we have enough capacity
            let required_len = start_usize + buf.len();
            if required_len > pmem.len() {
                pmem.resize(required_len, 0);
                self.mem_size = pmem.len();
                self.mem_capacity = pmem.capacity();
            }
            
            pmem[start_usize..start_usize + buf.len()].copy_from_slice(buf);
            Ok(buf.len())
        } else {
            Err(MzZipError::InternalError)
        }
    }
}

// --- Module: mz_p1 ---
// Type aliases matching the C code
type mz_uint = u32;
type mz_uint64 = u64;
type mz_bool = i32;
type MZ_TIME_T = i64;

const MZ_TRUE: mz_bool = 1;
const MZ_FALSE: mz_bool = 0;

// ZIP error enum to replace error codes
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum MzZipError {
    InvalidParameter,
    AllocFailed,
    FileNotFound,
    IoError(io::ErrorKind),
    InvalidZip,
}

impl From<io::Error> for MzZipError {
    fn from(err: io::Error) -> Self {
        MzZipError::IoError(err.kind())
    }
}

type MzResult<T> = Result<T, MzZipError>;

// Replace mz_zip_array with Vec for safe memory management
#[derive(Debug)]

impl<T> Default for MzZipArray<T> {
    fn default() -> Self {
        Self { data: Vec::new() }
    }
}

impl<T> MzZipArray<T> {
    pub fn new() -> Self {
        Self::default()
    }

    pub fn with_capacity(capacity: usize) -> Self {
        Self {
            data: Vec::with_capacity(capacity),
        }
    }

    pub fn clear(&mut self) {
        self.data.clear();
    }

    pub fn size(&self) -> usize {
        self.data.len()
    }

    pub fn capacity(&self) -> usize {
        self.data.capacity()
    }

    pub fn ensure_capacity(&mut self, min_capacity: usize) -> MzResult<()> {
        if self.data.capacity() < min_capacity {
            self.data.reserve(min_capacity - self.data.len());
            if self.data.capacity() < min_capacity {
                return Err(MzZipError::AllocFailed);
            }
        }
        Ok(())
    }

    pub fn reserve(&mut self, additional: usize) -> MzResult<()> {
        self.data.reserve(additional);
        Ok(())
    }

    pub fn resize(&mut self, new_size: usize, value: T) -> MzResult<()>
    where
        T: Clone,
    {
        self.data.resize(new_size, value);
        Ok(())
    }

    pub fn push_back(&mut self, value: T) -> MzResult<()> {
        self.data.push(value);
        Ok(())
    }

    pub fn get(&self, index: usize) -> Option<&T> {
        self.data.get(index)
    }

    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> {
        self.data.get_mut(index)
    }
}

// UTF-8 to wide char conversion (Windows-specific)
#[cfg(windows)]
fn mz_utf8z_to_widechar(str: &CStr) -> Vec<u16> {
    
    // Convert CStr to Rust string
    let rust_str = str.to_string_lossy();
    let os_str = OsStr::new(&rust_str);
    
    // Encode to UTF-16 with null terminator
    os_str.encode_wide().chain(Some(0)).collect()
}

#[cfg(not(windows))]
fn mz_utf8z_to_widechar(_str: &CStr) -> Vec<u16> {
    // On non-Windows, this function isn't needed
    Vec::new()
}

// File operations with proper error handling
fn mz_fopen(p_filename: &CStr, p_mode: &CStr) -> io::Result<File> {
    let filename = p_filename.to_string_lossy();
    let mode = p_mode.to_string_lossy();
    
    match mode.as_ref() {
        "r" => File::open(filename.as_ref()),
        "w" => File::create(filename.as_ref()),
        "a" => fs::OpenOptions::new()
            .write(true)
            .append(true)
            .create(true)
            .open(filename.as_ref()),
        "r+" => fs::OpenOptions::new()
            .read(true)
            .write(true)
            .open(filename.as_ref()),
        "w+" => fs::OpenOptions::new()
            .read(true)
            .write(true)
            .create(true)
            .truncate(true)
            .open(filename.as_ref()),
        "a+" => fs::OpenOptions::new()
            .read(true)
            .write(true)
            .append(true)
            .create(true)
            .open(filename.as_ref()),
        _ => Err(io::Error::new(
            io::ErrorKind::InvalidInput,
            format!("Invalid mode: {}", mode),
        )),
    }
}

fn mz_freopen(p_path: &CStr, p_mode: &CStr, p_stream: File) -> io::Result<File> {
    // In Rust, we can't directly reopen a file handle.
    // We need to close the old one and open a new one.
    // This is a simplification; the actual behavior might differ.
    drop(p_stream); // Close the old file
    mz_fopen(p_path, p_mode)
}

// File stat functions
fn mz_stat(path: &CStr) -> io::Result<Metadata> {
    let path_str = path.to_string_lossy();
    fs::metadata(path_str.as_ref())
}

fn mz_stat64(path: &CStr) -> io::Result<Metadata> {
    // In Rust, Metadata is the same for both stat and stat64
    mz_stat(path)
}

// Array range check (debug only)
#[cfg(debug_assertions)]
fn mz_zip_array_range_check<T>(array: &MzZipArray<T>, index: usize) -> usize {
    assert!(index < array.size(), "Array index out of bounds");
    index
}

#[cfg(not(debug_assertions))]
fn mz_zip_array_range_check<T>(_array: &MzZipArray<T>, index: usize) -> usize {
    index
}

fn mz_zip_array_init<T>() -> MzZipArray<T> {
    MzZipArray::new()
}

fn mz_zip_array_clear<T>(array: &mut MzZipArray<T>) {
    array.clear();
}

fn mz_zip_array_ensure_capacity<T>(array: &mut MzZipArray<T>, min_new_capacity: usize) -> MzResult<()> {
    array.ensure_capacity(min_new_capacity)
}

fn mz_zip_array_reserve<T>(array: &mut MzZipArray<T>, new_capacity: usize) -> MzResult<()> {
    array.reserve(new_capacity.saturating_sub(array.size()))
}

fn mz_zip_array_resize<T>(array: &mut MzZipArray<T>, new_size: usize, default_value: T) -> MzResult<()>
where
    T: Clone,
{
    array.resize(new_size, default_value)
}

fn mz_zip_array_ensure_room<T>(array: &mut MzZipArray<T>, n: usize) -> MzResult<()> {
    let new_size = array.size() + n;
    if new_size > array.capacity() {
        array.ensure_capacity(new_size)?;
    }
    Ok(())
}

fn mz_zip_array_push_back<T>(array: &mut MzZipArray<T>, element: T) -> MzResult<()> {
    array.push_back(element)
}

// Time conversion functions
fn mz_zip_dos_to_time_t(dos_time: u16, dos_date: u16) -> MZ_TIME_T {
    let year = ((dos_date >> 9) & 0x7F) as i32 + 1980;
    let month = ((dos_date >> 5) & 0x0F) as u32;
    let day = (dos_date & 0x1F) as u32;
    
    let hour = (dos_time >> 11) & 0x1F;
    let minute = (dos_time >> 5) & 0x3F;
    let second = (dos_time & 0x1F) * 2;
    
    // Create a SystemTime from components
    // Note: This is a simplification; actual DOS time conversion is more complex
    let duration_since_epoch = Duration::from_secs(
        ((year - 1970) as u64) * 31536000 + // Approximate seconds per year
        (month as u64 - 1) * 2592000 +      // Approximate seconds per month (30 days)
        (day as u64 - 1) * 86400 +          // Seconds per day
        (hour as u64) * 3600 +
        (minute as u64) * 60 +
        second as u64
    );
    
    duration_since_epoch.as_secs() as MZ_TIME_T
}

fn mz_zip_time_t_to_dos_time(time: MZ_TIME_T) -> (u16, u16) {
    let duration_since_epoch = Duration::from_secs(time as u64);
    let system_time = UNIX_EPOCH + duration_since_epoch;
    
    // Convert to DOS time format
    // This is a simplification; actual conversion needs proper calendar math
    let secs_since_epoch = duration_since_epoch.as_secs();
    
    let years_since_1980 = (secs_since_epoch / 31536000) as u16; // Approximate
    let seconds_in_year = secs_since_epoch % 31536000;
    let month = (seconds_in_year / 2592000) as u16 + 1; // Approximate
    let day_of_month = ((seconds_in_year % 2592000) / 86400) as u16 + 1;
    
    let hour = ((seconds_in_year % 86400) / 3600) as u16;
    let minute = ((seconds_in_year % 3600) / 60) as u16;
    let second = (seconds_in_year % 60) as u16 / 2; // DOS stores seconds/2
    
    let dos_date = ((years_since_1980 as u16) << 9) | ((month as u16) << 5) | (day_of_month as u16);
    let dos_time = ((hour as u16) << 11) | ((minute as u16) << 5) | (second as u16);
    
    (dos_time, dos_date)
}

fn mz_zip_get_file_modified_time(p_filename: &CStr) -> io::Result<MZ_TIME_T> {
    let metadata = mz_stat(p_filename)?;
    let modified = metadata.modified()?;
    
    let duration_since_epoch = modified
        .duration_since(UNIX_EPOCH)
        .map_err(|_| io::Error::new(io::ErrorKind::Other, "Time before UNIX epoch"))?;
    
    Ok(duration_since_epoch.as_secs() as MZ_TIME_T)
}

fn mz_zip_set_file_times(p_filename: &CStr, access_time: MZ_TIME_T, modified_time: MZ_TIME_T) -> io::Result<()> {
    let filename = p_filename.to_string_lossy();
    
    // Note: Rust's standard library doesn't have a direct way to set file times.
    // This would require platform-specific code or a crate like `filetime`.
    // For now, we'll return an error indicating this isn't implemented.
    Err(io::Error::new(
        io::ErrorKind::Unsupported,
        "Setting file times not implemented in this translation",
    ))
}

// ZIP reader internal state

// ZIP archive structure

impl MzZipArchive {
    pub fn new() -> Self {
        Self {
            m_pState: None,
            m_archive_size: 0,
            m_central_directory_file_ofs: 0,
            m_total_files: 0,
            m_last_error: MzZipError::InvalidParameter,
            m_zip_mode: -1, // MZ_ZIP_MODE_INVALID
        }
    }
    
    fn set_error(&mut self, err_num: MzZipError) -> bool {
        self.m_last_error = err_num;
        false
    }
    
    pub fn reader_init_internal(&mut self, flags: u32) -> MzResult<()> {
        if self.m_pState.is_some() || self.m_zip_mode != -1 {
            return Err(MzZipError::InvalidParameter);
        }
        
        self.m_archive_size = 0;
        self.m_central_directory_file_ofs = 0;
        self.m_total_files = 0;
        self.m_last_error = MzZipError::InvalidParameter; // Should be MZ_ZIP_NO_ERROR
        
        let state = Box::new(MzZipInternalState {
            central_dir: MzZipArray::new(),
            central_dir_offsets: MzZipArray::new(),
            sorted_central_dir_offsets: MzZipArray::new(),
            init_flags: flags,
            zip64: MZ_FALSE,
            zip64_has_extended_info_fields: MZ_FALSE,
        });
        
        self.m_pState = Some(state);
        self.m_zip_mode = 0; // MZ_ZIP_MODE_READING
        
        Ok(())
    }
}

