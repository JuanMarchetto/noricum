// Default implementation for MzZipArchiveFileStat
impl Default for MzZipArchiveFileStat {
    fn default() -> Self {
        Self {
            m_file_index: 0,
            m_central_dir_ofs: 0,
            m_version_made_by: 0,
            m_version_needed: 0,
            m_bit_flag: 0,
            m_method: 0,
            m_time: 0,
            m_crc32: 0,
            m_comp_size: 0,
            m_uncomp_size: 0,
