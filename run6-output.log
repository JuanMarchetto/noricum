fn mz_zip_array_resize<T: Default>(
    zip: &mut ZipArchive,
    array: &mut Vec<T>,
    new_size: usize,
    zero_new: bool,
) -> bool {
    if new_size > array.len() {
        if zero_new {
            array.resize_with(new_size, Default::default);
        } else {
            array.resize(new_size, Default::default());
        }
    } else {
        array.truncate(new_size);
    }
    true
}

