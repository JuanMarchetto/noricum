    if comment_size > 0 && comment.is_none() {
        return mz_zip_set_error(zip, MZ_ZIP_INVALID_PARAMETER);
    }
    
    let mut gen_flags: u16 = 0;
    let level = if (level_and_flags as i32) < 0 {
        MZ_DEFAULT_LEVEL
