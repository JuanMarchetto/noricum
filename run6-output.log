    if zip.m_zip_mode != ZipMode::Writing 
        || archive_name.is_empty() 
        || level > MZ_UBER_COMPRESSION 
        || level_and_flags & MZ_ZIP_FLAG_COMPRESSED_DATA != 0 
    {
        return mz_zip_set_error(zip, MZ_ZIP_INVALID_PARAMETER);
    }
    
