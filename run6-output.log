    let mut cur_archive_file_ofs = zip.m_archive_size + num_alignment_padding_bytes as u64;
    
    // Check file offset alignment
    if zip.m_file_offset_alignment > 0 {
        debug_assert_eq!(cur_archive_file_ofs & (zip.m_file_offset_alignment as u64 - 1), 0);
    }
    
    let mut extra_data = [0u8; MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE];
    let mut extra_size = 0;
