// Types from the migration context


pub enum ZipMode {
    Invalid,
    Reading,
    Writing,
}

impl PartialEq for ZipMode {
    fn eq(&self, other: &Self) -> bool {
        match (self, other) {
            (ZipMode::Invalid, ZipMode::Invalid) => true,
            (ZipMode::Reading, ZipMode::Reading) => true,
            (ZipMode::Writing, ZipMode::Writing) => true,
            _ => false,
        }
    }
}

impl PartialEq for ZipType {
    fn eq(&self, other: &Self) -> bool {
        match (self, other) {
            (ZipType::File, ZipType::File) => true,
            (ZipType::CFile, ZipType::CFile) => true,
            (ZipType::Memory, ZipType::Memory) => true,
            (ZipType::User, ZipType::User) => true,
            _ => false,
        }
    }
}


