// Helper functions (assumed to be defined elsewhere)
fn mz_write_le16(p: &mut [u8], v: u16) {
    p[0] = (v & 0xFF) as u8;
    p[1] = (v >> 8) as u8;
}

fn mz_write_le32(p: &mut [u8], v: u32) {
    p[0] = (v & 0xFF) as u8;
    p[1] = ((v >> 8) & 0xFF) as u8;
    p[2] = ((v >> 16) & 0xFF) as u8;
    p[3] = ((v >> 24) & 0xFF) as u8;
}

fn mz_write_le64(p: &mut [u8], v: u64) {
    mz_write_le32(p, (v & 0xFFFFFFFF) as u32);
    mz_write_le32(&mut p[4..], (v >> 32) as u32);
}

