    if state.m_zip64 {
        if zip.m_total_files == u32::MAX {
            return mz_zip_set_error(zip, MZ_ZIP_TOO_MANY_FILES);
        }
    } else if zip.m_total_files == MZ_UINT16_MAX {
        state.m_zip64 = true;
    }
    
    let archive_name_size = archive_name.len();
    if archive_name_size > u16::MAX as usize {
        return mz_zip_set_error(zip, MZ_ZIP_INVALID_FILENAME);
    }
    
    let num_alignment_padding_bytes = mz_zip_writer_compute_padding_needed_for_file_alignment(zip);
    
    // Check central directory size
    if (state.m_central_dir.len() as u64 
        + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as u64 
        + archive_name_size as u64 
        + MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE as u64 
        + comment_size as u64) >= MZ_UINT32_MAX 
    {
        return mz_zip_set_error(zip, MZ_ZIP_UNSUPPORTED_CDIR_SIZE);
    }
    
    // Check archive size for non-zip64
    if !state.m_zip64 {
        let estimated_size = zip.m_archive_size 
            + num_alignment_padding_bytes as u64
            + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64
            + archive_name_size as u64
            + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as u64
            + archive_name_size as u64
            + comment_size as u64
            + user_extra_data_len as u64
            + state.m_central_dir.len() as u64
            + MZ_ZIP_DATA_DESCRIPTER_SIZE32 as u64
            + user_extra_data_central_len as u64
            + 1024;
            
        if estimated_size > 0xFFFFFFFF {
            state.m_zip64 = true;
        }
    }
    
    let (dos_time, dos_date) = if let Some(ftime) = file_time {
        mz_zip_time_t_to_dos_time(*ftime)
    } else {
        (0, 0)
    };
    
    let method = if max_size > 0 && level > 0 { 8 } else { 0 }; // 8 = DEFLATED
    let local_dir_header_ofs = zip.m_archive_size + num_alignment_padding_bytes as u64;
    
    // Write alignment padding
    if !mz_zip_writer_write_zeros(zip, zip.m_archive_size, num_alignment_padding_bytes) {
        return mz_zip_set_error(zip, MZ_ZIP_FILE_WRITE_FAILED);
