// --- Module: mz_p1 ---
fn mz_tolower(c: u8) -> u8 {
    if c.is_ascii_uppercase() {
        c - b'A' + b'a'
    } else {
        c
    }
}

fn mz_zip_dos_to_time_t(dos_time: i32, dos_date: i32) -> i64 {
    let year = i64::from((dos_date >> 9) & 127) + 1980;
    let month = i64::from((dos_date >> 5) & 15);
    let day = i64::from(dos_date & 31);
    let hour = i64::from((dos_time >> 11) & 31);
    let min = i64::from((dos_time >> 5) & 63);
    let sec = i64::from((dos_time << 1) & 62);

    let mut y = year;
    let mut m = month;

    if m <= 2 {
        y -= 1;
        m += 12;
    }

    let days = 365 * y + y / 4 - y / 100 + y / 400 + (153 * (m - 3) + 2) / 5 + day - 719469;

    days * 86400 + hour * 3600 + min * 60 + sec
}

fn mz_zip_time_t_to_dos_time(time: i64) -> (u16, u16) {
    if time < 0 {
        return (0, 0);
    }

    let secs = time % 86400;
    let mut days = time / 86400;

    let hour = (secs / 3600) as i32;
    let min = ((secs % 3600) / 60) as i32;
    let sec = (secs % 60) as i32;

    let mut y: i32 = 1970;
    loop {
        let days_in_year: i64 = if y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) { 366 } else { 365 };
        if days < days_in_year { break; }
        days -= days_in_year;
        y += 1;
    }

    let leap = y % 4 == 0 && (y % 100 != 0 || y % 400 == 0);
    let month_days: [i64; 12] = [31, if leap { 29 } else { 28 }, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

    let mut m: i32 = 0;
    for i in 0..12 {
        if days < month_days[i] { m = i as i32; break; }
        days -= month_days[i];
        if i == 11 { m = 11; }
    }

    let day = days as i32 + 1;
    let mon = m + 1;

    let dos_time = ((hour << 11) + (min << 5) + (sec >> 1)) as u16;
    let dos_date = (((y - 1980) << 9) + (mon << 5) + day) as u16;

    (dos_time, dos_date)
}

