const MZ_ZIP_LOCAL_DIR_HEADER_SIZE: usize = 30;
const MZ_ZIP_LOCAL_DIR_HEADER_SIG: u32 = 0x04034b50;
const MZ_ZIP_DOS_DIR_ATTRIBUTE_BITFLAG: u32 = 0x10;
const MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_IS_ENCRYPTED: u16 = 1;
const MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_USES_STRONG_ENCRYPTION: u16 = 0x0040;
const MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_COMPRESSED_PATCH_FLAG: u16 = 0x0020;
const MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID: u16 = 0x0001;
const MZ_DEFLATED: u16 = 8;
const MZ_ZIP_FLAG_DO_NOT_SORT_CENTRAL_DIRECTORY: u32 = 0x0800;
const MZ_ZIP_FLAG_IGNORE_PATH: u32 = 0x2000;
const MZ_ZIP_FLAG_CASE_SENSITIVE: u32 = 0x0100;
