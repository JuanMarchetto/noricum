    pub zip64_has_extended_info_fields: bool,
    pub pfile: Option<std::fs::File>,
    pub file_archive_start_ofs: u64,
    pub pmem: Option<Vec<u8>>,
    pub mem_size: usize,
    pub mem_capacity: usize,
}

