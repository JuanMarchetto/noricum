fn mz_zip_writer_add_put_buf_callback(pBuf: &[u8], len: i32, pUser: &mut WriterAddState) -> bool {
    let write_func = pUser.m_pZip.m_pWrite.unwrap();
    let io_opaque = pUser.m_pZip.m_pIO_opaque.as_mut().unwrap();
    
    match write_func(io_opaque, pUser.m_cur_archive_file_ofs, &pBuf[..len as usize]) {
        Ok(written) if written == len as usize => {
            pUser.m_cur_archive_file_ofs += written as u64;
            pUser.m_comp_size += written as u64;
            true
        }
        _ => false,
    }
}

fn mz_zip_writer_create_zip64_extra_data(
    pBuf: &mut [u8],
    pUncomp_size: Option<&mut u64>,
    pComp_size: Option<&mut u64>,
    pLocal_header_ofs: Option<&mut u64>,
) -> u32 {
    let mut pDst = pBuf;
    let mut field_size = 0;

    mz_write_le16(&mut pDst[0..2], MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID);
    mz_write_le16(&mut pDst[2..4], 0);
    pDst = &mut pDst[4..];

    if let Some(size) = pUncomp_size {
        mz_write_le64(&mut pDst[0..8], *size);
        pDst = &mut pDst[8..];
        field_size += 8;
    }

    if let Some(size) = pComp_size {
        mz_write_le64(&mut pDst[0..8], *size);
        pDst = &mut pDst[8..];
        field_size += 8;
    }

    if let Some(ofs) = pLocal_header_ofs {
        mz_write_le64(&mut pDst[0..8], *ofs);
        pDst = &mut pDst[8..];
        field_size += 8;
    }

    mz_write_le16(&mut pBuf[2..4], field_size as u16);
    (pDst.as_ptr() as usize - pBuf.as_ptr() as usize) as u32
}

fn mz_zip_writer_create_local_dir_header(
    pZip: &ZipArchive,
    pDst: &mut [u8],
    filename_size: u16,
    extra_size: u16,
    uncomp_size: u64,
    comp_size: u64,
    uncomp_crc32: u32,
    method: u16,
    bit_flags: u16,
    dos_time: u16,
    dos_date: u16,
) -> bool {
    pDst[..MZ_ZIP_LOCAL_DIR_HEADER_SIZE].fill(0);
    
    mz_write_le32(&mut pDst[MZ_ZIP_LDH_SIG_OFS..], MZ_ZIP_LOCAL_DIR_HEADER_SIG);
    mz_write_le16(&mut pDst[MZ_ZIP_LDH_VERSION_NEEDED_OFS..], if method != 0 { 20 } else { 0 });
    mz_write_le16(&mut pDst[MZ_ZIP_LDH_BIT_FLAG_OFS..], bit_flags);
    mz_write_le16(&mut pDst[MZ_ZIP_LDH_METHOD_OFS..], method);
    mz_write_le16(&mut pDst[MZ_ZIP_LDH_FILE_TIME_OFS..], dos_time);
    mz_write_le16(&mut pDst[MZ_ZIP_LDH_FILE_DATE_OFS..], dos_date);
    mz_write_le32(&mut pDst[MZ_ZIP_LDH_CRC32_OFS..], uncomp_crc32);
    mz_write_le32(&mut pDst[MZ_ZIP_LDH_COMPRESSED_SIZE_OFS..], mz_min(comp_size, MZ_UINT32_MAX) as u32);
    mz_write_le32(&mut pDst[MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS..], mz_min(uncomp_size, MZ_UINT32_MAX) as u32);
    mz_write_le16(&mut pDst[MZ_ZIP_LDH_FILENAME_LEN_OFS..], filename_size);
    mz_write_le16(&mut pDst[MZ_ZIP_LDH_EXTRA_LEN_OFS..], extra_size);
    
    true
}

fn mz_zip_writer_create_central_dir_header(
    pZip: &ZipArchive,
    pDst: &mut [u8],
    filename_size: u16,
    extra_size: u16,
    comment_size: u16,
    uncomp_size: u64,
    comp_size: u64,
    uncomp_crc32: u32,
    method: u16,
    bit_flags: u16,
    dos_time: u16,
    dos_date: u16,
    local_header_ofs: u64,
    ext_attributes: u32,
) -> bool {
    pDst[..MZ_ZIP_CENTRAL_DIR_HEADER_SIZE].fill(0);
    
    mz_write_le32(&mut pDst[MZ_ZIP_CDH_SIG_OFS..], MZ_ZIP_CENTRAL_DIR_HEADER_SIG);
    mz_write_le16(&mut pDst[MZ_ZIP_CDH_VERSION_NEEDED_OFS..], if method != 0 { 20 } else { 0 });
    mz_write_le16(&mut pDst[MZ_ZIP_CDH_BIT_FLAG_OFS..], bit_flags);
    mz_write_le16(&mut pDst[MZ_ZIP_CDH_METHOD_OFS..], method);
    mz_write_le16(&mut pDst[MZ_ZIP_CDH_FILE_TIME_OFS..], dos_time);
    mz_write_le16(&mut pDst[MZ_ZIP_CDH_FILE_DATE_OFS..], dos_date);
    mz_write_le32(&mut pDst[MZ_ZIP_CDH_CRC32_OFS..], uncomp_crc32);
    mz_write_le32(&mut pDst[MZ_ZIP_CDH_COMPRESSED_SIZE_OFS..], mz_min(comp_size, MZ_UINT32_MAX) as u32);
    mz_write_le32(&mut pDst[MZ_ZIP_CDH_DECOMPRESSED_SIZE_OFS..], mz_min(uncomp_size, MZ_UINT32_MAX) as u32);
    mz_write_le16(&mut pDst[MZ_ZIP_CDH_FILENAME_LEN_OFS..], filename_size);
    mz_write_le16(&mut pDst[MZ_ZIP_CDH_EXTRA_LEN_OFS..], extra_size);
    mz_write_le16(&mut pDst[MZ_ZIP_CDH_COMMENT_LEN_OFS..], comment_size);
    mz_write_le32(&mut pDst[MZ_ZIP_CDH_EXTERNAL_ATTR_OFS..], ext_attributes);
    mz_write_le32(&mut pDst[MZ_ZIP_CDH_LOCAL_HEADER_OFS..], mz_min(local_header_ofs, MZ_UINT32_MAX) as u32);
    
    true
}

fn mz_zip_writer_validate_archive_name(pArchive_name: &str) -> bool {
    // Basic validity checks
    !pArchive_name.starts_with('/')
}

fn mz_zip_writer_compute_padding_needed_for_file_alignment(pZip: &ZipArchive) -> u32 {
    if pZip.m_file_offset_alignment == 0 {
        return 0;
    }
    let n = (pZip.m_archive_size & (pZip.m_file_offset_alignment as u64 - 1)) as u32;
    (pZip.m_file_offset_alignment - n) & (pZip.m_file_offset_alignment - 1)
}

fn mz_zip_writer_write_zeros(pZip: &mut ZipArchive, cur_file_ofs: u64, n: u32) -> bool {
    let mut buf = [0u8; 4096];
    let mut remaining = n;
    let mut current_ofs = cur_file_ofs;
    
    while remaining > 0 {
        let to_write = mz_min(buf.len(), remaining as usize);
        let write_func = pZip.m_pWrite.unwrap();
        let io_opaque = pZip.m_pIO_opaque.as_mut().unwrap();
        
        match write_func(io_opaque, current_ofs, &buf[..to_write]) {
            Ok(written) if written == to_write => {
                current_ofs += written as u64;
                remaining -= written as u32;
            }
            _ => return false,
        }
    }
    
    true
}

struct WriterAddState {
    m_pZip: *mut ZipArchive,
    m_cur_archive_file_ofs: u64,
