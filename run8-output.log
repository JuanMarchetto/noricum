// Constants from the original C code
const MZ_ZIP_DATA_DESCRIPTER_SIZE64: usize = 24;
const MZ_ZIP_DATA_DESCRIPTER_SIZE32: usize = 16;

// Field offsets

const MZ_ZIP_LDH_SIG_OFS: usize = 0;
const MZ_ZIP_LDH_VERSION_NEEDED_OFS: usize = 4;
const MZ_ZIP_LDH_BIT_FLAG_OFS: usize = 6;
const MZ_ZIP_LDH_METHOD_OFS: usize = 8;
const MZ_ZIP_LDH_FILE_TIME_OFS: usize = 10;
const MZ_ZIP_LDH_FILE_DATE_OFS: usize = 12;
const MZ_ZIP_LDH_CRC32_OFS: usize = 14;
const MZ_ZIP_LDH_COMPRESSED_SIZE_OFS: usize = 18;
const MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS: usize = 22;
const MZ_ZIP_LDH_BIT_FLAG_HAS_LOCATOR: u16 = 1 << 3;
const MZ_ZIP_DOS_DIR_ATTRIBUTE_BITFLAG: u32 = 0x10;
const MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_UTF8: u16 = 1 << 11;

const MZ_ZIP64_MAX_LOCAL_EXTRA_FIELD_SIZE: usize = 2 * 2 + 8 * 2;
const MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE: usize = 2 * 2 + 8 * 3;

const MZ_UINT32_MAX: u64 = 0xFFFFFFFF;
const MZ_UINT16_MAX: u32 = 0xFFFF;

// Type definitions

// Error types
#[derive(Debug)]

// Result type
type ZipResult<T> = Result<T, ZipError>;

// Struct definitions
pub struct ZipArray<T> {
    data: Vec<T>,
    element_size: usize,
}

impl<T> ZipArray<T> {
    pub fn new(element_size: usize) -> Self {
        Self {
            data: Vec::new(),
            element_size,
        }
    }

    pub fn push_back(&mut self, item: T) {
        self.data.push(item);
    }

    pub fn size(&self) -> usize {
        self.data.len()
    }

    pub fn clear(&mut self) {
        self.data.clear();
    }

    pub fn resize(&mut self, new_size: usize) {
        self.data.resize_with(new_size, || unsafe { mem::zeroed() });
    }

    pub fn ensure_room(&mut self, additional: usize) -> bool {
        let needed = self.data.len() + additional;
        if needed > self.data.capacity() {
            self.data.reserve(needed - self.data.capacity());
        }
        true
    }
}


pub trait ReadWriteSeek: Read + Write + Seek {}
impl<T: Read + Write + Seek> ReadWriteSeek for T {}


#[derive(PartialEq)]

#[derive(PartialEq)]

// Helper functions for little-endian writing
fn mz_write_le16(p: &mut [u8], v: u16) {
    p[0] = v as u8;
    p[1] = (v >> 8) as u8;
}

fn mz_write_le32(p: &mut [u8], v: u32) {
    p[0] = v as u8;
    p[1] = (v >> 8) as u8;
    p[2] = (v >> 16) as u8;
    p[3] = (v >> 24) as u8;
}

fn mz_write_le64(p: &mut [u8], v: u64) {
    mz_write_le32(&mut p[0..4], v as u32);
    mz_write_le32(&mut p[4..8], (v >> 32) as u32);
}

fn mz_min<T: PartialOrd>(a: T, b: T) -> T {
    if a < b { a } else { b }
}

fn mz_zip_set_error(_pZip: &mut ZipArchive, error: ZipError) -> mz_bool {
    // In Rust, we return Result instead of setting error codes
    MZ_FALSE
}

// File I/O functions (platform-independent in Rust)
fn mz_zip_file_write_func(pIO_opaque: &mut dyn std::any::Any, file_ofs: u64, pBuf: &[u8]) -> io::Result<usize> {
    if let Some(file) = pIO_opaque.downcast_mut::<&mut dyn ReadWriteSeek>() {
        file.seek(SeekFrom::Start(file_ofs))?;
        file.write(pBuf)
    } else {
        Err(io::Error::new(io::ErrorKind::Other, "Invalid IO opaque"))
    }
}


fn mz_zip_heap_write_func(pIO_opaque: &mut dyn std::any::Any, file_ofs: u64, pBuf: &[u8]) -> io::Result<usize> {
    if let Some(vec) = pIO_opaque.downcast_mut::<&mut Vec<u8>>() {
        let end_pos = file_ofs as usize + pBuf.len();
        if end_pos > vec.len() {
            vec.resize(end_pos, 0);
        }
        vec[file_ofs as usize..end_pos].copy_from_slice(pBuf);
        Ok(pBuf.len())
    } else {
        Err(io::Error::new(io::ErrorKind::Other, "Invalid IO opaque"))
    }
}

