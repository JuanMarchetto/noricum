// ============ Utility functions ============
pub(crate) fn mz_tolower(c: u8) -> u8 {
    if (b'A'..=b'Z').contains(&c) {
        c - b'A' + b'a'
    } else {
        c
    }
}

pub(crate) fn swap_u32(a: &mut u32, b: &mut u32) {
    std::mem::swap(a, b);
}

