pub fn mz_file_read_func_stdio(
    pOpaque: *mut std::ffi::c_void,
    file_ofs: mz_uint64,
    pBuf: *mut u8,
    n: usize,
) -> usize {
    unsafe {
        // Assuming pOpaque is a FILE* (wrapped as *mut libc::FILE in real implementation)
        // For now, we'll implement a simplified version that reads from a Rust File
        let file = &mut *(pOpaque as *mut File);
        
        if file.seek(SeekFrom::Start(file_ofs)).is_err() {
            return 0;
        }
        
        let slice = std::slice::from_raw_parts_mut(pBuf, n);
        match file.read(slice) {
            Ok(bytes_read) => bytes_read,
            Err(_) => 0,
        }
    }
}

pub fn mz_zip_writer_add_file(
    pZip: &mut mz_zip_archive,
    pArchive_name: &str,
    pSrc_filename: &str,
    pComment: Option<&[u8]>,
    comment_size: mz_uint16,
    level_and_flags: mz_uint,
) -> mz_bool {
    let mut src_file = match File::open(pSrc_filename) {
        Ok(file) => file,
        Err(_) => return mz_zip_set_error(pZip, ZipError::FileOpenFailed),
    };

    // Get file size
    let uncomp_size = match src_file.metadata() {
        Ok(metadata) => metadata.len(),
        Err(_) => return mz_zip_set_error(pZip, ZipError::FileStatFailed),
    };

    // Get file modified time
    let mut file_modified_time = SystemTime::now();
    #[cfg(not(any(feature = "no_time", feature = "no_stdio")))]
    {
        if !mz_zip_get_file_modified_time(pSrc_filename, &mut file_modified_time) {
            return mz_zip_set_error(pZip, ZipError::FileStatFailed);
        }
    }

    let pFile_time = Some(&file_modified_time);

    // Convert to raw pointer for the callback
    let src_file_ptr = &mut src_file as *mut File as *mut std::ffi::c_void;

    let result = mz_zip_writer_add_read_buf_callback(
        pZip,
        pArchive_name,
        mz_file_read_func_stdio,
        src_file_ptr,
        uncomp_size,
        pFile_time,
        pComment.unwrap_or(&[]),
        comment_size,
        level_and_flags,
        &[],
        0,
        &[],
        0,
    );

    result
}

fn mz_zip_writer_add_read_buf_callback(
    pZip: &mut mz_zip_archive,
    pArchive_name: &str,
    read_callback: mz_file_read_func,
    callback_opaque: *mut std::ffi::c_void,
    max_size: mz_uint64,
    pFile_time: Option<&MZ_TIME_T>,
    pComment: &[u8],
    comment_size: mz_uint16,
    level_and_flags: mz_uint,
    user_extra_data: &[u8],
    user_extra_data_len: mz_uint,
    user_extra_data_central: &[u8],
    user_extra_data_central_len: mz_uint,
) -> mz_bool {
    let gen_flags: mz_uint16;
    let mut uncomp_crc32 = 0u32;
    let level: mz_uint;
    let num_alignment_padding_bytes: mz_uint32;
    let mut method: mz_uint16 = 0;
    let mut dos_time: mz_uint16 = 0;
    let mut dos_date: mz_uint16 = 0;
    let ext_attributes: mz_uint32 = 0;
    let mut local_dir_header_ofs: mz_uint64;
    let mut cur_archive_file_ofs = pZip.m_archive_size;
    let mut uncomp_size: mz_uint64 = 0;
    let mut comp_size: mz_uint64 = 0;
    let archive_name_size = pArchive_name.len();
    let mut local_dir_header = [0u8; MZ_ZIP_LOCAL_DIR_HEADER_SIZE];
    let mut pExtra_data: Option<&[u8]> = None;
    let mut extra_size: mz_uint32 = 0;
    let mut extra_data = [0u8; MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE];
    let mut file_ofs: mz_uint64 = 0;
    let mut cur_archive_header_file_ofs: mz_uint64;

    let level_and_flags = if (level_and_flags as i32) < 0 {
        MZ_DEFAULT_LEVEL
    } else {
        level_and_flags
    };
    
    level = level_and_flags & 0xF;

    gen_flags = if (level_and_flags & MZ_ZIP_FLAG_WRITE_HEADER_SET_SIZE) != 0 {
        0
    } else {
        MZ_ZIP_LDH_BIT_FLAG_HAS_LOCATOR
    };

    let gen_flags = if (level_and_flags & MZ_ZIP_FLAG_ASCII_FILENAME) != 0 {
        gen_flags
    } else {
        gen_flags | MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_UTF8
    };

    // Sanity checks
    if pZip.m_zip_mode != /* MZ_ZIP_MODE_WRITING */ 1 
        || pArchive_name.is_empty() 
        || (comment_size > 0 && pComment.is_empty())
        || level > MZ_UBER_COMPRESSION 
    {
        return mz_zip_set_error(pZip, ZipError::InvalidParameter);
    }

    let pState = match &mut pZip.m_pState {
        Some(state) => state,
        None => return mz_zip_set_error(pZip, ZipError::InvalidParameter),
    };

    if !pState.m_zip64 && max_size > MZ_UINT32_MAX {
        pState.m_zip64 = true;
    }

    if (level_and_flags & MZ_ZIP_FLAG_COMPRESSED_DATA) != 0 {
        return mz_zip_set_error(pZip, ZipError::InvalidParameter);
    }

    if !mz_zip_writer_validate_archive_name(pArchive_name) {
        return mz_zip_set_error(pZip, ZipError::InvalidFilename);
    }

    if pState.m_zip64 {
        if pZip.m_total_files == u32::MAX {
            return mz_zip_set_error(pZip, ZipError::TooManyFiles);
        }
    } else {
        if pZip.m_total_files == MZ_UINT16_MAX {
            pState.m_zip64 = true;
        }
    }

    if archive_name_size > u16::MAX as usize {
        return mz_zip_set_error(pZip, ZipError::InvalidFilename);
    }

    num_alignment_padding_bytes = mz_zip_writer_compute_padding_needed_for_file_alignment(pZip);

    // Check central directory size
    if (pState.m_central_dir.m_size as u64 + 46 + archive_name_size as u64 
        + MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE as u64 + comment_size as u64) >= u32::MAX as u64 
    {
        return mz_zip_set_error(pZip, ZipError::UnsupportedCdirSize);
    }

    if !pState.m_zip64 {
        // Check if archive would become too large
        let total_size = pZip.m_archive_size + num_alignment_padding_bytes as u64 + 30 
            + archive_name_size as u64 + 46 + archive_name_size as u64 + comment_size as u64 
            + user_extra_data_len as u64 + pState.m_central_dir.m_size as u64 + 22 + 1024 
            + 16 + user_extra_data_central_len as u64;
        
        if total_size > 0xFFFFFFFF {
            pState.m_zip64 = true;
        }
    }

    #[cfg(not(feature = "no_time"))]
    {
        if let Some(file_time) = pFile_time {
            mz_zip_time_t_to_dos_time(*file_time, &mut dos_time, &mut dos_date);
        }
    }

    if max_size <= 3 {
        // level = 0; // Already set
    }

    if !mz_zip_writer_write_zeros(pZip, cur_archive_file_ofs, num_alignment_padding_bytes) {
        return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
    }

    cur_archive_file_ofs += num_alignment_padding_bytes as u64;
    local_dir_header_ofs = cur_archive_file_ofs;

    if pZip.m_file_offset_alignment != 0 {
        // Assert alignment
        debug_assert!((cur_archive_file_ofs & (pZip.m_file_offset_alignment as u64 - 1)) == 0);
    }

    if max_size > 0 && level > 0 {
        method = MZ_DEFLATED;
    }

    local_dir_header.fill(0);
    
    if pState.m_zip64 {
        if max_size >= MZ_UINT32_MAX || local_dir_header_ofs >= MZ_UINT32_MAX {
            pExtra_data = Some(&extra_data);
            if (level_and_flags & MZ_ZIP_FLAG_WRITE_HEADER_SET_SIZE) != 0 {
                let uncomp_ptr = if max_size >= MZ_UINT32_MAX { Some(&mut uncomp_size) } else { None };
                let comp_ptr = if max_size >= MZ_UINT32_MAX { Some(&mut comp_size) } else { None };
                let header_ofs_ptr = if local_dir_header_ofs >= MZ_UINT32_MAX { Some(&mut local_dir_header_ofs) } else { None };
                
                extra_size = mz_zip_writer_create_zip64_extra_data(
                    &mut extra_data,
                    uncomp_ptr,
                    comp_ptr,
                    header_ofs_ptr,
                ) as u32;
            } else {
                let header_ofs_ptr = if local_dir_header_ofs >= MZ_UINT32_MAX { Some(&mut local_dir_header_ofs) } else { None };
                
                extra_size = mz_zip_writer_create_zip64_extra_data(
                    &mut extra_data,
                    None,
                    None,
                    header_ofs_ptr,
                ) as u32;
            }
        }

        if !mz_zip_writer_create_local_dir_header(
            pZip,
            &mut local_dir_header,
            archive_name_size as u16,
            (extra_size + user_extra_data_len as u32) as u16,
            0,
            0,
            0,
            method,
            gen_flags,
            dos_time,
            dos_date,
        ) {
            return mz_zip_set_error(pZip, ZipError::InternalError);
        }

        let write_func = pZip.m_pWrite;
        if write_func(pZip, cur_archive_file_ofs, &local_dir_header) != local_dir_header.len() {
            return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
        }

        cur_archive_file_ofs += local_dir_header.len() as u64;

        if write_func(pZip, cur_archive_file_ofs, pArchive_name.as_bytes()) != archive_name_size {
            return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
        }

        cur_archive_file_ofs += archive_name_size as u64;

        if extra_size > 0 {
            if write_func(pZip, cur_archive_file_ofs, &extra_data[..extra_size as usize]) != extra_size as usize {
                return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
            }
            cur_archive_file_ofs += extra_size as u64;
        }
    } else {
        if comp_size > MZ_UINT32_MAX || cur_archive_file_ofs > MZ_UINT32_MAX {
            return mz_zip_set_error(pZip, ZipError::ArchiveTooLarge);
        }
        
        if !mz_zip_writer_create_local_dir_header(
            pZip,
            &mut local_dir_header,
            archive_name_size as u16,
            user_extra_data_len as u16,
            0,
            0,
            0,
            method,
            gen_flags,
            dos_time,
            dos_date,
        ) {
            return mz_zip_set_error(pZip, ZipError::InternalError);
        }

        let write_func = pZip.m_pWrite;
        if write_func(pZip, cur_archive_file_ofs, &local_dir_header) != local_dir_header.len() {
            return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
        }

        cur_archive_file_ofs += local_dir_header.len() as u64;

        if write_func(pZip, cur_archive_file_ofs, pArchive_name.as_bytes()) != archive_name_size {
            return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
        }

        cur_archive_file_ofs += archive_name_size as u64;
    }

    if user_extra_data_len > 0 {
        let write_func = pZip.m_pWrite;
        if write_func(pZip, cur_archive_file_ofs, user_extra_data) != user_extra_data_len as usize {
            return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
        }
        cur_archive_file_ofs += user_extra_data_len as u64;
    }

    if max_size > 0 {
        // Allocate read buffer
        let alloc_func = pZip.m_pAlloc;
        let pRead_buf = alloc_func(pZip.m_pAlloc_opaque, 1, MZ_ZIP_MAX_IO_BUF_SIZE);
        
        if pRead_buf.is_null() {
            return mz_zip_set_error(pZip, ZipError::AllocFailed);
        }

        if level == 0 {
            // Store without compression
            loop {
                let n = unsafe {
                    read_callback(
                        callback_opaque,
                        file_ofs,
                        pRead_buf as *mut u8,
                        MZ_ZIP_MAX_IO_BUF_SIZE,
                    )
                };
                
                if n == 0 {
                    break;
                }

                if n > MZ_ZIP_MAX_IO_BUF_SIZE || file_ofs + n as u64 > max_size {
                    let free_func = pZip.m_pFree;
                    free_func(pZip.m_pAlloc_opaque, pRead_buf);
                    return mz_zip_set_error(pZip, ZipError::FileReadFailed);
                }
                
                let write_func = pZip.m_pWrite;
                let slice = unsafe { std::slice::from_raw_parts(pRead_buf as *const u8, n) };
                if write_func(pZip, cur_archive_file_ofs, slice) != n {
                    let free_func = pZip.m_pFree;
                    free_func(pZip.m_pAlloc_opaque, pRead_buf);
                    return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
                }
                
                file_ofs += n as u64;
                uncomp_crc32 = mz_crc32(uncomp_crc32, slice);
                cur_archive_file_ofs += n as u64;
            }
            
            uncomp_size = file_ofs;
            comp_size = uncomp_size;
        } else {
            // Compress the data
            let mut result = false;
            
            // Allocate compressor
            let alloc_func = pZip.m_pAlloc;
            let pComp = alloc_func(pZip.m_pAlloc_opaque, 1, std::mem::size_of::<tdefl_compressor>()) as *mut tdefl_compressor;
            
            if pComp.is_null() {
                let free_func = pZip.m_pFree;
                free_func(pZip.m_pAlloc_opaque, pRead_buf);
                return mz_zip_set_error(pZip, ZipError::AllocFailed);
            }
            
            let mut state = mz_zip_writer_add_state {
                m_pZip: pZip as *mut mz_zip_archive,
                m_cur_archive_file_ofs: cur_archive_file_ofs,
                m_comp_size: 0,
            };
            
            let state_ptr = &mut state as *mut mz_zip_writer_add_state as *mut std::ffi::c_void;
            unsafe {
                if tdefl_init(
                    &mut *pComp,
                    mz_zip_writer_add_put_buf_callback,
                    state_ptr,
                    tdefl_create_comp_flags_from_zip_params(level, -15, /* MZ_DEFAULT_STRATEGY */ 0),
                ) != 0 // TDEFL_STATUS_OKAY
                {
                    let free_func = pZip.m_pFree;
                    free_func(pZip.m_pAlloc_opaque, pComp as *mut std::ffi::c_void);
                    free_func(pZip.m_pAlloc_opaque, pRead_buf);
                    return mz_zip_set_error(pZip, ZipError::InternalError);
                }
            }
            
            loop {
                let n = unsafe {
                    read_callback(
                        callback_opaque,
                        file_ofs,
                        pRead_buf as *mut u8,
                        MZ_ZIP_MAX_IO_BUF_SIZE,
                    )
                };
                
                if n > MZ_ZIP_MAX_IO_BUF_SIZE || file_ofs + n as u64 > max_size {
                    mz_zip_set_error(pZip, ZipError::FileReadFailed);
                    break;
                }
                
                file_ofs += n as u64;
                
                let slice = unsafe { std::slice::from_raw_parts(pRead_buf as *const u8, n) };
                uncomp_crc32 = mz_crc32(uncomp_crc32, slice);
                
                let mut flush = 0u32; // TDEFL_NO_FLUSH
                
                // Check if keepalive needed
                if let Some(needs_keepalive) = pZip.m_pNeeds_keepalive {
                    if needs_keepalive(pZip.m_pIO_opaque) {
                        flush = 2; // TDEFL_FULL_FLUSH
                    }
                }
                
                if n == 0 {
                    flush = 4; // TDEFL_FINISH
                }
                
                unsafe {
                    let status = tdefl_compress_buffer(&mut *pComp, slice, n, flush);
                    if status == 1 { // TDEFL_STATUS_DONE
                        result = true;
                        break;
                    } else if status != 0 { // TDEFL_STATUS_OKAY
                        mz_zip_set_error(pZip, ZipError::CompressionFailed);
                        break;
                    }
                }
            }
            
            let free_func = pZip.m_pFree;
            free_func(pZip.m_pAlloc_opaque, pComp as *mut std::ffi::c_void);
            
            if !result {
                free_func(pZip.m_pAlloc_opaque, pRead_buf);
                return false;
            }
            
            uncomp_size = file_ofs;
            comp_size = state.m_comp_size;
            cur_archive_file_ofs = state.m_cur_archive_file_ofs;
        }
        
        let free_func = pZip.m_pFree;
        free_func(pZip.m_pAlloc_opaque, pRead_buf);
    }

    if (level_and_flags & MZ_ZIP_FLAG_WRITE_HEADER_SET_SIZE) == 0 {
        let mut local_dir_footer = [0u8; MZ_ZIP_DATA_DESCRIPTER_SIZE64];
        let mut local_dir_footer_size = MZ_ZIP_DATA_DESCRIPTER_SIZE32;

        // Write data descriptor
        local_dir_footer[0..4].copy_from_slice(&MZ_ZIP_DATA_DESCRIPTOR_ID.to_le_bytes());
        local_dir_footer[4..8].copy_from_slice(&uncomp_crc32.to_le_bytes());
        
        if pExtra_data.is_none() {
            if comp_size > MZ_UINT32_MAX {
                return mz_zip_set_error(pZip, ZipError::ArchiveTooLarge);
            }
            local_dir_footer[8..12].copy_from_slice(&(comp_size as u32).to_le_bytes());
            local_dir_footer[12..16].copy_from_slice(&(uncomp_size as u32).to_le_bytes());
        } else {
            local_dir_footer[8..16].copy_from_slice(&comp_size.to_le_bytes());
            local_dir_footer[16..24].copy_from_slice(&uncomp_size.to_le_bytes());
            local_dir_footer_size = MZ_ZIP_DATA_DESCRIPTER_SIZE64;
        }

        let write_func = pZip.m_pWrite;
        if write_func(pZip, cur_archive_file_ofs, &local_dir_footer[..local_dir_footer_size]) != local_dir_footer_size {
            return false;
        }
        cur_archive_file_ofs += local_dir_footer_size as u64;
    }

    if (level_and_flags & MZ_ZIP_FLAG_WRITE_HEADER_SET_SIZE) != 0 {
        if pExtra_data.is_some() {
            let uncomp_ptr = if max_size >= MZ_UINT32_MAX { Some(&mut uncomp_size) } else { None };
            let comp_ptr = if max_size >= MZ_UINT32_MAX { Some(&mut comp_size) } else { None };
            let header_ofs_ptr = if local_dir_header_ofs >= MZ_UINT32_MAX { Some(&mut local_dir_header_ofs) } else { None };
            
            extra_size = mz_zip_writer_create_zip64_extra_data(
                &mut extra_data,
                uncomp_ptr,
                comp_ptr,
                header_ofs_ptr,
            ) as u32;
        }

        if !mz_zip_writer_create_local_dir_header(
            pZip,
            &mut local_dir_header,
            archive_name_size as u16,
            (extra_size + user_extra_data_len as u32) as u16,
            if max_size >= MZ_UINT32_MAX { u32::MAX } else { uncomp_size as u32 },
            if max_size >= MZ_UINT32_MAX { u32::MAX } else { comp_size as u32 },
            uncomp_crc32,
            method,
            gen_flags,
            dos_time,
            dos_date,
        ) {
            return mz_zip_set_error(pZip, ZipError::InternalError);
        }

        cur_archive_header_file_ofs = local_dir_header_ofs;
        let write_func = pZip.m_pWrite;
        
        if write_func(pZip, cur_archive_header_file_ofs, &local_dir_header) != local_dir_header.len() {
            return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
        }

        if pExtra_data.is_some() {
            cur_archive_header_file_ofs += local_dir_header.len() as u64;
            
            if write_func(pZip, cur_archive_header_file_ofs, pArchive_name.as_bytes()) != archive_name_size {
                return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
            }
            
            cur_archive_header_file_ofs += archive_name_size as u64;
            
            if write_func(pZip, cur_archive_header_file_ofs, &extra_data[..extra_size as usize]) != extra_size as usize {
                return mz_zip_set_error(pZip, ZipError::FileWriteFailed);
            }
            
            cur_archive_header_file_ofs += extra_size as u64;
        }
    }

    if pExtra_data.is_some() {
        let uncomp_ptr = if uncomp_size >= MZ_UINT32_MAX { Some(&mut uncomp_size) } else { None };
        let comp_ptr = if uncomp_size >= MZ_UINT32_MAX { Some(&mut comp_size) } else { None };
        let header_ofs_ptr = if local_dir_header_ofs >= MZ_UINT32_MAX { Some(&mut local_dir_header_ofs) } else { None };
        
        extra_size = mz_zip_writer_create_zip64_extra_data(
            &mut extra_data,
            uncomp_ptr,
            comp_ptr,
            header_ofs_ptr,
        ) as u32;
    }

    if !mz_zip_writer_add_to_central_dir(
        pZip,
        pArchive_name,
        archive_name_size as u16,
        if extra_size > 0 { &extra_data[..extra_size as usize] } else { &[] },
        extra_size as u16,
        pComment,
        comment_size,
        uncomp_size,
        comp_size,
        uncomp_crc32,
        method,
        gen_flags,
        dos_time,
        dos_date,
        local_dir_header_ofs,
        ext_attributes,
        user_extra_data_central,
        user_extra_data_central_len,
    ) {
        return false;
    }

    pZip.m_total_files += 1;
    pZip.m_archive_size = cur_archive_file_ofs;

    true
}

pub fn mz_zip_writer_update_zip64_extension_block(
    pNew_ext: &mut mz_zip_array,
    pZip: &mut mz_zip_archive,
    pExt: Option<&[u8]>,
    ext_len: mz_uint32,
    pComp_size: Option<&mut mz_uint64>,
    pUncomp_size: Option<&mut mz_uint64>,
    pLocal_header_ofs: Option<&mut mz_uint64>,
    pDisk_start: Option<&mut mz_uint32>,
) -> mz_bool {
    // Reserve space (+64 for any new zip64 data)
    if !mz_zip_array_reserve(pZip, pNew_ext, ext_len as usize + 64, false) {
        return mz_zip_set_error(pZip, ZipError::AllocFailed);
    }

    mz_zip_array_resize(pZip, pNew_ext, 0, false);

    if pUncomp_size.is_some() || pComp_size.is_some() || pLocal_header_ofs.is_some() || pDisk_start.is_some() {
        let mut new_ext_block = [0u8; 64];
        let mut pDst = 0;

        // Header ID
        new_ext_block[pDst..pDst + 2].copy_from_slice(&MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID.to_le_bytes());
        pDst += 2;
        
        // Data size (placeholder)
        new_ext_block[pDst..pDst + 2].copy_from_slice(&0u16.to_le_bytes());
        pDst += 2;

        if let Some(uncomp_size) = pUncomp_size {
            new_ext_block[pDst..pDst + 8].copy_from_slice(&uncomp_size.to_le_bytes());
            pDst += 8;
        }

        if let Some(comp_size) = pComp_size {
            new_ext_block[pDst..pDst + 8].copy_from_slice(&comp_size.to_le_bytes());
            pDst += 8;
        }

        if let Some(local_header_ofs) = pLocal_header_ofs {
            new_ext_block[pDst..pDst + 8].copy_from_slice(&local_header_ofs.to_le_bytes());
            pDst += 8;
        }

        if let Some(disk_start) = pDisk_start {
            new_ext_block[pDst..pDst + 4].copy_from_slice(&disk_start.to_le_bytes());
            pDst += 4;
        }

        // Update data size
        let data_size = (pDst - 4) as u16; // Subtract header ID and size fields
        new_ext_block[2..4].copy_from_slice(&data_size.to_le_bytes());

        if !mz_zip_array_push_back(pZip, pNew_ext, &new_ext_block[..pDst], pDst) {
            return mz_zip_set_error(pZip, ZipError::AllocFailed);
        }
    }

    if let Some(pExt) = pExt {
        let mut extra_size_remaining = ext_len as usize;
        let mut pExtra_data = pExt;

        while extra_size_remaining > 0 {
            if extra_size_remaining < 4 {
                return mz_zip_set_error(pZip, ZipError::InvalidHeaderOrCorrupted);
            }

            let field_id = u16::from_le_bytes([pExtra_data[0], pExtra_data[1]]);
            let field_data_size = u16::from_le_bytes([pExtra_data[2], pExtra_data[3]]) as usize;
            let field_total_size = field_data_size + 4;

            if field_total_size > extra_size_remaining {
                return mz_zip_set_error(pZip, ZipError::InvalidHeaderOrCorrupted);
            }

            if field_id != MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID {
                if !mz_zip_array_push_back(pZip, pNew_ext, &pExtra_data[..field_total_size], field_total_size) {
                    return mz_zip_set_error(pZip, ZipError::AllocFailed);
                }
            }

            pExtra_data = &pExtra_data[field_total_size..];
            extra_size_remaining -= field_total_size;
        }
    }

    true
}

// --- Module: mz_p8 ---
/// Validates a single file in a zip archive
pub fn mz_zip_validate_file(
    zip: &mut MzZipArchive,
    file_index: u32,
    flags: u32,
) -> Result<(), ZipError> {
    let p_state = zip.m_pState.as_mut().ok_or(ZipError::InvalidParameter)?;
    
    if file_index >= zip.m_total_files {
        return Err(ZipError::InvalidParameter);
    }

    let central_dir_header = mz_zip_get_cdh(zip, file_index)?;
    
    let (file_stat, found_zip64_ext_data_in_cdir) = 
        mz_zip_file_stat_internal(zip, file_index, central_dir_header)?;
    
    // A directory or zero length file
    if file_stat.m_is_directory || file_stat.m_uncomp_size == 0 {
        return Ok(());
    }
    
    // Encryption and patch files are not supported
    if file_stat.m_is_encrypted {
        return Err(ZipError::UnsupportedEncryption);
    }
    
    // This function only supports stored and deflate
    if file_stat.m_method != 0 && file_stat.m_method != MZ_DEFLATED {
        return Err(ZipError::UnsupportedMethod);
    }
    
    if !file_stat.m_is_supported {
        return Err(ZipError::UnsupportedFeature);
    }
    
    // Read and parse the local directory entry
    let local_header_ofs = file_stat.m_local_header_ofs;
    let mut local_header_buf = [0u8; MZ_ZIP_LOCAL_DIR_HEADER_SIZE];
    
    if let Some(read_fn) = zip.m_pRead {
        read_fn(
            zip.m_pIO_opaque,
            local_header_ofs,
            &mut local_header_buf,
        )?;
    } else {
        return Err(ZipError::InvalidParameter);
    }
    
    if u32::from_le_bytes(local_header_buf[0..4].try_into().unwrap()) != MZ_ZIP_LOCAL_DIR_HEADER_SIG {
        return Err(ZipError::InvalidHeaderOrCorrupted);
    }
    
    let local_header_filename_len = u16::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_FILENAME_LEN_OFS..MZ_ZIP_LDH_FILENAME_LEN_OFS + 2]
            .try_into().unwrap()
    ) as usize;
    
    let local_header_extra_len = u16::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_EXTRA_LEN_OFS..MZ_ZIP_LDH_EXTRA_LEN_OFS + 2]
            .try_into().unwrap()
    ) as usize;
    
    let mut local_header_comp_size = u32::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_COMPRESSED_SIZE_OFS..MZ_ZIP_LDH_COMPRESSED_SIZE_OFS + 4]
            .try_into().unwrap()
    ) as u64;
    
    let mut local_header_uncomp_size = u32::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS..MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS + 4]
            .try_into().unwrap()
    ) as u64;
    
    let local_header_crc32 = u32::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_CRC32_OFS..MZ_ZIP_LDH_CRC32_OFS + 4]
            .try_into().unwrap()
    );
    
    let local_header_bit_flags = u16::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_BIT_FLAG_OFS..MZ_ZIP_LDH_BIT_FLAG_OFS + 2]
            .try_into().unwrap()
    );
    
    let has_data_descriptor = (local_header_bit_flags & 8) != 0;
    
    if local_header_filename_len != file_stat.m_filename.len() {
        return Err(ZipError::InvalidHeaderOrCorrupted);
    }
    
    if local_header_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + 
       local_header_filename_len as u64 + local_header_extra_len as u64 + 
       file_stat.m_comp_size > zip.m_archive_size {
        return Err(ZipError::InvalidHeaderOrCorrupted);
    }
    
    // Use temporary buffer for filename and extra field
    let max_len = local_header_filename_len.max(local_header_extra_len);
    let mut temp_buf = vec![0u8; max_len];
    
    if local_header_filename_len > 0 {
        if let Some(read_fn) = zip.m_pRead {
            read_fn(
                zip.m_pIO_opaque,
                local_header_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64,
                &mut temp_buf[0..local_header_filename_len],
            )?;
        } else {
            return Err(ZipError::InvalidParameter);
        }
        
        // Compare filename bytes
        if file_stat.m_filename.as_bytes() != &temp_buf[0..local_header_filename_len] {
            return Err(ZipError::ValidationFailed);
        }
    }
    
    let mut found_zip64_ext_data_in_ldir = false;
    
    if local_header_extra_len > 0 && 
       (local_header_comp_size == u32::MAX as u64 || local_header_uncomp_size == u32::MAX as u64) {
        
        if let Some(read_fn) = zip.m_pRead {
            read_fn(
                zip.m_pIO_opaque,
                local_header_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + local_header_filename_len as u64,
                &mut temp_buf[0..local_header_extra_len],
            )?;
        } else {
            return Err(ZipError::InvalidParameter);
        }
        
        let mut extra_data = &temp_buf[0..local_header_extra_len];
        let mut extra_size_remaining = local_header_extra_len;
        
        while extra_size_remaining >= 4 {
            let field_id = u16::from_le_bytes(extra_data[0..2].try_into().unwrap());
            let field_data_size = u16::from_le_bytes(extra_data[2..4].try_into().unwrap()) as usize;
            let field_total_size = field_data_size + 4;
            
            if field_total_size > extra_size_remaining {
                return Err(ZipError::InvalidHeaderOrCorrupted);
            }
            
            if field_id == MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID {
                if field_data_size < 16 { // sizeof(u64) * 2
                    return Err(ZipError::InvalidHeaderOrCorrupted);
                }
                
                local_header_uncomp_size = u64::from_le_bytes(
                    extra_data[4..12].try_into().unwrap()
                );
                local_header_comp_size = u64::from_le_bytes(
                    extra_data[12..20].try_into().unwrap()
                );
                
                found_zip64_ext_data_in_ldir = true;
                break;
            }
            
            extra_data = &extra_data[field_total_size..];
            extra_size_remaining -= field_total_size;
        }
    }
    
    // Check data descriptor or local header values
    if has_data_descriptor && local_header_comp_size == 0 && local_header_crc32 == 0 {
        let num_descriptor_uint32s = if p_state.m_zip64 || found_zip64_ext_data_in_ldir { 6 } else { 4 };
        let descriptor_size = num_descriptor_uint32s * 4;
        let mut descriptor_buf = vec![0u8; descriptor_size];
        
        let descriptor_pos = local_header_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + 
            local_header_filename_len as u64 + local_header_extra_len as u64 + 
            file_stat.m_comp_size;
        
        if let Some(read_fn) = zip.m_pRead {
            read_fn(
                zip.m_pIO_opaque,
                descriptor_pos,
                &mut descriptor_buf,
            )?;
        } else {
            return Err(ZipError::InvalidParameter);
        }
        
        let has_id = u32::from_le_bytes(descriptor_buf[0..4].try_into().unwrap()) == MZ_ZIP_DATA_DESCRIPTOR_ID;
        let src_start = if has_id { 4 } else { 0 };
        
        let file_crc32 = u32::from_le_bytes(
            descriptor_buf[src_start..src_start + 4].try_into().unwrap()
        );
        
        let (comp_size, uncomp_size) = if p_state.m_zip64 || found_zip64_ext_data_in_ldir {
            let comp = u64::from_le_bytes(
                descriptor_buf[src_start + 4..src_start + 12].try_into().unwrap()
            );
            let uncomp = u64::from_le_bytes(
                descriptor_buf[src_start + 12..src_start + 20].try_into().unwrap()
            );
            (comp, uncomp)
        } else {
            let comp = u32::from_le_bytes(
                descriptor_buf[src_start + 4..src_start + 8].try_into().unwrap()
            ) as u64;
            let uncomp = u32::from_le_bytes(
                descriptor_buf[src_start + 8..src_start + 12].try_into().unwrap()
            ) as u64;
            (comp, uncomp)
        };
        
        if file_crc32 != file_stat.m_crc32 || 
           comp_size != file_stat.m_comp_size || 
           uncomp_size != file_stat.m_uncomp_size {
            return Err(ZipError::ValidationFailed);
        }
    } else {
        if local_header_crc32 != file_stat.m_crc32 || 
           local_header_comp_size != file_stat.m_comp_size || 
           local_header_uncomp_size != file_stat.m_uncomp_size {
            return Err(ZipError::ValidationFailed);
        }
    }
    
    // Validate actual file contents if requested
    if (flags & MZ_ZIP_FLAG_VALIDATE_HEADERS_ONLY) == 0 {
        let mut uncomp_crc32 = MZ_CRC32_INIT;
        
        mz_zip_reader_extract_to_callback(
            zip,
            file_index,
            |data: &[u8], context: &mut u32| {
                *context = mz_crc32(*context, data);
                true
            },
            &mut uncomp_crc32,
            0,
        )?;
        
        if uncomp_crc32 != file_stat.m_crc32 {
            return Err(ZipError::ValidationFailed);
        }
    }
    
    Ok(())
}

/// Validates an entire zip archive
pub fn mz_zip_validate_archive(
    zip: &mut MzZipArchive,
    flags: u32,
) -> Result<(), ZipError> {
    let p_state = zip.m_pState.as_mut().ok_or(ZipError::InvalidParameter)?;
    
    // Basic sanity checks
    if !p_state.m_zip64 {
        if zip.m_total_files > u16::MAX as u32 {
            return Err(ZipError::ArchiveTooLarge);
        }
        if zip.m_archive_size > u32::MAX as u64 {
            return Err(ZipError::ArchiveTooLarge);
        }
    } else {
        if p_state.m_central_dir.m_size >= u32::MAX as usize {
            return Err(ZipError::ArchiveTooLarge);
        }
    }
    
    for i in 0..zip.m_total_files {
        if (flags & MZ_ZIP_FLAG_VALIDATE_LOCATE_FILE_FLAG) != 0 {
            let stat = mz_zip_reader_file_stat(zip, i)?;
            
            let found_index = mz_zip_reader_locate_file_v2(
                zip,
                &stat.m_filename,
                None,
                0,
            )?;
            
            // Check for duplicate filenames
            if found_index != i {
                return Err(ZipError::ValidationFailed);
            }
        }
        
        mz_zip_validate_file(zip, i, flags)?;
    }
    
    Ok(())
}

/// Validates a memory-based zip archive
pub fn mz_zip_validate_mem_archive(
    p_mem: &[u8],
    flags: u32,
) -> Result<(), ZipError> {
    if p_mem.is_empty() {
        return Err(ZipError::InvalidParameter);
    }
    
    let mut zip = MzZipArchive::default();
    
    mz_zip_reader_init_mem(&mut zip, p_mem, flags)?;
    
    let result = mz_zip_validate_archive(&mut zip, flags);
    
    if !mz_zip_reader_end_internal(&mut zip, result.is_ok())? && result.is_ok() {
        // If reader_end failed and we were successful before, return that error
        return Err(zip.m_last_error);
    }
    
    result
}

