#[derive(Debug, Clone)]
struct ZipArray<T> {
    data: Vec<T>,
    element_size: usize,
}

impl<T> ZipArray<T> {
    fn new() -> Self {
        Self {
            data: Vec::new(),
            element_size: std::mem::size_of::<T>(),
        }
    }

    fn resize(&mut self, new_size: usize) -> Result<()> {
        if new_size > self.data.capacity() {
            self.data.reserve(new_size - self.data.len());
        }
        self.data.resize(new_size, unsafe { std::mem::zeroed() });
        Ok(())
    }

    fn clear(&mut self) {
        self.data.clear();
    }

    fn len(&self) -> usize {
        self.data.len()
    }

    fn is_empty(&self) -> bool {
        self.data.is_empty()
    }

    fn as_slice(&self) -> &[T] {
        &self.data
    }

    fn as_mut_slice(&mut self) -> &mut [T] {
        &mut self.data
    }

    fn get(&self, index: usize) -> Option<&T> {
        self.data.get(index)
    }

    fn get_mut(&mut self, index: usize) -> Option<&mut T> {
        self.data.get_mut(index)
    }
}

#[derive(Debug)]
struct ZipInternalState {
    central_dir: ZipArray<u8>,
    central_dir_offsets: ZipArray<MzUint>,
    sorted_central_dir_offsets: ZipArray<MzUint>,
    init_flags: MzUint,
    zip64: MzBool,
    zip64_has_extended_info_fields: MzBool,
    file: Option<File>,
    file_archive_start_ofs: MzUint64,
    mem: Option<NonNull<u8>>,
    mem_size: usize,
    mem_capacity: usize,
}

#[derive(Debug)]
pub enum ZipType {
    Memory,
    File,
    CFile,
    User,
    Invalid,
}

#[derive(Debug)]

impl ZipArchive {
    pub fn new() -> Self {
        Self {
            archive_size: 0,
            central_directory_file_ofs: 0,
            total_files: 0,
            state: None,
            zip_type: ZipType::Invalid,
            last_error: None,
        }
    }

    fn set_error(&mut self, error: ZipError) -> Result<()> {
        self.last_error = Some(error.clone());
        Err(error)
    }

    fn clear_error(&mut self) {
        self.last_error = None;
    }

    pub fn last_error(&self) -> Option<&ZipError> {
        self.last_error.as_ref()
    }
}

// Helper functions for reading little-endian values
fn read_le_u16(buf: &[u8], offset: usize) -> u16 {
    let bytes = &buf[offset..offset + 2];
    u16::from_le_bytes([bytes[0], bytes[1]])
}

fn read_le_u32(buf: &[u8], offset: usize) -> u32 {
    let bytes = &buf[offset..offset + 4];
    u32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]])
}

fn read_le_u64(buf: &[u8], offset: usize) -> u64 {
    let bytes = &buf[offset..offset + 8];
    u64::from_le_bytes([
        bytes[0], bytes[1], bytes[2], bytes[3],
        bytes[4], bytes[5], bytes[6], bytes[7],
    ])
}

