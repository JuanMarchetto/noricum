// --- Module: mz_p6 ---
//! ZIP archive writing functionality
//!
//! This module provides functions for creating and modifying ZIP archives.
//! It handles both standard ZIP and ZIP64 formats for large files.


use crate::miniz::{
    MzZipArchive, MzZipInternalState, MzZipArray, MzBool, MzUInt, MzUInt16, MzUInt32, MzUInt64, 
    MzFile, MzZipMode, MzZipType, MzZipError, MzZipResult, MzZipWriterAddState,
    MZ_ZIP_LOCAL_DIR_HEADER_SIZE, MZ_ZIP_CENTRAL_DIR_HEADER_SIZE, MZ_ZIP_DATA_DESCRIPTER_SIZE32,
    MZ_ZIP_DATA_DESCRIPTER_SIZE64, MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE, MZ_ZIP_LDH_BIT_FLAG_HAS_LOCATOR,
    MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_UTF8, MZ_ZIP_DOS_DIR_ATTRIBUTE_BITFLAG, MZ_DEFAULT_LEVEL,
    MZ_UBER_COMPRESSION, MZ_CRC32_INIT, MZ_UINT16_MAX, MZ_UINT32_MAX, MZ_MIN,
    mz_zip_set_error, mz_zip_array_clear, mz_zip_array_push_back, mz_zip_array_ensure_room,
    mz_zip_array_resize, mz_zip_writer_init_v2, mz_zip_reader_end_internal,
    mz_crc32, mz_zip_time_t_to_dos_time, tdefl_compressor, tdefl_init, tdefl_compress_buffer,
    tdefl_create_comp_flags_from_zip_params, TDEFL_STATUS_OKAY, TDEFL_STATUS_DONE, TDEFL_FINISH,
    mz_zip_file_write_func, mz_zip_file_read_func, mz_zip_heap_write_func,
    MZ_ZIP_FLAG_WRITE_ALLOW_READING, MZ_ZIP_FLAG_WRITE_ZIP64, MZ_ZIP_FLAG_ASCII_FILENAME,
    MZ_ZIP_FLAG_COMPRESSED_DATA, MZ_ZIP_MODE_READING, MZ_ZIP_MODE_WRITING,
    MZ_ZIP_TYPE_CFILE, MZ_ZIP_TYPE_FILE,
};

/// Initialize a ZIP archive writer using a C file handle
///
/// # Arguments
/// * `p_zip` - The ZIP archive to initialize
/// * `p_file` - The file handle to write to
/// * `flags` - Writer flags
///
/// # Returns
/// `MzZipResult<()>` indicating success or failure
pub fn mz_zip_writer_init_cfile(
    p_zip: &mut MzZipArchive,
    p_file: MzFile,
    flags: MzUInt,
) -> MzZipResult<()> {
    p_zip.m_p_write = Some(mz_zip_file_write_func);
    p_zip.m_p_needs_keepalive = None;

    if flags & MZ_ZIP_FLAG_WRITE_ALLOW_READING != 0 {
        p_zip.m_p_read = Some(mz_zip_file_read_func);
    }

    p_zip.m_p_io_opaque = p_zip as *const _ as usize;

    mz_zip_writer_init_v2(p_zip, 0, flags)?;

    // SAFETY: We just initialized the writer, so m_p_state should be valid
    let state = unsafe { &mut *p_zip.m_p_state };
    state.m_p_file = Some(p_file);
    
    // Get current file position
    state.m_file_archive_start_ofs = p_file.stream_position()
        .map_err(|_| MzZipError::FileOpenFailed)?;
    
    p_zip.m_zip_type = MzZipType::CFile;

    Ok(())
}

/// Convert a ZIP archive from reader to writer mode
///
/// # Arguments
/// * `p_zip` - The ZIP archive to convert
/// * `p_filename` - Filename for reopening (if needed)
/// * `flags` - Writer flags
///
/// # Returns
/// `MzZipResult<()>` indicating success or failure
pub fn mz_zip_writer_init_from_reader_v2(
    p_zip: &mut MzZipArchive,
    p_filename: Option<&str>,
    flags: MzUInt,
) -> MzZipResult<()> {
    let state = p_zip.m_p_state.as_mut()
        .ok_or(MzZipError::InvalidParameter)?;
    
    if p_zip.m_zip_mode != MzZipMode::Reading {
        return Err(MzZipError::InvalidParameter);
    }

    // Check for ZIP64 conversion attempt
    if flags & MZ_ZIP_FLAG_WRITE_ZIP64 != 0 && !state.m_zip64 {
        return Err(MzZipError::InvalidParameter);
    }

    // Check file count limits
    if state.m_zip64 {
        if p_zip.m_total_files == MzUInt32::MAX {
            return Err(MzZipError::TooManyFiles);
        }
    } else {
        if p_zip.m_total_files == u16::MAX as MzUInt32 {
            return Err(MzZipError::TooManyFiles);
        }
        
        if (p_zip.m_archive_size + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as u64 + 
            MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64) > u32::MAX as u64 {
            return Err(MzZipError::FileTooLarge);
        }
    }

    // Handle different archive types
    if let Some(file) = &mut state.m_p_file {
        if p_zip.m_p_io_opaque != p_zip as *const _ as usize {
            return Err(MzZipError::InvalidParameter);
        }

        if p_zip.m_zip_type == MzZipType::File && 
           flags & MzUInt::from(MZ_ZIP_FLAG_WRITE_ALLOW_READING) == 0 {
            let filename = p_filename.ok_or(MzZipError::InvalidParameter)?;
            
            // Reopen file in read/write mode
            let path = Path::new(filename);
            let reopened = OpenOptions::new()
                .read(true)
                .write(true)
                .open(path)
                .map_err(|_| MzZipError::FileOpenFailed)?;
            
            *file = reopened;
        }

        p_zip.m_p_write = Some(mz_zip_file_write_func);
        p_zip.m_p_needs_keepalive = None;
    } else if state.m_p_mem.is_some() {
        // Memory-based archive
        if p_zip.m_p_io_opaque != p_zip as *const _ as usize {
            return Err(MzZipError::InvalidParameter);
        }

        state.m_mem_capacity = state.m_mem_size;
        p_zip.m_p_write = Some(mz_zip_heap_write_func);
        p_zip.m_p_needs_keepalive = None;
    } else if p_zip.m_p_write.is_none() {
        // User-provided read function but no write function
        return Err(MzZipError::InvalidParameter);
    }

    // Start writing at current central directory position
    p_zip.m_archive_size = p_zip.m_central_directory_file_ofs;
    p_zip.m_central_directory_file_ofs = 0;

    // Clear sorted directory offsets (not maintained in write mode)
    mz_zip_array_clear(p_zip, &mut state.m_sorted_central_dir_offsets);

    p_zip.m_zip_mode = MzZipMode::Writing;

    Ok(())
}

/// Convert a ZIP archive from reader to writer mode (no flags)
///
/// # Arguments
/// * `p_zip` - The ZIP archive to convert
/// * `p_filename` - Filename for reopening (if needed)
///
/// # Returns
/// `MzZipResult<()>` indicating success or failure
pub fn mz_zip_writer_init_from_reader(
    p_zip: &mut MzZipArchive,
    p_filename: Option<&str>,
) -> MzZipResult<()> {
    mz_zip_writer_init_from_reader_v2(p_zip, p_filename, 0)
}

/// Add a file to a ZIP archive from memory
///
/// # Arguments
/// * `p_zip` - The ZIP archive
/// * `archive_name` - Name of the file in the archive
/// * `buf` - File data
/// * `buf_size` - Size of file data
/// * `level_and_flags` - Compression level and flags
///
/// # Returns
/// `MzZipResult<()>` indicating success or failure
pub fn mz_zip_writer_add_mem(
    p_zip: &mut MzZipArchive,
    archive_name: &str,
    buf: &[u8],
    level_and_flags: MzUInt,
) -> MzZipResult<()> {
    mz_zip_writer_add_mem_ex(
        p_zip, 
        archive_name, 
        buf, 
        None, 
        0, 
        level_and_flags, 
        0, 
        0
    )
}

/// Callback for writing compressed data during compression
///
/// # Arguments
/// * `buf` - Data to write
/// * `len` - Length of data
/// * `user_data` - User state (MzZipWriterAddState)
///
/// # Returns
/// `true` on success, `false` on failure
fn mz_zip_writer_add_put_buf_callback(
    buf: &[u8],
    user_data: &mut MzZipWriterAddState,
) -> MzBool {
    let write_func = user_data.m_p_zip.m_p_write
        .ok_or(MzZipError::InvalidParameter)?;
    
    let written = write_func(
        user_data.m_p_zip.m_p_io_opaque,
        user_data.m_cur_archive_file_ofs,
        buf,
    );
    
    if written != buf.len() {
        return false;
    }
    
    user_data.m_cur_archive_file_ofs += written as u64;
    user_data.m_comp_size += written as u64;
    true
}

/// Create ZIP64 extended information extra data field
///
/// # Arguments
/// * `buf` - Output buffer
/// * `uncomp_size` - Optional uncompressed size (for ZIP64)
/// * `comp_size` - Optional compressed size (for ZIP64)
/// * `local_header_ofs` - Optional local header offset (for ZIP64)
///
/// # Returns
/// Size of the extra data field
fn mz_zip_writer_create_zip64_extra_data(
    buf: &mut [u8],
    uncomp_size: Option<&MzUInt64>,
    comp_size: Option<&MzUInt64>,
    local_header_ofs: Option<&MzUInt64>,
) -> MzUInt32 {
    let mut dst = buf;
    let mut field_size = 0;

    // Write header ID
    dst[..2].copy_from_slice(&(1u16.to_le_bytes())); // MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID
    dst[2..4].copy_from_slice(&(0u16.to_le_bytes())); // Placeholder for size
    dst = &mut dst[4..];

    // Write optional fields
    if let Some(size) = uncomp_size {
        dst[..8].copy_from_slice(&size.to_le_bytes());
        dst = &mut dst[8..];
        field_size += 8;
    }

    if let Some(size) = comp_size {
        dst[..8].copy_from_slice(&size.to_le_bytes());
        dst = &mut dst[8..];
        field_size += 8;
    }

    if let Some(ofs) = local_header_ofs {
        dst[..8].copy_from_slice(&ofs.to_le_bytes());
        dst = &mut dst[8..];
        field_size += 8;
    }

    // Update size field
    buf[2..4].copy_from_slice(&(field_size as u16).to_le_bytes());

    (buf.len() - dst.len()) as MzUInt32
}

/// Create local directory header
///
/// # Arguments
/// * `p_zip` - ZIP archive
/// * `dst` - Output buffer
/// * `filename_size` - Size of filename
/// * `extra_size` - Size of extra data
/// * `uncomp_size` - Uncompressed size
/// * `comp_size` - Compressed size
/// * `uncomp_crc32` - CRC32 of uncompressed data
/// * `method` - Compression method
/// * `bit_flags` - General purpose bit flags
/// * `dos_time` - DOS time
/// * `dos_date` - DOS date
///
/// # Returns
/// `true` on success
fn mz_zip_writer_create_local_dir_header(
    p_zip: &MzZipArchive,
    dst: &mut [u8],
    filename_size: MzUInt16,
    extra_size: MzUInt16,
    uncomp_size: MzUInt64,
    comp_size: MzUInt64,
    uncomp_crc32: MzUInt32,
    method: MzUInt16,
    bit_flags: MzUInt16,
    dos_time: MzUInt16,
    dos_date: MzUInt16,
) -> MzBool {
    // Clear buffer
    dst[..MZ_ZIP_LOCAL_DIR_HEADER_SIZE].fill(0);

    // Write signature
    dst[0..4].copy_from_slice(&0x04034b50u32.to_le_bytes()); // MZ_ZIP_LOCAL_DIR_HEADER_SIG
    
    // Version needed
    dst[4..6].copy_from_slice(&(if method != 0 { 20u16 } else { 0u16 }).to_le_bytes());
    
    // Bit flags
    dst[6..8].copy_from_slice(&bit_flags.to_le_bytes());
    
    // Method
    dst[8..10].copy_from_slice(&method.to_le_bytes());
    
    // DOS time/date
    dst[10..12].copy_from_slice(&dos_time.to_le_bytes());
    dst[12..14].copy_from_slice(&dos_date.to_le_bytes());
    
    // CRC32
    dst[14..18].copy_from_slice(&uncomp_crc32.to_le_bytes());
    
    // Compressed size (32-bit, clamp to UINT32_MAX)
    let comp_32 = MZ_MIN(comp_size, MzUInt64::from(MZ_UINT32_MAX));
    dst[18..22].copy_from_slice(&(comp_32 as u32).to_le_bytes());
    
    // Uncompressed size (32-bit, clamp to UINT32_MAX)
    let uncomp_32 = MZ_MIN(uncomp_size, MzUInt64::from(MZ_UINT32_MAX));
    dst[22..26].copy_from_slice(&(uncomp_32 as u32).to_le_bytes());
    
    // Filename and extra lengths
    dst[26..28].copy_from_slice(&filename_size.to_le_bytes());
    dst[28..30].copy_from_slice(&extra_size.to_le_bytes());

    true
}

/// Create central directory header
///
/// # Arguments
/// * `p_zip` - ZIP archive
/// * `dst` - Output buffer
/// * `filename_size` - Size of filename
/// * `extra_size` - Size of extra data
/// * `comment_size` - Size of comment
/// * `uncomp_size` - Uncompressed size
/// * `comp_size` - Compressed size
/// * `uncomp_crc32` - CRC32 of uncompressed data
/// * `method` - Compression method
/// * `bit_flags` - General purpose bit flags
/// * `dos_time` - DOS time
/// * `dos_date` - DOS date
/// * `local_header_ofs` - Local header offset
/// * `ext_attributes` - External attributes
///
/// # Returns
/// `true` on success
fn mz_zip_writer_create_central_dir_header(
    p_zip: &MzZipArchive,
    dst: &mut [u8],
    filename_size: MzUInt16,
    extra_size: MzUInt16,
    comment_size: MzUInt16,
    uncomp_size: MzUInt64,
    comp_size: MzUInt64,
    uncomp_crc32: MzUInt32,
    method: MzUInt16,
    bit_flags: MzUInt16,
    dos_time: MzUInt16,
    dos_date: MzUInt16,
    local_header_ofs: MzUInt64,
    ext_attributes: MzUInt32,
) -> MzBool {
    // Clear buffer
    dst[..MZ_ZIP_CENTRAL_DIR_HEADER_SIZE].fill(0);

    // Write signature
    dst[0..4].copy_from_slice(&0x02014b50u32.to_le_bytes()); // MZ_ZIP_CENTRAL_DIR_HEADER_SIG
    
    // Version needed
    dst[4..6].copy_from_slice(&(if method != 0 { 20u16 } else { 0u16 }).to_le_bytes());
    
    // Bit flags
    dst[6..8].copy_from_slice(&bit_flags.to_le_bytes());
    
    // Method
    dst[8..10].copy_from_slice(&method.to_le_bytes());
    
    // DOS time/date
    dst[10..12].copy_from_slice(&dos_time.to_le_bytes());
    dst[12..14].copy_from_slice(&dos_date.to_le_bytes());
    
    // CRC32
    dst[14..18].copy_from_slice(&uncomp_crc32.to_le_bytes());
    
    // Compressed size (32-bit, clamp to UINT32_MAX)
    let comp_32 = MZ_MIN(comp_size, MzUInt64::from(MZ_UINT32_MAX));
    dst[18..22].copy_from_slice(&(comp_32 as u32).to_le_bytes());
    
    // Uncompressed size (32-bit, clamp to UINT32_MAX)
    let uncomp_32 = MZ_MIN(uncomp_size, MzUInt64::from(MZ_UINT32_MAX));
    dst[22..26].copy_from_slice(&(uncomp_32 as u32).to_le_bytes());
    
    // Filename, extra, and comment lengths
    dst[26..28].copy_from_slice(&filename_size.to_le_bytes());
    dst[28..30].copy_from_slice(&extra_size.to_le_bytes());
    dst[30..32].copy_from_slice(&comment_size.to_le_bytes());
    
    // External attributes
    dst[38..42].copy_from_slice(&ext_attributes.to_le_bytes());
    
    // Local header offset (32-bit, clamp to UINT32_MAX)
    let ofs_32 = MZ_MIN(local_header_ofs, MzUInt64::from(MZ_UINT32_MAX));
    dst[42..46].copy_from_slice(&(ofs_32 as u32).to_le_bytes());

    true
}

/// Add entry to central directory
///
/// # Arguments
/// * `p_zip` - ZIP archive
/// * `filename` - Filename
/// * `filename_size` - Size of filename
/// * `extra` - Extra data
/// * `extra_size` - Size of extra data
/// * `comment` - Comment
/// * `comment_size` - Size of comment
/// * `uncomp_size` - Uncompressed size
/// * `comp_size` - Compressed size
/// * `uncomp_crc32` - CRC32 of uncompressed data
/// * `method` - Compression method
/// * `bit_flags` - General purpose bit flags
/// * `dos_time` - DOS time
/// * `dos_date` - DOS date
/// * `local_header_ofs` - Local header offset
/// * `ext_attributes` - External attributes
/// * `user_extra_data` - User extra data
/// * `user_extra_data_len` - Length of user extra data
///
/// # Returns
/// `MzZipResult<()>` indicating success or failure
fn mz_zip_writer_add_to_central_dir(
    p_zip: &mut MzZipArchive,
    filename: &str,
    filename_size: MzUInt16,
    extra: Option<&[u8]>,
    extra_size: MzUInt16,
    comment: Option<&[u8]>,
    comment_size: MzUInt16,
    uncomp_size: MzUInt64,
    comp_size: MzUInt64,
    uncomp_crc32: MzUInt32,
    method: MzUInt16,
    bit_flags: MzUInt16,
    dos_time: MzUInt16,
    dos_date: MzUInt16,
    local_header_ofs: MzUInt64,
    ext_attributes: MzUInt32,
    user_extra_data: Option<&[u8]>,
    user_extra_data_len: MzUInt,
) -> MzZipResult<()> {
    let state = p_zip.m_p_state.as_mut()
        .ok_or(MzZipError::InvalidParameter)?;

    // Check ZIP32 offset limit
    if !state.m_zip64 && local_header_ofs > u32::MAX as u64 {
        return Err(MzZipError::FileTooLarge);
    }

    // Check central directory size limit
    let total_size = state.m_central_dir.m_size as u64 + 
        MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as u64 + 
        filename_size as u64 + 
        extra_size as u64 + 
        user_extra_data_len as u64 + 
        comment_size as u64;
    
    if total_size >= u32::MAX as u64 {
        return Err(MzZipError::UnsupportedCdirSize);
    }

    // Create central directory header
    let mut central_dir_header = [0u8; MZ_ZIP_CENTRAL_DIR_HEADER_SIZE];
    if !mz_zip_writer_create_central_dir_header(
        p_zip,
        &mut central_dir_header,
        filename_size,
        (extra_size + user_extra_data_len as MzUInt16),
        comment_size,
        uncomp_size,
        comp_size,
        uncomp_crc32,
        method,
        bit_flags,
        dos_time,
        dos_date,
        local_header_ofs,
        ext_attributes,
    ) {
        return Err(MzZipError::InternalError);
    }

    // Save original size for rollback
    let orig_central_dir_size = state.m_central_dir.m_size;
    
    // Push header and data to central directory
    let central_dir_ofs = state.m_central_dir.m_size as MzUInt32;
    
    if !mz_zip_array_push_back(p_zip, &mut state.m_central_dir, &central_dir_header, MZ_ZIP_CENTRAL_DIR_HEADER_SIZE) ||
       !mz_zip_array_push_back(p_zip, &mut state.m_central_dir, filename.as_bytes(), filename_size as usize) {
        mz_zip_array_resize(p_zip, &mut state.m_central_dir, orig_central_dir_size, false);
        return Err(MzZipError::AllocFailed);
    }

    if let Some(extra_data) = extra {
        if !mz_zip_array_push_back(p_zip, &mut state.m_central_dir, extra_data, extra_size as usize) {
            mz_zip_array_resize(p_zip, &mut state.m_central_dir, orig_central_dir_size, false);
            return Err(MzZipError::AllocFailed);
        }
    }

    if let Some(user_data) = user_extra_data {
        if !mz_zip_array_push_back(p_zip, &mut state.m_central_dir, user_data, user_extra_data_len) {
            mz_zip_array_resize(p_zip, &mut state.m_central_dir, orig_central_dir_size, false);
            return Err(MzZipError::AllocFailed);
        }
    }

    if let Some(comment_data) = comment {
        if !mz_zip_array_push_back(p_zip, &mut state.m_central_dir, comment_data, comment_size as usize) {
            mz_zip_array_resize(p_zip, &mut state.m_central_dir, orig_central_dir_size, false);
            return Err(MzZipError::AllocFailed);
        }
    }

    // Push offset
    if !mz_zip_array_push_back(p_zip, &mut state.m_central_dir_offsets, &central_dir_ofs, 1) {
        mz_zip_array_resize(p_zip, &mut state.m_central_dir, orig_central_dir_size, false);
        return Err(MzZipError::AllocFailed);
    }

    Ok(())
}

/// Validate archive filename
///
/// # Arguments
/// * `archive_name` - Filename to validate
///
/// # Returns
/// `true` if valid, `false` otherwise
fn mz_zip_writer_validate_archive_name(archive_name: &str) -> MzBool {
    // Cannot start with forward slash
    if archive_name.starts_with('/') {
        return false;
    }
    
    // Other checks (drive letters, backslashes) are responsibility of caller
    true
}

/// Compute padding needed for file alignment
///
/// # Arguments
/// * `p_zip` - ZIP archive
///
/// # Returns
/// Number of padding bytes needed
fn mz_zip_writer_compute_padding_needed_for_file_alignment(p_zip: &MzZipArchive) -> MzUInt {
    if p_zip.m_file_offset_alignment == 0 {
        return 0;
    }
    
    let n = (p_zip.m_archive_size & (p_zip.m_file_offset_alignment - 1)) as MzUInt32;
    ((p_zip.m_file_offset_alignment - n) & (p_zip.m_file_offset_alignment - 1)) as MzUInt
}

/// Write zeros to archive
///
/// # Arguments
/// * `p_zip` - ZIP archive
/// * `cur_file_ofs` - Current file offset
/// * `n` - Number of zeros to write
///
/// # Returns
/// `MzZipResult<()>` indicating success or failure
fn mz_zip_writer_write_zeros(
    p_zip: &mut MzZipArchive,
    cur_file_ofs: MzUInt64,
    n: MzUInt32,
) -> MzZipResult<()> {
    const BUF_SIZE: usize = 4096;
    let zero_buf = [0u8; BUF_SIZE];
    
    let mut remaining = n as usize;
    let mut offset = cur_file_ofs;
    
    while remaining > 0 {
        let to_write = std::cmp::min(BUF_SIZE, remaining);
        let write_func = p_zip.m_p_write
            .ok_or(MzZipError::InvalidParameter)?;
        
        let written = write_func(
            p_zip.m_p_io_opaque,
            offset,
            &zero_buf[..to_write],
        );
        
        if written != to_write {
            return Err(MzZipError::FileWriteFailed);
        }
        
        offset += written as u64;
        remaining -= written;
    }
    
    Ok(())
}

/// Add file to archive from memory (extended version)
///
/// # Arguments
/// * `p_zip` - ZIP archive
/// * `archive_name` - Name of file in archive
/// * `buf` - File data
/// * `comment` - Optional comment
/// * `comment_size` - Size of comment
/// * `level_and_flags` - Compression level and flags
/// * `uncomp_size` - Uncompressed size (if already known)
/// * `uncomp_crc32` - CRC32 (if already known)
///
/// # Returns
/// `MzZipResult<()>` indicating success or failure
pub fn mz_zip_writer_add_mem_ex(
    p_zip: &mut MzZipArchive,
    archive_name: &str,
    buf: &[u8],
    comment: Option<&[u8]>,
    comment_size: MzUInt16,
    level_and_flags: MzUInt,
    uncomp_size: MzUInt64,
    uncomp_crc32: MzUInt32,
) -> MzZipResult<()> {
    mz_zip_writer_add_mem_ex_v2(
        p_zip,
        archive_name,
        buf,
        comment,
        comment_size,
        level_and_flags,
        uncomp_size,
        uncomp_crc32,
        None,
        None,
        0,
        None,
        0,
    )
}

/// Add file to archive from memory (v2 with more options)
///
/// # Arguments
/// * `p_zip` - ZIP archive
/// * `archive_name` - Name of file in archive
/// * `buf` - File data
/// * `comment` - Optional comment
/// * `comment_size` - Size of comment
/// * `level_and_flags` - Compression level and flags
/// * `uncomp_size` - Uncompressed size (if already known)
/// * `uncomp_crc32` - CRC32 (if already known)
/// * `last_modified` - Optional last modified time
/// * `user_extra_data` - Optional user extra data
/// * `user_extra_data_len` - Length of user extra data
/// * `user_extra_data_central` - Optional user extra data for central directory
/// * `user_extra_data_central_len` - Length of central directory user extra data
///
/// # Returns
/// `MzZipResult<()>` indicating success or failure
pub fn mz_zip_writer_add_mem_ex_v2(
    p_zip: &mut MzZipArchive,
    archive_name: &str,
    buf: &[u8],
    comment: Option<&[u8]>,
    comment_size: MzUInt16,
    level_and_flags: MzUInt,
    uncomp_size: MzUInt64,
    uncomp_crc32: MzUInt32,
    last_modified: Option<&std::time::SystemTime>,
    user_extra_data: Option<&[u8]>,
    user_extra_data_len: MzUInt,
    user_extra_data_central: Option<&[u8]>,
    user_extra_data_central_len: MzUInt,
) -> MzZipResult<()> {
    let mut method = 0;
    let mut dos_time = 0;
    let mut dos_date = 0;
    let mut ext_attributes = 0;
    
    let buf_size = buf.len();
    let mut local_dir_header_ofs = p_zip.m_archive_size;
    let mut cur_archive_file_ofs = p_zip.m_archive_size;
    let mut comp_size = 0u64;
    let archive_name_size = archive_name.len();
    
    let mut local_dir_header = [0u8; MZ_ZIP_LOCAL_DIR_HEADER_SIZE];
    let mut p_comp: Option<Box<tdefl_compressor>> = None;
    let mut store_data_uncompressed;
    
    let state = p_zip.m_p_state.as_mut()
        .ok_or(MzZipError::InvalidParameter)?;
    
    let mut extra_data = [0u8; MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE];
    let mut extra_size = 0;
    let mut p_extra_data: Option<&[u8]> = None;
    let mut bit_flags = 0u16;
    
    // Validate parameters
    let actual_level_and_flags = if (level_and_flags as i32) < 0 {
        MZ_DEFAULT_LEVEL
    } else {
        level_and_flags
    };
    
    // Set bit flags
    if uncomp_size != 0 || (buf_size > 0 && actual_level_and_flags & MZ_ZIP_FLAG_COMPRESSED_DATA == 0) {
        bit_flags |= MZ_ZIP_LDH_BIT_FLAG_HAS_LOCATOR;
    }
    
    if actual_level_and_flags & MZ_ZIP_FLAG_ASCII_FILENAME == 0 {
        bit_flags |= MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_UTF8;
    }
    
    let level = actual_level_and_flags & 0xF;
    store_data_uncompressed = (level == 0) || (actual_level_and_flags & MZ_ZIP_FLAG_COMPRESSED_DATA != 0);
    
    // Check basic parameters
    if p_zip.m_zip_mode != MzZipMode::Writing ||
       (buf_size > 0 && buf.is_empty()) ||
       archive_name.is_empty() ||
       (comment_size > 0 && comment.is_none()) ||
       level > MZ_UBER_COMPRESSION as MzUInt {
        return Err(MzZipError::InvalidParameter);
    }
    
    // Check file count limits
    if state.m_zip64 {
        if p_zip.m_total_files == MzUInt32::MAX {
            return Err(MzZipError::TooManyFiles);
        }
    } else {
        if p_zip.m_total_files == u16::MAX as MzUInt32 {
            state.m_zip64 = true;
        }
        if buf_size > u32::MAX as usize || uncomp_size > u32::MAX as u64 {
            state.m_zip64 = true;
        }
    }
    
    // Validate uncompressed size parameter
    if actual_level_and_flags & MZ_ZIP_FLAG_COMPRESSED_DATA == 0 && uncomp_size != 0 {
        return Err(MzZipError::InvalidParameter);
    }
    
    // Validate archive name
    if !mz_zip_writer_validate_archive_name(archive_name) {
        return Err(MzZipError::InvalidFilename);
    }
    
    // Set DOS time/date
    #[cfg(not(feature = "no_time"))]
    {
        if let Some(time) = last_modified {
            let (time_val, date_val) = mz_zip_time_t_to_dos_time(*time);
            dos_time = time_val;
            dos_date = date_val;
        } else {
            let now = std::time::SystemTime::now();
            let (time_val, date_val) = mz_zip_time_t_to_dos_time(now);
            dos_time = time_val;
            dos_date = date_val;
        }
    }
    
    // Calculate CRC32 and size if not provided
    let mut actual_uncomp_size = uncomp_size;
    let mut actual_uncomp_crc32 = uncomp_crc32;
    
    if actual_level_and_flags & MZ_ZIP_FLAG_COMPRESSED_DATA == 0 {
        actual_uncomp_crc32 = mz_crc32(MZ_CRC32_INIT, buf);
        actual_uncomp_size = buf_size as u64;
        
        if actual_uncomp_size <= 3 {
            store_data_uncompressed = true;
        }
    }
    
    // Check filename length
    if archive_name_size > MZ_UINT16_MAX as usize {
        return Err(MzZipError::InvalidFilename);
    }
    
    // Compute alignment padding
    let num_alignment_padding_bytes = mz_zip_writer_compute_padding_needed_for_file_alignment(p_zip);
    
    // Check central directory size limit
    let central_dir_limit = state.m_central_dir.m_size as u64 + 
        MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as u64 + 
        archive_name_size as u64 + 
        MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE as u64 + 
        comment_size as u64;
    
    if central_dir_limit >= u32::MAX as u64 {
        return Err(MzZipError::UnsupportedCdirSize);
    }
    
    // Check for ZIP32 size limits
    if !state.m_zip64 {
        let total_size_estimate = p_zip.m_archive_size + 
            num_alignment_padding_bytes as u64 + 
            MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + 
            archive_name_size as u64 + 
            MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as u64 + 
            archive_name_size as u64 + 
            comment_size as u64 + 
            user_extra_data_len as u64 +
            state.m_central_dir.m_size as u64 + 
            MZ_ZIP_DATA_DESCRIPTER_SIZE32 as u64 + 
            user_extra_data_central_len as u64;
        
        if total_size_estimate > u32::MAX as u64 {
            state.m_zip64 = true;
        }
    }
    
    // Handle directory entries
    if archive_name.ends_with('/') {
        ext_attributes |= MZ_ZIP_DOS_DIR_ATTRIBUTE_BITFLAG;
        
        if buf_size > 0 || actual_uncomp_size > 0 {
            return Err(MzZipError::InvalidParameter);
        }
    }
    
    // Ensure space in central directory arrays
    let extra_field_size = if state.m_zip64 { MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE } else { 0 };
    if !mz_zip_array_ensure_room(
        p_zip, 
        &mut state.m_central_dir, 
        MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + archive_name_size + comment_size as usize + extra_field_size
    ) || !mz_zip_array_ensure_room(p_zip, &mut state.m_central_dir_offsets, 1) {
        return Err(MzZipError::AllocFailed);
    }
    
    // Allocate compressor if needed
    if !store_data_uncompressed && buf_size > 0 {
        // Note: In real code, we'd allocate using pZip's allocator
        p_comp = Some(Box::new(tdefl_compressor::default()));
    }
    
    // Write alignment padding
    if num_alignment_padding_bytes > 0 {
        mz_zip_writer_write_zeros(p_zip, cur_archive_file_ofs, num_alignment_padding_bytes as u32)?;
    }
    
    local_dir_header_ofs += num_alignment_padding_bytes as u64;
    cur_archive_file_ofs += num_alignment_padding_bytes as u64;
    
    // Set compression method
    if !store_data_uncompressed || actual_level_and_flags & MZ_ZIP_FLAG_COMPRESSED_DATA != 0 {
        method = 8; // MZ_DEFLATED
    }
    
    // Handle ZIP64 extra data
    if state.m_zip64 {
        let needs_zip64 = actual_uncomp_size >= u32::MAX as u64 || local_dir_header_ofs >= u32::MAX as u64;
        
        if needs_zip64 {
            let uncomp_ptr = if actual_uncomp_size >= u32::MAX as u64 { Some(&actual_uncomp_size) } else { None };
            let comp_ptr = if actual_uncomp_size >= u32::MAX as u64 { Some(&comp_size) } else { None };
            let ofs_ptr = if local_dir_header_ofs >= u32::MAX as u64 { Some(&local_dir_header_ofs) } else { None };
            
            extra_size = mz_zip_writer_create_zip64_extra_data(
                &mut extra_data,
                uncomp_ptr,
                comp_ptr,
                ofs_ptr,
            ) as usize;
            p_extra_data = Some(&extra_data[..extra_size]);
        }
        
        // Create and write local header
        if !mz_zip_writer_create_local_dir_header(
            p_zip,
            &mut local_dir_header,
            archive_name_size as MzUInt16,
            (extra_size + user_extra_data_len) as MzUInt16,
            0, 0, 0, method, bit_flags, dos_time, dos_date,
        ) {
            return Err(MzZipError::InternalError);
        }
        
        let write_func = p_zip.m_p_write.ok_or(MzZipError::InvalidParameter)?;
        if write_func(p_zip.m_p_io_opaque, local_dir_header_ofs, &local_dir_header) != local_dir_header.len() {
            return Err(MzZipError::FileWriteFailed);
        }
        
        cur_archive_file_ofs += local_dir_header.len() as u64;
        
        // Write filename
        if write_func(p_zip.m_p_io_opaque, cur_archive_file_ofs, archive_name.as_bytes()) != archive_name_size {
            return Err(MzZipError::FileWriteFailed);
        }
        cur_archive_file_ofs += archive_name_size as u64;
        
        // Write extra data
        if let Some(extra) = p_extra_data {
            if write_func(p_zip.m_p_io_opaque, cur_archive_file_ofs, extra) != extra_size {
                return Err(MzZipError::FileWriteFailed);
            }
            cur_archive_file_ofs += extra_size as u64;
        }
    } else {
        // ZIP32 path
        if comp_size > u32::MAX as u64 || cur_archive_file_ofs > u32::MAX as u64 {
            return Err(MzZipError::ArchiveTooLarge);
        }
        
        if !mz_zip_writer_create_local_dir_header(
            p_zip,
            &mut local_dir_header,
            archive_name_size as MzUInt16,
            user_extra_data_len as MzUInt16,
            0, 0, 0, method, bit_flags, dos_time, dos_date,
        ) {
            return Err(MzZipError::InternalError);
        }
        
        let write_func = p_zip.m_p_write.ok_or(MzZipError::InvalidParameter)?;
        if write_func(p_zip.m_p_io_opaque, local_dir_header_ofs, &local_dir_header) != local_dir_header.len() {
            return Err(MzZipError::FileWriteFailed);
        }
        
        cur_archive_file_ofs += local_dir_header.len() as u64;
        
        // Write filename
        if write_func(p_zip.m_p_io_opaque, cur_archive_file_ofs, archive_name.as_bytes()) != archive_name_size {
            return Err(MzZipError::FileWriteFailed);
        }
        cur_archive_file_ofs += archive_name_size as u64;
    }
    
    // Write user extra data
    if let Some(user_data) = user_extra_data {
        let write_func = p_zip.m_p_write.ok_or(MzZipError::InvalidParameter)?;
        if write_func(p_zip.m_p_io_opaque, cur_archive_file_ofs, user_data) != user_extra_data_len {
            return Err(MzZipError::FileWriteFailed);
        }
        cur_archive_file_ofs += user_extra_data_len as u64;
    }
    
    // Write file data
    if store_data_uncompressed {
        let write_func = p_zip.m_p_write.ok_or(MzZipError::InvalidParameter)?;
        if write_func(p_zip.m_p_io_opaque, cur_archive_file_ofs, buf) != buf_size {
            return Err(MzZipError::FileWriteFailed);
        }
        
        cur_archive_file_ofs += buf_size as u64;
        comp_size = buf_size as u64;
    } else if buf_size > 0 {
        let mut state = MzZipWriterAddState {
            m_p_zip: p_zip,
            m_cur_archive_file_ofs: cur_archive_file_ofs,
            m_comp_size: 0,
        };
        
        // Initialize compressor
        let mut comp = p_comp.take().ok_or(MzZipError::AllocFailed)?;
        let flags = tdefl_create_comp_flags_from_zip_params(level as i32, -15, 0);
        
        if tdefl_init(&mut comp, |buf| {
            mz_zip_writer_add_put_buf_callback(buf, &mut state)
        }, &mut state as *mut _ as usize, flags) != TDEFL_STATUS_OKAY {
            return Err(MzZipError::CompressionFailed);
        }
        
        // Compress data
        if tdefl_compress_buffer(&mut comp, buf, TDEFL_FINISH) != TDEFL_STATUS_DONE {
            return Err(MzZipError::CompressionFailed);
        }
        
        comp_size = state.m_comp_size;
        cur_archive_file_ofs = state.m_cur_archive_file_ofs;
    }
    
    // Write data descriptor if needed
    if actual_uncomp_size != 0 {
        let mut local_dir_footer = [0u8; MZ_ZIP_DATA_DESCRIPTER_SIZE64];
        let mut local_dir_footer_size = MZ_ZIP_DATA_DESCRIPTER_SIZE32;
        
        // Data descriptor signature
        local_dir_footer[0..4].copy_from_slice(&0x08074b50u32.to_le_bytes());
        
        // CRC32
        local_dir_footer[4..8].copy_from_slice(&actual_uncomp_crc32.to_le_bytes());
        
        if p_extra_data.is_none() {
            // ZIP32
            if comp_size > u32::MAX as u64 {
                return Err(MzZipError::ArchiveTooLarge);
            }
            
            local_dir_footer[8..12].copy_from_slice(&(comp_size as u32).to_le_bytes());
            local_dir_footer[12..16].copy_from_slice(&(actual_uncomp_size as u32).to_le_bytes());
        } else {
            // ZIP64
            local_dir_footer[8..16].copy_from_slice(&comp_size.to_le_bytes());
            local_dir_footer[16..24].copy_from_slice(&actual_uncomp_size.to_le_bytes());
            local_dir_footer_size = MZ_ZIP_DATA_DESCRIPTER_SIZE64;
        }
        
        let write_func = p_zip.m_p_write.ok_or(MzZipError::InvalidParameter)?;
        if write_func(p_zip.m_p_io_opaque, cur_archive_file_ofs, &local_dir_footer[..local_dir_footer_size]) != local_dir_footer_size {
            return Err(MzZipError::FileWriteFailed);
        }
        
        cur_archive_file_ofs += local_dir_footer_size as u64;
    }
    
    // Create ZIP64 extra data for central directory
    let mut central_extra_data = [0u8; MZ_ZIP64_MAX_CENTRAL_EXTRA_FIELD_SIZE];
    let mut central_extra_size = 0;
    
    if p_extra_data.is_some() {
        let uncomp_ptr = if actual_uncomp_size >= u32::MAX as u64 { Some(&actual_uncomp_size) } else { None };
        let comp_ptr = if actual_uncomp_size >= u32::MAX as u64 { Some(&comp_size) } else { None };
        let ofs_ptr = if local_dir_header_ofs >= u32::MAX as u64 { Some(&local_dir_header_ofs) } else { None };
        
        central_extra_size = mz_zip_writer_create_zip64_extra_data(
            &mut central_extra_data,
            uncomp_ptr,
            comp_ptr,
            ofs_ptr,
        ) as usize;
    }
    
    // Add to central directory
    mz_zip_writer_add_to_central_dir(
        p_zip,
        archive_name,
        archive_name_size as MzUInt16,
        if central_extra_size > 0 { Some(&central_extra_data[..central_extra_size]) } else { None },
        central_extra_size as MzUInt16,
        comment,
        comment_size,
        actual_uncomp_size,
        comp_size,
        actual_uncomp_crc32,
        method,
        bit_flags,
        dos_time,
        dos_date,
        local_dir_header_ofs,
        ext_attributes,
        user_extra_data_central,
        user_extra_data_central_len,
    )?;
    
    // Update archive state
    p_zip.m_total_files += 1;
    p_zip.m_archive_size = cur_archive_file_ofs;
    
    Ok(())
}

// --- Module: mz_p7 ---
// Error type for ZIP operations
#[derive(Debug)]

impl From<io::Error> for ZipError {
    fn from(err: io::Error) -> Self {
        ZipError::Io(err)
    }
}


// Simulates C's mz_bool (0 = false, 1 = true)
#[repr(transparent)]
#[derive(Debug, Clone, Copy, PartialEq, Eq)]

impl MzBool {
    const FALSE: Self = Self(0);
    const TRUE: Self = Self(1);
    
    fn from_bool(b: bool) -> Self {
        if b { Self::TRUE } else { Self::FALSE }
    }
    
    fn as_bool(self) -> bool {
        self.0 != 0
    }
}

// ZIP archive state
struct MzZipArchive {
    total_files: u32,
    archive_size: u64,
    file_offset_alignment: u64,
    state: Option<MzZipInternalState>,
}

struct MzZipInternalState {
    zip64: MzBool,
    central_dir: Vec<u8>,
    // Other fields omitted for brevity
}

// Dynamic array type (simplified from mz_zip_array)
struct MzZipArray {
    data: Vec<u8>,
    element_size: usize,
}

impl MzZipArray {
    fn new(element_size: usize) -> Self {
        Self {
            data: Vec::new(),
            element_size,
        }
    }
    
    fn reserve(&mut self, capacity: usize, zero: bool) -> Result<()> {
        if zero {
            self.data.resize(self.data.len() + capacity, 0);
        } else {
            self.data.reserve(capacity);
        }
        Ok(())
    }
    
    fn resize(&mut self, new_size: usize, zero: bool) -> Result<()> {
        if zero {
            self.data.resize(new_size * self.element_size, 0);
        } else {
            self.data.truncate(new_size * self.element_size);
        }
        Ok(())
    }
    
    fn push_back(&mut self, bytes: &[u8]) -> Result<()> {
        self.data.extend_from_slice(bytes);
        Ok(())
    }
}

// File read callback trait
trait MzFileRead {
    fn read_at(&mut self, file_ofs: u64, buf: &mut [u8]) -> io::Result<usize>;
}

impl MzFileRead for File {
    fn read_at(&mut self, file_ofs: u64, buf: &mut [u8]) -> io::Result<usize> {
        let cur_ofs = self.stream_position()?;
        if cur_ofs != file_ofs {
            self.seek(SeekFrom::Start(file_ofs))?;
        }
        self.read(buf)
    }
}

// Static function 1: File read callback using stdio
fn mz_file_read_func_stdio(p_opaque: &mut dyn MzFileRead, file_ofs: u64, p_buf: &mut [u8]) -> usize {
    match p_opaque.read_at(file_ofs, p_buf) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

// Function 2: Add file to ZIP archive
fn mz_zip_writer_add_file(
    p_zip: &mut MzZipArchive,
    p_archive_name: &str,
    p_src_filename: &Path,
    p_comment: Option<&[u8]>,
    comment_size: u16,
    level_and_flags: u32,
) -> Result<MzBool> {
    // Get file metadata for modified time
    let metadata = std::fs::metadata(p_src_filename)
        .map_err(|_| ZipError::FileStatFailed)?;
    
    let file_modified_time = metadata.modified()
        .map_err(|_| ZipError::FileStatFailed)?;
    
    // Open source file
    let mut src_file = File::open(p_src_filename)
        .map_err(|_| ZipError::FileOpenFailed)?;
    
    // Get file size
    let uncomp_size = metadata.len();
    
    // Call the more general function with file callback
    mz_zip_writer_add_cfile(
        p_zip,
        p_archive_name,
        &mut src_file,
        uncomp_size,
        Some(&file_modified_time),
        p_comment,
        comment_size,
        level_and_flags,
        None,
        0,
        None,
        0,
    )
}

// Helper: Add file with callback (simplified version)
fn mz_zip_writer_add_cfile(
    p_zip: &mut MzZipArchive,
    p_archive_name: &str,
    p_src_file: &mut dyn MzFileRead,
    max_size: u64,
    p_file_time: Option<&SystemTime>,
    p_comment: Option<&[u8]>,
    comment_size: u16,
    level_and_flags: u32,
    _user_extra_data: Option<&[u8]>,
    _user_extra_data_len: u32,
    _user_extra_data_central: Option<&[u8]>,
    _user_extra_data_central_len: u32,
) -> Result<MzBool> {
    // Simplified implementation - actual ZIP writing would be much more complex
    // This shows the structure and error handling patterns
    
    // Validate parameters
    if p_archive_name.is_empty() || p_archive_name.len() > u16::MAX as usize {
        return Err(ZipError::InvalidFilename);
    }
    
    if let Some(state) = &p_zip.state {
        if !state.zip64.as_bool() && max_size > u32::MAX as u64 {
            return Err(ZipError::ArchiveTooLarge);
        }
        
        if !state.zip64.as_bool() && p_zip.total_files == u16::MAX as u32 {
            return Err(ZipError::TooManyFiles);
        }
    }
    
    // Calculate alignment padding
    let num_alignment_padding_bytes = if p_zip.file_offset_alignment > 0 {
        let padding = p_zip.file_offset_alignment - (p_zip.archive_size % p_zip.file_offset_alignment);
        if padding == p_zip.file_offset_alignment { 0 } else { padding }
    } else {
        0
    };
    
    // Write alignment zeros if needed
    if num_alignment_padding_bytes > 0 {
        // In real implementation, would write zeros to output
    }
    
    // Process the file data
    let mut uncomp_crc32 = 0u32;
    let mut read_buf = vec![0u8; 65536]; // MZ_ZIP_MAX_IO_BUF_SIZE
    
    let mut file_ofs = 0u64;
    let level = level_and_flags & 0xF;
    
    if level == 0 {
        // Store uncompressed
        while file_ofs < max_size {
            let to_read = std::cmp::min(read_buf.len() as u64, max_size - file_ofs) as usize;
            let n = p_src_file.read_at(file_ofs, &mut read_buf[..to_read])
                .map_err(|_| ZipError::FileReadFailed)?;
            
            if n == 0 {
                break;
            }
            
            // In real implementation, would write to archive and update CRC
            file_ofs += n as u64;
            // uncomp_crc32 = mz_crc32(uncomp_crc32, &read_buf[..n]);
        }
    } else {
        // Compressed - simplified
        // Real implementation would use a compression library
        return Err(ZipError::CompressionFailed);
    }
    
    // Update archive state
    p_zip.total_files += 1;
    // p_zip.archive_size would be updated with actual written bytes
    
    Ok(MzBool::TRUE)
}

// Static function 3: Update ZIP64 extension block
fn mz_zip_writer_update_zip64_extension_block(
    p_new_ext: &mut MzZipArray,
    p_ext: Option<&[u8]>,
    ext_len: u32,
    p_comp_size: Option<&mut u64>,
    p_uncomp_size: Option<&mut u64>,
    p_local_header_ofs: Option<&mut u64>,
    p_disk_start: Option<&mut u32>,
) -> Result<MzBool> {
    // Reserve space
    p_new_ext.reserve((ext_len + 64) as usize, false)?;
    p_new_ext.resize(0, false)?;
    
    // Create new ZIP64 extra field if any parameters provided
    if p_uncomp_size.is_some() || p_comp_size.is_some() || p_local_header_ofs.is_some() || p_disk_start.is_some() {
        let mut new_ext_block = Vec::with_capacity(64);
        
        // Write header ID
        new_ext_block.extend_from_slice(&0x0001u16.to_le_bytes());
        // Placeholder for data size (will update later)
        new_ext_block.extend_from_slice(&0u16.to_le_bytes());
        
        let start_len = new_ext_block.len();
        
        // Write provided fields
        if let Some(size) = p_uncomp_size {
            new_ext_block.extend_from_slice(&size.to_le_bytes());
        }
        if let Some(size) = p_comp_size {
            new_ext_block.extend_from_slice(&size.to_le_bytes());
        }
        if let Some(ofs) = p_local_header_ofs {
            new_ext_block.extend_from_slice(&ofs.to_le_bytes());
        }
        if let Some(disk) = p_disk_start {
            new_ext_block.extend_from_slice(&disk.to_le_bytes());
        }
        
        // Update data size field
        let data_size = (new_ext_block.len() - start_len) as u16;
        new_ext_block[2..4].copy_from_slice(&data_size.to_le_bytes());
        
        p_new_ext.push_back(&new_ext_block)?;
    }
    
    // Process existing extra data
    if let Some(ext_data) = p_ext {
        let mut remaining = ext_data;
        
        while !remaining.is_empty() {
            if remaining.len() < 4 {
                return Err(ZipError::InvalidHeaderOrCorrupted);
            }
            
            let field_id = u16::from_le_bytes([remaining[0], remaining[1]]);
            let field_data_size = u16::from_le_bytes([remaining[2], remaining[3]]) as usize;
            let field_total_size = field_data_size + 4;
            
            if field_total_size > remaining.len() {
                return Err(ZipError::InvalidHeaderOrCorrupted);
            }
            
            // Copy all fields except ZIP64 (we already handled it)
            if field_id != 0x0001 {
                p_new_ext.push_back(&remaining[..field_total_size])?;
            }
            
            remaining = &remaining[field_total_size..];
        }
    }
    
    Ok(MzBool::TRUE)
}

// --- Module: mz_p8 ---
/// Validates a single file in a zip archive
pub fn mz_zip_validate_file(
    zip: &mut MzZipArchive,
    file_index: u32,
    flags: u32,
) -> Result<(), ZipError> {
    let p_state = zip.m_pState.as_mut().ok_or(ZipError::InvalidParameter)?;
    
    if file_index >= zip.m_total_files {
        return Err(ZipError::InvalidParameter);
    }

    let central_dir_header = mz_zip_get_cdh(zip, file_index)?;
    
    let (file_stat, found_zip64_ext_data_in_cdir) = 
        mz_zip_file_stat_internal(zip, file_index, central_dir_header)?;
    
    // A directory or zero length file
    if file_stat.m_is_directory || file_stat.m_uncomp_size == 0 {
        return Ok(());
    }
    
    // Encryption and patch files are not supported
    if file_stat.m_is_encrypted {
        return Err(ZipError::UnsupportedEncryption);
    }
    
    // This function only supports stored and deflate
    if file_stat.m_method != 0 && file_stat.m_method != MZ_DEFLATED {
        return Err(ZipError::UnsupportedMethod);
    }
    
    if !file_stat.m_is_supported {
        return Err(ZipError::UnsupportedFeature);
    }
    
    // Read and parse the local directory entry
    let local_header_ofs = file_stat.m_local_header_ofs;
    let mut local_header_buf = [0u8; MZ_ZIP_LOCAL_DIR_HEADER_SIZE];
    
    if let Some(read_fn) = zip.m_pRead {
        read_fn(
            zip.m_pIO_opaque,
            local_header_ofs,
            &mut local_header_buf,
        )?;
    } else {
        return Err(ZipError::InvalidParameter);
    }
    
    if u32::from_le_bytes(local_header_buf[0..4].try_into().unwrap()) != MZ_ZIP_LOCAL_DIR_HEADER_SIG {
        return Err(ZipError::InvalidHeaderOrCorrupted);
    }
    
    let local_header_filename_len = u16::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_FILENAME_LEN_OFS..MZ_ZIP_LDH_FILENAME_LEN_OFS + 2]
            .try_into().unwrap()
    ) as usize;
    
    let local_header_extra_len = u16::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_EXTRA_LEN_OFS..MZ_ZIP_LDH_EXTRA_LEN_OFS + 2]
            .try_into().unwrap()
    ) as usize;
    
    let mut local_header_comp_size = u32::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_COMPRESSED_SIZE_OFS..MZ_ZIP_LDH_COMPRESSED_SIZE_OFS + 4]
            .try_into().unwrap()
    ) as u64;
    
    let mut local_header_uncomp_size = u32::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS..MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS + 4]
            .try_into().unwrap()
    ) as u64;
    
    let local_header_crc32 = u32::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_CRC32_OFS..MZ_ZIP_LDH_CRC32_OFS + 4]
            .try_into().unwrap()
    );
    
    let local_header_bit_flags = u16::from_le_bytes(
        local_header_buf[MZ_ZIP_LDH_BIT_FLAG_OFS..MZ_ZIP_LDH_BIT_FLAG_OFS + 2]
            .try_into().unwrap()
    );
    
    let has_data_descriptor = (local_header_bit_flags & 8) != 0;
    
    if local_header_filename_len != file_stat.m_filename.len() {
        return Err(ZipError::InvalidHeaderOrCorrupted);
    }
    
    if local_header_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + 
       local_header_filename_len as u64 + local_header_extra_len as u64 + 
       file_stat.m_comp_size > zip.m_archive_size {
        return Err(ZipError::InvalidHeaderOrCorrupted);
    }
    
    // Use temporary buffer for filename and extra field
    let max_len = local_header_filename_len.max(local_header_extra_len);
    let mut temp_buf = vec![0u8; max_len];
    
    if local_header_filename_len > 0 {
        if let Some(read_fn) = zip.m_pRead {
            read_fn(
                zip.m_pIO_opaque,
                local_header_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64,
                &mut temp_buf[0..local_header_filename_len],
            )?;
        } else {
            return Err(ZipError::InvalidParameter);
        }
        
        // Compare filename bytes
        if file_stat.m_filename.as_bytes() != &temp_buf[0..local_header_filename_len] {
            return Err(ZipError::ValidationFailed);
        }
    }
    
    let mut found_zip64_ext_data_in_ldir = false;
    
    if local_header_extra_len > 0 && 
       (local_header_comp_size == u32::MAX as u64 || local_header_uncomp_size == u32::MAX as u64) {
        
        if let Some(read_fn) = zip.m_pRead {
            read_fn(
                zip.m_pIO_opaque,
                local_header_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + local_header_filename_len as u64,
                &mut temp_buf[0..local_header_extra_len],
            )?;
        } else {
            return Err(ZipError::InvalidParameter);
        }
        
        let mut extra_data = &temp_buf[0..local_header_extra_len];
        let mut extra_size_remaining = local_header_extra_len;
        
        while extra_size_remaining >= 4 {
            let field_id = u16::from_le_bytes(extra_data[0..2].try_into().unwrap());
            let field_data_size = u16::from_le_bytes(extra_data[2..4].try_into().unwrap()) as usize;
            let field_total_size = field_data_size + 4;
            
            if field_total_size > extra_size_remaining {
                return Err(ZipError::InvalidHeaderOrCorrupted);
            }
            
            if field_id == MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID {
                if field_data_size < 16 { // sizeof(u64) * 2
                    return Err(ZipError::InvalidHeaderOrCorrupted);
                }
                
                local_header_uncomp_size = u64::from_le_bytes(
                    extra_data[4..12].try_into().unwrap()
                );
                local_header_comp_size = u64::from_le_bytes(
                    extra_data[12..20].try_into().unwrap()
                );
                
                found_zip64_ext_data_in_ldir = true;
                break;
            }
            
            extra_data = &extra_data[field_total_size..];
            extra_size_remaining -= field_total_size;
        }
    }
    
    // Check data descriptor or local header values
    if has_data_descriptor && local_header_comp_size == 0 && local_header_crc32 == 0 {
        let num_descriptor_uint32s = if p_state.m_zip64 || found_zip64_ext_data_in_ldir { 6 } else { 4 };
        let descriptor_size = num_descriptor_uint32s * 4;
        let mut descriptor_buf = vec![0u8; descriptor_size];
        
        let descriptor_pos = local_header_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + 
            local_header_filename_len as u64 + local_header_extra_len as u64 + 
            file_stat.m_comp_size;
        
        if let Some(read_fn) = zip.m_pRead {
            read_fn(
                zip.m_pIO_opaque,
                descriptor_pos,
                &mut descriptor_buf,
            )?;
        } else {
            return Err(ZipError::InvalidParameter);
        }
        
        let has_id = u32::from_le_bytes(descriptor_buf[0..4].try_into().unwrap()) == MZ_ZIP_DATA_DESCRIPTOR_ID;
        let src_start = if has_id { 4 } else { 0 };
        
        let file_crc32 = u32::from_le_bytes(
            descriptor_buf[src_start..src_start + 4].try_into().unwrap()
        );
        
        let (comp_size, uncomp_size) = if p_state.m_zip64 || found_zip64_ext_data_in_ldir {
            let comp = u64::from_le_bytes(
                descriptor_buf[src_start + 4..src_start + 12].try_into().unwrap()
            );
            let uncomp = u64::from_le_bytes(
                descriptor_buf[src_start + 12..src_start + 20].try_into().unwrap()
            );
            (comp, uncomp)
        } else {
            let comp = u32::from_le_bytes(
                descriptor_buf[src_start + 4..src_start + 8].try_into().unwrap()
            ) as u64;
            let uncomp = u32::from_le_bytes(
                descriptor_buf[src_start + 8..src_start + 12].try_into().unwrap()
            ) as u64;
            (comp, uncomp)
        };
        
        if file_crc32 != file_stat.m_crc32 || 
           comp_size != file_stat.m_comp_size || 
           uncomp_size != file_stat.m_uncomp_size {
            return Err(ZipError::ValidationFailed);
        }
    } else {
        if local_header_crc32 != file_stat.m_crc32 || 
           local_header_comp_size != file_stat.m_comp_size || 
           local_header_uncomp_size != file_stat.m_uncomp_size {
            return Err(ZipError::ValidationFailed);
        }
    }
    
    // Validate actual file contents if requested
    if (flags & MZ_ZIP_FLAG_VALIDATE_HEADERS_ONLY) == 0 {
        let mut uncomp_crc32 = MZ_CRC32_INIT;
        
        mz_zip_reader_extract_to_callback(
            zip,
            file_index,
            |data: &[u8], context: &mut u32| {
                *context = mz_crc32(*context, data);
                true
            },
            &mut uncomp_crc32,
            0,
        )?;
        
        if uncomp_crc32 != file_stat.m_crc32 {
            return Err(ZipError::ValidationFailed);
        }
    }
    
    Ok(())
}

/// Validates an entire zip archive
pub fn mz_zip_validate_archive(
    zip: &mut MzZipArchive,
    flags: u32,
) -> Result<(), ZipError> {
    let p_state = zip.m_pState.as_mut().ok_or(ZipError::InvalidParameter)?;
    
    // Basic sanity checks
    if !p_state.m_zip64 {
        if zip.m_total_files > u16::MAX as u32 {
            return Err(ZipError::ArchiveTooLarge);
        }
        if zip.m_archive_size > u32::MAX as u64 {
            return Err(ZipError::ArchiveTooLarge);
        }
    } else {
        if p_state.m_central_dir.m_size >= u32::MAX as usize {
            return Err(ZipError::ArchiveTooLarge);
        }
    }
    
    for i in 0..zip.m_total_files {
        if (flags & MZ_ZIP_FLAG_VALIDATE_LOCATE_FILE_FLAG) != 0 {
            let stat = mz_zip_reader_file_stat(zip, i)?;
            
            let found_index = mz_zip_reader_locate_file_v2(
                zip,
                &stat.m_filename,
                None,
                0,
            )?;
            
            // Check for duplicate filenames
            if found_index != i {
                return Err(ZipError::ValidationFailed);
            }
        }
        
        mz_zip_validate_file(zip, i, flags)?;
    }
    
    Ok(())
}

/// Validates a memory-based zip archive
pub fn mz_zip_validate_mem_archive(
    p_mem: &[u8],
    flags: u32,
) -> Result<(), ZipError> {
    if p_mem.is_empty() {
        return Err(ZipError::InvalidParameter);
    }
    
    let mut zip = MzZipArchive::default();
    
    mz_zip_reader_init_mem(&mut zip, p_mem, flags)?;
    
    let result = mz_zip_validate_archive(&mut zip, flags);
    
    if !mz_zip_reader_end_internal(&mut zip, result.is_ok())? && result.is_ok() {
        // If reader_end failed and we were successful before, return that error
        return Err(zip.m_last_error);
    }
    
    result
}

/// Validates a file-based zip archive
#[cfg(not(feature = "no_stdio"))]
pub fn mz_zip_validate_file_archive(
    filename: &str,
    flags: u32,
) -> Result<(), ZipError> {
    if filename.is_empty() {
        return Err(ZipError::InvalidParameter);
    }
    
    let mut zip = MzZipArchive::default();
    
    mz_zip_reader_init_file_v2(&mut zip, filename, flags, 0, 0)?;
    
    let result = mz_zip_validate_archive(&mut zip, flags);
    
    if !mz_zip_reader_end_internal(&mut zip, result.is_ok())? && result.is_ok() {
        // If reader_end failed and we were successful before, return that error
        return Err(zip.m_last_error);
    }
    
    result
}

/// Write a little-endian 16-bit value to a byte array
pub fn mz_write_le16(p: &mut [u8], v: u16) {
    p[0] = v as u8;
    p[1] = (v >> 8) as u8;
}

/// Write a little-endian 32-bit value to a byte array
pub fn mz_write_le32(p: &mut [u8], v: u32) {
    p[0] = v as u8;
    p[1] = (v >> 8) as u8;
    p[2] = (v >> 16) as u8;
    p[3] = (v >> 24) as u8;
}

/// Write a little-endian 64-bit value to a byte array
pub fn mz_write_le64(p: &mut [u8], v: u64) {
    mz_write_le32(p, v as u32);
    mz_write_le32(&mut p[4..], (v >> 32) as u32);
}

// Constants and type definitions that need to be included
const MZ_ZIP_LDH_COMPRESSED_SIZE_OFS: usize = 18;
const MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS: usize = 22;
const MZ_ZIP_LDH_CRC32_OFS: usize = 14;
const MZ_ZIP_LDH_BIT_FLAG_OFS: usize = 6;
const MZ_ZIP_DATA_DESCRIPTOR_ID: u32 = 0x08074b50;
const MZ_ZIP_FLAG_VALIDATE_HEADERS_ONLY: u32 = 0x0001;
const MZ_ZIP_FLAG_VALIDATE_LOCATE_FILE_FLAG: u32 = 0x0002;

