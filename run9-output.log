fn mz_zip_mem_read_func(
    zip: &ZipArchive,
    file_ofs: MzUint64,
    buf: &mut [u8],
    n: usize,
) -> usize {
    if let Some(state) = &zip.state {
        if let Some(mem) = state.mem {
            if file_ofs >= zip.archive_size {
                return 0;
            }
            
            let remaining = (zip.archive_size - file_ofs) as usize;
            let to_read = n.min(remaining);
            
            unsafe {
                let src = mem.as_ptr().add(file_ofs as usize);
                std::ptr::copy_nonoverlapping(src, buf.as_mut_ptr(), to_read);
            }
            
            return to_read;
        }
    }
    0
}

pub fn mz_zip_reader_init_mem(
    zip: &mut ZipArchive,
    p_mem: &[u8],
    size: usize,
    flags: MzUint,
) -> Result<()> {
    if size < MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as usize {
        return zip.set_error(ZipError::NotAnArchive);
    }

    let ptr = NonNull::new(p_mem.as_ptr() as *mut u8).unwrap();
    
    zip.state = Some(Box::new(ZipInternalState {
        central_dir: ZipArray::new(),
        central_dir_offsets: ZipArray::new(),
        sorted_central_dir_offsets: ZipArray::new(),
        init_flags: flags,
        zip64: MZ_FALSE,
        zip64_has_extended_info_fields: MZ_FALSE,
        file: None,
        file_archive_start_ofs: 0,
        mem: Some(ptr),
        mem_size: size,
        mem_capacity: size,
    }));
    
    zip.archive_size = size as MzUint64;
    zip.zip_type = ZipType::Memory;
    
    // In real implementation, would call mz_zip_reader_read_central_dir
    Ok(())
}

fn mz_zip_file_read_func(
    zip: &ZipArchive,
    file_ofs: MzUint64,
    buf: &mut [u8],
    n: usize,
) -> usize {
    if let Some(state) = &zip.state {
        if let Some(file) = &state.file {
            let adjusted_ofs = file_ofs + state.file_archive_start_ofs;
            
            if file.seek(SeekFrom::Start(adjusted_ofs)).is_err() {
                return 0;
            }
            
            match file.read(buf) {
                Ok(bytes_read) => bytes_read,
                Err(_) => 0,
            }
        } else {
            0
        }
    } else {
        0
    }
}

pub fn mz_zip_reader_init_file(
    zip: &mut ZipArchive,
    filename: &str,
    flags: MzUint,
) -> Result<()> {
    mz_zip_reader_init_file_v2(zip, filename, flags, 0, 0)
}

pub fn mz_zip_reader_init_file_v2(
    zip: &mut ZipArchive,
    filename: &str,
    flags: MzUint,
    file_start_ofs: MzUint64,
    archive_size: MzUint64,
) -> Result<()> {
    let path = Path::new(filename);
    let open_flags = if flags & 0x8000 != 0 { "r+b" } else { "rb" };
    
    let mut file = File::open(path)
        .map_err(|_| ZipError::FileOpenFailed)?;
    
    let mut file_size = archive_size;
    if file_size == 0 {
        file_size = file.seek(SeekFrom::End(0))
            .map_err(|_| ZipError::FileSeekFailed)?;
        
        if file_size < MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64 {
            return Err(ZipError::NotAnArchive);
        }
    }
    
    zip.state = Some(Box::new(ZipInternalState {
        central_dir: ZipArray::new(),
        central_dir_offsets: ZipArray::new(),
        sorted_central_dir_offsets: ZipArray::new(),
        init_flags: flags,
        zip64: MZ_FALSE,
        zip64_has_extended_info_fields: MZ_FALSE,
        file: Some(file),
        file_archive_start_ofs: file_start_ofs,
        mem: None,
        mem_size: 0,
        mem_capacity: 0,
    }));
    
    zip.archive_size = file_size;
    zip.zip_type = ZipType::File;
    
    // In real implementation, would call mz_zip_reader_read_central_dir
    Ok(())
}

pub fn mz_zip_reader_init_cfile(
    zip: &mut ZipArchive,
    file: File,
    archive_size: MzUint64,
    flags: MzUint,
) -> Result<()> {
    let current_pos = file.seek(SeekFrom::Current(0))
        .map_err(|_| ZipError::FileSeekFailed)?;
    
    let actual_archive_size = if archive_size == 0 {
        let end = file.seek(SeekFrom::End(0))
            .map_err(|_| ZipError::FileSeekFailed)?;
        file.seek(SeekFrom::Start(current_pos))
            .map_err(|_| ZipError::FileSeekFailed)?;
        end - current_pos
    } else {
        archive_size
    };
    
    if actual_archive_size < MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64 {
        return Err(ZipError::NotAnArchive);
    }
    
    zip.state = Some(Box::new(ZipInternalState {
        central_dir: ZipArray::new(),
        central_dir_offsets: ZipArray::new(),
        sorted_central_dir_offsets: ZipArray::new(),
        init_flags: flags,
        zip64: MZ_FALSE,
        zip64_has_extended_info_fields: MZ_FALSE,
        file: Some(file),
        file_archive_start_ofs: current_pos,
        mem: None,
        mem_size: 0,
        mem_capacity: 0,
    }));
    
    zip.archive_size = actual_archive_size;
    zip.zip_type = ZipType::CFile;
    
    // In real implementation, would call mz_zip_reader_read_central_dir
    Ok(())
}

fn mz_zip_get_cdh(zip: &ZipArchive, file_index: MzUint) -> Option<&[u8]> {
    if let Some(state) = &zip.state {
        if file_index < zip.total_files && file_index < state.central_dir_offsets.len() as MzUint {
            if let Some(offset) = state.central_dir_offsets.get(file_index as usize) {
                let start = *offset as usize;
                let end = start + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as usize;
                if end <= state.central_dir.len() {
                    return Some(&state.central_dir.as_slice()[start..end]);
                }
            }
        }
    }
    None
}

pub fn mz_zip_reader_is_file_encrypted(
    zip: &mut ZipArchive,
    file_index: MzUint,
) -> Result<bool> {
    let cdh = mz_zip_get_cdh(zip, file_index)
        .ok_or(ZipError::InvalidParameter)?;
    
    let bit_flag = read_le_u16(cdh, MZ_ZIP_CDH_BIT_FLAG_OFS);
    let encrypted = (bit_flag & (MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_IS_ENCRYPTED |
                                MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_USES_STRONG_ENCRYPTION)) != 0;
    
    Ok(encrypted)
}

pub fn mz_zip_reader_is_file_supported(
    zip: &mut ZipArchive,
    file_index: MzUint,
) -> Result<bool> {
    let cdh = mz_zip_get_cdh(zip, file_index)
        .ok_or(ZipError::InvalidParameter)?;
    
    let method = read_le_u16(cdh, MZ_ZIP_CDH_METHOD_OFS);
    let bit_flag = read_le_u16(cdh, MZ_ZIP_CDH_BIT_FLAG_OFS);
    
    // Check method
    if method != 0 && method != MZ_DEFLATED {
        zip.set_error(ZipError::UnsupportedMethod)?;
        return Ok(false);
    }
    
    // Check encryption
    if bit_flag & (MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_IS_ENCRYPTED |
                   MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_USES_STRONG_ENCRYPTION) != 0 {
        zip.set_error(ZipError::UnsupportedEncryption)?;
        return Ok(false);
    }
    
    // Check compressed patch flag
    if bit_flag & MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_COMPRESSED_PATCH_FLAG != 0 {
        zip.set_error(ZipError::UnsupportedFeature)?;
        return Ok(false);
    }
    
    Ok(true)
}

