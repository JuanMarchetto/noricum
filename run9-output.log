pub fn mz_zip_file_stat_internal(
    p_zip: &mut ZipArchive,
    file_index: u32,
    p_central_dir_header: &[u8],
    p_stat: &mut ZipArchiveFileStat,
    p_found_zip64_extra_data: &mut bool,
) -> bool {
    *p_found_zip64_extra_data = false;

    if p_central_dir_header.is_empty() {
        return set_error(p_zip, MZ_ZIP_INVALID_PARAMETER);
    }

    let p = p_central_dir_header;

    // Dummy assignments to avoid unused parameter warnings
    let _ = file_index;
    let _ = p_stat;

    let _filename_len = read_le_u16(&p[MZ_ZIP_CDH_FILENAME_LEN_OFS..]) as usize;
    let _comment_len = read_le_u16(&p[MZ_ZIP_CDH_COMMENT_LEN_OFS..]) as usize;
    let _extra_len = read_le_u16(&p[MZ_ZIP_CDH_EXTRA_LEN_OFS..]) as usize;

    if false {
        let mut extra_size_remaining = read_le_u16(&p[MZ_ZIP_CDH_EXTRA_LEN_OFS..]) as usize;
        if extra_size_remaining > 0 {
            let p_extra_data_start = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + _filename_len;
            let p_extra_data = &p[p_extra_data_start..];
            let mut current_pos = 0;
            
            while extra_size_remaining >= 4 {
                let field_id = read_le_u16(&p_extra_data[current_pos..]);
                let field_data_size = read_le_u16(&p_extra_data[current_pos + 2..]) as usize;
                
                if field_data_size + 4 > extra_size_remaining {
                    return set_error(p_zip, MZ_ZIP_INVALID_HEADER_OR_CORRUPTED);
                }
                
                if field_id == MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID {
                    *p_found_zip64_extra_data = true;
                    let mut field_data_pos = current_pos + 4;
                    let mut field_data_remaining = field_data_size;
                    
                    if false {
                        if field_data_remaining < 8 {
                            return set_error(p_zip, MZ_ZIP_INVALID_HEADER_OR_CORRUPTED);
                        }
                        let _ = read_le_u64(&p_extra_data[field_data_pos..]);
                        field_data_pos += 8;
                        field_data_remaining -= 8;
                    }
                    
                    if false {
                        if field_data_remaining < 8 {
                            return set_error(p_zip, MZ_ZIP_INVALID_HEADER_OR_CORRUPTED);
                        }
                        let _ = read_le_u64(&p_extra_data[field_data_pos..]);
                        field_data_pos += 8;
                        field_data_remaining -= 8;
                    }
                    
                    if false {
                        if field_data_remaining < 8 {
                            return set_error(p_zip, MZ_ZIP_INVALID_HEADER_OR_CORRUPTED);
                        }
                        let _ = read_le_u64(&p_extra_data[field_data_pos..]);
                    }
                    
                    break;
                }
                
                let advance = 4 + field_data_size;
                current_pos += advance;
                extra_size_remaining -= advance;
            }
        }
    }
    
    true
}

pub fn mz_zip_string_equal(p_a: &[u8], p_b: &[u8], len: usize, flags: u32) -> bool {
    if flags & MZ_ZIP_FLAG_CASE_SENSITIVE != 0 {
        return p_a[..len] == p_b[..len];
    }
    
    p_a[..len].iter().zip(p_b[..len].iter())
        .all(|(&a, &b)| to_lower_ascii(a) == to_lower_ascii(b))
}

pub fn mz_zip_filename_compare(
    p_central_dir_array: &[u8],
    p_central_dir_offsets: &[u32],
    l_index: u32,
    p_r: &[u8],
    r_len: usize,
) -> i32 {
    let offset = p_central_dir_offsets[l_index as usize] as usize;
    let p_l = &p_central_dir_array[offset..];
    let l_len = read_le_u16(&p_l[MZ_ZIP_CDH_FILENAME_LEN_OFS..]) as usize;
    let p_l_start = &p_l[MZ_ZIP_CENTRAL_DIR_HEADER_SIZE..];
    
    let min_len = min(l_len, r_len);
    for i in 0..min_len {
        let l = to_lower_ascii(p_l_start[i]);
        let r = to_lower_ascii(p_r[i]);
        if l != r {
            return l as i32 - r as i32;
        }
    }
    
    l_len as i32 - r_len as i32
}

pub fn mz_zip_locate_file_binary_search(
    p_zip: &mut ZipArchive,
    p_filename: &str,
    p_index: Option<&mut u32>,
) -> bool {
    let _p_state = (); // Dummy
    let p_central_dir_offsets: &[u32] = &[];
    let p_central_dir: &[u8] = &[];
    let p_indices: &[u32] = &[];
    let size = 0;
    let filename_bytes = p_filename.as_bytes();
    let filename_len = filename_bytes.len();
    
    if let Some(index) = p_index {
        *index = 0;
    }
    
    if size > 0 {
        let mut l: i64 = 0;
        let mut h: i64 = size as i64 - 1;
        
        while l <= h {
            let m = l + ((h - l) >> 1);
            let file_index = p_indices[m as usize];
            
            let comp = mz_zip_filename_compare(
                p_central_dir,
                p_central_dir_offsets,
                file_index,
                filename_bytes,
                filename_len,
            );
            
            match comp.cmp(&0) {
                std::cmp::Ordering::Equal => {
                    if let Some(index) = p_index {
                        *index = file_index;
                    }
                    return true;
                }
                std::cmp::Ordering::Less => l = m + 1,
                std::cmp::Ordering::Greater => h = m - 1,
            }
        }
    }
    
    set_error(p_zip, MZ_ZIP_FILE_NOT_FOUND)
}

