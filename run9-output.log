/// Read raw data from the archive at the specified offset
pub fn mz_zip_read_archive_data(
    p_zip: &ZipArchive,
    file_ofs: u64,
    p_buf: &mut [u8],
) -> Result<usize, ZipError> {
    if p_buf.is_empty() {
        return Err(ZipError::InvalidParameter);
    }

    p_zip.m_p_read
        .as_ref()
        .ok_or(ZipError::InvalidParameter)?
        (p_zip.m_p_io_opaque.as_ref(), file_ofs, p_buf)
        .map_err(|_| ZipError::FileReadFailed)
}

/// Get the filename of a file in the archive
/// 
/// Returns the filename as a String, or an error if the file index is invalid
pub fn mz_zip_reader_get_filename(
    p_zip: &ZipArchive,
    file_index: u32,
) -> Result<String, ZipError> {
    let p = p_zip.get_cdh(file_index)
        .ok_or(ZipError::InvalidParameter)?;
    
    let filename_len = read_le_u16(p, MZ_ZIP_CDH_FILENAME_LEN_OFS as usize) as usize;
    let start = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as usize;
    let end = start + filename_len;
    
    if end > p.len() {
        return Err(ZipError::InvalidHeaderOrCorrupted);
    }
    
    // Handle UTF-8 or CP437 encoding based on flags
    let bytes = &p[start..end];
    
    // Check if UTF-8 flag is set
    let is_utf8 = (read_le_u16(p, MZ_ZIP_CDH_BIT_FLAG_OFS as usize) & MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_UTF8) != 0;
    
    let filename = if is_utf8 {
        String::from_utf8(bytes.to_vec())
            .map_err(|_| ZipError::InvalidHeaderOrCorrupted)?
    } else {
        // CP437 to UTF-8 conversion (simplified - real implementation would need full CP437 table)
        bytes.iter()
            .map(|&b| if b < 0x80 { b as char } else { '?' })
            .collect()
    };
    
    Ok(filename)
}

/// Get file statistics for a file in the archive
pub fn mz_zip_reader_file_stat(
    p_zip: &ZipArchive,
    file_index: u32,
) -> Result<ZipArchiveFileStat, ZipError> {
    let p_cdh = p_zip.get_cdh(file_index)
        .ok_or(ZipError::InvalidParameter)?;
    
    let mut stat = ZipArchiveFileStat::default();
    if mz_zip_file_stat_internal(p_zip, file_index, p_cdh, &mut stat, None) {
        Ok(stat)
    } else {
        Err(ZipError::InvalidHeaderOrCorrupted)
    }
}

/// End archive operations (reader or writer)
pub fn mz_zip_end(p_zip: &mut ZipArchive) -> Result<(), ZipError> {
    match p_zip.m_zip_mode {
        ZipMode::Reading => {
            if mz_zip_reader_end(p_zip) {
                Ok(())
            } else {
                Err(p_zip.m_last_error)
            }
        }
        #[cfg(not(feature = "no_archive_writing_apis"))]
        ZipMode::Writing | ZipMode::WritingHasBeenFinalized => {
            if mz_zip_writer_end(p_zip) {
                Ok(())
            } else {
                Err(p_zip.m_last_error)
            }
        }
        _ => Err(ZipError::InvalidParameter),
    }
}

