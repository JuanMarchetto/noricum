// --- Module: mz_p9 ---
/// Extract a specific file from a zip archive to heap memory (with comment support)
/// 
/// Returns `Ok(Some(data))` if file found and extracted successfully,
/// `Ok(None)` if file not found (archive still valid), or `Err(ZipError)` on failure.
pub fn mz_zip_extract_archive_file_to_heap_v2(
    p_zip_filename: &str,
    p_archive_name: &str,
    p_comment: Option<&str>,
    flags: u32,
) -> Result<Option<Vec<u8>>, ZipError> {
    if p_zip_filename.is_empty() || p_archive_name.is_empty() {
        return Err(ZipError::InvalidParameter);
    }

    let mut zip_archive = ZipArchive::new();
    
    // Initialize zip reader with file
    if !mz_zip_reader_init_file_v2(&mut zip_archive, p_zip_filename, flags | MZ_ZIP_FLAG_DO_NOT_SORT_CENTRAL_DIRECTORY, 0, 0) {
        return Err(zip_archive.m_last_error);
    }

    let file_index = match p_comment {
        Some(comment) => mz_zip_reader_locate_file_v2(&zip_archive, p_archive_name, Some(comment), flags),
        None => mz_zip_reader_locate_file_v2(&zip_archive, p_archive_name, None, flags),
    };

    let result = match file_index {
        Some(index) => {
            let data = mz_zip_reader_extract_to_heap(&zip_archive, index, flags);
            match data {
                Some(vec) => Ok(Some(vec)),
                None => {
                    let err = zip_archive.m_last_error;
                    mz_zip_reader_end_internal(&mut zip_archive, false);
                    Err(err)
                }
            }
        }
        None => {
            // File not found, but archive is valid
            let err = zip_archive.m_last_error;
            mz_zip_reader_end_internal(&mut zip_archive, false);
            if err == ZipError::FileNotFound {
                Ok(None)
            } else {
                Err(err)
            }
        }
    };

    // Clean up if not already done
    if matches!(result, Ok(Some(_))) {
        mz_zip_reader_end_internal(&mut zip_archive, true);
    }
    
    result
}

/// Extract a specific file from a zip archive to heap memory (without comment)
pub fn mz_zip_extract_archive_file_to_heap(
    p_zip_filename: &str,
    p_archive_name: &str,
    flags: u32,
) -> Result<Option<Vec<u8>>, ZipError> {
    mz_zip_extract_archive_file_to_heap_v2(p_zip_filename, p_archive_name, None, flags)
}

/// Get the current mode of the zip archive
pub fn mz_zip_get_mode(p_zip: &ZipArchive) -> ZipMode {
    p_zip.m_zip_mode
}

/// Get the current type of the zip archive
pub fn mz_zip_get_type(p_zip: &ZipArchive) -> ZipType {
    p_zip.m_zip_type
}

/// Set the last error for a zip archive and return the previous error
pub fn mz_zip_set_last_error(p_zip: &mut ZipArchive, err_num: ZipError) -> ZipError {
    mem::replace(&mut p_zip.m_last_error, err_num)
}

/// Peek at the last error without clearing it
pub fn mz_zip_peek_last_error(p_zip: &ZipArchive) -> ZipError {
    p_zip.m_last_error
}

/// Clear the last error (set to no error) and return the previous error
pub fn mz_zip_clear_last_error(p_zip: &mut ZipArchive) -> ZipError {
    mz_zip_set_last_error(p_zip, ZipError::NoError)
}

/// Get the last error and clear it (set to no error)
pub fn mz_zip_get_last_error(p_zip: &mut ZipArchive) -> ZipError {
    mem::replace(&mut p_zip.m_last_error, ZipError::NoError)
}

