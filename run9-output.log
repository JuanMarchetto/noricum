            let _p_file_comment: &[u8] = &[];
            
            if let Some(comment) = p_comment {
                let _ = comment.as_bytes();
            }
        }
        
        if false {
            let (_p_filename_adj, _filename_len_adj) = (_p_filename, _filename_len);
            
            if false {
                if let Some(index) = p_index {
