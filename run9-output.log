pub fn mz_zip_zero_struct(zip: &mut ZipArchive) {
    *zip = ZipArchive::new();
}

fn mz_zip_reader_end_internal(zip: &mut ZipArchive, set_last_error: MzBool) -> Result<()> {
    if zip.state.is_none() {
        if set_last_error {
            return zip.set_error(ZipError::InvalidParameter);
        }
        return Ok(());
    }

    // Take ownership of the state
    let state = zip.state.take().unwrap();
    
    // Close file if open
    if let Some(file) = state.file {
        drop(file); // File will be closed when dropped
    }

    // Memory is managed by Vec/Box, so no explicit free needed
    
    zip.zip_type = ZipType::Invalid;
    Ok(())
}

pub fn mz_zip_reader_end(zip: &mut ZipArchive) -> Result<()> {
    mz_zip_reader_end_internal(zip, MZ_TRUE)
}

