pub fn mz_zip_compute_crc32_callback(p_opaque: &mut dyn std::any::Any, _file_ofs: u64, p_buf: &[u8]) -> usize {
    if let Some(crc) = p_opaque.downcast_mut::<u32>() {
        *crc = mz_crc32(*crc as u64, p_buf);
        p_buf.len()
    } else {
        0
    }
}

