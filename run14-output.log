pub fn mz_zip_reader_extract_to_heap(
    pZip: &mut mz_zip_archive,
    file_index: mz_uint,
    pSize: &mut usize,
    flags: mz_uint,
) -> Option<Vec<u8>> {
    let mut file_stat = mz_zip_archive_file_stat {
        m_file_index: 0,
        m_central_dir_ofs: 0,
        m_version_made_by: 0,
        m_version_needed: 0,
        m_bit_flag: 0,
        m_method: 0,
        m_time: 0,
        m_crc32: 0,
        m_comp_size: 0,
        m_uncomp_size: 0,
        m_internal_attr: 0,
        m_external_attr: 0,
        m_local_header_ofs: 0,
        m_filename: String::new(),
        m_comment: Vec::new(),
        m_comment_size: 0,
        m_is_directory: false,
        m_is_encrypted: false,
        m_is_supported: false,
    };
    
    *pSize = 0;
    
    if !mz_zip_reader_file_stat(pZip, file_index, &mut file_stat) {
        return None;
    }
    
    let alloc_size = if flags & MZ_ZIP_FLAG_COMPRESSED_DATA != 0 {
        file_stat.m_comp_size
    } else {
        file_stat.m_uncomp_size
    } as usize;
    
    if mem::size_of::<usize>() == 4 && alloc_size > i32::MAX as usize {
        mz_zip_set_error(pZip, MZ_ZIP_INTERNAL_ERROR);
        return None;
    }
    
    let mut pBuf = vec![0u8; alloc_size];
    
    if !mz_zip_reader_extract_to_mem_no_alloc1(pZip, file_index, &mut pBuf, alloc_size, flags, None, 0, Some(&file_stat)) {
        return None;
    }
    
    *pSize = alloc_size;
    Some(pBuf)
}

pub fn mz_zip_reader_extract_file_to_heap(
    pZip: &mut mz_zip_archive,
    pFilename: &str,
    pSize: &mut usize,
    flags: mz_uint,
) -> Option<Vec<u8>> {
    let mut file_index = 0;
    if !mz_zip_reader_locate_file_v2(pZip, pFilename, None, flags, &mut file_index) {
        *pSize = 0;
        return None;
    }
    mz_zip_reader_extract_to_heap(pZip, file_index, pSize, flags)
}

// --- Module: mz_p4 ---
// From the C code, we need these constants
const TINFL_LZ_DICT_SIZE: usize = 32768;

// Already defined in migration context, but we need to reference them

// File stat structure - not defined in migration context
#[derive(Clone, Debug)]
pub struct MzZipArchiveFileStat {
    pub m_is_directory: bool,
    pub m_is_supported: bool,
    pub m_method: u16,
    pub m_bit_flag: u16,
    pub m_comp_size: u64,
    pub m_uncomp_size: u64,
    pub m_local_header_ofs: u64,
    pub m_crc32: u32,
    pub m_time: u32,
}

// Iterator state for streaming extraction
pub struct MzZipReaderExtractIterState<'a> {
    pub p_zip: &'a mut MzZipArchive,
    pub file_stat: MzZipArchiveFileStat,
    pub flags: u32,
    pub status: TinflStatus,
    pub file_crc32: u32,
    pub read_buf_ofs: usize,
    pub out_buf_ofs: u64,
    pub p_read_buf: Option<Vec<u8>>,
    pub p_write_buf: Option<Vec<u8>>,
    pub out_blk_remain: usize,
    pub inflator: tinfl::DecompressorOxide,
    pub read_buf_size: u64,
    pub read_buf_avail: u64,
    pub comp_remaining: u64,
    pub cur_file_ofs: u64,
}

// Callback type for writing data (similar to C's mz_file_write_func)
pub type MzFileWriteFunc = dyn FnMut(&mut dyn std::any::Any, u64, &[u8]) -> usize;

// Already defined in migration context, but we need to re-export for completeness
pub fn mz_zip_set_error(p_zip: &mut MzZipArchive, error: MzZipError) {
    p_zip.m_last_error = error;
}

// CRC32 function from migration context
pub fn mz_crc32(initial_crc: u64, buf: &[u8]) -> u32 {
    let mut crc = initial_crc as u32;
    let table = crate::CRC32_TABLE; // Assuming this is defined elsewhere
    
    for &byte in buf {
        crc = table[((crc ^ (byte as u32)) & 0xFF) as usize] ^ (crc >> 8);
    }
    crc
}

// Read little-endian 32-bit value
fn read_le32(data: &[u8]) -> u32 {
    u32::from_le_bytes([data[0], data[1], data[2], data[3]])
}

// Read little-endian 16-bit value
fn read_le16(data: &[u8]) -> u16 {
    u16::from_le_bytes([data[0], data[1]])
}

