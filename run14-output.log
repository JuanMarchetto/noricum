/// Zero out a ZIP archive structure
pub fn mz_zip_zero_struct(p_zip: &mut MzZipArchive) {
    *p_zip = MzZipArchive::new();
}

/// Internal function to end reading a ZIP archive
fn mz_zip_reader_end_internal(p_zip: &mut MzZipArchive, set_last_error: bool) -> bool {
    if p_zip.m_zip_mode != MzZipMode::Reading {
        if set_last_error {
            p_zip.m_last_error = MzZipError::InvalidParameter;
        }
        return false;
    }

    if let Some(state) = p_zip.m_pstate.take() {
        // Arrays are cleared when dropped (RAII)
        
        #[cfg(not(feature = "miniz_no_stdio"))]
        {
            if let Some(mut file) = state.pfile {
                if p_zip.m_zip_type == MzZipType::File {
                    if let Err(_) = file.flush() {
                        if set_last_error {
                            p_zip.m_last_error = MzZipError::FileCloseFailed;
                        }
                        return false;
                    }
                }
                // File is closed when dropped (RAII)
            }
        }
    }
    
    p_zip.m_zip_mode = MzZipMode::Invalid;
    true
}

/// End reading a ZIP archive
pub fn mz_zip_reader_end(p_zip: &mut MzZipArchive) -> bool {
    mz_zip_reader_end_internal(p_zip, true)
}

