/// Initialize ZIP writer
pub fn mz_zip_writer_init_v2(
    p_zip: &mut MzZipArchive,
    existing_size: u64,
    flags: u32
) -> Result<(), MzZipError> {
    let zip64 = (flags & MZ_ZIP_FLAG_WRITE_ZIP64) != 0;
    
    if p_zip.m_pstate.is_some() || p_zip.m_zip_mode != MzZipMode::Invalid {
        return Err(MzZipError::InvalidParameter);
    }
    
    if flags & MZ_ZIP_FLAG_WRITE_ALLOW_READING != 0 {
        // Reading capability needed
    }
    
    // Check file offset alignment is power of 2
    if p_zip.m_file_offset_alignment != 0 && 
       (p_zip.m_file_offset_alignment & (p_zip.m_file_offset_alignment - 1)) != 0 {
        return Err(MzZipError::InvalidParameter);
    }
    
    p_zip.m_archive_size = existing_size;
    p_zip.m_central_directory_file_ofs = 0;
    p_zip.m_total_files = 0;
    
    // Create internal state
    let state = MzZipInternalState {
        central_dir: MzZipArray::new(1), // bytes
        central_dir_offsets: MzZipArray::new(4), // u32
        sorted_central_dir_offsets: MzZipArray::new(4), // u32
        init_flags: 0,
        zip64,
        zip64_has_extended_info_fields: zip64,
        pfile: None,
        file_archive_start_ofs: 0,
        pmem: None,
        mem_size: 0,
        mem_capacity: 0,
    };
    
    p_zip.m_pstate = Some(Box::new(state));
    p_zip.m_zip_type = MzZipType::User;
    p_zip.m_zip_mode = MzZipMode::Writing;
    
    Ok(())
}

/// Initialize ZIP writer (simple version)
pub fn mz_zip_writer_init(
    p_zip: &mut MzZipArchive,
    existing_size: u64
) -> Result<(), MzZipError> {
    mz_zip_writer_init_v2(p_zip, existing_size, 0)
}

/// Initialize heap-based ZIP writer
pub fn mz_zip_writer_init_heap_v2(
    p_zip: &mut MzZipArchive,
    size_to_reserve_at_beginning: usize,
    initial_allocation_size: usize,
    flags: u32
) -> Result<(), MzZipError> {
    p_zip.m_pwrite = Some(Box::new(mz_zip_heap_write_func));
    p_zip.m_pneeds_keepalive = None;
    
    if flags & MZ_ZIP_FLAG_WRITE_ALLOW_READING != 0 {
        // Set read callback if needed
    }
    
    p_zip.m_pio_opaque = p_zip as *mut _ as *mut std::ffi::c_void;
    
    mz_zip_writer_init_v2(p_zip, size_to_reserve_at_beginning as u64, flags)?;
    
    p_zip.m_zip_type = MzZipType::Heap;
    
    let initial_allocation_size = initial_allocation_size.max(size_to_reserve_at_beginning);
    if initial_allocation_size != 0 {
        let p_state = p_zip.m_pstate.as_mut().unwrap();
        let mut mem = Vec::with_capacity(initial_allocation_size);
        mem.resize(initial_allocation_size, 0);
        p_state.pmem = Some(mem);
        p_state.mem_capacity = initial_allocation_size;
    }
    
    Ok(())
}

/// Initialize heap-based ZIP writer (simple version)
pub fn mz_zip_writer_init_heap(
    p_zip: &mut MzZipArchive,
    size_to_reserve_at_beginning: usize,
    initial_allocation_size: usize
) -> Result<(), MzZipError> {
    mz_zip_writer_init_heap_v2(p_zip, size_to_reserve_at_beginning, initial_allocation_size, 0)
}

/// File write callback function
#[cfg(not(feature = "no_stdio"))]
pub fn mz_zip_file_write_func(
    p_opaque: &mut MzZipArchive,
    file_ofs: u64,
    p_buf: &[u8],
    n: usize
) -> usize {
    
    let p_state = match p_opaque.m_pstate.as_mut() {
        Some(state) => state,
        None => {
            p_opaque.m_last_error = MzZipError::InvalidParameter;
            return 0;
        }
    };
    
    let file = match &mut p_state.pfile {
        Some(f) => f,
        None => {
            p_opaque.m_last_error = MzZipError::InvalidParameter;
            return 0;
        }
    };
    
    let target_ofs = file_ofs + p_state.file_archive_start_ofs;
    
    // Seek to position
    if let Err(_) = file.seek(std::io::SeekFrom::Start(target_ofs)) {
        p_opaque.m_last_error = MzZipError::FileSeekFailed;
        return 0;
    }
    
    // Write data
    match file.write(p_buf) {
        Ok(bytes_written) => bytes_written,
        Err(_) => {
            p_opaque.m_last_error = MzZipError::FileWriteFailed;
            0
        }
    }
}

/// Initialize file-based ZIP writer (simple version)
#[cfg(not(feature = "no_stdio"))]
pub fn mz_zip_writer_init_file(
    p_zip: &mut MzZipArchive,
    p_filename: &str,
    size_to_reserve_at_beginning: u64
) -> Result<(), MzZipError> {
    mz_zip_writer_init_file_v2(p_zip, p_filename, size_to_reserve_at_beginning, 0)
}

/// Initialize file-based ZIP writer with flags
#[cfg(not(feature = "no_stdio"))]
pub fn mz_zip_writer_init_file_v2(
    p_zip: &mut MzZipArchive,
    p_filename: &str,
    size_to_reserve_at_beginning: u64,
    flags: u32
) -> Result<(), MzZipError> {
    
    p_zip.m_pwrite = Some(Box::new(mz_zip_file_write_func));
    p_zip.m_pneeds_keepalive = None;
    
    if flags & MZ_ZIP_FLAG_WRITE_ALLOW_READING != 0 {
        // Set read callback if needed
    }
    
    p_zip.m_pio_opaque = p_zip as *mut _ as *mut std::ffi::c_void;
    
    mz_zip_writer_init_v2(p_zip, size_to_reserve_at_beginning, flags)?;
    
    // Open file
    let mode = if flags & MZ_ZIP_FLAG_WRITE_ALLOW_READING != 0 {
        "w+b"
    } else {
        "wb"
    };
    
    let file = OpenOptions::new()
        .read(flags & MZ_ZIP_FLAG_WRITE_ALLOW_READING != 0)
        .write(true)
        .create(true)
        .truncate(true)
        .open(p_filename)
        .map_err(|_| MzZipError::FileOpenFailed)?;
    
    let p_state = p_zip.m_pstate.as_mut().unwrap();
    p_state.pfile = Some(Box::new(file));
    p_zip.m_zip_type = MzZipType::File;
    
    // Reserve space at beginning if requested
    if size_to_reserve_at_beginning != 0 {
        let mut cur_ofs = 0;
        let mut remaining = size_to_reserve_at_beginning;
        let buf = [0u8; 4096];
        
        while remaining > 0 {
            let n = (buf.len() as u64).min(remaining) as usize;
            if mz_zip_file_write_func(p_zip, cur_ofs, &buf[..n], n) != n {
                let _ = mz_zip_writer_end_internal(p_zip, true);
                return Err(MzZipError::FileWriteFailed);
            }
            cur_ofs += n as u64;
            remaining -= n as u64;
        }
    }
    
    Ok(())
}

