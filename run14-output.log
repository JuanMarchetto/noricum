            }
            'w' => {
                options.write(true);
                options.create(true);
                options.truncate(true);
                if second == Some('+') {
                    options.read(true);
                }
                if third == Some('b') || (second == Some('+') && third == Some('b')) {
                    // Binary mode - no-op in Rust
                }
            }
            'a' => {
                options.write(true);
                options.create(true);
                options.append(true);
                if second == Some('+') {
                    options.read(true);
                }
                if third == Some('b') || (second == Some('+') && third == Some('b')) {
                    // Binary mode - no-op in Rust
                }
            }
            _ => return Err(std::io::Error::new(
                std::io::ErrorKind::InvalidInput,
                "Invalid mode string"
            )),
        }
        
        options.open(filename)
    }

    /// Non-Windows freopen
    pub fn freopen_utf8(
        p_path: &str,
        p_mode: &str,
        stream: &mut std::fs::File,
    ) -> Result<std::fs::File, std::io::Error> {
        drop(stream); // Close the old file
        fopen_utf8(p_path, p_mode)
    }

    /// Non-Windows stat
    pub fn stat_utf8(path: &str) -> Result<std::fs::Metadata, std::io::Error> {
        std::fs::metadata(path)
    }

    /// Non-Windows stat64
    pub fn stat64_utf8(path: &str) -> Result<std::fs::Metadata, std::io::Error> {
        std::fs::metadata(path)
    }
}

// Public functions that handle platform differences
pub fn mz_fopen(p_filename: &str, p_mode: &str) -> Result<std::fs::File, std::io::Error> {
    #[cfg(windows)]
    return windows::fopen_utf8(p_filename, p_mode);
    
    #[cfg(not(windows))]
    return posix::fopen_utf8(p_filename, p_mode);
}

pub fn mz_freopen(
    p_path: &str,
    p_mode: &str,
    p_stream: &mut std::fs::File,
) -> Result<std::fs::File, std::io::Error> {
    #[cfg(windows)]
    return windows::freopen_utf8(p_path, p_mode, p_stream);
    
    #[cfg(not(windows))]
    return posix::freopen_utf8(p_path, p_mode, p_stream);
}

pub fn mz_stat(path: &str) -> Result<std::fs::Metadata, std::io::Error> {
    #[cfg(windows)]
    return windows::stat_utf8(path);
    
    #[cfg(not(windows))]
    return posix::stat_utf8(path);
}

pub fn mz_stat64(path: &str) -> Result<std::fs::Metadata, std::io::Error> {
    #[cfg(windows)]
    return windows::stat64_utf8(path);
    
    #[cfg(not(windows))]
    return posix::stat64_utf8(path);
}

