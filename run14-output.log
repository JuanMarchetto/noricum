// Main extraction function
pub fn mz_zip_reader_extract_to_callback(
    p_zip: &mut MzZipArchive,
    file_index: u32,
    mut p_callback: Box<MzFileWriteFunc>,
    p_opaque: &mut dyn std::any::Any,
    flags: u32,
) -> Result<bool, MzZipError> {
    let mut file_crc32 = MZ_CRC32_INIT;
    let mut file_stat = MzZipArchiveFileStat {
        m_is_directory: false,
        m_is_supported: false,
        m_method: 0,
        m_bit_flag: 0,
        m_comp_size: 0,
        m_uncomp_size: 0,
        m_local_header_ofs: 0,
        m_crc32: 0,
        m_time: 0,
    };

    if p_zip.m_pstate.is_none() || p_zip.m_pstate.as_ref().unwrap().central_dir.p.is_none() {
        return Err(MzZipError::InvalidParameter);
    }

    // Get file stat
    if !mz_zip_reader_file_stat(p_zip, file_index, &mut file_stat) {
        return Ok(false);
    }

    // Directory or zero length file
    if file_stat.m_is_directory || file_stat.m_comp_size == 0 {
        return Ok(true);
    }

    // Check encryption
    if file_stat.m_bit_flag & (MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_IS_ENCRYPTED 
        | MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_USES_STRONG_ENCRYPTION 
        | MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_COMPRESSED_PATCH_FLAG) != 0 {
        mz_zip_set_error(p_zip, MzZipError::UnsupportedEncryption);
        return Ok(false);
    }

    // Check method
    if (flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) == 0 
        && file_stat.m_method != 0 
        && file_stat.m_method != MZ_DEFLATED {
        mz_zip_set_error(p_zip, MzZipError::UnsupportedMethod);
        return Ok(false);
    }

    // Read local header
    let mut local_header = vec![0u8; MZ_ZIP_LOCAL_DIR_HEADER_SIZE];
    let cur_file_ofs = file_stat.m_local_header_ofs;
    
    let state = p_zip.m_pstate.as_ref().unwrap();
    let bytes_read = state.read_data(cur_file_ofs, &mut local_header)?;
    
    if bytes_read != MZ_ZIP_LOCAL_DIR_HEADER_SIZE {
        mz_zip_set_error(p_zip, MzZipError::FileReadFailed);
        return Ok(false);
    }

    if read_le32(&local_header) != MZ_ZIP_LOCAL_DIR_HEADER_SIG {
        mz_zip_set_error(p_zip, MzZipError::InvalidHeaderOrCorrupted);
        return Ok(false);
    }

    let filename_len = read_le16(&local_header[MZ_ZIP_LDH_FILENAME_LEN_OFS..]) as u64;
    let extra_len = read_le16(&local_header[MZ_ZIP_LDH_EXTRA_LEN_OFS..]) as u64;
    let mut cur_file_ofs = cur_file_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + filename_len + extra_len;

    if cur_file_ofs + file_stat.m_comp_size > p_zip.m_archive_size {
        mz_zip_set_error(p_zip, MzZipError::InvalidHeaderOrCorrupted);
        return Ok(false);
    }

    // Prepare for extraction
    let mut read_buf = Vec::new();
    let mut write_buf = Vec::new();
    let mut status = TinflStatus::Done;
    let mut out_buf_ofs = 0u64;
    let mut comp_remaining = file_stat.m_comp_size;

    if state.pmem.is_some() {
        // Memory-based extraction
        if (flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) != 0 || file_stat.m_method == 0 {
            // Stored or compressed data requested
            let pmem = state.pmem.as_ref().unwrap();
            let start = (state.file_archive_start_ofs + cur_file_ofs) as usize;
            let end = start + file_stat.m_comp_size as usize;
            
            if end > pmem.len() {
                mz_zip_set_error(p_zip, MzZipError::InternalError);
                return Ok(false);
            }

            let data = &pmem[start..end];
            let written = p_callback(p_opaque, out_buf_ofs, data);
            
            if written != data.len() {
                mz_zip_set_error(p_zip, MzZipError::WriteCallbackFailed);
                status = TinflStatus::Failed;
            } else if (flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) == 0 {
                file_crc32 = mz_crc32(file_crc32 as u64, data);
            }
        }
    } else {
        // File-based extraction
        if (flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) != 0 || file_stat.m_method == 0 {
            // Stored or compressed data requested
            let mut read_buf = vec![0u8; MZ_ZIP_MAX_IO_BUF_SIZE as usize];
            
            while comp_remaining > 0 {
                let to_read = std::cmp::min(read_buf.len() as u64, comp_remaining) as usize;
                let bytes_read = state.read_data(cur_file_ofs, &mut read_buf[..to_read])?;
                
                if bytes_read != to_read {
                    mz_zip_set_error(p_zip, MzZipError::FileReadFailed);
                    status = TinflStatus::Failed;
                    break;
                }

                if (flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) == 0 {
                    file_crc32 = mz_crc32(file_crc32 as u64, &read_buf[..bytes_read]);
                }

                let written = p_callback(p_opaque, out_buf_ofs, &read_buf[..bytes_read]);
                if written != bytes_read {
                    mz_zip_set_error(p_zip, MzZipError::WriteCallbackFailed);
                    status = TinflStatus::Failed;
                    break;
                }

                cur_file_ofs += bytes_read as u64;
                out_buf_ofs += bytes_read as u64;
                comp_remaining -= bytes_read as u64;
            }
        } else {
            // Deflate decompression
            let mut inflator = tinfl::DecompressorOxide::new();
            write_buf = vec![0u8; TINFL_LZ_DICT_SIZE];
            read_buf = vec![0u8; std::cmp::min(file_stat.m_comp_size, MZ_ZIP_MAX_IO_BUF_SIZE) as usize];
            
            let mut read_buf_avail = 0;
            let mut read_buf_ofs = 0;
            
            loop {
                let out_buf_ofs_mod = (out_buf_ofs as usize) & (TINFL_LZ_DICT_SIZE - 1);
                let out_buf_size = TINFL_LZ_DICT_SIZE - out_buf_ofs_mod;
                
                if read_buf_avail == 0 && comp_remaining > 0 {
                    let to_read = std::cmp::min(read_buf.len() as u64, comp_remaining) as usize;
                    let bytes_read = state.read_data(cur_file_ofs, &mut read_buf[..to_read])?;
                    
                    if bytes_read != to_read {
                        mz_zip_set_error(p_zip, MzZipError::FileReadFailed);
                        status = TinflStatus::Failed;
                        break;
                    }
                    
                    cur_file_ofs += bytes_read as u64;
                    comp_remaining -= bytes_read as u64;
                    read_buf_avail = bytes_read;
                    read_buf_ofs = 0;
                }
                
                let in_buf_size = read_buf_avail;
                let mut out_buf_size_var = out_buf_size;
                
                let flags = if comp_remaining > 0 { 
                    tinfl::MZ_TINFL_FLAG_HAS_MORE_INPUT 
                } else { 
                    0 
                };
                
                let result = tinfl::decompress(
                    &mut inflator,
                    &read_buf[read_buf_ofs..read_buf_ofs + in_buf_size],
                    &mut write_buf[out_buf_ofs_mod..out_buf_ofs_mod + out_buf_size_var],
                    flags,
                );
                
                read_buf_avail -= result.bytes_consumed;
                read_buf_ofs += result.bytes_consumed;
                
                if result.bytes_written > 0 {
                    let written = p_callback(
                        p_opaque, 
                        out_buf_ofs, 
                        &write_buf[out_buf_ofs_mod..out_buf_ofs_mod + result.bytes_written]
                    );
                    
                    if written != result.bytes_written {
                        mz_zip_set_error(p_zip, MzZipError::WriteCallbackFailed);
                        status = TinflStatus::Failed;
                        break;
                    }
                    
                    file_crc32 = mz_crc32(file_crc32 as u64, 
                        &write_buf[out_buf_ofs_mod..out_buf_ofs_mod + result.bytes_written]);
                    
                    out_buf_ofs += result.bytes_written as u64;
                    
                    if out_buf_ofs > file_stat.m_uncomp_size {
                        mz_zip_set_error(p_zip, MzZipError::DecompressionFailed);
                        status = TinflStatus::Failed;
                        break;
                    }
                }
                
                match result.status {
                    tinfl::Status::Done => {
                        status = TinflStatus::Done;
                        break;
                    }
                    tinfl::Status::Failed => {
                        status = TinflStatus::Failed;
                        break;
                    }
                    tinfl::Status::NeedsMoreInput | tinfl::Status::HasMoreOutput => {
                        continue;
                    }
                }
            }
        }
    }

    // Final validation
    if status == TinflStatus::Done && (flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) == 0 {
        if out_buf_ofs != file_stat.m_uncomp_size {
            mz_zip_set_error(p_zip, MzZipError::UnexpectedDecompressedSize);
            status = TinflStatus::Failed;
        } else if file_crc32 != file_stat.m_crc32 {
            mz_zip_set_error(p_zip, MzZipError::DecompressionFailed);
            status = TinflStatus::Failed;
        }
    }

    Ok(status == TinflStatus::Done)
}

pub fn mz_zip_reader_extract_file_to_callback(
    p_zip: &mut MzZipArchive,
    p_filename: &str,
    p_callback: Box<MzFileWriteFunc>,
    p_opaque: &mut dyn std::any::Any,
    flags: u32,
) -> Result<bool, MzZipError> {
    let mut file_index = 0u32;
    if !mz_zip_reader_locate_file_v2(p_zip, p_filename, None, flags, &mut file_index) {
        return Ok(false);
    }

    mz_zip_reader_extract_to_callback(p_zip, file_index, p_callback, p_opaque, flags)
}

pub fn mz_zip_reader_extract_iter_new<'a>(
    p_zip: &'a mut MzZipArchive,
    file_index: u32,
    flags: u32,
) -> Result<Box<MzZipReaderExtractIterState<'a>>, MzZipError> {
    let mut file_stat = MzZipArchiveFileStat {
        m_is_directory: false,
        m_is_supported: false,
        m_method: 0,
        m_bit_flag: 0,
        m_comp_size: 0,
        m_uncomp_size: 0,
        m_local_header_ofs: 0,
        m_crc32: 0,
        m_time: 0,
    };

    if p_zip.m_pstate.is_none() {
        return Err(MzZipError::InvalidParameter);
    }

    // Get file stat
    if !mz_zip_reader_file_stat(p_zip, file_index, &mut file_stat) {
        return Err(MzZipError::FileNotFound);
    }

    // Check encryption
    if file_stat.m_bit_flag & (MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_IS_ENCRYPTED 
        | MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_USES_STRONG_ENCRYPTION 
        | MZ_ZIP_GENERAL_PURPOSE_BIT_FLAG_COMPRESSED_PATCH_FLAG) != 0 {
        mz_zip_set_error(p_zip, MzZipError::UnsupportedEncryption);
        return Err(MzZipError::UnsupportedEncryption);
    }

    // Check method
    if (flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) == 0 
        && file_stat.m_method != 0 
        && file_stat.m_method != MZ_DEFLATED {
        mz_zip_set_error(p_zip, MzZipError::UnsupportedMethod);
        return Err(MzZipError::UnsupportedMethod);
    }

    // Read local header
    let mut local_header = vec![0u8; MZ_ZIP_LOCAL_DIR_HEADER_SIZE];
    let state = p_zip.m_pstate.as_ref().unwrap();
    let cur_file_ofs = file_stat.m_local_header_ofs;
    
    let bytes_read = state.read_data(cur_file_ofs, &mut local_header)?;
    
    if bytes_read != MZ_ZIP_LOCAL_DIR_HEADER_SIZE {
        mz_zip_set_error(p_zip, MzZipError::FileReadFailed);
        return Err(MzZipError::FileReadFailed);
    }

    if read_le32(&local_header) != MZ_ZIP_LOCAL_DIR_HEADER_SIG {
        mz_zip_set_error(p_zip, MzZipError::InvalidHeaderOrCorrupted);
        return Err(MzZipError::InvalidHeaderOrCorrupted);
    }

    let filename_len = read_le16(&local_header[MZ_ZIP_LDH_FILENAME_LEN_OFS..]) as u64;
    let extra_len = read_le16(&local_header[MZ_ZIP_LDH_EXTRA_LEN_OFS..]) as u64;
    let cur_file_ofs = cur_file_ofs + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 + filename_len + extra_len;

    if cur_file_ofs + file_stat.m_comp_size > p_zip.m_archive_size {
        mz_zip_set_error(p_zip, MzZipError::InvalidHeaderOrCorrupted);
        return Err(MzZipError::InvalidHeaderOrCorrupted);
    }

    // Create iterator state
    let mut iter_state = Box::new(MzZipReaderExtractIterState {
        p_zip,
        file_stat,
        flags,
        status: TinflStatus::Done,
        file_crc32: MZ_CRC32_INIT,
        read_buf_ofs: 0,
        out_buf_ofs: 0,
        p_read_buf: None,
        p_write_buf: None,
        out_blk_remain: 0,
        inflator: tinfl::DecompressorOxide::new(),
        read_buf_size: 0,
        read_buf_avail: 0,
        comp_remaining: 0,
        cur_file_ofs,
    });

    let state_ref = iter_state.p_zip.m_pstate.as_ref().unwrap();
    
    if state_ref.pmem.is_some() {
        // Memory-based
        iter_state.comp_remaining = iter_state.file_stat.m_comp_size;
    } else {
        // File-based
        if (flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) == 0 && iter_state.file_stat.m_method != 0 {
            // Decompression required
            iter_state.read_buf_size = std::cmp::min(
                iter_state.file_stat.m_comp_size, 
                MZ_ZIP_MAX_IO_BUF_SIZE
            );
            iter_state.p_read_buf = Some(vec![0u8; iter_state.read_buf_size as usize]);
            iter_state.p_write_buf = Some(vec![0u8; TINFL_LZ_DICT_SIZE]);
        } else {
            // No decompression
            iter_state.read_buf_size = 0;
        }
        iter_state.comp_remaining = iter_state.file_stat.m_comp_size;
    }

    Ok(iter_state)
}

pub fn mz_zip_reader_extract_file_iter_new<'a>(
    p_zip: &'a mut MzZipArchive,
    p_filename: &str,
    flags: u32,
) -> Result<Box<MzZipReaderExtractIterState<'a>>, MzZipError> {
    let mut file_index = 0u32;
    if !mz_zip_reader_locate_file_v2(p_zip, p_filename, None, flags, &mut file_index) {
        return Err(MzZipError::FileNotFound);
    }

    mz_zip_reader_extract_iter_new(p_zip, file_index, flags)
}

pub fn mz_zip_reader_extract_iter_read(
    p_state: &mut MzZipReaderExtractIterState,
    pv_buf: &mut [u8],
    buf_size: usize,
) -> Result<usize, MzZipError> {
    let mut copied_to_caller = 0;
    
    if pv_buf.is_empty() || buf_size == 0 {
        return Ok(0);
    }

    let state = p_state.p_zip.m_pstate.as_ref().ok_or(MzZipError::InvalidParameter)?;
    
    if (p_state.flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) != 0 || p_state.file_stat.m_method == 0 {
        // Stored or compressed data requested
        let to_copy = std::cmp::min(buf_size, p_state.comp_remaining as usize);
        
        if state.pmem.is_some() {
            // Memory-based
            let pmem = state.pmem.as_ref().unwrap();
            let start = (state.file_archive_start_ofs + p_state.cur_file_ofs) as usize;
            
            if start >= pmem.len() {
                return Ok(0);
            }
            
            let end = std::cmp::min(start + to_copy, pmem.len());
            let actual_copy = end - start;
            
            pv_buf[..actual_copy].copy_from_slice(&pmem[start..end]);
            copied_to_caller = actual_copy;
        } else {
            // File-based
            let bytes_read = state.read_data(p_state.cur_file_ofs, &mut pv_buf[..to_copy])?;
            copied_to_caller = bytes_read;
        }

        // Update CRC if not compressed data
        if (p_state.flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) == 0 {
            p_state.file_crc32 = mz_crc32(p_state.file_crc32 as u64, &pv_buf[..copied_to_caller]);
        }

        p_state.cur_file_ofs += copied_to_caller as u64;
        p_state.out_buf_ofs += copied_to_caller as u64;
        p_state.comp_remaining -= copied_to_caller as u64;
    } else {
        // Deflate decompression
        while copied_to_caller < buf_size && p_state.status != TinflStatus::Failed {
            if p_state.out_blk_remain == 0 {
                // Need to decompress more data
                if p_state.read_buf_avail == 0 && state.pmem.is_none() {
                    // Read from file
                    let read_buf = p_state.p_read_buf.as_mut().ok_or(MzZipError::InternalError)?;
                    let to_read = std::cmp::min(read_buf.len(), p_state.comp_remaining as usize) as u64;
                    
                    let bytes_read = state.read_data(p_state.cur_file_ofs, &mut read_buf[..to_read as usize])?;
                    p_state.read_buf_avail = bytes_read as u64;
                    p_state.cur_file_ofs += bytes_read as u64;
                    p_state.comp_remaining -= bytes_read as u64;
                    p_state.read_buf_ofs = 0;
                }

                let in_buf_size = p_state.read_buf_avail as usize;
                let out_buf_ofs_mod = (p_state.out_buf_ofs as usize) & (TINFL_LZ_DICT_SIZE - 1);
                let out_buf_size = TINFL_LZ_DICT_SIZE - out_buf_ofs_mod;
                
                let flags = if p_state.comp_remaining > 0 { 
                    tinfl::MZ_TINFL_FLAG_HAS_MORE_INPUT 
                } else { 
                    0 
                };
                
                let write_buf = p_state.p_write_buf.as_mut().ok_or(MzZipError::InternalError)?;
                let read_buf = p_state.p_read_buf.as_ref().ok_or(MzZipError::InternalError)?;
                
                let result = tinfl::decompress(
                    &mut p_state.inflator,
                    &read_buf[p_state.read_buf_ofs..p_state.read_buf_ofs + in_buf_size],
                    &mut write_buf[out_buf_ofs_mod..out_buf_ofs_mod + out_buf_size],
                    flags,
                );
                
                p_state.read_buf_avail -= result.bytes_consumed as u64;
                p_state.read_buf_ofs += result.bytes_consumed;
                p_state.out_blk_remain = result.bytes_written;
                p_state.status = match result.status {
                    tinfl::Status::Done => TinflStatus::Done,
                    tinfl::Status::Failed => TinflStatus::Failed,
                    tinfl::Status::NeedsMoreInput => TinflStatus::NeedMoreInput,
                    tinfl::Status::HasMoreOutput => TinflStatus::HasMoreOutput,
                };
            }

            if p_state.out_blk_remain > 0 {
                let to_copy = std::cmp::min(buf_size - copied_to_caller, p_state.out_blk_remain);
                let out_buf_ofs_mod = (p_state.out_buf_ofs as usize) & (TINFL_LZ_DICT_SIZE - 1);
                let write_buf = p_state.p_write_buf.as_ref().ok_or(MzZipError::InternalError)?;
                
                pv_buf[copied_to_caller..copied_to_caller + to_copy]
                    .copy_from_slice(&write_buf[out_buf_ofs_mod..out_buf_ofs_mod + to_copy]);
                
                // Update CRC
                p_state.file_crc32 = mz_crc32(
                    p_state.file_crc32 as u64, 
                    &write_buf[out_buf_ofs_mod..out_buf_ofs_mod + to_copy]
                );
                
                p_state.out_blk_remain -= to_copy;
                p_state.out_buf_ofs += to_copy as u64;
                copied_to_caller += to_copy;
                
                if p_state.out_buf_ofs > p_state.file_stat.m_uncomp_size {
                    p_state.status = TinflStatus::Failed;
                    break;
                }
            }
            
            if p_state.status == TinflStatus::Done || p_state.status == TinflStatus::Failed {
                break;
            }
        }
    }

    Ok(copied_to_caller)
}

pub fn mz_zip_reader_extract_iter_free(
    p_state: Box<MzZipReaderExtractIterState>,
) -> Result<bool, MzZipError> {
    let status = p_state.status;
    
    // Final validation for decompressed files
    if status == TinflStatus::Done && (p_state.flags & crate::MZ_ZIP_FLAG_COMPRESSED_DATA) == 0 {
        if p_state.out_buf_ofs != p_state.file_stat.m_uncomp_size {
            mz_zip_set_error(p_state.p_zip, MzZipError::UnexpectedDecompressedSize);
            return Ok(false);
        } else if p_state.file_crc32 != p_state.file_stat.m_crc32 {
            mz_zip_set_error(p_state.p_zip, MzZipError::DecompressionFailed);
            return Ok(false);
        }
    }
    
    // Buffers are automatically freed when Box is dropped
    Ok(status == TinflStatus::Done)
}

// File write callback for stdio files
pub fn mz_zip_file_write_callback(p_opaque: &mut dyn std::any::Any, _ofs: u64, p_buf: &[u8]) -> usize {
    if let Some(file) = p_opaque.downcast_mut::<File>() {
        file.write(p_buf).unwrap_or(0)
    } else {
        0
    }
}

pub fn mz_zip_reader_extract_to_file(
    p_zip: &mut MzZipArchive,
    file_index: u32,
    p_dst_filename: &str,
    flags: u32,
) -> Result<bool, MzZipError> {
    let mut file_stat = MzZipArchiveFileStat {
        m_is_directory: false,
        m_is_supported: false,
        m_method: 0,
        m_bit_flag: 0,
        m_comp_size: 0,
        m_uncomp_size: 0,
        m_local_header_ofs: 0,
        m_crc32: 0,
        m_time: 0,
    };

    if !mz_zip_reader_file_stat(p_zip, file_index, &mut file_stat) {
        return Ok(false);
    }

    if file_stat.m_is_directory || !file_stat.m_is_supported {
        mz_zip_set_error(p_zip, MzZipError::UnsupportedFeature);
        return Ok(false);
    }

    let mut file = match File::create(p_dst_filename) {
        Ok(f) => f,
        Err(_) => {
            mz_zip_set_error(p_zip, MzZipError::FileOpenFailed);
            return Ok(false);
        }
    };

    let status = mz_zip_reader_extract_to_callback(
        p_zip,
        file_index,
        Box::new(mz_zip_file_write_callback),
        &mut file,
        flags,
    )?;

    if let Err(_) = file.sync_all() {
        if status {
            mz_zip_set_error(p_zip, MzZipError::FileCloseFailed);
        }
        return Ok(false);
    }

    // Note: File times are not set in this implementation
    // as MINIZ_NO_TIME is typically defined
    
    Ok(status)
}

pub fn mz_zip_reader_extract_file_to_file(
    p_zip: &mut MzZipArchive,
    p_archive_filename: &str,
    p_dst_filename: &str,
    flags: u32,
) -> Result<bool, MzZipError> {
    let mut file_index = 0u32;
    if !mz_zip_reader_locate_file_v2(p_zip, p_archive_filename, None, flags, &mut file_index) {
        return Ok(false);
    }

    mz_zip_reader_extract_to_file(p_zip, file_index, p_dst_filename, flags)
}

