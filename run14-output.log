pub fn mz_zip_file_stat_internal(
    pZip: &mz_zip_archive,
    file_index: mz_uint,
    pCentral_dir_header: &[u8],
    pStat: &mut mz_zip_archive_file_stat,
    pFound_zip64_extra_data: &mut mz_bool,
) -> mz_bool {
    if pCentral_dir_header.is_empty() || pStat.is_none() {
        return mz_zip_set_error(pZip, MZ_ZIP_INVALID_PARAMETER);
    }

    if let Some(found) = pFound_zip64_extra_data {
        *found = MZ_FALSE;
    }

    let p = pCentral_dir_header;

    // Extract fields from the central directory record
    pStat.m_file_index = file_index;
    pStat.m_central_dir_ofs = 0; // Would be set from offsets array
    pStat.m_version_made_by = MZ_READ_LE16(&p[4..]);
    pStat.m_version_needed = MZ_READ_LE16(&p[6..]);
    pStat.m_bit_flag = MZ_READ_LE16(&p[8..]);
    pStat.m_method = MZ_READ_LE16(&p[10..]);
    pStat.m_time = mz_zip_dos_to_time_t(
        MZ_READ_LE16(&p[12..]),
        MZ_READ_LE16(&p[14..]),
    );
    pStat.m_crc32 = MZ_READ_LE32(&p[16..]);
    pStat.m_comp_size = MZ_READ_LE32(&p[20..]) as mz_uint64;
    pStat.m_uncomp_size = MZ_READ_LE32(&p[24..]) as mz_uint64;
    pStat.m_internal_attr = MZ_READ_LE16(&p[36..]);
    pStat.m_external_attr = MZ_READ_LE32(&p[38..]);
    pStat.m_local_header_ofs = MZ_READ_LE32(&p[42..]) as mz_uint64;

    // Copy filename
    let filename_len = MZ_READ_LE16(&p[28..]) as usize;
    let n = MZ_MIN(filename_len, MZ_ZIP_MAX_ARCHIVE_FILENAME_SIZE - 1);
    if n > 0 && p.len() >= MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + n {
        pStat.m_filename = String::from_utf8_lossy(
            &p[MZ_ZIP_CENTRAL_DIR_HEADER_SIZE..MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + n]
        ).to_string();
    }

    // Copy comment
    let comment_len = MZ_READ_LE16(&p[32..]) as usize;
    let extra_len = MZ_READ_LE16(&p[30..]) as usize;
    let n = MZ_MIN(comment_len, MZ_ZIP_MAX_ARCHIVE_FILE_COMMENT_SIZE - 1);
    pStat.m_comment_size = n as mz_uint16;
    
    let comment_start = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + filename_len + extra_len;
    if n > 0 && p.len() >= comment_start + n {
        pStat.m_comment = p[comment_start..comment_start + n].to_vec();
    }

    // Set flags
    pStat.m_is_directory = mz_zip_reader_is_file_a_directory(pZip, file_index);
    pStat.m_is_encrypted = mz_zip_reader_is_file_encrypted(pZip, file_index);
    pStat.m_is_supported = mz_zip_reader_is_file_supported(pZip, file_index);

    // Check for zip64 extended information
    if MZ_MAX(MZ_MAX(pStat.m_comp_size, pStat.m_uncomp_size), pStat.m_local_header_ofs) == MZ_UINT32_MAX as mz_uint64 {
        let mut extra_size_remaining = MZ_READ_LE16(&p[30..]);
        
        if extra_size_remaining > 0 {
            let filename_len = MZ_READ_LE16(&p[28..]) as usize;
            let mut extra_data_start = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + filename_len;
            
            while extra_size_remaining >= 4 {
                if p.len() < extra_data_start + 4 {
                    return mz_zip_set_error(pZip, MZ_ZIP_INVALID_HEADER_OR_CORRUPTED);
                }
                
                let field_id = MZ_READ_LE16(&p[extra_data_start..]);
                let field_data_size = MZ_READ_LE16(&p[extra_data_start + 2..]);
                
                if (field_data_size as u32 + 4) > extra_size_remaining {
                    return mz_zip_set_error(pZip, MZ_ZIP_INVALID_HEADER_OR_CORRUPTED);
                }
                
                if field_id == MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID {
                    if let Some(found) = pFound_zip64_extra_data {
                        *found = MZ_TRUE;
                    }
                    
                    let mut field_data_remaining = field_data_size;
                    let mut field_data_ofs = extra_data_start + 4;
                    
                    if pStat.m_uncomp_size == MZ_UINT32_MAX as mz_uint64 {
                        if field_data_remaining < 8 {
                            return mz_zip_set_error(pZip, MZ_ZIP_INVALID_HEADER_OR_CORRUPTED);
                        }
                        pStat.m_uncomp_size = MZ_READ_LE64(&p[field_data_ofs..]);
                        field_data_ofs += 8;
                        field_data_remaining -= 8;
                    }
                    
                    if pStat.m_comp_size == MZ_UINT32_MAX as mz_uint64 {
                        if field_data_remaining < 8 {
                            return mz_zip_set_error(pZip, MZ_ZIP_INVALID_HEADER_OR_CORRUPTED);
                        }
                        pStat.m_comp_size = MZ_READ_LE64(&p[field_data_ofs..]);
                        field_data_ofs += 8;
                        field_data_remaining -= 8;
                    }
                    
                    if pStat.m_local_header_ofs == MZ_UINT32_MAX as mz_uint64 {
                        if field_data_remaining < 8 {
                            return mz_zip_set_error(pZip, MZ_ZIP_INVALID_HEADER_OR_CORRUPTED);
                        }
                        pStat.m_local_header_ofs = MZ_READ_LE64(&p[field_data_ofs..]);
                    }
                    
                    break;
                }
                
                extra_data_start += 4 + field_data_size as usize;
                extra_size_remaining -= 4 + field_data_size;
            }
        }
    }

    MZ_TRUE
}

fn mz_zip_string_equal(pA: &[u8], pB: &[u8], len: mz_uint, flags: mz_uint) -> mz_bool {
    if flags & MZ_ZIP_FLAG_CASE_SENSITIVE != 0 {
        return pA[..len as usize] == pB[..len as usize];
    }
    
    for i in 0..len as usize {
        if MZ_TOLOWER(pA[i]) != MZ_TOLOWER(pB[i]) {
            return MZ_FALSE;
        }
    }
    MZ_TRUE
}

fn mz_zip_filename_compare(
    pCentral_dir_array: &mz_zip_array,
    pCentral_dir_offsets: &mz_zip_array,
    l_index: mz_uint,
    pR: &[u8],
    r_len: mz_uint,
) -> i32 {
    // Get left filename from central directory
    let offset = pCentral_dir_offsets.element::<mz_uint32>(l_index as usize) as usize;
    let pL_start = offset + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE;
    let l_len = MZ_READ_LE16(&pCentral_dir_array.m_p[offset + 28..]) as usize;
    
    let min_len = l_len.min(r_len as usize);
    
    for i in 0..min_len {
        let l_char = MZ_TOLOWER(pCentral_dir_array.m_p[pL_start + i]);
        let r_char = MZ_TOLOWER(pR[i]);
        if l_char != r_char {
            return l_char as i32 - r_char as i32;
        }
    }
    
    l_len as i32 - r_len as i32
}

fn mz_zip_locate_file_binary_search(
    pZip: &mz_zip_archive,
    pFilename: &str,
    pIndex: &mut mz_uint32,
) -> mz_bool {
    let pState = match &pZip.m_pState {
        Some(state) => state,
        None => return mz_zip_set_error(pZip, MZ_ZIP_INVALID_PARAMETER),
    };
    
    let pCentral_dir_offsets = &pState.m_central_dir_offsets;
    let pCentral_dir = &pState.m_central_dir;
    let pIndices = &pState.m_sorted_central_dir_offsets.m_p;
    let size = pZip.m_total_files;
    let filename_bytes = pFilename.as_bytes();
    let filename_len = filename_bytes.len() as mz_uint;
    
    if let Some(index) = pIndex {
        *index = 0;
    }
    
    if size == 0 {
        return mz_zip_set_error(pZip, MZ_ZIP_FILE_NOT_FOUND);
    }
    
    let mut l: mz_int64 = 0;
    let mut h: mz_int64 = size as mz_int64 - 1;
    
    while l <= h {
        let m = l + ((h - l) >> 1);
        let file_index = {
            let bytes = &pIndices[(m as usize * 4)..(m as usize * 4 + 4)];
            MZ_READ_LE32(bytes)
        };
        
        let comp = mz_zip_filename_compare(
            pCentral_dir,
            pCentral_dir_offsets,
            file_index,
            filename_bytes,
            filename_len,
        );
        
        match comp.cmp(&0) {
            Ordering::Equal => {
                if let Some(index) = pIndex {
                    *index = file_index;
                }
                return MZ_TRUE;
            }
            Ordering::Less => l = m + 1,
            Ordering::Greater => h = m - 1,
        }
    }
    
    mz_zip_set_error(pZip, MZ_ZIP_FILE_NOT_FOUND)
}

pub fn mz_zip_reader_locate_file(
    pZip: &mz_zip_archive,
    pName: &str,
    pComment: Option<&str>,
    flags: mz_uint,
) -> i32 {
    let mut index = 0;
    if mz_zip_reader_locate_file_v2(pZip, pName, pComment, flags, &mut index) {
        index as i32
    } else {
        -1
    }
}

pub fn mz_zip_reader_locate_file_v2(
    pZip: &mz_zip_archive,
    pName: &str,
    pComment: Option<&str>,
    flags: mz_uint,
    pIndex: &mut mz_uint32,
) -> mz_bool {
    if pIndex.is_some() {
        *pIndex = 0;
    }
    
    if pZip.m_pState.is_none() || pName.is_empty() {
        return mz_zip_set_error(pZip, MZ_ZIP_INVALID_PARAMETER);
    }
    
    let state = pZip.m_pState.as_ref().unwrap();
    
    // Try binary search if conditions allow
    if (state.m_init_flags & MZ_ZIP_FLAG_DO_NOT_SORT_CENTRAL_DIRECTORY) == 0 &&
        pZip.m_zip_mode == MZ_ZIP_MODE::MZ_ZIP_MODE_READING &&
        (flags & (MZ_ZIP_FLAG_IGNORE_PATH | MZ_ZIP_FLAG_CASE_SENSITIVE)) == 0 &&
        pComment.is_none() &&
        !state.m_sorted_central_dir_offsets.m_p.is_empty()
    {
        return mz_zip_locate_file_binary_search(pZip, pName, pIndex);
    }
    
    // Linear scan
    let name_len = pName.len();
    if name_len > u16::MAX as usize {
        return mz_zip_set_error(pZip, MZ_ZIP_INVALID_PARAMETER);
    }
    
    let comment_len = pComment.map(|c| c.len()).unwrap_or(0);
    if comment_len > u16::MAX as usize {
        return mz_zip_set_error(pZip, MZ_ZIP_INVALID_PARAMETER);
    }
    
    for file_index in 0..pZip.m_total_files {
        let offset = state.m_central_dir_offsets.element::<mz_uint32>(file_index as usize) as usize;
        if offset + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE > state.m_central_dir.m_p.len() {
            continue;
        }
        
        let pHeader = &state.m_central_dir.m_p[offset..];
        let filename_len = MZ_READ_LE16(&pHeader[28..]) as usize;
        if filename_len < name_len {
            continue;
        }
        
        let filename_start = MZ_ZIP_CENTRAL_DIR_HEADER_SIZE;
        
        // Check comment if provided
        if let Some(comment) = pComment {
            let file_extra_len = MZ_READ_LE16(&pHeader[30..]) as usize;
            let file_comment_len = MZ_READ_LE16(&pHeader[32..]) as usize;
            
            if file_comment_len != comment_len {
                continue;
            }
            
            let file_comment_start = filename_start + filename_len + file_extra_len;
            if file_comment_start + file_comment_len > pHeader.len() {
                continue;
            }
            
            let file_comment = &pHeader[file_comment_start..file_comment_start + file_comment_len];
            if !mz_zip_string_equal(comment.as_bytes(), file_comment, file_comment_len as mz_uint, flags) {
                continue;
            }
        }
        
        let mut compare_filename = &pHeader[filename_start..filename_start + filename_len];
        let mut compare_len = filename_len;
        
        // Handle path ignoring flag
        if flags & MZ_ZIP_FLAG_IGNORE_PATH != 0 && filename_len > 0 {
            if let Some(pos) = compare_filename.iter().rposition(|&c| c == b'/' || c == b'\\' || c == b':') {
                compare_filename = &compare_filename[pos + 1..];
                compare_len = compare_filename.len();
            }
        }
        
        if compare_len == name_len && mz_zip_string_equal(pName.as_bytes(), compare_filename, name_len as mz_uint, flags) {
            if let Some(index) = pIndex {
                *index = file_index;
            }
            return MZ_TRUE;
        }
    }
    
    mz_zip_set_error(pZip, MZ_ZIP_FILE_NOT_FOUND)
}

