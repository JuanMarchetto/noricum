// Platform-specific Windows functions (UTF-8 to wide char)
#[cfg(windows)]
mod windows {

    /// Convert UTF-8 string to Windows wide character string (UTF-16)
    pub fn utf8z_to_widechar(str: &str) -> Result<Vec<u16>, std::io::Error> {
        // Handle empty strings
        if str.is_empty() {
            return Ok(vec![0]);
        }
        
        // Convert UTF-8 to UTF-16 with null terminator
        let os_str = OsStr::new(str);
        let mut wide: Vec<u16> = os_str.encode_wide().collect();
        wide.push(0); // Null terminator
        Ok(wide)
    }

    /// Windows-specific fopen with UTF-8 support
    pub fn fopen_utf8(p_filename: &str, p_mode: &str) -> Result<std::fs::File, std::io::Error> {
        
        let filename = p_filename;
        let mode = p_mode;
        
        let mut options = OpenOptions::new();
        
        // Parse mode string
        let mut chars = mode.chars();
        let first = chars.next().unwrap_or('r');
        let second = chars.next();
        let third = chars.next();
        
        match first {
            'r' => {
                options.read(true);
                if second == Some('+') {
                    options.write(true);
                }
                if third == Some('b') {
                    // Binary mode - no-op in Rust
                }
            }
            'w' => {
                options.write(true);
                options.create(true);
                options.truncate(true);
                if second == Some('+') {
                    options.read(true);
                }
                if third == Some('b') || (second == Some('+') && third == Some('b')) {
                    // Binary mode - no-op in Rust
                }
            }
            'a' => {
                options.write(true);
                options.create(true);
                options.append(true);
                if second == Some('+') {
                    options.read(true);
                }
                if third == Some('b') || (second == Some('+') && third == Some('b')) {
                    // Binary mode - no-op in Rust
                }
            }
            _ => return Err(std::io::Error::new(
                std::io::ErrorKind::InvalidInput,
                "Invalid mode string"
            )),
        }
        
        options.open(filename)
    }

    /// Windows-specific freopen with UTF-8 support
    pub fn freopen_utf8(
        p_path: &str,
        p_mode: &str,
        stream: &mut std::fs::File,
    ) -> Result<std::fs::File, std::io::Error> {
        // In Rust, we can't directly "reopen" a FILE* like in C
        // We'll close the old stream and open a new one
        drop(stream); // Close the old file
        fopen_utf8(p_path, p_mode)
    }

    /// Windows-specific stat with UTF-8 support
    pub fn stat_utf8(path: &str) -> Result<std::fs::Metadata, std::io::Error> {
        std::fs::metadata(path)
    }

    /// Windows-specific stat64 with UTF-8 support
    pub fn stat64_utf8(path: &str) -> Result<std::fs::Metadata, std::io::Error> {
        std::fs::metadata(path)
    }
}

