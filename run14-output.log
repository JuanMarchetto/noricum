        };

        if u32::from_le_bytes(p_src_central_header[0..4].try_into().unwrap()) 
            != MZ_ZIP_CENTRAL_DIR_HEADER_SIG {
            return Err(MzZipError::InvalidHeaderOrCorrupted);
        }

        let src_filename_len = u16::from_le_bytes(
            p_src_central_header[MZ_ZIP_CDH_FILENAME_LEN_OFS..][..2]
                .try_into()
                .unwrap()
        ) as usize;
        let src_comment_len = u16::from_le_bytes(
            p_src_central_header[MZ_ZIP_CDH_COMMENT_LEN_OFS..][..2]
                .try_into()
                .unwrap()
        ) as usize;
        let src_ext_len = u16::from_le_bytes(
            p_src_central_header[MZ_ZIP_CDH_EXTRA_LEN_OFS..][..2]
                .try_into()
                .unwrap()
        ) as usize;
        
        let src_central_dir_following_data_size = src_filename_len + src_ext_len + src_comment_len;

        if (p_state.central_dir.size + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE 
            + src_central_dir_following_data_size + 32) >= u32::MAX as usize {
            return Err(MzZipError::UnsupportedCdirSize);
        }

        let num_alignment_padding_bytes = self.writer_compute_padding_needed_for_file_alignment();

        if !p_state.zip64 {
            if self.m_total_files == u16::MAX as u32 {
                return Err(MzZipError::TooManyFiles);
            }
        } else if self.m_total_files == u32::MAX {
            return Err(MzZipError::TooManyFiles);
        }

        let mut src_file_stat = MzZipArchiveFileStat::default();
        if !self.file_stat_internal(source_zip, src_file_index, p_src_central_header, &mut src_file_stat) {
            return Err(self.m_last_error);
        }

        let mut cur_src_file_ofs = src_file_stat.m_local_header_ofs;
        let mut cur_dst_file_ofs = self.m_archive_size;

        // Read source local directory header
        let mut local_header = [0u8; MZ_ZIP_LOCAL_DIR_HEADER_SIZE];
        source_zip.read_data(cur_src_file_ofs, &mut local_header)?;
        
        if u32::from_le_bytes(local_header[0..4].try_into().unwrap()) 
            != MZ_ZIP_LOCAL_DIR_HEADER_SIG {
            return Err(MzZipError::InvalidHeaderOrCorrupted);
        }

        cur_src_file_ofs += MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64;

        let local_header_filename_size = u16::from_le_bytes(
            local_header[MZ_ZIP_LDH_FILENAME_LEN_OFS..][..2]
                .try_into()
                .unwrap()
        ) as usize;
        let local_header_extra_len = u16::from_le_bytes(
            local_header[MZ_ZIP_LDH_EXTRA_LEN_OFS..][..2]
                .try_into()
                .unwrap()
        ) as usize;
        let local_header_comp_size = u32::from_le_bytes(
            local_header[MZ_ZIP_LDH_COMPRESSED_SIZE_OFS..][..4]
                .try_into()
                .unwrap()
        ) as u64;
        let local_header_uncomp_size = u32::from_le_bytes(
            local_header[MZ_ZIP_LDH_DECOMPRESSED_SIZE_OFS..][..4]
                .try_into()
                .unwrap()
        ) as u64;
        
        let mut src_archive_bytes_remaining = src_file_stat.m_comp_size 
            + local_header_filename_size as u64 
            + local_header_extra_len as u64;

        let mut found_zip64_ext_data_in_ldir = false;
        let mut actual_comp_size = local_header_comp_size;
        let mut actual_uncomp_size = local_header_uncomp_size;

        if local_header_extra_len > 0 
            && (local_header_comp_size == u32::MAX as u64 
                || local_header_uncomp_size == u32::MAX as u64) {
            
            let mut extra_data = vec![0u8; local_header_extra_len];
            source_zip.read_data(
                src_file_stat.m_local_header_ofs 
                    + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 
                    + local_header_filename_size as u64,
                &mut extra_data,
            )?;

            let mut extra_remaining = local_header_extra_len;
            let mut pos = 0;

            while extra_remaining >= 4 {
                let field_id = u16::from_le_bytes(extra_data[pos..][..2].try_into().unwrap());
                let field_data_size = u16::from_le_bytes(extra_data[pos + 2..][..2].try_into().unwrap());
                let field_total_size = field_data_size as usize + 4;

                if field_total_size > extra_remaining {
                    return Err(MzZipError::InvalidHeaderOrCorrupted);
                }

                if field_id == MZ_ZIP64_EXTENDED_INFORMATION_FIELD_HEADER_ID 
                    && field_data_size >= 16 {
                    
                    let field_data = &extra_data[pos + 4..];
                    actual_uncomp_size = u64::from_le_bytes(field_data[0..8].try_into().unwrap());
                    actual_comp_size = u64::from_le_bytes(field_data[8..16].try_into().unwrap());
                    found_zip64_ext_data_in_ldir = true;
                    break;
                }

                pos += field_total_size;
                extra_remaining -= field_total_size;
            }
        }

        if !p_state.zip64 {
            let approx_new_archive_size = cur_dst_file_ofs 
                + num_alignment_padding_bytes as u64 
                + MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64 
                + src_archive_bytes_remaining 
                + 16 // descriptor
                + p_state.central_dir.size as u64 
                + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE as u64 
                + src_central_dir_following_data_size as u64 
                + MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64 
                + 64;

            if approx_new_archive_size >= u32::MAX as u64 {
                return Err(MzZipError::ArchiveTooLarge);
            }
        }

        // Write padding
        self.writer_write_zeros(cur_dst_file_ofs, num_alignment_padding_bytes)?;
        cur_dst_file_ofs += num_alignment_padding_bytes as u64;

        let local_dir_header_ofs = cur_dst_file_ofs;
        if self.m_file_offset_alignment != 0 {
            debug_assert_eq!(
                local_dir_header_ofs & (self.m_file_offset_alignment - 1),
                0
            );
        }

        // Copy local header
        self.write_data(cur_dst_file_ofs, &local_header)?;
        cur_dst_file_ofs += MZ_ZIP_LOCAL_DIR_HEADER_SIZE as u64;

        // Copy file data
        let buf_size = MZ_ZIP_MAX_IO_BUF_SIZE.min(src_archive_bytes_remaining as usize) as usize;
        let mut buf = vec![0u8; buf_size.max(32)];

        while src_archive_bytes_remaining > 0 {
            let n = buf_size.min(src_archive_bytes_remaining as usize);
            source_zip.read_data(cur_src_file_ofs, &mut buf[..n])?;
            self.write_data(cur_dst_file_ofs, &buf[..n])?;
            
            cur_src_file_ofs += n as u64;
            cur_dst_file_ofs += n as u64;
            src_archive_bytes_remaining -= n as u64;
        }

        // Handle data descriptor if present
        let bit_flags = u16::from_le_bytes(
            local_header[MZ_ZIP_LDH_BIT_FLAG_OFS..][..2]
                .try_into()
                .unwrap()
        );
        
        if bit_flags & 8 != 0 {
            let source_zip64 = source_zip.m_pstate.as_ref().map_or(false, |s| s.zip64);
            
            if source_zip64 || found_zip64_ext_data_in_ldir {
                let mut descriptor = [0u8; 24];
                source_zip.read_data(cur_src_file_ofs, &mut descriptor)?;
                
                let has_id = u32::from_le_bytes(descriptor[0..4].try_into().unwrap()) 
                    == MZ_ZIP_DATA_DESCRIPTOR_ID;
                let n = if has_id { 24 } else { 20 };
                
                self.write_data(cur_dst_file_ofs, &descriptor[..n])?;
                cur_src_file_ofs += n as u64;
                cur_dst_file_ofs += n as u64;
            } else {
                let mut descriptor = [0u8; 16];
                source_zip.read_data(cur_src_file_ofs, &mut descriptor)?;
                
                let has_id = u32::from_le_bytes(descriptor[0..4].try_into().unwrap()) 
                    == MZ_ZIP_DATA_DESCRIPTOR_ID;
                
                if p_state.zip64 {
                    // Upgrade to zip64 descriptor
                    let src_crc32 = u32::from_le_bytes(descriptor[if has_id { 4 } else { 0 }..][..4]
                        .try_into().unwrap());
                    let src_comp_size = u32::from_le_bytes(
                        descriptor[if has_id { 8 } else { 4 }..][..4].try_into().unwrap()
                    ) as u64;
                    let src_uncomp_size = u32::from_le_bytes(
                        descriptor[if has_id { 12 } else { 8 }..][..4].try_into().unwrap()
                    ) as u64;
                    
                    let mut zip64_descriptor = [0u8; 24];
                    (&mut zip64_descriptor[0..4])
                        .copy_from_slice(&MZ_ZIP_DATA_DESCRIPTOR_ID.to_le_bytes());
                    (&mut zip64_descriptor[4..8])
                        .copy_from_slice(&src_crc32.to_le_bytes());
                    (&mut zip64_descriptor[8..16])
                        .copy_from_slice(&src_comp_size.to_le_bytes());
                    (&mut zip64_descriptor[16..24])
                        .copy_from_slice(&src_uncomp_size.to_le_bytes());
                    
                    self.write_data(cur_dst_file_ofs, &zip64_descriptor)?;
                    cur_src_file_ofs += 16;
                    cur_dst_file_ofs += 24;
                } else {
                    let n = if has_id { 16 } else { 12 };
                    self.write_data(cur_dst_file_ofs, &descriptor[..n])?;
                    cur_src_file_ofs += n as u64;
                    cur_dst_file_ofs += n as u64;
                }
            }
        }

        // Add central directory entry
        let orig_central_dir_size = p_state.central_dir.size;
        let mut new_central_header = [0u8; MZ_ZIP_CENTRAL_DIR_HEADER_SIZE];
        new_central_header.copy_from_slice(&p_src_central_header[..MZ_ZIP_CENTRAL_DIR_HEADER_SIZE]);

        if p_state.zip64 {
            // Update for zip64
            (&mut new_central_header[MZ_ZIP_CDH_COMPRESSED_SIZE_OFS..][..4])
                .copy_from_slice(&u32::MAX.to_le_bytes());
            (&mut new_central_header[MZ_ZIP_CDH_DECOMPRESSED_SIZE_OFS..][..4])
                .copy_from_slice(&u32::MAX.to_le_bytes());
            (&mut new_central_header[MZ_ZIP_CDH_LOCAL_HEADER_OFS..][..4])
                .copy_from_slice(&u32::MAX.to_le_bytes());

            let p_src_ext = &p_src_central_header
                [MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + src_filename_len..];
            
            let new_ext_block = self.writer_update_zip64_extension_block(
                &p_src_ext[..src_ext_len],
                &src_file_stat.m_comp_size,
                &src_file_stat.m_uncomp_size,
                &local_dir_header_ofs,
                None,
            )?;

            (&mut new_central_header[MZ_ZIP_CDH_EXTRA_LEN_OFS..][..2])
                .copy_from_slice(&(new_ext_block.len() as u16).to_le_bytes());

            // Push new central directory entry
            p_state.central_dir.push_bytes(&new_central_header)?;
            p_state.central_dir.push_bytes(
                &p_src_central_header
                    [MZ_ZIP_CENTRAL_DIR_HEADER_SIZE..MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + src_filename_len],
            )?;
            p_state.central_dir.push_bytes(&new_ext_block)?;
            p_state.central_dir.push_bytes(
                &p_src_central_header
                    [MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + src_filename_len + src_ext_len
                        ..MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + src_filename_len + src_ext_len + src_comment_len],
            )?;
        } else {
            if cur_dst_file_ofs > u32::MAX as u64 
                || local_dir_header_ofs >= u32::MAX as u64 {
                return Err(MzZipError::ArchiveTooLarge);
            }

            (&mut new_central_header[MZ_ZIP_CDH_LOCAL_HEADER_OFS..][..4])
                .copy_from_slice(&(local_dir_header_ofs as u32).to_le_bytes());

            p_state.central_dir.push_bytes(&new_central_header)?;
            p_state.central_dir.push_bytes(
                &p_src_central_header
                    [MZ_ZIP_CENTRAL_DIR_HEADER_SIZE
                        ..MZ_ZIP_CENTRAL_DIR_HEADER_SIZE + src_central_dir_following_data_size],
            )?;
        }

        if p_state.central_dir.size >= u32::MAX as usize {
            p_state.central_dir.resize(orig_central_dir_size, false)?;
            return Err(MzZipError::UnsupportedCdirSize);
        }

        p_state.central_dir_offsets.push::<u32>(&(orig_central_dir_size as u32))?;
        self.m_total_files += 1;
        self.m_archive_size = cur_dst_file_ofs;

        Ok(())
    }

    pub fn writer_finalize_archive(&mut self) -> Result<(), MzZipError> {
        let p_state = self
            .m_pstate
            .as_mut()
            .ok_or(MzZipError::InvalidParameter)?;
        
        if self.m_zip_mode != MzZipMode::Writing {
            return Err(MzZipError::InvalidParameter);
        }

        if p_state.zip64 {
            if p_state.central_dir.size >= u32::MAX as usize {
                return Err(MzZipError::TooManyFiles);
            }
        } else {
            if self.m_total_files > u16::MAX as u32 
                || (self.m_archive_size 
                    + p_state.central_dir.size as u64 
                    + MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64) > u32::MAX as u64 {
                return Err(MzZipError::TooManyFiles);
            }
        }

        let (central_dir_ofs, central_dir_size) = if self.m_total_files > 0 {
            let ofs = self.m_archive_size;
            let size = p_state.central_dir.size as u64;
            self.m_central_directory_file_ofs = ofs;
            
            let central_dir_bytes = p_state.central_dir.as_bytes()
                .ok_or(MzZipError::InternalError)?;
            self.write_data(ofs, central_dir_bytes)?;
            
            self.m_archive_size += size;
            (ofs, size)
        } else {
            (0, 0)
        };

        if p_state.zip64 {
            // Write zip64 end of central directory header
            let rel_ofs_to_zip64_ecdr = self.m_archive_size;
            let mut hdr = [0u8; MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE];
            
            (&mut hdr[MZ_ZIP64_ECDH_SIG_OFS..][..4])
                .copy_from_slice(&MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIG.to_le_bytes());
            (&mut hdr[MZ_ZIP64_ECDH_SIZE_OF_RECORD_OFS..][..8]).copy_from_slice(
                &((MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE - 12) as u64).to_le_bytes()
            );
            (&mut hdr[MZ_ZIP64_ECDH_VERSION_MADE_BY_OFS..][..2])
                .copy_from_slice(&0x031Eu16.to_le_bytes());
            (&mut hdr[MZ_ZIP64_ECDH_VERSION_NEEDED_OFS..][..2])
                .copy_from_slice(&0x002Du16.to_le_bytes());
            (&mut hdr[MZ_ZIP64_ECDH_CDIR_NUM_ENTRIES_ON_DISK_OFS..][..8])
                .copy_from_slice(&(self.m_total_files as u64).to_le_bytes());
            (&mut hdr[MZ_ZIP64_ECDH_CDIR_TOTAL_ENTRIES_OFS..][..8])
                .copy_from_slice(&(self.m_total_files as u64).to_le_bytes());
            (&mut hdr[MZ_ZIP64_ECDH_CDIR_SIZE_OFS..][..8])
                .copy_from_slice(&central_dir_size.to_le_bytes());
            (&mut hdr[MZ_ZIP64_ECDH_CDIR_OFS_OFS..][..8])
                .copy_from_slice(&central_dir_ofs.to_le_bytes());
            
            self.write_data(self.m_archive_size, &hdr)?;
            self.m_archive_size += MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE as u64;

            // Write zip64 end of central directory locator
            let mut locator = [0u8; MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE];
            (&mut locator[MZ_ZIP64_ECDL_SIG_OFS..][..4])
                .copy_from_slice(&MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIG.to_le_bytes());
            (&mut locator[MZ_ZIP64_ECDL_REL_OFS_TO_ZIP64_ECDR_OFS..][..8])
                .copy_from_slice(&rel_ofs_to_zip64_ecdr.to_le_bytes());
            (&mut locator[MZ_ZIP64_ECDL_TOTAL_NUMBER_OF_DISKS_OFS..][..4])
                .copy_from_slice(&1u32.to_le_bytes());
            
            self.write_data(self.m_archive_size, &locator)?;
            self.m_archive_size += MZ_ZIP64_END_OF_CENTRAL_DIR_LOCATOR_SIZE as u64;
        }

        // Write end of central directory record
        let mut ecdr = [0u8; MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE];
        (&mut ecdr[MZ_ZIP_ECDH_SIG_OFS..][..4])
            .copy_from_slice(&MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIG.to_le_bytes());
        
        let files_on_disk = u16::min(u16::MAX, self.m_total_files as u16);
        (&mut ecdr[MZ_ZIP_ECDH_CDIR_NUM_ENTRIES_ON_DISK_OFS..][..2])
            .copy_from_slice(&files_on_disk.to_le_bytes());
        (&mut ecdr[MZ_ZIP_ECDH_CDIR_TOTAL_ENTRIES_OFS..][..2])
            .copy_from_slice(&files_on_disk.to_le_bytes());
        
        let cdir_size = u32::min(u32::MAX, central_dir_size as u32);
        (&mut ecdr[MZ_ZIP_ECDH_CDIR_SIZE_OFS..][..4])
            .copy_from_slice(&cdir_size.to_le_bytes());
        
        let cdir_ofs = u32::min(u32::MAX, central_dir_ofs as u32);
        (&mut ecdr[MZ_ZIP_ECDH_CDIR_OFS_OFS..][..4])
            .copy_from_slice(&cdir_ofs.to_le_bytes());
        
        self.write_data(self.m_archive_size, &ecdr)?;
        self.m_archive_size += MZ_ZIP_END_OF_CENTRAL_DIR_HEADER_SIZE as u64;

        self.m_zip_mode = MzZipMode::WritingHasBeenFinalized;
        Ok(())
    }

    pub fn writer_finalize_heap_archive(&mut self) -> Result<Vec<u8>, MzZipError> {
        // Note: In Rust, we don't check the write function type as in C.
        // We assume it's a heap-based archive.
        
        self.writer_finalize_archive()?;
        
        let p_state = self
            .m_pstate
            .as_mut()
            .ok_or(MzZipError::InvalidParameter)?;
        
        let result = p_state
            .pmem
            .take()
            .ok_or(MzZipError::InternalError)?;
        
        p_state.mem_size = 0;
        p_state.mem_capacity = 0;
        
        Ok(result)
    }

    pub fn writer_end(&mut self) -> Result<(), MzZipError> {
        self.writer_end_internal(true)
    }
}

pub fn mz_zip_add_mem_to_archive_file_in_place(
    p_zip_filename: &str,
    p_archive_name: &str,
    p_buf: &[u8],
    p_comment: &[u8],
    level_and_flags: u32,
) -> Result<(), MzZipError> {
    mz_zip_add_mem_to_archive_file_in_place_v2(
        p_zip_filename,
        p_archive_name,
        p_buf,
        p_comment,
        level_and_flags,
    )
}

pub fn mz_zip_add_mem_to_archive_file_in_place_v2(
    p_zip_filename: &str,
    p_archive_name: &str,
    p_buf: &[u8],
    p_comment: &[u8],
    level_and_flags: u32,
) -> Result<(), MzZipError> {
    
    let level_and_flags = if (level_and_flags as i32) < 0 {
        MZ_DEFAULT_LEVEL
    } else {
        level_and_flags
    };

    if p_zip_filename.is_empty() 
        || p_archive_name.is_empty() 
        || (!p_buf.is_empty() && p_buf.as_ptr().is_null())
        || (!p_comment.is_empty() && p_comment.as_ptr().is_null())
        || ((level_and_flags & 0xF) > MZ_UBER_COMPRESSION) {
        return Err(MzZipError::InvalidParameter);
    }

    if !writer_validate_archive_name(p_archive_name) {
        return Err(MzZipError::InvalidFilename);
    }

    let path = Path::new(p_zip_filename);
    let created_new_archive = !path.exists();

    let mut zip_archive = MzZipArchive::new();
    
    if created_new_archive {
        zip_archive.writer_init_file_v2(p_zip_filename, 0, level_and_flags)?;
    } else {
        zip_archive.reader_init_file_v2(
            p_zip_filename,
            level_and_flags | MZ_ZIP_FLAG_DO_NOT_SORT_CENTRAL_DIRECTORY | MZ_ZIP_FLAG_READ_ALLOW_WRITING,
            0,
            0,
        )?;
        
        zip_archive.writer_init_from_reader_v2(
            p_zip_filename,
            level_and_flags | MZ_ZIP_FLAG_READ_ALLOW_WRITING,
        )?;
    }

    let mut status = zip_archive.writer_add_mem_ex(
        p_archive_name,
        p_buf,
        p_comment,
        level_and_flags,
        0,
        0,
    );

    let mut actual_err = zip_archive.m_last_error;

    // Always try to finalize
    if !zip_archive.writer_finalize_archive().is_ok() && actual_err == MzZipError::NoError {
        actual_err = zip_archive.m_last_error;
        status = Err(actual_err);
    }

    // Always try to end
    if !zip_archive.writer_end_internal(status.is_ok()).is_ok() && actual_err == MzZipError::NoError {
        actual_err = zip_archive.m_last_error;
        status = Err(actual_err);
    }

    if status.is_err() && created_new_archive {
        // Delete the new archive on failure
        let _ = fs::remove_file(p_zip_filename);
    }

    status
}

