#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum MZ_ZIP_MODE {
    MZ_ZIP_MODE_INVALID = 0,
    MZ_ZIP_MODE_READING = 1,
    MZ_ZIP_MODE_WRITING = 2,
    MZ_ZIP_MODE_WRITING_HAS_BEEN_FINALIZED = 3,
}

#[derive(Debug, Clone, Copy)]
pub struct mz_zip_array {
    pub m_p: Vec<u8>,
    pub m_element_size: usize,
}

impl mz_zip_array {
    pub fn new(element_size: usize) -> Self {
        Self {
            m_p: Vec::new(),
            m_element_size,
        }
    }
    
    pub fn element<T: Copy + Default>(&self, index: usize) -> T {
        let byte_offset = index * self.m_element_size;
        if byte_offset + mem::size_of::<T>() <= self.m_p.len() {
            let mut result = T::default();
            let bytes = unsafe {
                slice::from_raw_parts_mut(
                    &mut result as *mut T as *mut u8,
                    mem::size_of::<T>()
                )
            };
            bytes.copy_from_slice(&self.m_p[byte_offset..byte_offset + mem::size_of::<T>()]);
            result
        } else {
            T::default()
        }
    }
}

