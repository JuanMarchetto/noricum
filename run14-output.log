// Default allocator functions
fn default_alloc_func(_opaque: *mut std::ffi::c_void, items: usize, size: usize) -> *mut std::ffi::c_void {
    let total = items.saturating_mul(size);
    if total == 0 {
        return std::ptr::null_mut();
    }
    let layout = std::alloc::Layout::from_size_align(total, 1).unwrap();
    unsafe { std::alloc::alloc(layout) as *mut std::ffi::c_void }
}

fn default_free_func(_opaque: *mut std::ffi::c_void, address: *mut std::ffi::c_void) {
    if !address.is_null() {
        unsafe {
            std::alloc::dealloc(address as *mut u8, std::alloc::Layout::from_size_align(1, 1).unwrap());
        }
    }
}

fn default_realloc_func(_opaque: *mut std::ffi::c_void, address: *mut std::ffi::c_void, items: usize, size: usize) -> *mut std::ffi::c_void {
    if address.is_null() {
        return default_alloc_func(_opaque, items, size);
    }
    
    let total = items.saturating_mul(size);
    if total == 0 {
        default_free_func(_opaque, address);
        return std::ptr::null_mut();
    }
    
    let layout = std::alloc::Layout::from_size_align(total, 1).unwrap();
    unsafe {
        std::alloc::realloc(address as *mut u8, layout, total) as *mut std::ffi::c_void
    }
}

fn default_read_func(opaque: *mut std::ffi::c_void, file_ofs: mz_uint64, pBuf: *mut u8, n: usize) -> usize {
    unsafe {
        if let Some(file) = (opaque as *mut MZ_FILE).as_mut() {
            if file.seek(SeekFrom::Start(file_ofs)).is_ok() {
                let slice = std::slice::from_raw_parts_mut(pBuf, n);
                file.read(slice).unwrap_or(0)
            } else {
                0
            }
        } else {
            0
        }
    }
}

fn default_write_func(_opaque: *mut std::ffi::c_void, _file_ofs: mz_uint64, _pBuf: *const u8, _n: usize) -> usize {
    0
}

fn default_needs_keepalive(_opaque: *mut std::ffi::c_void) -> mz_bool {
    false
}

// Helper functions
fn MZ_TOLOWER(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' {
        c - b'A' + b'a'
    } else {
        c
    }
}

fn MZ_MIN<T: Ord>(a: T, b: T) -> T {
    a.min(b)
}

fn MZ_MAX<T: Ord>(a: T, b: T) -> T {
    a.max(b)
}

fn MZ_READ_LE16(p: &[u8]) -> mz_uint16 {
    if p.len() >= 2 {
        u16::from_le_bytes([p[0], p[1]])
    } else {
        0
    }
}

fn MZ_READ_LE32(p: &[u8]) -> mz_uint32 {
    if p.len() >= 4 {
        u32::from_le_bytes([p[0], p[1], p[2], p[3]])
    } else {
        0
    }
}

fn MZ_READ_LE64(p: &[u8]) -> mz_uint64 {
    if p.len() >= 8 {
        u64::from_le_bytes([p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]])
    } else {
        0
    }
}

// CRC32 function (simplified - would need actual implementation)
fn mz_crc32(init: mz_crc32, buf: &[u8], size: usize) -> mz_crc32 {
    let mut crc = init;
    for &byte in &buf[..size] {
        crc = crc.wrapping_add(byte as u32); // Simplified - use a real CRC32 implementation
    }
    crc
}

