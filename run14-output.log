// Write little-endian values
pub fn mz_write_le16(p: &mut [u8], v: u16) {
    if p.len() >= 2 {
        p[0] = v as u8;
        p[1] = (v >> 8) as u8;
    }
}

pub fn mz_write_le32(p: &mut [u8], v: u32) {
    if p.len() >= 4 {
        p[0] = v as u8;
        p[1] = (v >> 8) as u8;
        p[2] = (v >> 16) as u8;
        p[3] = (v >> 24) as u8;
    }
}

pub fn mz_write_le64(p: &mut [u8], v: u64) {
    if p.len() >= 8 {
        mz_write_le32(p, v as u32);
        mz_write_le32(&mut p[4..], (v >> 32) as u32);
    }
}

/// Heap write callback function
pub fn mz_zip_heap_write_func(
    p_opaque: &mut MzZipArchive,
    file_ofs: u64,
    p_buf: &[u8],
    n: usize
) -> usize {
    let p_state = match p_opaque.m_pstate.as_mut() {
        Some(state) => state,
        None => {
            p_opaque.m_last_error = MzZipError::InvalidParameter;
            return 0;
        }
    };
    
    if n == 0 {
        return 0;
    }
    
    let new_size = (file_ofs + n as u64).max(p_state.mem_size as u64);
    
    // Check for 32-bit overflow (simplified)
    if cfg!(target_pointer_width = "32") && new_size > 0x7FFFFFFF {
        p_opaque.m_last_error = MzZipError::FileTooLarge;
        return 0;
    }
    
    let new_size_usize = new_size as usize;
    
    // Ensure capacity
    if new_size_usize > p_state.mem_capacity {
        let mut new_capacity = p_state.mem_capacity.max(64);
        while new_capacity < new_size_usize {
            new_capacity = new_capacity.saturating_mul(2);
        }
        
        let p_mem = match p_state.pmem.as_mut() {
            Some(vec) => {
                vec.reserve(new_capacity - vec.capacity());
                vec.resize(new_capacity, 0);
                vec
            }
            None => {
                let mut new_vec = Vec::with_capacity(new_capacity);
                new_vec.resize(new_capacity, 0);
                p_state.pmem = Some(new_vec);
                p_state.pmem.as_mut().unwrap()
            }
        };
        
        p_state.mem_capacity = new_capacity;
    }
    
    // Write data
    if let Some(ref mut vec) = p_state.pmem {
        let start = file_ofs as usize;
        let end = start + n;
        
        if end <= vec.len() {
            vec[start..end].copy_from_slice(p_buf);
            p_state.mem_size = p_state.mem_size.max(end);
            n
        } else {
            p_opaque.m_last_error = MzZipError::WriteFailed;
            0
        }
    } else {
        p_opaque.m_last_error = MzZipError::WriteFailed;
        0
    }
}

