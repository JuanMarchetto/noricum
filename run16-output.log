impl MzZipArray {
    /// Check if index is within bounds (debug mode only)
    pub fn range_check(&self, index: usize) -> Option<usize> {
        #[cfg(debug_assertions)]
        {
            if index >= self.m_size {
                return None;
            }
        }
        Some(index)
    }

    /// Initialize array with element size
    pub fn init(&mut self, element_size: u32) {
        self.m_p.clear();
        self.m_size = 0;
        self.m_capacity = 0;
        self.m_element_size = element_size;
    }

    /// Clear array and free memory
    pub fn clear_array(&mut self) {
        self.m_p.clear();
        self.m_size = 0;
        self.m_capacity = 0;
        self.m_p.shrink_to_fit();
    }

    /// Ensure array has at least min_new_capacity elements
    pub fn ensure_capacity(&mut self, min_new_capacity: usize, growing: bool) -> Result<(), MzZipError> {
        if self.m_capacity >= min_new_capacity {
            return Ok(());
        }

        let mut new_capacity = min_new_capacity;
        if growing && self.m_capacity > 0 {
            new_capacity = self.m_capacity;
            while new_capacity < min_new_capacity {
                new_capacity = new_capacity.checked_mul(2).ok_or(MzZipError::AllocFailed)?;
            }
        }

        self.m_p.reserve_exact((new_capacity - self.m_capacity) * self.m_element_size as usize);
        self.m_capacity = new_capacity;
        Ok(())
    }

    /// Reserve capacity for new_capacity elements
    pub fn reserve(&mut self, new_capacity: usize, growing: bool) -> Result<(), MzZipError> {
        if new_capacity > self.m_capacity {
            self.ensure_capacity(new_capacity, growing)
        } else {
            Ok(())
        }
    }

    /// Resize array to new_size elements
    pub fn resize(&mut self, new_size: usize, growing: bool) -> Result<(), MzZipError> {
        if new_size > self.m_capacity {
            self.ensure_capacity(new_size, growing)?;
        }
        
        let new_byte_size = new_size * self.m_element_size as usize;
        if new_byte_size > self.m_p.len() {
            self.m_p.resize(new_byte_size, 0);
        } else {
            self.m_p.truncate(new_byte_size);
        }
        self.m_size = new_size;
        Ok(())
    }

    /// Ensure room for n additional elements
    pub fn ensure_room(&mut self, n: usize) -> Result<(), MzZipError> {
        self.reserve(self.m_size + n, true)
    }

    /// Push elements to back of array
    pub fn push_back(&mut self, elements: &[u8]) -> Result<(), MzZipError> {
        let element_size = self.m_element_size as usize;
        if elements.len() % element_size != 0 {
            return Err(MzZipError::InvalidParameter);
        }
        
        let n_elements = elements.len() / element_size;
        let old_size = self.m_size;
        self.resize(self.m_size + n_elements, true)?;
        
        let start_idx = old_size * element_size;
        if n_elements > 0 {
            self.m_p[start_idx..start_idx + elements.len()].copy_from_slice(elements);
        }
        Ok(())
    }
}

impl MzZipArchive {
    /// Convert DOS date/time to system time
    pub fn dos_to_time_t(dos_time: u16, dos_date: u16) -> Result<SystemTime, MzZipError> {
        let year = ((dos_date >> 9) & 0x7F) as i32 + 1980;
        let month = ((dos_date >> 5) & 0x0F) as i32;
        let day = (dos_date & 0x1F) as i32;
        
        let hour = ((dos_time >> 11) & 0x1F) as i32;
        let minute = ((dos_time >> 5) & 0x3F) as i32;
        let second = ((dos_time & 0x1F) as i32) * 2;
        
        // Use chrono for proper date/time conversion if available
        // For now, approximate using seconds since UNIX_EPOCH
        // Note: This is simplified - real implementation should handle time zones, leap years, etc.
        let days_since_1970 = days_since_unix_epoch(year, month, day);
        let total_seconds = days_since_1970 * 86400 + hour * 3600 + minute * 60 + second;
        
        UNIX_EPOCH.checked_add(std::time::Duration::from_secs(total_seconds as u64))
            .ok_or(MzZipError::InvalidParameter)
    }

    /// Convert system time to DOS date/time
    pub fn time_t_to_dos_time(time: SystemTime) -> (u16, u16) {
        let duration = time.duration_since(UNIX_EPOCH).unwrap_or_else(|_| std::time::Duration::from_secs(0));
        let secs = duration.as_secs();
        
        // Simplified conversion - real implementation should use localtime
        let days = secs / 86400;
        let seconds_in_day = secs % 86400;
        
        let hour = (seconds_in_day / 3600) as u16;
        let minute = ((seconds_in_day % 3600) / 60) as u16;
        let second = ((seconds_in_day % 60) / 2) as u16; // DOS stores seconds/2
        
        // Approximate year/month/day calculation
        // Note: This is simplified
        let year = 1980u16 + (days / 365) as u16;
        let month = 1u16 + ((days % 365) / 30) as u16;
        let day = ((days % 365) % 30) as u16;
        
        let dos_time = (hour << 11) | (minute << 5) | second;
        let dos_date = ((year - 1980) << 9) | (month << 5) | day;
        
        (dos_time, dos_date)
    }

    /// Get file modified time
    pub fn get_file_modified_time(p_filename: &str) -> Result<SystemTime, MzZipError> {
        let metadata = std::fs::metadata(p_filename)
            .map_err(|_| MzZipError::FileNotFound)?;
        metadata.modified()
            .map_err(|_| MzZipError::FileStatFailed)
    }

    /// Set file access and modified times
    pub fn set_file_times(p_filename: &str, access_time: SystemTime, modified_time: SystemTime) -> Result<(), MzZipError> {
        #[cfg(unix)]
        {
            let file = File::open(p_filename)
                .map_err(|_| MzZipError::FileOpenFailed)?;
            
            let atime = FileTime::from_system_time(access_time);
            let mtime = FileTime::from_system_time(modified_time);
            
            file.set_times(atime, mtime)
                .map_err(|_| MzZipError::FileTimesSetFailed)?;
        }
        
        #[cfg(windows)]
        {
            // Windows implementation
            let wide_filename: Vec<u16> = p_filename.encode_utf16().chain(Some(0)).collect();
            
            unsafe {
                let handle = CreateFileW(
                    wide_filename.as_ptr(),
                    GENERIC_WRITE,
                    FILE_SHARE_READ | FILE_SHARE_WRITE,
                    std::ptr::null_mut(),
                    OPEN_EXISTING,
                    FILE_ATTRIBUTE_NORMAL,
                    std::ptr::null_mut(),
                );
                
                if handle.is_null() {
                    return Err(MzZipError::FileOpenFailed);
                }
                
                fn system_time_to_filetime(time: SystemTime) -> winapi::shared::minwindef::FILETIME {
                    let duration = time.duration_since(UNIX_EPOCH)
                        .unwrap_or_else(|_| std::time::Duration::from_secs(0));
                    let intervals = (duration.as_secs() * 10_000_000) + (duration.subsec_nanos() as u64 / 100) + 116444736000000000;
                    
                    winapi::shared::minwindef::FILETIME {
                        dwLowDateTime: intervals as u32,
                        dwHighDateTime: (intervals >> 32) as u32,
                    }
                }
                
                let atime = system_time_to_filetime(access_time);
                let mtime = system_time_to_filetime(modified_time);
                
                if SetFileTime(handle, std::ptr::null_mut(), &atime, &mtime) == 0 {
                    CloseHandle(handle);
                    return Err(MzZipError::FileTimesSetFailed);
                }
                
                CloseHandle(handle);
            }
        }
        
        Ok(())
    }

