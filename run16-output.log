    /// Compare filenames for sorting (case-insensitive)
    pub fn reader_filename_less(
        central_dir: &MzZipArray,
        central_dir_offsets: &MzZipArray,
        l_index: u32,
        r_index: u32,
    ) -> Result<bool, MzZipError> {
        let l_offset = central_dir_offsets.get::<u32>(l_index as usize)
            .ok_or(MzZipError::InvalidParameter)?;
        let r_offset = central_dir_offsets.get::<u32>(r_index as usize)
            .ok_or(MzZipError::InvalidParameter)?;
        
        let central_dir_bytes = central_dir.as_bytes()
            .ok_or(MzZipError::InvalidParameter)?;
        
        // Get filename lengths
        let l_filename_len = u16::from_le_bytes([
            central_dir_bytes[(l_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS) as usize],
            central_dir_bytes[(l_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS + 1) as usize],
        ]) as usize;
        
        let r_filename_len = u16::from_le_bytes([
            central_dir_bytes[(r_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS) as usize],
            central_dir_bytes[(r_offset + MZ_ZIP_CDH_FILENAME_LEN_OFS + 1) as usize],
        ]) as usize;
        
        // Get filename pointers
        let l_filename_start = (l_offset + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE) as usize;
        let r_filename_start = (r_offset + MZ_ZIP_CENTRAL_DIR_HEADER_SIZE) as usize;
        
        let l_filename = &central_dir_bytes[l_filename_start..l_filename_start + l_filename_len];
        let r_filename = &central_dir_bytes[r_filename_start..r_filename_start + r_filename_len];
        
        // Case-insensitive comparison
        let min_len = l_filename_len.min(r_filename_len);
        for i in 0..min_len {
            let lc = l_filename[i].to_ascii_lowercase();
            let rc = r_filename[i].to_ascii_lowercase();
            if lc != rc {
                return Ok(lc < rc);
            }
        }
        
        Ok(l_filename_len < r_filename_len)
    }

    /// Sort central directory offsets by filename
    pub fn reader_sort_central_dir_offsets_by_filename(&mut self) -> Result<(), MzZipError> {
        let state = self.m_p_state.as_mut().ok_or(MzZipError::InvalidParameter)?;
        
        let size = self.m_total_files;
        if size <= 1 {
            return Ok(());
        }
        
        // Get mutable references to arrays
        let central_dir = &state.m_central_dir;
        let central_dir_offsets = &state.m_central_dir_offsets;
        
        // Create vector of indices
        let mut indices: Vec<u32> = (0..size).collect();
        
        // Heap sort implementation (as in C code)
        let mut start = ((size - 2) >> 1) as usize;
        loop {
            let mut root = start;
            loop {
                let mut child = (root << 1) + 1;
                if child >= size as usize {
                    break;
                }
                
                if child + 1 < size as usize {
                    let less = Self::reader_filename_less(
                        central_dir,
                        central_dir_offsets,
                        indices[child],
                        indices[child + 1],
                    )?;
                    if less {
                        child += 1;
                    }
                }
                
                let less = Self::reader_filename_less(
                    central_dir,
                    central_dir_offsets,
                    indices[root],
                    indices[child],
                )?;
                
                if !less {
                    break;
                }
                
                indices.swap(root, child);
                root = child;
            }
            
            if start == 0 {
                break;
            }
            start -= 1;
        }
        
        let mut end = size as usize - 1;
        while end > 0 {
            indices.swap(0, end);
            
            let mut root = 0;
            loop {
                let mut child = (root << 1) + 1;
                if child >= end {
                    break;
                }
                
                if child + 1 < end {
                    let less = Self::reader_filename_less(
                        central_dir,
                        central_dir_offsets,
                        indices[child],
                        indices[child + 1],
                    )?;
                    if less {
                        child += 1;
                    }
                }
                
                let less = Self::reader_filename_less(
                    central_dir,
                    central_dir_offsets,
                    indices[root],
                    indices[child],
                )?;
                
                if !less {
                    break;
                }
                
                indices.swap(root, child);
                root = child;
            }
            
            end -= 1;
        }
        
        // Update sorted offsets array
        state.m_sorted_central_dir_offsets.clear();
        for &idx in &indices {
            state.m_sorted_central_dir_offsets.push(idx)?;
        }
        
        Ok(())
    }

    /// Locate header signature in archive
    pub fn reader_locate_header_sig(
        &self,
        record_sig: u32,
        record_size: u32,
    ) -> Result<Option<i64>, MzZipError> {
        if self.m_archive_size < record_size as u64 {
            return Ok(None);
        }
        
        let mut buf = [0u8; 4096];
        let mut cur_file_ofs = std::cmp::max(self.m_archive_size as i64 - 4096, 0);
        
        loop {
            let n = std::cmp::min(4096, self.m_archive_size - cur_file_ofs as u64) as usize;
            let mut slice = &mut buf[..n];
            
            let read = self.read_data(cur_file_ofs as u64, &mut slice)?;
            if read != n {
                return Ok(None);
            }
            
            // Search for signature from end to beginning
            for i in (0..n.saturating_sub(3)).rev() {
                let sig = u32::from_le_bytes([buf[i], buf[i + 1], buf[i + 2], buf[i + 3]]);
                if sig == record_sig {
                    let found_ofs = cur_file_ofs + i as i64;
                    if self.m_archive_size - found_ofs as u64 >= record_size as u64 {
                        return Ok(Some(found_ofs));
                    }
                }
            }
            
            // Stop if we've searched enough
            if cur_file_ofs == 0 || (self.m_archive_size - cur_file_ofs as u64) >= (u16::MAX as u64 + record_size as u64) {
                return Ok(None);
            }
            
            cur_file_ofs = std::cmp::max(cur_file_ofs - (4096 - 3), 0);
        }
    }

    /// Check if EOCD64 is valid
    pub fn reader_eocd64_valid(&self, offset: u64) -> Result<bool, MzZipError> {
        let mut buf = [0u8; MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE as usize];
        let mut slice = &mut buf[..];
        
        let read = self.read_data(offset, &mut slice)?;
        if read != MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIZE as usize {
            return Ok(false);
        }
        
        let sig = u32::from_le_bytes([buf[0], buf[1], buf[2], buf[3]]);
        Ok(sig == MZ_ZIP64_END_OF_CENTRAL_DIR_HEADER_SIG)
    }
}

// Helper function for days calculation (simplified)
fn days_since_unix_epoch(year: i32, month: i32, day: i32) -> u64 {
    // Simplified calculation - real implementation should handle leap years
    let years_since_1970 = year - 1970;
    let days = years_since_1970 as u64 * 365
        + ((years_since_1970 + 1) / 4) as u64 // Approximate leap years
        + ((month - 1) * 30) as u64 // Approximate months
        + day as u64;
    
    days
}

