    p_comment: *const c_void,
    comment_size: u16,
    level_and_flags: u32,
) -> bool {
    mz_zip_add_mem_to_archive_file_in_place_v2(
        p_zip_filename,
        p_archive_name,
        p_buf,
        buf_size,
        p_comment,
        comment_size,
        level_and_flags,
        ptr::null_mut(),
    )
