// Main compressor structure
#[repr(C)]
pub struct TdeflCompressor {
    // State
    pub m_flags: u32,
    pub m_max_probes: [u32; 2],
    pub m_greedy_parsing: bool,
    pub m_adler32: u32,
    
    // Output
    pub m_pPut_buf_func: Option<fn(*const u8, usize, *mut ()) -> bool>,
    pub m_pPut_buf_user: *mut (),
    pub m_pOut_buf: *mut u8,
    pub m_pOut_buf_size: *mut usize,
    pub m_out_buf_ofs: usize,
    pub m_output_buf: [u8; TDEFL_OUT_BUF_SIZE],
    pub m_pOutput_buf: *mut u8,
    pub m_pOutput_buf_end: *mut u8,
    pub m_output_flush_ofs: usize,
    pub m_output_flush_remaining: usize,
    
    // Input
    pub m_pIn_buf: *const u8,
    pub m_pIn_buf_size: *mut usize,
    pub m_pSrc: *const u8,
    pub m_src_buf_left: usize,
    pub m_flush: TdeflFlush,
    
    // LZ compression
    pub m_dict: [u8; TDEFL_LZ_DICT_SIZE + TDEFL_MAX_MATCH_LEN - 1],
    pub m_hash: [u16; TDEFL_LZ_HASH_SIZE],
    pub m_next: [u16; TDEFL_LZ_DICT_SIZE],
    pub m_dict_size: u32,
    pub m_lookahead_pos: u32,
    pub m_lookahead_size: u32,
    pub m_total_lz_bytes: u32,
    pub m_lz_code_buf_dict_pos: u32,
    
    // LZ output buffer
    pub m_lz_code_buf: [u8; TDEFL_LZ_CODE_BUF_SIZE],
    pub m_pLZ_code_buf: *mut u8,
    pub m_pLZ_flags: *mut u8,
    pub m_num_flags_left: u32,
    
    // Huffman coding
    pub m_huff_count: [[u16; TDEFL_MAX_HUFF_SYMBOLS]; 3],
    pub m_huff_codes: [[u16; TDEFL_MAX_HUFF_SYMBOLS]; 3],
    pub m_huff_code_sizes: [[u8; TDEFL_MAX_HUFF_SYMBOLS]; 3],
    
    // Bit buffer
    pub m_bit_buffer: u32,
    pub m_bits_in: u32,
    
    // Misc
    pub m_saved_match_dist: u32,
    pub m_saved_match_len: u32,
    pub m_saved_lit: u8,
    pub m_block_index: u32,
    pub m_wants_to_finish: bool,
    pub m_finished: bool,
    pub m_prev_return_status: TdeflStatus,
}

// Helper functions
fn memset<T: Copy>(slice: &mut [T], value: T) {
    for elem in slice.iter_mut() {
        *elem = value;
    }
}

// Radix sort for Huffman symbols
fn tdefl_radix_sort_syms(
    num_syms: usize,
    syms0: &mut [TdeflSymFreq],
    syms1: &mut [TdeflSymFreq],
) -> &mut [TdeflSymFreq] {
    let mut total_passes = 2;
    let mut hist = [0u32; 512];
    let mut p_cur_syms = syms0;
    let mut p_new_syms = syms1;
    
    // Clear histogram
    memset(&mut hist, 0);
    
    // Build histogram
    for i in 0..num_syms {
        let freq = syms0[i].key as u32;
        hist[(freq & 0xFF) as usize] += 1;
        hist[256 + ((freq >> 8) & 0xFF) as usize] += 1;
    }
    
    // Skip passes if all symbols have same frequency
    while total_passes > 1 && (num_syms as u32) == hist[(total_passes - 1) as usize * 256] {
        total_passes -= 1;
    }
    
    let mut pass_shift = 0;
    for pass in 0..total_passes {
        let hist_offset = (pass as usize) * 256;
        let mut offsets = [0u32; 256];
        let mut cur_ofs = 0;
        
        for i in 0..256 {
            offsets[i] = cur_ofs;
            cur_ofs += hist[hist_offset + i];
        }
        
        for i in 0..num_syms {
            let bucket = ((p_cur_syms[i].key >> pass_shift) & 0xFF) as usize;
            let offset = offsets[bucket] as usize;
            offsets[bucket] += 1;
            p_new_syms[offset] = p_cur_syms[i];
        }
        
        std::mem::swap(&mut p_cur_syms, &mut p_new_syms);
        pass_shift += 8;
    }
    
    p_cur_syms
}

// Calculate minimum redundancy for Huffman codes
fn tdefl_calculate_minimum_redundancy(a: &mut [TdeflSymFreq], n: usize) {
    if n == 0 {
        return;
    }
    
    if n == 1 {
        a[0].key = 1;
        return;
    }
    
    a[0].key = a[0].key.wrapping_add(a[1].key);
    let mut root = 0;
    let mut leaf = 2;
    
    for next in 1..n - 1 {
        if leaf >= n || a[root].key < a[leaf].key {
            a[next].key = a[root].key;
            a[root].key = next as u16;
            root += 1;
        } else {
            a[next].key = a[leaf].key;
            leaf += 1;
        }
        
        if leaf >= n || (root < next && a[root].key < a[leaf].key) {
            a[next].key = a[next].key.wrapping_add(a[root].key);
            a[root].key = next as u16;
            root += 1;
        } else {
            a[next].key = a[next].key.wrapping_add(a[leaf].key);
            leaf += 1;
        }
    }
    
    a[n - 2].key = 0;
    
    for next in (0..n - 2).rev() {
        a[next].key = a[a[next].key as usize].key.wrapping_add(1);
    }
    
    let mut avbl = 1;
    let mut used = 0;
    let mut dpth = 0;
    let mut root = n - 2;
    let mut next = n - 1;
    
    while avbl > 0 {
        while root > 0 && a[root].key as usize == dpth {
            used += 1;
            root -= 1;
        }
        
        while avbl > used {
            next -= 1;
            a[next].key = dpth as u16;
            avbl -= 1;
        }
        
        avbl = 2 * used;
        dpth += 1;
        used = 0;
    }
}

// Enforce maximum code size for Huffman tables
fn tdefl_huffman_enforce_max_code_size(
    num_codes: &mut [i32; 33],
    code_list_len: usize,
    max_code_size: i32,
) {
    if code_list_len <= 1 {
        return;
    }
    
    // Move codes beyond max_code_size to max_code_size
    for i in (max_code_size + 1) as usize..33 {
        num_codes[max_code_size as usize] += num_codes[i];
        num_codes[i] = 0;
    }
    
    let mut total = 0u32;
    for i in 1..=max_code_size as usize {
        total += ((num_codes[i] as u32) << (max_code_size - i as i32));
    }
    
    while total != (1u32 << max_code_size) {
        num_codes[max_code_size as usize] -= 1;
        
        for i in (1..max_code_size as usize).rev() {
            if num_codes[i] > 0 {
                num_codes[i] -= 1;
                num_codes[i + 1] += 2;
                break;
            }
        }
        
        total -= 1;
    }
}

// Optimize Huffman table
fn tdefl_optimize_huffman_table(
    d: &mut TdeflCompressor,
    table_num: usize,
    table_len: usize,
    code_size_limit: i32,
    static_table: bool,
) {
    let mut num_codes = [0i32; 33];
    let mut next_code = [0u32; 33];
    
    if static_table {
        for i in 0..table_len {
            let code_size = d.m_huff_code_sizes[table_num][i];
            if (code_size as usize) < num_codes.len() {
                num_codes[code_size as usize] += 1;
            }
        }
    } else {
        let mut syms0 = vec![TdeflSymFreq { key: 0, sym_index: 0 }; TDEFL_MAX_HUFF_SYMBOLS];
        let mut syms1 = vec![TdeflSymFreq { key: 0, sym_index: 0 }; TDEFL_MAX_HUFF_SYMBOLS];
        let mut num_used_syms = 0;
        
        for i in 0..table_len {
            let count = d.m_huff_count[table_num][i];
            if count > 0 {
                syms0[num_used_syms].key = count;
                syms0[num_used_syms].sym_index = i as u16;
                num_used_syms += 1;
            }
        }
        
        let p_syms = tdefl_radix_sort_syms(
            num_used_syms,
            &mut syms0[0..num_used_syms],
            &mut syms1[0..num_used_syms],
        );
        
        tdefl_calculate_minimum_redundancy(&mut p_syms[0..num_used_syms], num_used_syms);
        
        for i in 0..num_used_syms {
            let key = p_syms[i].key as usize;
            if key < num_codes.len() {
                num_codes[key] += 1;
            }
        }
        
        tdefl_huffman_enforce_max_code_size(&mut num_codes, num_used_syms, code_size_limit);
        
        memset(&mut d.m_huff_code_sizes[table_num][0..table_len], 0);
        memset(&mut d.m_huff_codes[table_num][0..table_len], 0);
        
        let mut j = num_used_syms;
        for i in 1..=code_size_limit as usize {
            for _ in 0..num_codes[i] {
                j -= 1;
                let sym_index = p_syms[j].sym_index as usize;
                d.m_huff_code_sizes[table_num][sym_index] = i as u8;
            }
        }
    }
    
    let mut j = 0;
    for i in 2..=code_size_limit as usize {
        j = (j + num_codes[i - 1] as u32) << 1;
        next_code[i] = j;
    }
    
    for i in 0..table_len {
        let code_size = d.m_huff_code_sizes[table_num][i];
        if code_size == 0 {
            continue;
        }
        
        let mut code = next_code[code_size as usize];
        next_code[code_size as usize] += 1;
        
        let mut rev_code = 0u32;
        for _ in 0..code_size {
            rev_code = (rev_code << 1) | (code & 1);
            code >>= 1;
        }
        
        d.m_huff_codes[table_num][i] = rev_code as u16;
    }
}

// Put bits into buffer (replaces TDEFL_PUT_BITS macro)
fn tdefl_put_bits(d: &mut TdeflCompressor, bits: u32, len: u32) {
    d.m_bit_buffer |= bits << d.m_bits_in;
    d.m_bits_in += len;
    
    while d.m_bits_in >= 8 {
        if (d.m_pOutput_buf as usize) < (d.m_pOutput_buf_end as usize) {
            unsafe {
                *d.m_pOutput_buf = (d.m_bit_buffer & 0xFF) as u8;
                d.m_pOutput_buf = d.m_pOutput_buf.add(1);
            }
        }
        d.m_bit_buffer >>= 8;
        d.m_bits_in -= 8;
    }
}

// Start a dynamic block
fn tdefl_start_dynamic_block(d: &mut TdeflCompressor) {
    let mut code_sizes_to_pack = [0u8; TDEFL_MAX_HUFF_SYMBOLS_0 + TDEFL_MAX_HUFF_SYMBOLS_1];
    let mut packed_code_sizes = [0u8; TDEFL_MAX_HUFF_SYMBOLS_0 + TDEFL_MAX_HUFF_SYMBOLS_1];
    
    d.m_huff_count[0][256] = 1;
    
    tdefl_optimize_huffman_table(d, 0, TDEFL_MAX_HUFF_SYMBOLS_0, 15, false);
    tdefl_optimize_huffman_table(d, 1, TDEFL_MAX_HUFF_SYMBOLS_1, 15, false);
    
    // Find number of literal codes
    let mut num_lit_codes = 286;
    while num_lit_codes > 257 && d.m_huff_code_sizes[0][num_lit_codes - 1] == 0 {
        num_lit_codes -= 1;
    }
    
    // Find number of distance codes
    let mut num_dist_codes = 30;
    while num_dist_codes > 1 && d.m_huff_code_sizes[1][num_dist_codes - 1] == 0 {
        num_dist_codes -= 1;
    }
    
    // Pack code sizes
    code_sizes_to_pack[0..num_lit_codes].copy_from_slice(&d.m_huff_code_sizes[0][0..num_lit_codes]);
    code_sizes_to_pack[num_lit_codes..num_lit_codes + num_dist_codes]
        .copy_from_slice(&d.m_huff_code_sizes[1][0..num_dist_codes]);
    
    let total_code_sizes_to_pack = num_lit_codes + num_dist_codes;
    let mut num_packed_code_sizes = 0;
    let mut rle_z_count = 0;
    let mut rle_repeat_count = 0;
    let mut prev_code_size = 0xFFu8;
    
    memset(&mut d.m_huff_count[2][0..TDEFL_MAX_HUFF_SYMBOLS_2], 0);
    
    for i in 0..total_code_sizes_to_pack {
        let code_size = code_sizes_to_pack[i];
        
        if code_size == 0 {
            // Handle zero run
            if rle_repeat_count > 0 {
                if rle_repeat_count < 3 {
                    d.m_huff_count[2][prev_code_size as usize] =
                        d.m_huff_count[2][prev_code_size as usize].wrapping_add(rle_repeat_count as u16);
                    for _ in 0..rle_repeat_count {
                        packed_code_sizes[num_packed_code_sizes] = prev_code_size;
                        num_packed_code_sizes += 1;
                    }
                } else {
                    d.m_huff_count[2][16] = d.m_huff_count[2][16].wrapping_add(1);
                    packed_code_sizes[num_packed_code_sizes] = 16;
                    num_packed_code_sizes += 1;
                    packed_code_sizes[num_packed_code_sizes] = (rle_repeat_count - 3) as u8;
                    num_packed_code_sizes += 1;
                }
                rle_repeat_count = 0;
            }
            
            rle_z_count += 1;
            if rle_z_count == 138 {
                if rle_z_count < 3 {
                    d.m_huff_count[2][0] = d.m_huff_count[2][0].wrapping_add(rle_z_count as u16);
                    for _ in 0..rle_z_count {
                        packed_code_sizes[num_packed_code_sizes] = 0;
                        num_packed_code_sizes += 1;
                    }
                } else if rle_z_count <= 10 {
                    d.m_huff_count[2][17] = d.m_huff_count[2][17].wrapping_add(1);
                    packed_code_sizes[num_packed_code_sizes] = 17;
                    num_packed_code_sizes += 1;
                    packed_code_sizes[num_packed_code_sizes] = (rle_z_count - 3) as u8;
                    num_packed_code_sizes += 1;
                } else {
                    d.m_huff_count[2][18] = d.m_huff_count[2][18].wrapping_add(1);
                    packed_code_sizes[num_packed_code_sizes] = 18;
                    num_packed_code_sizes += 1;
                    packed_code_sizes[num_packed_code_sizes] = (rle_z_count - 11) as u8;
                    num_packed_code_sizes += 1;
                }
                rle_z_count = 0;
            }
        } else {
            // Handle zero run if any
            if rle_z_count > 0 {
                if rle_z_count < 3 {
                    d.m_huff_count[2][0] = d.m_huff_count[2][0].wrapping_add(rle_z_count as u16);
                    for _ in 0..rle_z_count {
                        packed_code_sizes[num_packed_code_sizes] = 0;
                        num_packed_code_sizes += 1;
                    }
                } else if rle_z_count <= 10 {
                    d.m_huff_count[2][17] = d.m_huff_count[2][17].wrapping_add(1);
                    packed_code_sizes[num_packed_code_sizes] = 17;
                    num_packed_code_sizes += 1;
                    packed_code_sizes[num_packed_code_sizes] = (rle_z_count - 3) as u8;
                    num_packed_code_sizes += 1;
                } else {
                    d.m_huff_count[2][18] = d.m_huff_count[2][18].wrapping_add(1);
                    packed_code_sizes[num_packed_code_sizes] = 18;
                    num_packed_code_sizes += 1;
                    packed_code_sizes[num_packed_code_sizes] = (rle_z_count - 11) as u8;
                    num_packed_code_sizes += 1;
                }
                rle_z_count = 0;
            }
            
            if code_size != prev_code_size {
                if rle_repeat_count > 0 {
                    if rle_repeat_count < 3 {
                        d.m_huff_count[2][prev_code_size as usize] =
                            d.m_huff_count[2][prev_code_size as usize].wrapping_add(rle_repeat_count as u16);
                        for _ in 0..rle_repeat_count {
                            packed_code_sizes[num_packed_code_sizes] = prev_code_size;
                            num_packed_code_sizes += 1;
                        }
                    } else {
                        d.m_huff_count[2][16] = d.m_huff_count[2][16].wrapping_add(1);
                        packed_code_sizes[num_packed_code_sizes] = 16;
                        num_packed_code_sizes += 1;
                        packed_code_sizes[num_packed_code_sizes] = (rle_repeat_count - 3) as u8;
                        num_packed_code_sizes += 1;
                    }
                    rle_repeat_count = 0;
                }
                
                d.m_huff_count[2][code_size as usize] =
                    d.m_huff_count[2][code_size as usize].wrapping_add(1);
                packed_code_sizes[num_packed_code_sizes] = code_size;
                num_packed_code_sizes += 1;
            } else {
                rle_repeat_count += 1;
                if rle_repeat_count == 6 {
                    d.m_huff_count[2][16] = d.m_huff_count[2][16].wrapping_add(1);
                    packed_code_sizes[num_packed_code_sizes] = 16;
                    num_packed_code_sizes += 1;
                    packed_code_sizes[num_packed_code_sizes] = (rle_repeat_count - 3) as u8;
                    num_packed_code_sizes += 1;
                    rle_repeat_count = 0;
                }
            }
        }
        prev_code_size = code_size;
    }
    
    // Handle any remaining runs
    if rle_repeat_count > 0 {
        if rle_repeat_count < 3 {
            d.m_huff_count[2][prev_code_size as usize] =
                d.m_huff_count[2][prev_code_size as usize].wrapping_add(rle_repeat_count as u16);
            for _ in 0..rle_repeat_count {
                packed_code_sizes[num_packed_code_sizes] = prev_code_size;
                num_packed_code_sizes += 1;
            }
        } else {
            d.m_huff_count[2][16] = d.m_huff_count[2][16].wrapping_add(1);
            packed_code_sizes[num_packed_code_sizes] = 16;
            num_packed_code_sizes += 1;
            packed_code_sizes[num_packed_code_sizes] = (rle_repeat_count - 3) as u8;
            num_packed_code_sizes += 1;
        }
    } else if rle_z_count > 0 {
        if rle_z_count < 3 {
            d.m_huff_count[2][0] = d.m_huff_count[2][0].wrapping_add(rle_z_count as u16);
            for _ in 0..rle_z_count {
                packed_code_sizes[num_packed_code_sizes] = 0;
                num_packed_code_sizes += 1;
            }
        } else if rle_z_count <= 10 {
            d.m_huff_count[2][17] = d.m_huff_count[2][17].wrapping_add(1);
            packed_code_sizes[num_packed_code_sizes] = 17;
            num_packed_code_sizes += 1;
            packed_code_sizes[num_packed_code_sizes] = (rle_z_count - 3) as u8;
            num_packed_code_sizes += 1;
        } else {
            d.m_huff_count[2][18] = d.m_huff_count[2][18].wrapping_add(1);
            packed_code_sizes[num_packed_code_sizes] = 18;
            num_packed_code_sizes += 1;
            packed_code_sizes[num_packed_code_sizes] = (rle_z_count - 11) as u8;
            num_packed_code_sizes += 1;
        }
    }
    
    tdefl_optimize_huffman_table(d, 2, TDEFL_MAX_HUFF_SYMBOLS_2, 7, false);
    
    // Write block header
    tdefl_put_bits(d, 2, 2); // Dynamic block
    tdefl_put_bits(d, (num_lit_codes - 257) as u32, 5);
    tdefl_put_bits(d, (num_dist_codes - 1) as u32, 5);
    
    // Find number of bit length codes
    let mut num_bit_lengths = 19;
    while num_bit_lengths > 0
        && d.m_huff_code_sizes[2][S_TDEFL_PACKED_CODE_SIZE_SYMS_SWIZZLE[num_bit_lengths - 1] as usize] == 0
    {
        num_bit_lengths -= 1;
    }
    
    num_bit_lengths = max(4, num_bit_lengths + 1);
    tdefl_put_bits(d, (num_bit_lengths - 4) as u32, 4);
    
    for i in 0..num_bit_lengths {
        let idx = S_TDEFL_PACKED_CODE_SIZE_SYMS_SWIZZLE[i] as usize;
        tdefl_put_bits(d, d.m_huff_code_sizes[2][idx] as u32, 3);
    }
    
    // Write packed code sizes
    let mut packed_code_sizes_index = 0;
    while packed_code_sizes_index < num_packed_code_sizes {
        let code = packed_code_sizes[packed_code_sizes_index] as usize;
        packed_code_sizes_index += 1;
        
        tdefl_put_bits(
            d,
            d.m_huff_codes[2][code] as u32,
            d.m_huff_code_sizes[2][code] as u32,
        );
        
        if code >= 16 {
            let extra_bits = packed_code_sizes[packed_code_sizes_index] as u32;
            packed_code_sizes_index += 1;
            
            let extra_bits_count = match code {
                16 => 2,
                17 => 3,
                _ => 7,
            };
            tdefl_put_bits(d, extra_bits, extra_bits_count);
        }
    }
}

// Start a static block
fn tdefl_start_static_block(d: &mut TdeflCompressor) {
    // Setup static Huffman tables
    for i in 0..=143 {
        d.m_huff_code_sizes[0][i] = 8;
    }
    for i in 144..=255 {
        d.m_huff_code_sizes[0][i] = 9;
    }
    for i in 256..=279 {
        d.m_huff_code_sizes[0][i] = 7;
    }
    for i in 280..=287 {
        d.m_huff_code_sizes[0][i] = 8;
    }
    
    for i in 0..32 {
        d.m_huff_code_sizes[1][i] = 5;
    }
    
    tdefl_optimize_huffman_table(d, 0, 288, 15, true);
    tdefl_optimize_huffman_table(d, 1, 32, 15, true);
    
    tdefl_put_bits(d, 1, 2); // Static block
}

// Compress LZ codes to output
fn tdefl_compress_lz_codes(d: &mut TdeflCompressor) -> bool {
    let mut flags = 1u32;
    let mut p_lz_codes = d.m_lz_code_buf.as_ptr();
    let p_lz_code_buf_end = unsafe { p_lz_codes.add(d.m_lz_code_buf.len()) };
    
    while (p_lz_codes as usize) < (p_lz_code_buf_end as usize) {
        if flags == 1 {
            flags = unsafe { *p_lz_codes } as u32 | 0x100;
            p_lz_codes = unsafe { p_lz_codes.add(1) };
        }
        
        if (flags & 1) != 0 {
            // Match
            let match_len = unsafe { *p_lz_codes } as u32;
            let match_dist = unsafe {
                *p_lz_codes.add(1) as u32 | ((*p_lz_codes.add(2) as u32) << 8)
            };
            p_lz_codes = unsafe { p_lz_codes.add(3) };
            
            let len_sym = S_TDEFL_LEN_SYM[match_len as usize] as usize;
            tdefl_put_bits(
                d,
                d.m_huff_codes[0][len_sym] as u32,
                d.m_huff_code_sizes[0][len_sym] as u32,
            );
            tdefl_put_bits(
                d,
                match_len & (MZ_BITMASKS[S_TDEFL_LEN_EXTRA[match_len as usize] as usize] as u32),
                S_TDEFL_LEN_EXTRA[match_len as usize] as u32,
            );
            
            let (sym, num_extra_bits) = if match_dist < 512 {
                (
                    S_TDEFL_SMALL_DIST_SYM[match_dist as usize] as usize,
                    S_TDEFL_SMALL_DIST_EXTRA[match_dist as usize] as u32,
                )
            } else {
                (
                    S_TDEFL_LARGE_DIST_SYM[(match_dist >> 8) as usize] as usize,
                    S_TDEFL_LARGE_DIST_EXTRA[(match_dist >> 8) as usize] as u32,
                )
            };
            
            tdefl_put_bits(
                d,
                d.m_huff_codes[1][sym] as u32,
                d.m_huff_code_sizes[1][sym] as u32,
            );
            tdefl_put_bits(
                d,
                match_dist & (MZ_BITMASKS[num_extra_bits as usize] as u32),
                num_extra_bits,
            );
        } else {
            // Literal
            let lit = unsafe { *p_lz_codes } as usize;
            p_lz_codes = unsafe { p_lz_codes.add(1) };
            
            tdefl_put_bits(
                d,
                d.m_huff_codes[0][lit] as u32,
                d.m_huff_code_sizes[0][lit] as u32,
            );
        }
        
        flags >>= 1;
    }
    
    // Write end of block code
    tdefl_put_bits(
        d,
        d.m_huff_codes[0][256] as u32,
        d.m_huff_code_sizes[0][256] as u32,
    );
    
    unsafe { (d.m_pOutput_buf as usize) < (d.m_pOutput_buf_end as usize) }
}

// Compress a block
fn tdefl_compress_block(d: &mut TdeflCompressor, static_block: bool) -> bool {
    if static_block {
        tdefl_start_static_block(d);
    } else {
        tdefl_start_dynamic_block(d);
    }
    tdefl_compress_lz_codes(d)
}

// Initialize compressor
pub fn tdefl_init(
    d: &mut TdeflCompressor,
    p_put_buf_func: Option<fn(*const u8, usize, *mut ()) -> bool>,
    p_put_buf_user: *mut (),
    flags: u32,
) -> TdeflStatus {
    d.m_pPut_buf_func = p_put_buf_func;
    d.m_pPut_buf_user = p_put_buf_user;
    d.m_flags = flags;
    
    d.m_max_probes[0] = 1 + ((flags & 0xFFF) + 2) / 3;
    d.m_greedy_parsing = (flags & TDEFL_GREEDY_PARSING_FLAG) != 0;
    d.m_max_probes[1] = 1 + (((flags & 0xFFF) >> 2) + 2) / 3;
    
    if (flags & TDEFL_NONDETERMINISTIC_PARSING_FLAG) == 0 {
        memset(&mut d.m_hash, 0);
    }
    
    d.m_lookahead_pos = 0;
    d.m_lookahead_size = 0;
    d.m_dict_size = 0;
    d.m_total_lz_bytes = 0;
    d.m_lz_code_buf_dict_pos = 0;
    d.m_bits_in = 0;
    d.m_bit_buffer = 0;
    d.m_output_flush_ofs = 0;
    d.m_output_flush_remaining = 0;
    d.m_finished = false;
    d.m_block_index = 0;
    d.m_wants_to_finish = false;
    
    d.m_pLZ_code_buf = d.m_lz_code_buf.as_mut_ptr();
    d.m_pLZ_flags = d.m_lz_code_buf.as_mut_ptr();
    *d.m_pLZ_flags = 0;
    d.m_num_flags_left = 8;
    
    d.m_pOutput_buf = d.m_output_buf.as_mut_ptr();
    d.m_pOutput_buf_end = unsafe { d.m_output_buf.as_mut_ptr().add(TDEFL_OUT_BUF_SIZE) };
    
    d.m_prev_return_status = TdeflStatus::Okay;
    d.m_saved_match_dist = 0;
    d.m_saved_match_len = 0;
    d.m_saved_lit = 0;
    d.m_adler32 = 1;
    
    d.m_pIn_buf = std::ptr::null();
    d.m_pOut_buf = std::ptr::null_mut();
    d.m_pIn_buf_size = std::ptr::null_mut();
    d.m_pOut_buf_size = std::ptr::null_mut();
    d.m_flush = TdeflFlush::NoFlush;
    d.m_pSrc = std::ptr::null();
    d.m_src_buf_left = 0;
    d.m_out_buf_ofs = 0;
    
    if (flags & TDEFL_NONDETERMINISTIC_PARSING_FLAG) == 0 {
        memset(&mut d.m_dict, 0);
    }
    
    memset(&mut d.m_huff_count[0][0..TDEFL_MAX_HUFF_SYMBOLS_0], 0);
    memset(&mut d.m_huff_count[1][0..TDEFL_MAX_HUFF_SYMBOLS_1], 0);
    
    TdeflStatus::Okay
}

